# Pin LF line endings for source files. Windows runners' default
# core.autocrlf=true would otherwise convert *.rs to CRLF on
# checkout, which trips rustfmt's "incorrect newline style" check.
# Pinning per-extension also keeps the working tree byte-identical
# across operating systems.
.gitattributes text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
# Preserve the operator-supplied masterplan byte-for-byte, including its three
# intentional Markdown hard breaks, while keeping normal whitespace checks on
# every other Markdown file.
PLAN/NEOTH_Context_Connector_Masterplan_2026-08-13.md whitespace=-trailing-space
*.sh   text eol=lf
*.slint text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.py    text eol=lf
*.iss   text eol=lf
*.txt   text eol=lf
*.lock  text eol=lf
THIRD_PARTY_LICENSES text eol=lf
packaging/**/fixtures/*.txt text eol=lf
*.ps1  text eol=crlf
# This vendor archive is checked against upstream SHA-256 file bytes. Disable
# checkout conversion for every member, including extensionless metadata.
SRC/vendor/arrayref/** -text
SRC/vendor/imbl/** -text
# Preserve Candle archive bytes and the reviewed patch's context-line markers.
SRC/vendor/candle-core/** -text
packaging/vendor-provenance/candle-core-0.8.4.crate -text
packaging/vendor-provenance/candle-core-0.8.4-zip9.patch text eol=lf whitespace=-blank-at-eol
packaging/vendor-provenance/zip9.0.5-russh0.64.1.patch text eol=lf whitespace=-blank-at-eol
# Preserve the upstream archive member's existing final blank line.
SRC/vendor/imbl/.github/dependabot.yml whitespace=-blank-at-eof
# Preserve the pinned Silero model, upstream license and provenance bytes.
SRC/neothd/assets/silero-vad/** -text
# Preserve authenticated upstream whitespace in these two unchanged Candle files.
SRC/vendor/candle-core/src/tensor_cat.rs whitespace=-blank-at-eol
SRC/vendor/candle-core/tests/conv_tests.rs whitespace=-blank-at-eol
