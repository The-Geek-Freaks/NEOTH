  "changes": [
    "Persist bounded document provenance in the existing sources table; migrate schema 46 to 47 without backfilling legacy provenance",
    "Validate exact extracted UTF-8 text bytes and SHA-256 before replacement; commit source, provenance and both FTS indexes together",
    "Return optional source_document_provenance on BM25, trigram and fuzzy hits; reject corrupt partial persisted metadata",
    "Report invalid_provenance before store opening; retain the previous indexed document when replacement fails",
    "Return actual committed source deletion count; repeated or absent-label purge returns zero"
  ],
  "compatibility": [
    "Existing rows remain unbound; non-document extractors remain supported",
    "Equal bytes under different labels do not merge documents",
    "Existing index transaction and migration dispatcher retain ownership"
  ],
  "tests": [
    "memory::document_provenance::tests::document_metadata_binds_exact_utf8_text",
    "memory::document_provenance::tests::document_metadata_rejects_malformed_shapes_and_unbounded_values",
    "memory::document_provenance::tests::other_extractors_and_legacy_metadata_remain_unbound",
    "memory::ctx::tests::document_provenance_survives_reopen_and_all_search_fallbacks_without_merging_labels",
    "memory::ctx::tests::upgraded_v46_store_indexes_provenance_and_reopens_with_legacy_rows_intact",
    "memory::ctx::tests::invalid_document_provenance_and_aborted_replacement_preserve_source_and_both_indexes",
    "memory::ctx::tests::replacing_document_with_unbound_text_clears_provenance_without_reusing_old_receipt",
    "memory::ctx::tests::search_rejects_partial_or_corrupt_document_provenance_instead_of_hiding_it",
    "memory::ctx::tests::purge_source_reports_only_committed_removals_and_preserves_other_documents",
    "memory::migrations::tests::v46_to_v47_preserves_legacy_source_and_leaves_provenance_unbound",
    "memory::migrations::tests::v46_to_v47_rolls_back_partial_alters_and_retains_previous_version",
    "memory::migrations::tests::v46_to_v47_requires_the_existing_sources_table",
    "memory::migrations::tests::v47_fresh_and_migrated_sources_have_the_same_column_contract",
    "cli::ingest::tests::document_ingest_retains_extractor_provenance_after_reopen_and_search",
    "cli::ingest::tests::document_ingest_rejects_invalid_provenance_before_replacing_existing_index"
