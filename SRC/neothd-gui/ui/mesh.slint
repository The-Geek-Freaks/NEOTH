// NEOTH — Mesh / Cluster fleet dashboard (Design Wave 4 → 5).
//
// WIRING — new since Wave 4 (Rust must bind these):
//   MeshPeerRow additions: cpu-pct float, ram-pct float, vram-pct float,
//     role string, version string, staleness-secs int
//   MeshView new in-properties:
//     gossip-events [string]  — recent gossip log lines, newest-first
//     expanded-peer string    — peer-id with inline detail open; "" = none
//   MeshView new callbacks:
//     peer-sync-clicked(string)  — Rust: enqueue WAL sync for peer id
//     peer-expanded(string)      — Rust: toggle expanded-peer (set "" to collapse)
//
// All Wave 4 properties / callbacks preserved (mesh-node-id, mesh-listen-port,
// mesh-mdns-enabled, mesh-trusted-ssids, mesh-peers, mesh-peer-count,
// mesh-gossip-note, mesh-foreign-rows, mesh-foreign-total, mesh-foreign-bytes,
// mesh-foreign-peers, mesh-refreshed-at, mesh-refresh-clicked).
//
// Slint 1.16 rules: `if` not `visible`; no @children in `if`; ScrollView inner
// VerticalLayout needs min-height; Led: "live"|"connecting"|"error"|"off";
// no inline hex; radius never 0px.

import { Theme } from "theme.slint";
import { Card, Led, EntranceFade, NeothButton, Kicker, InfoRow, RefreshFooter, SegBar } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// ── Exported structs (Rust must re-export from main.slint) ────────────────────

/// One peer entry from cluster status peers[] — extended with gossip resource data.
export struct MeshPeerRow {
    id: string,             // peer node id (mono display, truncated)
    last-seen: string,      // human-readable relative time e.g. "3 s ago"
    reachable: bool,        // false → pink rail + Led "error"
    cpu-pct: float,         // CPU usage 0..1 from gossip heartbeat
    ram-pct: float,         // RAM usage 0..1 from gossip heartbeat
    vram-pct: float,        // VRAM usage 0..1; 0.0 = no GPU or unreported
    role: string,           // peer role label e.g. "worker" | "coord" | "relay"
    version: string,        // daemon semver e.g. "1.2.0"
    staleness-secs: int,    // seconds since last heartbeat; > 30 → amber rail
}

/// DES-13 — per-origin-peer replicated-backup summary (idx_foreign_events).
export struct MeshForeignRow {
    peer: string,     // origin peer pubkey (mono, truncated)
    count: string,    // pre-formatted event count e.g. "128"
    bytes: string,    // pre-formatted total payload bytes e.g. "4.2 KB"
    latest: string,   // pre-formatted latest received time e.g. "12:03"
}

/// One unresolved canonical-content divergence from `neoth cluster conflicts`.
export struct MeshConflictRow {
    content-id: string,
    incumbent-origin: string,
    incoming-origin: string,
    incumbent-digest: string,
    incoming-digest: string,
    policy: string,
    observed-at: string,
}

// ── PeerCard — fleet peer: health rail + resource meters + quick actions ──────

component PeerCard inherits Rectangle {
    in property <string> peer-id;
    in property <string> last-seen;
    in property <bool>   reachable;
    in property <float>  cpu-pct;
    in property <float>  ram-pct;
    in property <float>  vram-pct;
    in property <string> role;
    in property <string> version;
    in property <int>    staleness-secs;
    in property <bool>   expanded;

    callback sync-clicked();
    callback expand-clicked();

    // Rail color: pink = unreachable, amber = stale (> 30 s), green = fresh
    property <color> rail-color: !root.reachable ? Theme.consent
                                : root.staleness-secs > 30 ? Theme.warning
                                : Theme.memory;

    // Led state: error | connecting (amber) | live
    property <string> led-state: !root.reachable ? "error"
                                : root.staleness-secs > 30 ? "connecting"
                                : "live";

    border-radius: Theme.radius-md;
    background: Theme.surface-1;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        spacing: 0px;
        padding: 0px;

        // Colored health rail (3 px left strip: green=fresh, amber=stale, pink=unreachable)
        Rectangle {
            width: 3px;
            background: root.rail-color;
            border-radius: 2px;
            animate background { duration: Theme.duration-slow; easing: ease-out; }
        }

        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;
            horizontal-stretch: 1;

            // LED · peer-id · role chip · version · last-seen badge
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                height: 22px;

                Led {
                    state: root.led-state;
                    dot-size: 6px;
                }

                Text {
                    text: root.peer-id;
                    color: root.reachable ? Theme.audit : Theme.text-disabled;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-size-xs;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                // Role chip
                Rectangle {
                    height: 18px;
                    width: 60px;
                    border-radius: Theme.radius-pill;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    accessible-role: text;
                    accessible-label: "role: " + root.role;
                    Text {
                        text: root.role;
                        color: Theme.text-tertiary;
                        font-family: Theme.font-mono;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        letter-spacing: Theme.letter-spacing-wide;
                        overflow: elide;
                    }
                }

                // Version (mono 2xs, right-aligned)
                Text {
                    text: root.version;
                    color: Theme.text-disabled;
                    font-family: Theme.font-mono;
                    font-size: 9px;
                    vertical-alignment: center;
                    width: 40px;
                    horizontal-alignment: right;
                }

                // Last-seen badge
                Rectangle {
                    height: 18px;
                    width: 80px;
                    border-radius: Theme.radius-sm;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    Text {
                        text: root.last-seen;
                        color: Theme.text-disabled;
                        font-family: Theme.font-mono;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // SegBar resource meters — CPU (cyan) · RAM (green) · VRAM (pink)
            HorizontalLayout {
                spacing: 14px;
                height: 26px;
                alignment: start;

                // CPU meter
                VerticalLayout {
                    spacing: 3px;
                    horizontal-stretch: 1;
                    alignment: start;
                    Text {
                        text: "CPU";
                        color: Theme.text-disabled;
                        font-family: Theme.font-mono;
                        font-size: 9px;
                        letter-spacing: Theme.letter-spacing-wide;
                        height: 11px;
                    }
                    SegBar {
                        segments: 10;
                        fraction: root.cpu-pct;
                        fill: Theme.audit;
                    }
                }

                // RAM meter
                VerticalLayout {
                    spacing: 3px;
                    horizontal-stretch: 1;
                    alignment: start;
                    Text {
                        text: "RAM";
                        color: Theme.text-disabled;
                        font-family: Theme.font-mono;
                        font-size: 9px;
                        letter-spacing: Theme.letter-spacing-wide;
                        height: 11px;
                    }
                    SegBar {
                        segments: 10;
                        fraction: root.ram-pct;
                        fill: Theme.memory;
                    }
                }

                // VRAM meter
                VerticalLayout {
                    spacing: 3px;
                    horizontal-stretch: 1;
                    alignment: start;
                    Text {
                        text: "VRAM";
                        color: Theme.text-disabled;
                        font-family: Theme.font-mono;
                        font-size: 9px;
                        letter-spacing: Theme.letter-spacing-wide;
                        height: 11px;
                    }
                    SegBar {
                        segments: 10;
                        fraction: root.vram-pct;
                        fill: Theme.consent;
                    }
                }
            }

            // Quick actions — Request Sync · Details toggle
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                height: 28px;

                NeothButton {
                    label: "Request Sync";
                    size: "sm";
                    primary: false;
                    clicked => { root.sync-clicked(); }
                }

                // Details toggle (ghost secondary button)
                Rectangle {
                    height: 28px;
                    width: 84px;
                    border-radius: Theme.radius-button;
                    background: transparent;
                    border-width: 1px;
                    border-color: det-ta.has-hover ? Theme.border-strong : Theme.border-subtle;
                    accessible-role: button;
                    accessible-label: root.expanded ? "Hide peer details" : "Show peer details";
                    accessible-action-default => { root.expand-clicked(); }
                    animate border-color { duration: Theme.duration-fast; easing: ease-out; }

                    Text {
                        text: root.expanded ? "Hide Details" : "Details ›";
                        color: det-ta.has-hover ? Theme.text-secondary : Theme.text-disabled;
                        font-family: Theme.font-mono;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        animate color { duration: Theme.duration-fast; easing: ease-out; }
                    }

                    det-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.expand-clicked(); }
                    }
                }
            }

            // Inline detail block (rendered only when expanded)
            if root.expanded: Rectangle {
                border-radius: Theme.radius-sm;
                background: Theme.bg-void;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 10px;
                    spacing: 3px;
                    alignment: start;

                    Text {
                        text: "ID    " + root.peer-id;
                        color: Theme.audit;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "CPU " + round(root.cpu-pct * 100) + "%"
                            + "   RAM " + round(root.ram-pct * 100) + "%"
                            + "   VRAM " + round(root.vram-pct * 100) + "%";
                        color: Theme.text-tertiary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                    }
                    Text {
                        text: "ROLE " + root.role
                            + "   VER " + root.version
                            + "   STALE " + root.staleness-secs + "s";
                        color: Theme.text-tertiary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                    }
                }
            }
        }
    }
}

// ── MeshView ──────────────────────────────────────────────────────────────────

export component MeshView inherits Rectangle {
    // ── NODE ─────────────────────────────────────────────────────────────────
    in property <string> mesh-node-id: "";
    in property <string> mesh-listen-port: "";
    in property <bool>   mesh-mdns-enabled: false;
    in property <string> mesh-trusted-ssids: "";

    // ── PEERS ────────────────────────────────────────────────────────────────
    in property <[MeshPeerRow]> mesh-peers: [];

    // ── REDUNDANCY ───────────────────────────────────────────────────────────
    in property <int>    mesh-peer-count: 0;
    in property <string> mesh-gossip-note: "";
    in property <[MeshForeignRow]> mesh-foreign-rows: [];
    in property <int>    mesh-foreign-total: 0;
    in property <string> mesh-foreign-bytes: "";
    in property <int>    mesh-foreign-peers: 0;

    // ── Typed conflict ledger ────────────────────────────────────────────────
    in property <[MeshConflictRow]> mesh-conflicts: [];
    in property <int> mesh-conflict-count: 0;
    in property <bool> mesh-conflicts-valid: true;
    in property <string> mesh-conflicts-error: "";

    // ── Gossip stream + expansion (Wave 5) ───────────────────────────────────
    in property <[string]> gossip-events: [];  // newest-first log lines
    in property <string>   expanded-peer: "";  // peer-id with detail open; "" = none

    in property <string> mesh-refreshed-at: "";
    callback mesh-refresh-clicked();

    // ── Per-peer quick action callbacks (Wave 5) ─────────────────────────────
    callback peer-sync-clicked(string /*peer-id*/);  // enqueue WAL sync
    callback peer-expanded(string /*peer-id*/);       // toggle inline detail
    callback conflict-resolve-clicked(string /*content-id*/, string /*preferred origin*/);

    // ── Layout ────────────────────────────────────────────────────────────────
    background: Theme.bg-base;

    EntranceFade {
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            // ── View header ──────────────────────────────────────────────────
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                height: 44px;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Mesh & Cluster";
                        color: Theme.text-primary;
                        font-family: Theme.font-sans;
                        font-size: Theme.font-size-md;
                        letter-spacing: Theme.letter-spacing-tight;
                    }
                    Text {
                        text: "node identity · fleet peers · failover status";
                        color: Theme.text-tertiary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                        letter-spacing: Theme.letter-spacing-wide;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                NeothButton {
                    label: "Refresh";
                    size: "sm";
                    primary: false;
                    clicked => { root.mesh-refresh-clicked(); }
                }
            }

            // Hairline separator
            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // ── Scrollable content ───────────────────────────────────────────
            ScrollView {

                VerticalLayout {
                    padding: 0px;
                    spacing: 14px;
                    alignment: start;
                    min-height: 900px;

                    // ── NODE CARD ────────────────────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "NODE"; }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: "mDNS";
                                    color: Theme.text-disabled;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-2xs;
                                    letter-spacing: Theme.letter-spacing-wide;
                                    vertical-alignment: center;
                                }
                                Led {
                                    state: root.mesh-mdns-enabled ? "live" : "off";
                                    dot-size: 7px;
                                }
                            }

                            // Node id full-width mono row
                            Rectangle {
                                height: 44px;
                                border-radius: Theme.radius-md;
                                background: Theme.surface-1;
                                border-width: 1px;
                                border-color: root.mesh-node-id != "" ? Theme.border-accent : Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: start;
                                    spacing: 10px;
                                    Text {
                                        text: "NODE ID";
                                        color: Theme.text-disabled;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        letter-spacing: Theme.letter-spacing-wide;
                                        vertical-alignment: center;
                                        width: 58px;
                                    }
                                    Text {
                                        text: root.mesh-node-id != "" ? root.mesh-node-id : "—";
                                        color: root.mesh-node-id != "" ? Theme.audit : Theme.text-disabled;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            InfoRow {
                                label: "LISTEN PORT";
                                value: root.mesh-listen-port;
                                value-color: Theme.text-primary;
                            }

                            if root.mesh-trusted-ssids != "": InfoRow {
                                label: "TRUST SSIDS";
                                value: root.mesh-trusted-ssids;
                                value-color: Theme.memory;
                            }

                            if root.mesh-trusted-ssids == "": InfoRow {
                                label: "TRUST SSIDS";
                                value: "any (no filter)";
                                value-color: Theme.text-disabled;
                            }

                            RefreshFooter { ts: root.mesh-refreshed-at; }
                        }
                    }

                    // ── CONFLICTS CARD ──────────────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                height: 18px;
                                Kicker { label: "CONTENT CONFLICTS"; }
                                Rectangle { horizontal-stretch: 1; }
                                Rectangle {
                                    height: 18px;
                                    width: 36px;
                                    border-radius: Theme.radius-pill;
                                    background: root.mesh-conflict-count > 0
                                        ? Theme.warning-tint : Theme.memory-tint;
                                    border-width: 1px;
                                    border-color: root.mesh-conflict-count > 0
                                        ? Theme.warning : Theme.memory;
                                    Text {
                                        text: "\{root.mesh-conflict-count}";
                                        color: root.mesh-conflict-count > 0
                                            ? Theme.warning : Theme.memory;
                                        font-family: Theme.font-mono;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if !root.mesh-conflicts-valid: Rectangle {
                                min-height: 48px;
                                border-radius: Theme.radius-sm;
                                background: Theme.consent-tint;
                                border-width: 1px;
                                border-color: Theme.consent;
                                VerticalLayout {
                                    padding: 10px;
                                    Text {
                                        text: root.mesh-conflicts-error;
                                        color: Theme.consent;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.mesh-conflicts-valid && root.mesh-conflict-count == 0: Text {
                                text: "No unresolved typed mesh conflicts.";
                                color: Theme.memory;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-xs;
                            }

                            for conflict in root.mesh-conflicts: Rectangle {
                                min-height: 132px;
                                border-radius: Theme.radius-sm;
                                background: Theme.surface-1;
                                border-width: 1px;
                                border-color: Theme.warning;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: conflict.content-id;
                                        color: Theme.warning;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-xs;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: conflict.policy + " · observed " + conflict.observed-at;
                                        color: Theme.text-tertiary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                    }
                                    Text {
                                        text: "A  " + conflict.incumbent-origin + "  " + conflict.incumbent-digest;
                                        color: Theme.text-secondary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "B  " + conflict.incoming-origin + "  " + conflict.incoming-digest;
                                        color: Theme.text-secondary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        NeothButton {
                                            label: "Prefer A";
                                            size: "sm";
                                            primary: false;
                                            clicked => {
                                                root.conflict-resolve-clicked(
                                                    conflict.content-id,
                                                    conflict.incumbent-origin
                                                );
                                            }
                                        }
                                        NeothButton {
                                            label: "Prefer B";
                                            size: "sm";
                                            primary: false;
                                            clicked => {
                                                root.conflict-resolve-clicked(
                                                    conflict.content-id,
                                                    conflict.incoming-origin
                                                );
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── PEERS CARD (fleet dashboard) ─────────────────────────
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            // Kicker + count chip
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "PEERS"; }
                                Rectangle { horizontal-stretch: 1; }
                                if root.mesh-peers.length > 0: Rectangle {
                                    height: 18px;
                                    width: 36px;
                                    border-radius: Theme.radius-pill;
                                    background: Theme.audit-tint;
                                    border-width: 1px;
                                    border-color: Theme.audit;
                                    Text {
                                        text: "\{root.mesh-peers.length}";
                                        color: Theme.audit;
                                        font-family: Theme.font-mono;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Fleet peer cards
                            for peer in root.mesh-peers: PeerCard {
                                peer-id: peer.id;
                                last-seen: peer.last-seen;
                                reachable: peer.reachable;
                                cpu-pct: peer.cpu-pct;
                                ram-pct: peer.ram-pct;
                                vram-pct: peer.vram-pct;
                                role: peer.role;
                                version: peer.version;
                                staleness-secs: peer.staleness-secs;
                                expanded: root.expanded-peer == peer.id;
                                sync-clicked => { root.peer-sync-clicked(peer.id); }
                                expand-clicked => { root.peer-expanded(peer.id); }
                            }

                            // Empty state — no peers discovered
                            if root.mesh-peers.length == 0: Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding: 24px;
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: "CLUSTER OFF";
                                        color: Theme.text-tertiary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-xs;
                                        horizontal-alignment: center;
                                        letter-spacing: Theme.letter-spacing-wide;
                                    }
                                    Text {
                                        text: "No peers discovered. NEOTH runs standalone.";
                                        color: Theme.text-disabled;
                                        font-family: Theme.font-mono;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "→ Enable mDNS in Settings › Cluster, or add peers manually via `neoth cluster add <addr>`.";
                                        color: Theme.text-disabled;
                                        font-family: Theme.font-mono;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.mesh-gossip-note != "": Rectangle {
                                height: 28px;
                                border-radius: Theme.radius-sm;
                                background: Theme.memory-tint;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    alignment: start;
                                    spacing: 6px;
                                    Text {
                                        text: "✓";
                                        color: Theme.memory;
                                        font-size: Theme.font-size-xs;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.mesh-gossip-note;
                                        color: Theme.memory;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            RefreshFooter { ts: root.mesh-refreshed-at; }
                        }
                    }

                    // ── GOSSIP EVENT STREAM ──────────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            // Kicker + event count chip
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "GOSSIP"; }
                                Rectangle { horizontal-stretch: 1; }
                                Rectangle {
                                    height: 18px;
                                    width: 36px;
                                    border-radius: Theme.radius-pill;
                                    background: Theme.warning-tint;
                                    border-width: 1px;
                                    border-color: Theme.warning;
                                    Text {
                                        text: "\{root.gossip-events.length}";
                                        color: Theme.warning;
                                        font-family: Theme.font-mono;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Log card — mono bg-void, newest first
                            Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.bg-void;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 3px;
                                    alignment: start;

                                    // Empty gossip state
                                    if root.gossip-events.length == 0: Text {
                                        text: "no gossip events yet";
                                        color: Theme.text-disabled;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        horizontal-alignment: center;
                                        height: 32px;
                                        vertical-alignment: center;
                                    }

                                    // Event lines (newest-first from Rust)
                                    for evt in root.gossip-events: Text {
                                        text: evt;
                                        color: Theme.text-tertiary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    // ── REDUNDANCY CARD ──────────────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "REDUNDANCY"; }
                                Rectangle { horizontal-stretch: 1; }
                                Led { state: "connecting"; dot-size: 7px; }
                            }

                            // DES-13 backup-at-rest
                            Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.accent-green.with-alpha(0.08);
                                border-width: 1px;
                                border-color: Theme.accent-green.with-alpha(0.35);

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    alignment: start;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Led { state: root.mesh-foreign-total > 0 ? "live" : "off"; dot-size: 7px; }
                                        Text {
                                            text: root.mesh-foreign-total > 0
                                                ? "Backup-at-rest is LIVE"
                                                : "No peer data replicated yet";
                                            color: Theme.accent-green;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-sm;
                                            font-weight: Theme.weight-semibold;
                                            vertical-alignment: center;
                                            letter-spacing: Theme.letter-spacing-tight;
                                        }
                                    }
                                    Text {
                                        text: root.mesh-foreign-total > 0
                                            ? "Holding " + root.mesh-foreign-total + " replicated event(s) from "
                                              + root.mesh-foreign-peers + " peer(s) · " + root.mesh-foreign-bytes
                                              + ". If a peer's disk dies, its gossiped events survive here."
                                            : "Once paired peers gossip, their replicable events are persisted here as failover backup. Pair a peer to begin.";
                                        color: Theme.text-secondary;
                                        font-family: Theme.font-sans;
                                        font-size: Theme.font-size-sm;
                                        wrap: word-wrap;
                                    }

                                    for f in root.mesh-foreign-rows: HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        height: 20px;
                                        Text {
                                            text: f.peer;
                                            color: Theme.text-tertiary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            vertical-alignment: center;
                                            width: 150px;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: f.count + " ev";
                                            color: Theme.accent-green;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            vertical-alignment: center;
                                            width: 60px;
                                        }
                                        Text {
                                            text: f.bytes;
                                            color: Theme.text-tertiary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            vertical-alignment: center;
                                            width: 72px;
                                        }
                                        Text {
                                            text: f.latest;
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Amber warning — honest about partial restore
                            Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.warning-tint;
                                border-width: 1px;
                                border-color: Theme.warning;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    alignment: start;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Text {
                                            text: "⚠";
                                            color: Theme.warning;
                                            font-size: Theme.font-size-sm;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Auto-restore is PARTIAL";
                                            color: Theme.warning;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-sm;
                                            font-weight: Theme.weight-semibold;
                                            vertical-alignment: center;
                                            letter-spacing: Theme.letter-spacing-tight;
                                        }
                                    }

                                    Text {
                                        text: "Replicated events are stored (above), but automatic merge back into a recovered node's recall/memory is not yet complete. Treat the mesh as durable backup, not one-click restore.";
                                        color: Theme.text-secondary;
                                        font-family: Theme.font-sans;
                                        font-size: Theme.font-size-sm;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: "Do not rely on the mesh as your only backup.";
                                        color: Theme.warning;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-sm;
                                        font-weight: Theme.weight-semibold;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Text {
                                            text: "→";
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-xs;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Use the Backup tab for reliable data protection.";
                                            color: Theme.text-tertiary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-xs;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // Reachable peer count
                            Rectangle {
                                height: 36px;
                                border-radius: Theme.radius-md;
                                background: Theme.surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: start;
                                    spacing: 10px;
                                    Text {
                                        text: "REACHABLE PEERS";
                                        color: Theme.text-tertiary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        letter-spacing: Theme.letter-spacing-wide;
                                        vertical-alignment: center;
                                        width: 110px;
                                    }
                                    Text {
                                        text: root.mesh-peer-count > 0
                                            ? "\{root.mesh-peer-count} peer(s) — gossip only"
                                            : "0 — fully standalone";
                                        color: root.mesh-peer-count > 0 ? Theme.audit : Theme.text-disabled;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            RefreshFooter { ts: root.mesh-refreshed-at; }
                        }
                    }
                }
            }
        }
    }
}
