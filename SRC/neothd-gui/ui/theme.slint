// NEOTH design tokens — single source of truth for the GUI's visual surface.
//
// Source of truth: the NEOTH Design System handoff bundle (claude.ai/design,
// 2026-06-15, "NEOTH Design System-handoff"), vendored at `design-system/`.
// Operator decision 2026-06-15: the bundle's SATURATED neon signal palette is
// canonical (green=memory #00ff80, pink=consent #ff2a6d, cyan=audit #05d5ff) —
// it supersedes the earlier desaturated emerald (#3ecf8e) experiment.
//
// Design Wave 1 additions (2026-07-04): full ds_colors.css semantic set
// (bg-void/base/sunken, surface-1/2/3/glass, border subtle/default/strong/
// accent, text hierarchy, accent/memory/audit/consent/warning tokens),
// plus motion tokens (duration-toast-in, duration-toast-life,
// duration-entrance, duration-side-in).
//
// Design language: neon-on-near-black. Three signal colours carry MEANING
// everywhere — green = memory (primary/live), pink = consent (boundaries/alert),
// cyan = audit (proof/info). Type: Space Grotesk (UI + display), Bodoni Moda
// (NEOTH wordmark only), JetBrains Mono (ids / audit frames / status lines).
//
// Anti-pattern guards (kept from the prior spec):
//   - Every radius MUST be one of the Theme.radius-* values (never 0px).
//     Exception: pixel-scale primitives (progress tracks, indicator rails
//     ≤6px tall) may use 1–3px where the token set is geometrically invalid.
//   - Every colour MUST come from this module, never inline hex.
//   - Glow — not drop-shadow — is the brand's true elevation on dark.
//
// Backward-compat: every property name the existing GUI already references is
// preserved here (only VALUES shift to the canonical neon); the richer
// signal/semantic/glow/buddy tokens are net-new additions.

export global Theme {
    // ── Theme mode ─────────────────────────────────────────────────────
    // `dark` is the live light/dark switch. Rust sets it from the persisted
    // operator choice on startup and flips it on the sidebar toggle. Surfaces,
    // text, semantic accents + borders switch on it; the raw signal scale
    // (green-500 etc.) + the Buddy stay vivid neon in BOTH themes (the orb is
    // the one place the signal palette goes loud). Light values are the design
    // system's inverted theme (warm paper, darkened neons that hold AA).
    in-out property <bool> dark: true;
    // ODY-11 — per-turn density: 0=compact  1=normal  2=spacious.
    // Rust sets this at startup from ~/.neoth/.gui-density and updates it
    // on the on_density_changed callback. Default=1 (normal).
    in-out property <int> density-mode: 1;

    // B23 — THEME-TWEAKS-RUNTIME: every retained tweaks.toml appearance key
    // terminates in one of these first-paint properties. Empty/zero sentinels
    // mean "use the built-in design-system token".
    in-out property <string> font-sans-override: "";
    in-out property <length> font-size-override: 0px;
    in-out property <length> sidebar-w-override: 0px;
    in-out property <length> input-height-override: 0px;
    in-out property <bool>   accent-override-enabled: false;
    in-out property <color>  accent-color-override: transparent;
    in-out property <bool>   background-override-enabled: false;
    in-out property <color>  background-color-override: transparent;
    in-out property <bool>   foreground-override-enabled: false;
    in-out property <color>  foreground-color-override: transparent;
    in-out property <length> border-radius-override: 0px;
    in-out property <float>  panel-opacity: 1.0;
    in-out property <bool>   show-token-count: true;
    in-out property <bool>   show-model-badge: false;
    // 0=rounded, 1=square (minimum accessible radius), 2=minimal.
    in-out property <int>    chat-bubble-style: 0;
    // 0=none, 1=reduced, 2=full.
    in-out property <int>    animation-mode: 2;
    in-out property <bool>   header-hidden: false;
    in-out property <bool>   sidebar-collapsed: false;

    // ══ INK SCALE — near-black canvas the brand lives on ════════════════
    out property <color> ink-1000: #050505;
    out property <color> ink-950:  #0a0a0a;
    out property <color> ink-900:  #0d0d0d;
    out property <color> ink-850:  #121212;
    out property <color> ink-800:  #161616;
    out property <color> ink-700:  #1c1c1c;
    out property <color> ink-600:  #3c3c40;  // +chroma ≈ hue 255
    out property <color> ink-500:  #2d2d30;
    out property <color> ink-400:  #393940;
    out property <color> ink-300:  #595960;
    out property <color> ink-200:  #8a8a92;
    out property <color> ink-150:  #aaaab2;
    out property <color> ink-100:  #c9c9d2;
    out property <color> ink-50:   #e6e6ee;
    out property <color> ink-0:    #f4f4f5;  // near-white; pure #ffffff banned

    // ══ SIGNAL COLOURS — the three meaning-carrying neons ═══════════════
    // GREEN = MEMORY (primary / live / accent).
    out property <color> green-500: #00ff80;
    out property <color> green-600: #00cc66;
    out property <color> green-400: #4dffa6;
    out property <color> green-700: #009950;
    out property <color> green-glow: #00ff808c;   // rgba(0,255,128,.55)
    out property <color> green-tint: #00ff801a;   // rgba(0,255,128,.10)
    // CYAN = AUDIT (proof / info / network).
    out property <color> cyan-500: #05d5ff;
    out property <color> cyan-600: #04aacc;
    out property <color> cyan-400: #5ce4ff;
    out property <color> cyan-700: #037f99;
    out property <color> cyan-glow: #05d5ff80;     // rgba(5,213,255,.50)
    out property <color> cyan-tint: #05d5ff1a;
    // PINK = CONSENT (boundaries / alert / danger).
    out property <color> pink-500: #ff2a6d;
    out property <color> pink-600: #cc2257;
    out property <color> pink-400: #ff6593;
    out property <color> pink-700: #991941;
    out property <color> pink-glow: #ff2a6d80;     // rgba(255,42,109,.50)
    out property <color> pink-tint: #ff2a6d1a;
    // AMBER = in-progress / caution (kanban "IN PROGRESS", pending).
    out property <color> amber-500: #ffb627;
    out property <color> amber-tint: #ffb6271f;    // rgba(255,182,39,.12)

    // ══ SEMANTIC SURFACES — elevation on dark ══════════════════════════
    out property <color> bg-void:   root.background-override-enabled ? root.background-color-override : (root.dark ? #050505 : #eceae4);   // deepest
    out property <color> bg-base:   root.background-override-enabled ? root.background-color-override : (root.dark ? #0d0d0d : #f4f2ec);   // page background
    out property <color> bg-center: root.background-override-enabled ? root.background-color-override : (root.dark ? #0a0a0a : #e7e4dc);   // radial centre
    out property <color> bg-sunken: root.background-override-enabled ? root.background-color-override : (root.dark ? #0a0a0a : #e7e4dc);
    out property <color> surface-1: (root.dark ? #121212 : #fbfaf6).with-alpha(root.panel-opacity);
    out property <color> surface-2: (root.dark ? #161616 : #ffffff).with-alpha(root.panel-opacity);
    out property <color> surface-3: (root.dark ? #1c1c1c : #ffffff).with-alpha(root.panel-opacity);
    out property <color> bg-card:   (root.dark ? #121212 : #fbfaf6).with-alpha(root.panel-opacity);   // card / inset
    out property <color> surface-glass: (root.dark ? #141414b8 : #ffffffbd).with-alpha(root.panel-opacity);

    // ══ TEXT HIERARCHY ═════════════════════════════════════════════════
    out property <color> text-primary:   root.foreground-override-enabled ? root.foreground-color-override : (root.dark ? #ffffff : #11140f);
    out property <color> text-secondary: root.dark ? #aaaaaa : #4a4d46;
    // R4-09 a11y: light-mode text-tertiary raised from #6f726a (~4.17:1, fails
    // WCAG AA) to #5d6058 (~5.3:1, passes AA for normal text).
    out property <color> text-tertiary:  root.dark ? #8a8a8a : #5d6058;
    out property <color> text-disabled:  root.dark ? #5a5a5a : #a7a99f;
    out property <color> text-inverse:   root.dark ? #0d0d0d : #f4f2ec;
    out property <color> text-on-accent: #04130b;   // dark-green ink on the green accent (both themes)
    out property <color> text-muted:     root.dark ? #aaaaaa : #4a4d46;   // back-compat alias
    out property <color> text-dim:       root.dark ? #909090 : #6f726a;   // back-compat caption

    // ══ SEMANTIC ALIASES — meaning, not colour, at the call site ═══════
    out property <color> accent:        root.accent-override-enabled ? root.accent-color-override : (root.dark ? #00ff80 : #008a45);
    out property <color> accent-hover:  root.accent-override-enabled ? root.accent-color-override : (root.dark ? #4dffa6 : #00a352);
    out property <color> accent-press:  root.accent-override-enabled ? root.accent-color-override : (root.dark ? #00cc66 : #006f38);
    out property <color> accent-tint:   root.accent-override-enabled ? root.accent-color-override.with-alpha(0.10) : (root.dark ? #00ff801a : #008a451f);
    out property <color> accent-glow:   root.accent-override-enabled ? root.accent-color-override.with-alpha(0.55) : (root.dark ? #00ff808c : #00a3524d);
    out property <color> memory:        root.accent-override-enabled ? root.accent-color-override : (root.dark ? #00ff80 : #008a45);
    out property <color> memory-tint:   root.accent-override-enabled ? root.accent-color-override.with-alpha(0.10) : (root.dark ? #00ff801a : #008a451f);
    out property <color> audit:         root.dark ? #05d5ff : #0286a8;
    out property <color> audit-tint:    root.dark ? #05d5ff1a : #0286a81f;
    out property <color> consent:       root.dark ? #ff2a6d : #d11254;
    out property <color> consent-tint:  root.dark ? #ff2a6d1a : #d112541f;
    out property <color> warning:       root.dark ? #ffb627 : #b8780a;
    out property <color> warning-tint:  root.dark ? #ffb6271f : #b8780a24;

    // Back-compat accent names the existing components reference. Values now
    // resolve to the canonical neon (the operator's "bundle is canonical" call).
    out property <color> accent-green: root.accent-override-enabled ? root.accent-color-override : (root.dark ? #00ff80 : #008a45);   // neon dark · AA-green light
    out property <color> accent-pink:  root.dark ? #ff2a6d : #d11254;
    out property <color> accent-amber: root.dark ? #ffb627 : #b8780a;
    out property <color> accent-teal:  root.dark ? #05d5ff : #0286a8;   // canonical audit-cyan
    out property <color> accent-cyan:  root.dark ? #05d5ff : #0286a8;

    // ══ BORDERS / DIVIDERS / FOCUS ═════════════════════════════════════
    out property <color> border-subtle:  root.dark ? #ffffff0f : #11141212;
    out property <color> border-default: root.dark ? #ffffff1a : #1114121f;
    out property <color> border-strong:  root.dark ? #ffffff29 : #11141233;
    out property <color> border-accent:  root.accent-override-enabled ? root.accent-color-override.with-alpha(0.45) : (root.dark ? #00ff8066 : #008a4573);
    out property <color> divider:        root.dark ? #ffffff12 : #1114121a;
    // R4-09 a11y: light-mode focus-ring alpha raised 0x80→0xcc (#008a4580 was
    // ~2.1:1 on white, below WCAG 2.2 §3.3.3 3:1 for focus indicators).
    out property <color> focus-ring:     root.accent-override-enabled ? root.accent-color-override.with-alpha(0.55) : (root.dark ? #00ff808c : #008a45cc);
    out property <color> scrim:          root.dark ? #050505a8 : #14161257;

    // ══ CORNER RADII — "Noble Curve", never 0px ════════════════════════
    out property <length> radius-xs:   root.border-radius-override > 0px ? root.border-radius-override : 4px;
    out property <length> radius-sm:   root.border-radius-override > 0px ? root.border-radius-override : 7px;
    out property <length> radius-md:   root.border-radius-override > 0px ? root.border-radius-override : 11px;
    out property <length> radius-lg:   root.border-radius-override > 0px ? root.border-radius-override : 16px;
    out property <length> radius-xl:   root.border-radius-override > 0px ? root.border-radius-override : 22px;
    out property <length> radius-2xl:  root.border-radius-override > 0px ? root.border-radius-override : 30px;
    out property <length> radius-pill: 999px;
    // Back-compat radius names.
    out property <length> radius-window: root.border-radius-override > 0px ? root.border-radius-override : 30px;
    out property <length> radius-card:   root.border-radius-override > 0px ? root.border-radius-override : 16px;
    out property <length> radius-button: root.border-radius-override > 0px ? root.border-radius-override : 8px;

    // ══ SPACING — 4px base grid, generous negative space ═══════════════
    out property <length> space-1:  4px;
    out property <length> space-2:  8px;
    out property <length> space-3:  12px;
    out property <length> space-4:  16px;
    out property <length> space-5:  20px;
    out property <length> space-6:  24px;
    out property <length> space-7:  32px;
    out property <length> space-8:  40px;
    out property <length> space-9:  48px;
    out property <length> space-10: 64px;
    // Back-compat spacing names.
    out property <length> space-tight:  8px;
    out property <length> space-base:   16px;
    out property <length> space-loose:  24px;
    out property <length> space-screen: 32px;

    // ODY-11 density tokens — derived from density-mode; consumed by chat.slint.
    // compact: tighter than baseline  normal: baseline  spacious: generous
    out property <length> bubble-padding:   root.density-mode == 0 ? 8px  : (root.density-mode == 2 ? 24px : 16px);
    out property <length> bubble-gap:       root.density-mode == 0 ? 4px  : (root.density-mode == 2 ? 16px : 8px);
    out property <length> composer-padding: root.density-mode == 0 ? 6px  : (root.density-mode == 2 ? 16px : 8px);

    // Layout.
    // sidebar-w: use override from tweaks.toml when > 0px, else 248px built-in.
    out property <length> sidebar-w: root.sidebar-w-override > 0px ? root.sidebar-w-override : 248px;
    out property <length> input-height: root.input-height-override > 0px ? root.input-height-override : 38px;
    out property <length> container-max: 1200px;

    // ══ TYPOGRAPHY ═════════════════════════════════════════════════════
    // Space Grotesk for all UI + display; Bodoni Moda for the wordmark only;
    // JetBrains Mono for machine-truth. Fallbacks resolve on the host.
    out property <string> font-sans:     root.font-sans-override != "" ? root.font-sans-override : "Space Grotesk, Inter, SF Pro Display, system-ui, sans-serif";
    out property <string> font-display:  root.font-sans;
    out property <string> font-wordmark: "Bodoni Moda, Didot, Times New Roman, Georgia, serif";
    out property <string> font-mono:     "JetBrains Mono, SF Mono, Consolas, monospace";

    // Weights.
    out property <int> weight-ultralight: 100;
    out property <int> weight-light:      300;
    out property <int> weight-regular:    400;
    out property <int> weight-medium:     500;
    out property <int> weight-semibold:   600;
    out property <int> weight-bold:       700;

    // Text sizes (grotesk steps).
    out property <length> font-size-2xs:     root.font-size-override > 0px ? max(9px, root.font-size-override - 4px) : 11px;
    out property <length> font-size-xs:      root.font-size-override > 0px ? max(10px, root.font-size-override - 3px) : 12px;
    out property <length> font-size-sm:      root.font-size-override > 0px ? max(10px, root.font-size-override - 2px) : 13px;
    out property <length> font-size-base:    root.font-size-override > 0px ? root.font-size-override : 15px;
    out property <length> font-size-md:      root.font-size-override > 0px ? root.font-size-override + 2px : 17px;
    out property <length> font-size-lg:      root.font-size-override > 0px ? root.font-size-override + 5px : 20px;
    out property <length> font-size-xl:      root.font-size-override > 0px ? root.font-size-override + 9px : 24px;
    // Display steps.
    out property <length> font-size-display-sm: 32px;
    out property <length> font-size-display-md: 48px;
    out property <length> font-size-display-lg: 80px;
    out property <length> font-size-hero:       72px;   // NEOTH wordmark
    // Back-compat size names.
    out property <length> font-size-h1:      root.font-size-override > 0px ? root.font-size-override + 17px : 32px;
    out property <length> font-size-h2:      root.font-size-override > 0px ? root.font-size-override + 5px : 20px;
    out property <length> font-size-body:    root.font-size-override > 0px ? root.font-size-override : 15px;
    out property <length> font-size-caption: root.font-size-override > 0px ? max(10px, root.font-size-override - 2px) : 13px;

    // Letter spacing (absolute px, the shipped values).
    out property <length> letter-spacing-hero:       14px;   // ≈ +20% on 72px wordmark
    out property <length> letter-spacing-body:       0.3px;
    out property <length> letter-spacing-tight:      1px;
    out property <length> letter-spacing-wide:       1.5px;
    out property <length> letter-spacing-extra-wide: 2px;
    out property <length> letter-spacing-brand-bar:  2px;    // ≈ 0.133em @15px — under 0.14em Hallmark cap
    out property <length> letter-spacing-mono-caps:  1.5px;  // ≈ 0.136em @11px — under 0.14em Hallmark cap

    // ══ MOTION ═════════════════════════════════════════════════════════
    // The "Sovereign Curve" — fast start, long majestic settle.
    // Canonical: animate <p> { duration: ...; easing: cubic-bezier(0.16,1,0.3,1); }
    // GOLD-ADAPT-GUI-02 — the ease-back overshoot curve is intentionally
    // inlined at its three short-travel animation sites. Slint 1.16 cannot
    // expose `easing` through a public global API without a generator warning.
    // Ambient-motion periods (design-taste audit B8): named so a
    // theme-wide timing pass reaches them.
    out property <duration> duration-sweep:   root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 350ms : 700ms);
    out property <duration> duration-spin:    root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 450ms : 900ms);
    out property <duration> duration-breathe: root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 800ms : 1600ms);
    out property <duration> duration-fast:       root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 60ms : 120ms);
    out property <duration> duration-micro:      root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 110ms : 220ms);
    out property <duration> duration-base:       root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 110ms : 220ms);
    out property <duration> duration-slow:       root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 190ms : 380ms);
    out property <duration> duration-screen-min: root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 300ms : 600ms);
    out property <duration> duration-slower:     root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 320ms : 640ms);
    // Wave-1 motion primitives (nh-in / nh-side-in / nh-toast-in / nh-toast-bar).
    // Names mirror the CSS keyframe names in the design report so cross-medium
    // search yields the same intent.
    out property <duration> duration-entrance:  root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 250ms : 500ms);
    out property <duration> duration-side-in:   root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 220ms : 440ms);
    out property <duration> duration-toast-in:  root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 200ms : 400ms);
    out property <duration> duration-toast-life: root.animation-mode == 0 ? 0ms : (root.animation-mode == 1 ? 3000ms : 6000ms);
}
