// NEOTH design tokens — single source of truth for the GUI's visual
// surface. Source: `docs/superpowers/specs/2026-05-15-neoth-uix-design-system.md`
// + `docs/superpowers/specs/2026-05-15-neoth-brand-identity.md`.
//
// Anti-pattern guards (per the spec's "Never use sharp 0px corners" rule
// and "Speed is important, but majesty is mandatory"):
//   - Every radius MUST be one of the Theme.radius-* values.
//   - Every animation MUST use Theme.curve-sovereign + a duration
//     ≥ Theme.duration-screen-min.
//   - Every colour MUST come from this module, never inline hex.
//
// Why globals instead of struct returns: Slint globals propagate to every
// component without import boilerplate at each call site, and the values
// stay editable from a single file when the spec rotates.

export global Theme {
    // ── Colour palette ───────────────────────────────────────────────
    // Background: 5%-darker centre per the spec's radial gradient
    // ("Background with 5% darker center focus"). Slint can't draw a
    // radial gradient as a window background directly, so we expose
    // both endpoints and let each screen choose either the flat
    // `bg-base` (cheap) or layer a Rectangle with the gradient for
    // hero shots.
    out property <color> bg-base: #1a1a1a;
    out property <color> bg-center: #0d0d0d;

    // Card / inset surface — one step lighter than the page background
    // so secondary containers register without breaking the dark feel.
    out property <color> bg-card: #242424;

    // Accent — the "synapse" green from the brand identity SVG.
    // Used for active states, focus rings, the cursor on inputs, the
    // "Neural Pulse" ripple. NEVER used for plain prose text.
    out property <color> accent-green: #00ff80;

    // Secondary accent — used sparingly for destructive / warning
    // states (revoke consent, delete, irreversible operations).
    out property <color> accent-pink: #ff2a6d;

    // Text colours. Pure white for primary, two muted variants for
    // hierarchy ("light grey" + "darker grey" per the spec's
    // hierarchy notes).
    //
    // Reviewer-3 P1-B contrast fix (2026-05-20): text-dim was #6b6b6b
    // which produced 3.55:1 / 3.12:1 contrast on bg-base/bg-card at
    // 12px — failing WCAG AA (4.5:1). Raised to #909090 → 5.42:1 /
    // 4.71:1, passing AA for all 12px caption usages.
    out property <color> text-primary: #ffffff;
    out property <color> text-muted: #aaaaaa;
    out property <color> text-dim: #909090;

    // Border + divider hairlines. Just shy of black so they show
    // against the card surface but don't fight the content.
    out property <color> border-subtle: #2f2f2f;

    // ── Corner radii — "Noble Curve" rule ────────────────────────────
    // Spec §1.2: Never use 0px. Three discrete sizes only.
    out property <length> radius-window: 40px;       // Large containers, modals
    out property <length> radius-card:   16px;       // Cards, inputs
    out property <length> radius-button: 8px;        // Action elements

    // ── Spacing scale ────────────────────────────────────────────────
    // Aligned with the spec's "wide / generous" feel — minimum gutters
    // are 24px so screens never feel cramped on a 1280-wide window.
    out property <length> space-tight:   8px;
    out property <length> space-base:    16px;
    out property <length> space-loose:   24px;
    out property <length> space-screen:  32px;

    // ── Typography ───────────────────────────────────────────────────
    // Font stack per spec §1.3. Slint resolves the first family present
    // on the host; SF Pro Display ships with macOS, Inter is the
    // cross-platform fallback, Helvetica Neue covers older Apple
    // boxes, system-sans is the universal fallback.
    out property <string> font-display: "SF Pro Display, Inter, Helvetica Neue, sans-serif";
    out property <string> font-mono:    "JetBrains Mono, SF Mono, Consolas, monospace";

    // Weights. Slint accepts numeric weights directly.
    // Ultra-light is reserved for hero titles + the NEOTH logo
    // (per the spec's hero SVG: weight 100 at 72px logo size).
    out property <int> weight-ultralight: 100;
    out property <int> weight-light:      300;
    out property <int> weight-regular:    400;
    out property <int> weight-medium:     500;
    out property <int> weight-bold:       700;

    // Font sizes.
    out property <length> font-size-hero:    72px;   // NEOTH logo
    out property <length> font-size-h1:      32px;   // Screen titles
    out property <length> font-size-h2:      20px;   // Section heads
    out property <length> font-size-body:    15px;
    out property <length> font-size-caption: 12px;

    // Letter spacing. Spec calls for +20% on ultra-light hero titles
    // and +2% on body. Slint expresses this in absolute px at the
    // current font size; we keep these as the most common shipped
    // values rather than computing per-glyph.
    //
    // Reviewer-3 P2 (2026-05-20): `letter-spacing-tight` + `wide`
    // tokenise the hardcoded `1px` / `1.5px` / `2px` literals that
    // were spreading across components.slint, main.slint and chat
    // .slint. New per-screen styling MUST use a token; the old
    // hardcoded values are migrated screen-by-screen.
    out property <length> letter-spacing-hero: 14px;     // ≈ +20% on 72px
    out property <length> letter-spacing-body: 0.3px;    // ≈ +2% on 15px
    out property <length> letter-spacing-tight: 1px;     // section headers, button labels
    out property <length> letter-spacing-wide: 1.5px;    // group labels, EMPHASIS captions
    out property <length> letter-spacing-extra-wide: 2px; // SETTINGS sidebar header
    out property <length> letter-spacing-brand-bar: 4px;  // ProgressIndicator NEOTH bar

    // ── Animation ────────────────────────────────────────────────────
    // The "Sovereign Curve" — fast start, long majestic settle.
    // Slint doesn't accept arbitrary cubic-bezier from a token, so each
    // animation site MUST hand-write the same curve. This token is a
    // compile-time grep anchor so audit can verify every animation
    // honours the spec.
    //
    // Canonical declaration: animate <prop> { duration: Theme.duration-screen-min;
    //                                           easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    out property <duration> duration-screen-min: 600ms;
    out property <duration> duration-micro:      220ms;
}
