// NEOTH Settings — Pick #32. Post-onboarding tab surface that mirrors
// the 12 slash-action commands (memory rule
// `neoth-slash-commands-and-settings-parity`).
//
// Layout: left sidebar with tab buttons, right content panel that swaps
// based on the active tab. Most simple fields auto-save. Cross-field and
// secret-bearing surfaces (notably Cluster) use one explicit typed Apply
// transaction so invalid intermediate states are never published.

import { VerticalBox, HorizontalBox, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NeothButton, Card, NeothComboBox, NeothCheckBox, NeothLineEdit, SegBar, Expander, Led } from "components.slint";

export enum SettingsTab {
    chat,
    hemispheres,
    channels,
    skills,
    plugins,
    memory,
    privacy,
    cluster,
    config,
    code-sessions,
}

/// One task entry in the Code Sessions board. Rust side populates via
/// `neothd kanban show <id> --output json`; Slint groups by status into
/// the 5 board columns. Pick #8 step 2 — subprocess data binding.
export struct KanbanTaskRow {
    task-id: string,          // pre-formatted `#42` so Slint avoids int-to-str
    title: string,
    hemisphere: string,       // "left" | "right" | "cerebellum" | "unassigned"
}

/// One row in the Code Sessions activity feed (right rail). Rust side
/// populates via `neothd kanban watch --output json` (Pick #8 step 3
/// will land that CLI path; today this carries fixture entries).
export struct KanbanFeedRow {
    ts: string,
    actor: string,
    message: string,
}

/// One comment in the Code Sessions detail-pane comment thread.
/// Rust side populates via `neoth kanban task <id> --output json`
/// after the operator clicks a task card. v0.2-complete: shipping in
/// v0.1 because `kanban task --output json` already exists.
export struct KanbanCommentRow {
    ts: string,       // pre-formatted HH:MM by Rust
    author: string,   // "operator" | "left" | "right" | "cerebellum" | …
    body: string,
}

// GR-10 — one row in the Safety Rails panel, from `neoth security safe-mode --json`.
export struct SafeRailRow {
    name: string,
    engaged: bool,
    detail: string,
}

// GR-03 — one label→value row in the Trust panel, from `neoth trust --output json`.
export struct TrustRow {
    label: string,
    value: string,
}

// GOLD-PROG-05 (SL-02) — one peer row for the Cluster-tab topology panel,
// from `neoth cluster topology --output json`. All fields pre-formatted.
export struct ClusterPeerRow {
    label: string,
    addr: string,
    status: string,
    rtt-ms: string,
    stability: string,
    last-seen: string,
}

// C2 — one row in the per-action permissions matrix.
// Rust populates via `neoth permissions show --output json`
// (active level decisions merged with active_custom_overrides).
export struct PermRow {
    action: string,
    decision: string,   // "allow" | "confirm" | "deny"
    overridden: bool,
}

// GU-01 — one role→provider binding for the Hemispheres panel.
export struct HemisphereRow {
    role: string,      // "left" | "right" | "cerebellum"
    provider: string,  // canonical id or "(unset)"
    model: string,     // "" when provider-default
    has-key: bool,
}

// GU-01 — one installed skill for the Skills panel.
// GOLD-ADAPT-AOS-01: rows come pre-grouped from Rust
// (`panel_logic::group_skill_rows`) — `is-header` rows carry the domain
// eyebrow (first manifest tag), skill rows carry tags + trigger keywords.
export struct SkillRow {
    id: string,
    description: string,
    enabled: bool,
    keywords: string,  // joined trigger keywords
    tags: string,      // joined manifest tags
    is-header: bool,   // domain group header row
}

// SPEC-05 — one saved preset for the selector (moved here from main.slint
// so the Config tab (AOS-02) and the chat tile share one definition).
// builtin: true for the four built-ins (full-auto/balanced/essentials/local-sovereign).
// description: short human-readable summary (empty on old daemons).
// is-header: true for sentinel section-header rows injected by Rust
//   ("BUILT-IN" / "YOURS") — same flat-row pattern as skills.
export struct PresetRow {
    name: string,
    active: bool,
    builtin: bool,
    description: string,
    is-header: bool,
}

// SPEC-05 step5c — one behavioural profile preset (LOWKEY/Formal/Deepdive/…)
// for the interaction-register selector.
export struct ProfilePresetRow {
    name: string,
    description: string,
    recommended: bool,
    active: bool,
}

// GU-01 — one discovered plugin for the Plugins panel.
export struct PluginRow {
    id: string,
    name: string,
    activation: string,  // "active" | "pending" | "disabled" | "reconsent_required"
    requested-permission: string,
    // DES-12 — set when the plugin declares ui_surface in its manifest.
    has-ui-surface: bool,
    ui-title: string,     // ui_surface.title, or "" when absent
}

// DES-12 — one WAL-feed event row for the inline plugin detail pane.
// kind is plain text (never parsed as rich text / markup — plugin-controlled content).
export struct PluginEventRow {
    kind: string,   // event kind — MUST be rendered as plain Text only
    bytes: string,  // pre-formatted payload byte count, e.g. "128 B"
    ts: string,     // pre-formatted timestamp, e.g. "14:23:07"
}

// GU-01 — one memory block (metadata only) for the Memory panel.
export struct MemoryRow {
    source: string,   // "global" | "project" | "rule" | "memory"
    path: string,
    bytes: string,    // pre-formatted by Rust
}

// GOLD-R3-04 — canonical channel probe state (never a secret).
export struct ChannelRow {
    name: string,
    status: string,      // ok | warn | error | unavailable | not_configured
    configured: bool,
    detail: string,
    // Descriptor-projected masking contract for the six channel form inputs.
    setup-secret-f1: bool,
    setup-secret-f2: bool,
    setup-secret-f3: bool,
    setup-secret-f4: bool,
    setup-secret-f5: bool,
    setup-secret-f6: bool,
}

/// DES-10 — one row in the live Channel Activity feed.
/// Contains ONLY traffic metadata: direction, channel, peer, byte count, time.
/// Message bodies are never stored (WAL is hashed by design).
export struct ChannelActivityRow {
    /// "in" | "out" | "proactive" | "blocked"
    direction: string,
    channel: string,
    peer: string,
    bytes: string,
    ts: string,
}

component TabButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    height: 36px;
    // GUI-overhaul: tint the active tab with the accent (was a flat bg-card fill)
    // so the selected tab reads clearly and matches its accent indicator bar.
    background: root.active ? Theme.accent-green.with-alpha(0.10) : transparent;
    border-radius: Theme.radius-button;

    animate background {
        duration: Theme.duration-micro;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    Rectangle {
        x: 0;
        y: 6px;
        width: 3px;
        height: parent.height - 12px;
        background: root.active ? Theme.accent-green : transparent;
        border-radius: 2px;
    }

    txt := Text {
        x: Theme.space-base;
        text: root.label;
        overflow: elide;
        font-family: Theme.font-display;
        font-size: Theme.font-size-body;
        font-weight: root.active ? Theme.weight-medium : Theme.weight-regular;
        letter-spacing: Theme.letter-spacing-body;
        color: root.active ? Theme.text-primary : Theme.text-muted;
        vertical-alignment: center;
        height: parent.height;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // G-25 fix: subtle hover affordance for desktop mouse pointers.
    // Inactive tabs lift to a 50% bg-card overlay + text moves to
    // primary for a frame; never overrides the active-state styling.
    states [
        hovered when touch.has-hover && !root.active: {
            background: Theme.bg-card.with-alpha(0.5);
            txt.color: Theme.text-primary;
        }
    ]
}

// ── KanbanTaskCard ───────────────────────────────────────────────────
// Single task tile in a board column. Title + 2-line description clip,
// hemisphere badge (cerebellum / left / right), status colour bar.
// Pick #8 step 1 — static fixture, no callbacks yet.

// G-8/G-21 fix: larger padding for readability, 90 px min height,
// hemisphere badge handles "unassigned" explicitly + widens to fit
// "cerebellum" (10 chars).
component KanbanTaskCard inherits Rectangle {
    in property <string> title: "";
    in property <string> hemisphere: "";       // "left" | "right" | "cerebellum" | "unassigned"
    in property <string> task-id: "";
    /// Step 5 (2026-05-20): selected state lights the card border in
    /// accent-green when the operator picked it for the detail pane.
    in property <bool> selected: false;
    callback clicked();
    /// A4 — fires on right-click up; x/y approximate absolute position
    /// (card.absolute-position + mouse offset within card).
    callback context-menu(length, length);

    min-height: 90px;
    background: Theme.bg-card;
    border-radius: Theme.radius-button;
    border-width: 1px;
    border-color: root.selected ? Theme.accent-green : Theme.border-subtle;

    animate border-color {
        duration: Theme.duration-micro;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        // A4: right-click fires context-menu with approximate window-space coords.
        // root.absolute-position is the card's top-left in logical px from the window
        // origin; self.mouse-x/y is the pointer offset within this TouchArea.
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.context-menu(
                    root.absolute-position.x + self.mouse-x,
                    root.absolute-position.y + self.mouse-y,
                );
            }
        }
    }

    VerticalLayout {
        padding: Theme.space-base;
        spacing: Theme.space-tight;

        HorizontalLayout {
            alignment: space-between;
            spacing: Theme.space-tight;
            Text {
                text: root.task-id;
                overflow: elide;
                font-family: Theme.font-mono;
                font-size: Theme.font-size-caption;
                color: Theme.text-dim;
            }
            Rectangle {
                width: 72px;
                height: 18px;
                background: transparent;
                border-width: 1px;
                border-radius: 4px;
                border-color:
                    root.hemisphere == "cerebellum" ? Theme.accent-green :
                    root.hemisphere == "right"      ? Theme.accent-pink :
                    root.hemisphere == "left"       ? Theme.text-muted :
                                                       Theme.border-subtle;
                Text {
                    text: root.hemisphere == "unassigned" ? "—" : root.hemisphere;
                    overflow: elide;
                    font-family: Theme.font-display;
                    font-size: 9px;
                    font-weight: Theme.weight-bold;
                    letter-spacing: Theme.letter-spacing-tight;
                    color:
                        root.hemisphere == "cerebellum" ? Theme.accent-green :
                        root.hemisphere == "right"      ? Theme.accent-pink :
                        root.hemisphere == "left"       ? Theme.text-muted :
                                                           Theme.text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.title;
            font-family: Theme.font-display;
            font-size: Theme.font-size-body;
            font-weight: Theme.weight-regular;
            color: Theme.text-primary;
            wrap: word-wrap;
        }
    }
}

// ── KanbanColumn ─────────────────────────────────────────────────────
// One of 5 board columns. Header with status label + task count, then a
// vertical stack of KanbanTaskCard rendered from the `tasks` array.
// Pick #8 step 2 — array-driven, no more @children fixture.

component KanbanColumn inherits Rectangle {
    in property <string> label: "";
    in property <color> accent: Theme.text-muted;
    in property <[KanbanTaskRow]> tasks: [];
    in property <string> selected-task-id: "";
    /// WIP limit for this column (0 = unlimited). The count turns amber and
    /// the column border warns once tasks.length reaches the limit — the core
    /// kanban discipline mechanism (Lean / Kanban Method).
    in property <int> wip-limit: 0;
    callback task-clicked(string);
    /// A4 — forwards right-click from a card to the parent view.
    callback task-context(string /*task-id*/, length /*x*/, length /*y*/);

    property <bool> over-wip: root.wip-limit > 0 && root.tasks.length >= root.wip-limit;

    background: Theme.bg-base;
    border-radius: Theme.radius-button;
    border-width: root.over-wip ? 2px : 1px;
    border-color: root.over-wip ? Theme.warning : Theme.border-subtle;

    VerticalLayout {
        padding: Theme.space-tight;
        spacing: Theme.space-tight;

        HorizontalLayout {
            alignment: space-between;
            spacing: Theme.space-tight;
            Text {
                text: root.label;
                overflow: elide;
                font-family: Theme.font-display;
                font-size: Theme.font-size-caption;
                font-weight: Theme.weight-bold;
                letter-spacing: Theme.letter-spacing-wide;
                color: root.accent;
            }
            Text {
                text: root.wip-limit > 0 ? "\{root.tasks.length}/\{root.wip-limit}" : "\{root.tasks.length}";
                font-family: Theme.font-mono;
                font-size: Theme.font-size-caption;
                color: root.over-wip ? Theme.warning : Theme.text-dim;
            }
        }
        Rectangle {
            height: 2px;
            background: root.accent;
            opacity: 0.4;
            border-radius: 1px;
        }
        VerticalLayout {
            spacing: Theme.space-tight;
            for entry[i] in root.tasks: KanbanTaskCard {
                task-id: entry.task-id;
                title: entry.title;
                hemisphere: entry.hemisphere;
                selected: entry.task-id == root.selected-task-id;
                clicked => { root.task-clicked(entry.task-id); }
                context-menu(x, y) => { root.task-context(entry.task-id, x, y); }
            }
        }
    }
}

// ── ActivityFeedEntry ────────────────────────────────────────────────
// One row in the right-rail activity feed. Mono timestamp, actor badge,
// message body. Static fixture for Pick #8 step 1.

component ActivityFeedEntry inherits HorizontalLayout {
    in property <string> ts: "";
    in property <string> actor: "";
    in property <string> message: "";

    spacing: Theme.space-tight;
    padding-top: 4px;
    padding-bottom: 4px;

    Text {
        text: root.ts;
        overflow: elide;
        font-family: Theme.font-mono;
        font-size: Theme.font-size-caption;
        color: Theme.text-dim;
        width: 48px;
    }
    Text {
        text: root.actor;
        overflow: elide;
        font-family: Theme.font-display;
        font-size: Theme.font-size-caption;
        font-weight: Theme.weight-bold;
        letter-spacing: Theme.letter-spacing-tight;
        color: root.actor == "cerebellum"
            ? Theme.accent-green
            : (root.actor == "right" ? Theme.accent-pink : Theme.text-muted);
        width: 72px;
    }
    Text {
        text: root.message;
        font-family: Theme.font-display;
        font-size: Theme.font-size-caption;
        color: Theme.text-primary;
        wrap: word-wrap;
    }
}

component PanelHeader inherits VerticalLayout {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> mirrors-slash: "";

    spacing: Theme.space-tight;

    Text {
        text: root.title;
        overflow: elide;
        font-family: Theme.font-display;
        font-size: Theme.font-size-h2;
        font-weight: Theme.weight-light;
        color: Theme.text-primary;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        font-family: Theme.font-display;
        font-size: Theme.font-size-body;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if root.mirrors-slash != "": Text {
        text: "CLI mirror: " + root.mirrors-slash;
        overflow: elide;
        font-family: Theme.font-mono;
        font-size: Theme.font-size-caption;
        color: Theme.accent-green;
    }
}

// GU-01: the PendingPanel "coming in vX" stub component was removed once all
// six settings tabs became real panels — every former stub now renders live data.

export component SettingsView inherits Rectangle {
    in-out property <SettingsTab> active: SettingsTab.chat;
    in-out property <string> autonomy-current: "standard";
    // GOLD-FEAT-01c — full-auto (sudomode) toggle. `full-auto-active` reflects the
    // live posture (Rust sets it from the trust snapshot); `full-auto-pending` is
    // the GUI-local two-step-confirm state. Enabling fires `full-auto-confirmed`
    // (→ CLI `autonomy full-auto --gui-confirmed`); disabling fires `full-auto-gated`.
    in-out property <bool> full-auto-active: false;
    in-out property <bool> full-auto-pending: false;
    callback full-auto-confirmed();
    callback full-auto-gated();
    // GOLD-PROG-08 — live token budget, polled from ~/.neoth/usage_meter.json
    // (the daemon's usage-export task writes it every 10s). `usage-available`
    // false → daemon not running / no usage yet.
    in property <bool> usage-available: false;
    in property <string> usage-responses: "";
    in property <string> usage-tokens: "";
    in property <string> usage-note: "";
    in-out property <string> provider-current: "claude_cli";
    /// GUI-improve — the Config ACTIVE PROVIDER combo's selected row index. Rust
    /// computes it (position of provider-current in the live provider-ids list)
    /// so the combo never silently falls back to row 0 for a provider missing
    /// from a stale hardcoded list.
    in-out property <int> provider-current-index: 0;

    // GR-10 — Safety Rails (from `neoth security safe-mode --json`), rendered in
    // the Privacy tab. Rust populates these on startup; `engaged` rails are the
    // ones actively restricting the daemon.
    in property <[SafeRailRow]> safety-rails: [];
    in property <int> rails-engaged-count: 0;
    in property <int> rails-total: 0;

    // GR-03 — Trust panel (from `neoth trust --output json`): autonomy posture,
    // privacy switches, recovery-key readiness, and WAL trust-ledger size. Rust
    // populates these on startup; all read-only.
    in property <string> trust-autonomy-level: "";
    in property <string> trust-autonomy-behavior: "";
    in property <[TrustRow]> trust-privacy: [];
    in property <[TrustRow]> trust-recovery: [];
    in property <[TrustRow]> trust-ledger: [];

    // OMI-MULTIMODAL-01 — complete opt-in, consent, health, credential-presence,
    // and privacy-operation surface. Secret drafts are write-only: Rust clears
    // them after saving and never loads existing values into the GUI.
    in-out property <bool> omi-enabled: false;
    in-out property <string> omi-mode: "developer_api";
    in-out property <string> omi-endpoint: "http://127.0.0.1:8002";
    in-out property <string> omi-listen-addr: "127.0.0.1:8003";
    in-out property <string> omi-retention-days: "30";
    in-out property <bool> omi-retain-transcripts: false;
    in-out property <bool> omi-audio-enabled: false;
    in-out property <bool> omi-image-enabled: false;
    in-out property <bool> omi-video-enabled: false;
    in-out property <bool> omi-allow-cloud-api: false;
    in-out property <bool> omi-allow-cloud-summary: false;
    in-out property <bool> omi-create-actions: true;
    in-out property <bool> omi-seed-groundtruth: true;
    in-out property <bool> omi-summary-enabled: true;
    in-out property <string> omi-developer-key-draft: "";
    in-out property <string> omi-native-token-draft: "";
    in property <bool> omi-developer-key-present: false;
    in property <bool> omi-native-token-present: false;
    in property <bool> omi-config-valid: false;
    in property <string> omi-config-error: "";
    in property <string> omi-runtime-state: "unknown";
    in property <string> omi-runtime-detail: "";
    in property <int> omi-pending-audits: 0;
    in-out property <string> omi-review-note: "";
    in-out property <string> omi-conversation-id: "";
    in-out property <bool> omi-purge-confirm: false;
    in-out property <bool> omi-reimport-confirm: false;
    callback omi-refresh-clicked();
    callback omi-probe-clicked();
    callback omi-save-clicked(bool, string, string, string, string, bool, bool, bool, bool, bool, bool, bool, bool, bool, string, string);
    callback omi-resume-clicked(string);
    callback omi-retention-clicked();
    callback omi-purge-clicked(string);
    callback omi-reimport-clicked(string);

    // SL-03 — Local resources (Cluster tab), from `neoth hardware --output json`:
    // CPU / memory / accelerator / VRAM / disk headlines + cached-model rows.
    in property <string> hw-cpu: "";
    in property <string> hw-memory: "";
    in property <string> hw-accelerator: "";
    in property <string> hw-vram: "";
    // GOLD-PROG-07 — VRAM used/total as a 0.0..=1.0 fraction for the live meter.
    in property <float> hw-vram-fraction: 0.0;
    in property <string> hw-disk: "";
    in property <[TrustRow]> hw-models: [];
    // GUI-HARDWARE-RESOURCES-01 — runtime load readout, e.g. "CPU 23% · GPU 41% · 62°C · 118W".
    in property <string> hw-load-readout: "";
    // GOLD-PROG-05 — cluster peer topology rows (Cluster tab), from
    // `neoth cluster topology --output json`.
    in property <[ClusterPeerRow]> cluster-peers: [];

    // KF-08 — Council budget meter (Config tab), from `neoth council budget
    // --output json`: the per-message cap + last debate's live usage.
    in property <string> council-cap: "";
    in property <string> council-daily-usd: "";
    in property <string> council-depth-warning: "";
    in property <[TrustRow]> council-last-debate: [];

    // GU-01 — Hemispheres + Skills panels. Rust populates these on startup from
    // `neoth hemispheres show --output json` / `neoth skills --list --output json`.
    in property <[HemisphereRow]> hemisphere-bindings: [];
    in property <string> hemispheres-mode: "";
    // SPEC-06 — implemented provider ids for the per-role rebind picker.
    in property <[string]> provider-ids: [];
    // GOLD-GUI-OVERHAUL — model-picker options for the rebind row (local GGUF
    // refs / cloud catalog), refreshed by Rust on provider pick.
    in property <[string]> hemisphere-model-ids: ["(provider default)"];
    in property <[SkillRow]> skills: [];
    // GOLD-ADAPT-AOS-01 — index search + true install count (the grouped
    // model shrinks under filter; the count must not).
    in-out property <string> skills-filter: "";
    in property <int> skills-total: 0;
    callback skills-filter-edited(string);
    // GOLD-ADAPT-AOS-06 — spec-shape entry drafts + create action.
    in-out property <string> spec-title: "";
    in-out property <string> spec-goal: "";
    in-out property <string> spec-acceptance: "";
    callback spec-create-clicked(string, string, string);
    // GOLD-ADAPT-AOS-02 — saved presets surfaced in the Config tab (same
    // data as the chat tile; Rust owns fetch/refresh).
    in property <[PresetRow]> preset-list: [];
    in property <string> preset-summary: "";
    callback preset-activate-clicked(string);
    callback preset-apply-clicked();
    // New preset system: dry-run consent + apply-by-name + delete.
    // preset-apply-named: operator clicked Apply on a named preset row →
    //   Rust runs dry-run, may show consent, then applies.
    callback preset-apply-named-clicked(string);
    // preset-delete-clicked: operator confirmed Delete on an operator preset.
    callback preset-delete-clicked(string);
    // Consent modal state — Rust sets these before showing the modal row.
    // consent-preset-name: the preset being reviewed.
    in-out property <string> consent-preset-name: "";
    // consent-warn-text: formatted warning lines ("path: old → new\n…").
    in-out property <string> consent-warn-text: "";
    // consent-needs-fullauto: true when autonomy_requested == "full".
    in-out property <bool> consent-needs-fullauto: false;
    // consent-fields-count: number of fields that will change.
    in-out property <int> consent-fields-count: 0;
    // consent-visible: Rust sets true to show the consent row.
    in-out property <bool> consent-visible: false;
    // Operator confirmed or cancelled the consent modal.
    callback preset-consent-confirmed();
    callback preset-consent-cancelled();
    // PF-01-GUI — skills.always_embed_route toggle (freedom.yaml write-back).
    in-out property <bool> skills-always-embed-route: true;
    callback skills-always-embed-route-changed(bool);
    // GU-01 — Channels / Plugins / Memory panels.
    in property <[ChannelRow]> channels: [];
    in property <[string]> channel-types: [];
    in property <string> channel-status-error: "";
    in property <int> channel-add-success-seq: 0;
    // DES-10 — live channel-activity feed (metadata only, no message bodies).
    in property <[ChannelActivityRow]> channel-activity: [];
    in property <[PluginRow]> plugins: [];
    in property <[MemoryRow]> memory-blocks: [];
    in property <string> memory-total: "";

    // GU-03 — persona-adaptive panel visibility. Rust (`panel_logic::panels_for`)
    // sets these from the operator's complexity level on startup; each gated
    // sidebar tab is conditionally created (`if`), so a hidden tab is removed
    // from the layout entirely. `chat`/`privacy`/`config` are never gated.
    in property <bool> show-hemispheres: true;
    in property <bool> show-channels: true;
    in property <bool> show-skills: true;
    in property <bool> show-plugins: true;
    in property <bool> show-memory: true;
    in property <bool> show-cluster: true;
    in property <bool> show-code-sessions: true;

    // Bite #5 — Cluster settings (post-onboarding mirror of the
    // wizard step). Rust loads the complete cluster draft from
    // freedom.yaml on settings-open. Changes remain local until the
    // operator submits the single validated Apply transaction below.
    in-out property <bool> cluster-mdns-enabled: true;
    // C6 — complete cluster desired-state draft. Persistence happens only
    // through the single typed Apply callback below.
    in-out property <bool>   cfg-cluster-enabled: false;
    in-out property <string> cfg-cluster-name: "";
    in-out property <int>    cfg-cluster-transport-idx: 0;
    in-out property <string> cfg-cluster-peers: "";
    in-out property <bool>   cfg-cluster-announce-untrusted: false;
    in-out property <string> cfg-cluster-ssids: "";
    in-out property <bool> cfg-cluster-replicate-raw-ingress: false;
    in-out property <string> cfg-cluster-replay-days-text: "30";
    in-out property <string> cfg-cluster-listen-port-text: "49737";
    in-out property <string> cfg-cluster-passphrase: "";
    in-out property <bool> cfg-cluster-passphrase-set: false;
    in-out property <bool> cfg-cluster-apply-in-flight: false;
    in-out property <string> cfg-cluster-apply-status: "";

    // Auto-update config (research P0).
    in-out property <bool>   cfg-autoupdate-enabled: false;
    in-out property <bool>   cfg-autoupdate-apply: false;
    in-out property <int>    cfg-autoupdate-channel-idx: 0;
    in-out property <string> cfg-autoupdate-interval: "";
    in property <string>     autoupdate-check-output: "";
    in property <bool>       autoupdate-check-running: false;
    in-out property <int> cluster-listen-port: 49737;
    /// Operator-readable summary of `cluster.policy.trusted_ssids`.
    /// Empty string renders the "no trusted SSIDs set" placeholder.
    in-out property <string> cluster-trusted-ssids-summary: "";
    // One complete transaction. Lists are newline-delimited in the UI and
    // encoded as JSON string arrays by Rust, so commas remain lossless.
    callback cfg-cluster-apply-clicked(bool, string, int, string, bool, bool, string, bool, string, string, string);

    callback cfg-autoupdate-enabled-changed(bool);
    callback cfg-autoupdate-apply-changed(bool);
    callback cfg-autoupdate-channel-changed(int);
    callback cfg-autoupdate-interval-changed(string);
    callback autoupdate-check-clicked();

    // ── Code Sessions tab state (Pick #8 step 2) ────────────────────
    // Rust side fetches `neothd kanban list/show --output json` on tab
    // open + populates the five status-bucket arrays here. Empty
    // arrays render an empty column with header + 0 count — that's
    // the steady state when the operator hasn't run `neoth code` yet.
    in property <[KanbanTaskRow]> kanban-backlog: [];
    in property <[KanbanTaskRow]> kanban-todo: [];
    in property <[KanbanTaskRow]> kanban-in-progress: [];
    in property <[KanbanTaskRow]> kanban-review: [];
    in property <[KanbanTaskRow]> kanban-done: [];
    in property <[KanbanFeedRow]> kanban-feed: [];
    /// One-line summary above the board: which session is showing,
    /// when it was opened, what the operator's prompt was. Empty
    /// string means "no sessions yet — operator has not run `neoth
    /// code` on this machine".
    in property <string> kanban-session-summary: "";
    // A3 — session selector.
    in property <[string]> kanban-sessions: [];
    in-out property <int> kanban-session-idx: 0;
    callback kanban-session-selected(int);
    /// HO-02: whether a Cerebellum hemisphere is bound (wizard step 5d).
    /// `false` surfaces a warning banner in the Code Sessions tab —
    /// without a Cerebellum the decompose step can't run, so `neoth code`
    /// is degraded. Defaults true so a probe failure doesn't false-alarm.
    in property <bool> cerebellum-bound: true;
    /// Step 5 (2026-05-20): currently-focused task. Operator clicks a
    /// card → property updates → detail pane below the board renders
    /// title / hemisphere / status. Empty string hides the pane.
    in-out property <string> kanban-selected-task-id: "";
    /// Step 5 — details for the focused task. Populated by Rust on the
    /// `kanban-task-selected` callback so the detail pane can render
    /// without re-walking the board snapshot.
    in property <string> kanban-selected-title: "";
    in property <string> kanban-selected-status: "";
    in property <string> kanban-selected-hemisphere: "";
    in property <string> kanban-selected-description: "";
    in property <[KanbanCommentRow]> kanban-selected-comments: [];

    // ODY-11 — current density selection (0=compact 1=normal 2=spacious).
    // Rust sets this at startup from ~/.neoth/.gui-density; the density
    // buttons update it locally; density-changed bubbles the new value to Rust
    // for persistence + Theme property update.
    in-out property <int> density-mode-current: 1;
    callback density-changed(int);

    callback wizard-rerun-clicked;
    callback reload-config-clicked;
    // GU-01 — Chat tab "Open chat" button → MainWindow switches to the chat view.
    callback open-chat-clicked;
    /// Launch the packaged CLI in a real platform terminal and make CLI the
    /// durable default for the next product launch.
    callback open-cli-clicked;
    // SPEC-06 — operator picked (role, provider) in the Hemispheres rebind
    // control → MainWindow shells `neoth hemispheres set`.
    callback hemisphere-set-clicked(string, string, string);
    /// GOLD-GUI-OVERHAUL — operator picked a provider in the rebind row; Rust
    /// refreshes hemisphere-model-ids with that provider's model options.
    callback hemisphere-provider-picked(string);
    /// G-12 fix — operator picked a different provider in the
    /// Config tab. Rust persists the change to freedom.yaml + drops
    /// the reload sentinel.
    callback provider-changed(string);
    /// Operator clicked "Refresh" on the Code Sessions tab. Rust side
    /// re-runs `neothd kanban list/show` + re-populates the 5 board
    /// properties. Live-tail (Pick #8 step 4) will replace this with
    /// a WAL-driven push.
    callback kanban-refresh-clicked;
    /// Operator clicked Refresh on the Channels tab. Rust asks the canonical
    /// `neoth channel list --output json` probe off-thread.
    callback channels-refresh-clicked;
    /// Step 5 (2026-05-20): operator clicked a KanbanTaskCard. Rust
    /// looks up the full task detail (title/status/hemisphere/desc)
    /// + sets the 4 `kanban-selected-*` properties so the detail pane
    /// renders. Passing the id string is enough — Rust already holds
    /// the snapshot.
    callback kanban-task-selected(string);
    /// Step 6 (2026-05-20): move a task to a target status column.
    /// Rust subprocesses `neoth kanban move <task-id> <status>`; the
    /// 2s live-tail picks up the change. `task-id` is the bare numeric
    /// id (no "#" prefix); status is the wire-form
    /// (backlog/todo/in_progress/review/done/blocked/archived).
    callback kanban-task-move(string, string);
    /// Step 6: REVIEW → DONE promote when the auto-promote check
    /// passes. Subprocess `neoth kanban review <task-id> --promote`.
    callback kanban-task-promote(string);
    /// v0.2 complete (2026-05-20): append a comment to the selected
    /// task. Subprocess `neoth kanban comment <id> <body> --author
    /// operator`. Args: (task_id, body).
    callback kanban-task-comment(string, string);
    /// v0.2 complete (2026-05-20): re-assign the task to a different
    /// hemisphere. Args: (task_id, hemisphere_wire_form). Wire form
    /// is one of "left" / "right" / "cerebellum" / "unassigned" —
    /// subprocess `neoth kanban assign <id> <hemisphere>`.
    callback kanban-task-assign(string, string);
    /// GAP-03: mark a task done via `neoth kanban finish <id>`.
    /// Fires from the "✓ Finish Task" button in the detail pane.
    callback kanban-task-finish(string);
    /// A4 — operator right-clicked a KanbanTaskCard.
    /// Args: (task_id, x, y). x/y are approximate logical-px coordinates
    /// (card.absolute-position + mouse-within-card). The orchestrator uses
    /// these to position the shared ContextMenu overlay mounted in main.slint.
    callback kanban-task-context(string /*task id*/, length /*x*/, length /*y*/);
    /// G-5 fix — operator clicked "← Chat" in the sidebar header so
    /// they can leave Settings. Without this they were trapped
    /// because the ⚙ icon lives in the Chat sidebar (not visible
    /// from Settings).
    callback back-clicked;
    /// GUI-overhaul feature parity — live connectivity test / credential removal
    /// for a channel. Rust shells `neoth channel test|remove <name>`.
    callback channel-test-clicked(string);
    callback channel-remove-clicked(string);
    /// GAP-19 — Add a new channel credential from the GUI.
    /// Args: channel_type + six typed fields + one boolean policy flag. Rust
    /// maps them to a private-stdin credential envelope for every registry channel.
    callback channel-add-clicked(string, string, string, string, string, string, string, bool);
    /// GUI-overhaul feature parity — Memory forget. Preview is a dry run
    /// (`neoth memory --forget <t>`); confirm wipes (`… --forget <t> --confirm`).
    callback memory-forget-preview-clicked(string);
    callback memory-forget-confirm-clicked(string);
    /// GUI-overhaul feature parity — operator toggled a skill's enable state.
    /// Args: (skill-id, enabled). Rust shells `neoth skills --enable/--disable`.
    callback skill-toggle-clicked(string, bool);
    /// Operator clicked "Install skill…" → Rust opens rfd folder picker →
    /// `neoth skills --install <dir>` → toast + refresh.
    callback skill-install-clicked();
    /// Operator confirmed "Uninstall" on a skill row.
    /// Rust shells `neoth skills --uninstall <id>` → toast + refresh.
    callback skill-uninstall-clicked(string);
    /// Operator clicked "New skill…" create-form submit.
    /// Args: (id, description, keywords, system_prompt).
    /// Rust shells `neoth skills --create --non-interactive --create-id <id>
    ///   --create-description <d> --create-keywords <k> --create-system-prompt <p>`.
    callback skill-create-clicked(string, string, string, string);

    /// GUI-overhaul feature parity — operator toggled a plugin's enable state.
    /// Args: (plugin-id, enabled). Rust shells `neoth plugin enable/disable`.
    callback plugin-toggle-clicked(string, bool);
    /// Operator clicked "Install plugin…" → Rust opens rfd folder picker →
    /// `neoth plugin install <dir>` → toast + refresh.
    callback plugin-install-clicked();
    /// Operator clicked "Remove" on a plugin row.
    /// Rust shells `neoth plugin remove <id>` → toast + refresh.
    callback plugin-remove-clicked(string);
    // DES-12 — inline plugin WAL-feed detail pane.
    // "" = closed; set to a plugin id to open the detail section.
    in-out property <string> plugin-detail-id: "";
    /// The ui_title of the currently-open detail pane (set by Rust from the row).
    in property <string> plugin-detail-title: "";
    /// WAL-feed events for the open plugin. Empty while no plugin is selected.
    in property <[PluginEventRow]> plugin-detail-events: [];
    /// Operator clicked the "Activity" button on a plugin row with ui_surface.
    /// Rust shells `neoth plugin events <id>` and populates plugin-detail-events.
    callback plugin-detail-clicked(string /*id*/);
    /// Operator clicked "Close" on the detail pane header.
    callback plugin-detail-close();
    /// GUI-overhaul feature parity — operator picked an autonomy level from the
    /// Privacy combo. Arg: level string. Rust shells `neoth autonomy set <level>`.
    callback autonomy-set-clicked(string);

    // GAP-04 — Memory search. Operator types a query + clicks Search →
    // Rust shells `neoth recall <query>` and renders plain-text output.
    // Empty query is a no-op (button disabled). Output is shown in a
    // ProbeView-style text area below the search row.
    in-out property <string> memory-search-query: "";
    in property <string> memory-search-output: "";
    in property <bool> memory-search-running: false;
    callback memory-search-clicked(string);

    // GAP-05/GAP-13 — Status + Security-audit probes live in the Doctor
    // nav panel (tabs.slint DoctorView), wired via MainWindow — no
    // SettingsView surface.

    // GAP-07 — Backup / rollback preview. Rust shells `neoth backup` or
    // `neoth rollback list` (read-only) and appends result to status-line.
    callback backup-now-clicked;
    callback rollback-preview-clicked;

    // ── DES-09 Welle A — Council editors ─────────────────────────────────
    in-out property <string> cfg-council-daily-usd: "";
    in-out property <string> cfg-council-max-calls: "";
    in-out property <string> cfg-council-max-depth: "";
    in-out property <int>    cfg-council-selection-mode-idx: 0;  // 0=legacy_majority 1=consensus_or_best 2=best_always
    callback cfg-council-daily-usd-changed(string);
    callback cfg-council-max-calls-changed(string);
    callback cfg-council-max-depth-changed(string);
    callback cfg-council-selection-mode-changed(int);

    // ── DES-09 Welle A — Provider detail editors ──────────────────────────
    in-out property <string> cfg-provider-model: "";
    in-out property <string> cfg-provider-endpoint: "";
    in-out property <string> cfg-provider-region: "";
    in-out property <string> cfg-provider-api-version: "";
    callback cfg-provider-model-changed(string);
    callback cfg-provider-endpoint-changed(string);
    callback cfg-provider-region-changed(string);
    callback cfg-provider-api-version-changed(string);

    // ── DES-09 Welle A — Profile + Behavior editors ───────────────────────
    in-out property <int>    cfg-persona-mode-idx: 0;  // 0=(none) 1=loyal_buddy
    in-out property <string> cfg-user-tz: "";
    // C3 — operator identity.
    in-out property <string> cfg-operator-id: "";
    in-out property <string> cfg-language-primary: "";
    in-out property <string> cfg-language-code: "";
    in-out property <int>    cfg-role-idx: 5;   // default "none"
    in-out property <string> cfg-role-custom: "";
    in-out property <bool>   cfg-elicitation-enabled: false;
    in-out property <int>    cfg-elicitation-min-intensity-idx: 1;  // 0=low 1=medium 2=high 3=urgent
    in-out property <bool>   cfg-tone-modifier-enabled: false;
    callback cfg-persona-mode-changed(int);
    callback cfg-user-tz-changed(string);
    // C3 — operator identity.
    callback cfg-operator-id-changed(string);
    callback cfg-language-primary-changed(string);
    callback cfg-language-code-changed(string);
    callback cfg-role-changed(int);
    callback cfg-role-custom-changed(string);
    callback cfg-elicitation-enabled-changed(bool);
    callback cfg-elicitation-min-intensity-changed(int);
    callback cfg-tone-modifier-enabled-changed(bool);

    // ── DES-09 Welle B — Privacy editors ─────────────────────────────────
    in-out property <bool> cfg-review-gate-enabled: false;
    in-out property <bool> cfg-cloud-stt-enabled: false;
    in-out property <bool> cfg-cloud-tts-enabled: false;
    in-out property <bool> cfg-cloud-vision-enabled: false;
    in-out property <bool> cfg-vad-enabled: false;
    in-out property <bool> cfg-dictation-enabled: false;
    in-out property <bool> cfg-proactive-idle-only: false;
    // DES-09 G37 — proactive.quiet_hours_utc editor state.
    in-out property <bool> cfg-quiet-hours-enabled: false;
    in-out property <string> cfg-quiet-hours-start: "22";
    in-out property <string> cfg-quiet-hours-end: "7";
    callback cfg-review-gate-enabled-changed(bool);
    callback cfg-cloud-stt-enabled-changed(bool);
    callback cfg-cloud-tts-enabled-changed(bool);
    callback cfg-cloud-vision-enabled-changed(bool);
    callback cfg-vad-enabled-changed(bool);
    callback cfg-dictation-enabled-changed(bool);
    callback cfg-proactive-idle-only-changed(bool);
    // (enabled, start-hour, end-hour) — Rust validates + writes the
    // proactive.quiet_hours_utc [u8;2] (or null when disabled).
    callback cfg-quiet-hours-changed(bool, string, string);

    // ── C2 — per-action permissions matrix (Privacy tab) ─────────────────
    // Rows from `neoth permissions show --output json`: active level decisions
    // merged with active_custom_overrides. cfg-perm-level is the current
    // autonomy level shown in the Expander header.
    in property <[PermRow]> cfg-perm-rows: [];
    in property <string> cfg-perm-level: "";
    /// Operator picked a new decision for an action row.
    /// Rust: `neoth permissions set <action> <decision>`
    callback cfg-perm-set(string /*action*/, string /*decision*/);
    /// Operator clicked the ✕ clear glyph on an overridden row.
    /// Rust: `neoth permissions clear <action>`
    callback cfg-perm-clear(string /*action*/);

    // ── DES-09 Welle C — Memory editors ──────────────────────────────────
    in-out property <bool> cfg-memory-name-sessions: false;
    in-out property <bool> cfg-memory-recall-shortcut: false;
    in-out property <int>  cfg-memory-vector-backend-idx: 0;  // 0=brute_force 1=hnsw
    in-out property <bool> cfg-consolidation-enabled: false;
    in-out property <string> cfg-consolidation-interval-secs: "";
    in-out property <string> cfg-consolidation-cosine: "";
    callback cfg-memory-name-sessions-changed(bool);
    callback cfg-memory-recall-shortcut-changed(bool);
    callback cfg-memory-vector-backend-changed(int);
    callback cfg-consolidation-enabled-changed(bool);
    callback cfg-consolidation-interval-secs-changed(string);
    callback cfg-consolidation-cosine-changed(string);

    background: Theme.bg-base;

    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: Theme.bg-base;
            VerticalLayout {
                padding: Theme.space-base;
                // GUI-overhaul — tighter nav: items were 8px apart + 44px tall
                // (felt spread out). 4px gap + 36px TabButton height densifies it.
                spacing: 4px;

                // G-5 fix: "← Chat" lives at the top of the sidebar so
                // the operator always has an obvious exit. Mirrors the
                // back-button pattern from every wizard step.
                NeothButton {
                    label: "← Chat";
                    primary: false;
                    clicked => { root.back-clicked(); }
                }

                Text {
                    text: "SETTINGS";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-caption;
                    font-weight: Theme.weight-bold;
                    letter-spacing: Theme.letter-spacing-extra-wide;
                    color: Theme.text-dim;
                }

                TabButton {
                    label: "Chat";
                    active: root.active == SettingsTab.chat;
                    clicked => { root.active = SettingsTab.chat; }
                }
                if root.show-hemispheres : TabButton {
                    label: "Hemispheres";
                    active: root.active == SettingsTab.hemispheres;
                    clicked => { root.active = SettingsTab.hemispheres; }
                }
                if root.show-channels : TabButton {
                    label: "Channels";
                    active: root.active == SettingsTab.channels;
                    clicked => { root.active = SettingsTab.channels; }
                }
                if root.show-skills : TabButton {
                    label: "Skills";
                    active: root.active == SettingsTab.skills;
                    clicked => { root.active = SettingsTab.skills; }
                }
                if root.show-plugins : TabButton {
                    label: "Plugins";
                    active: root.active == SettingsTab.plugins;
                    clicked => { root.active = SettingsTab.plugins; }
                }
                if root.show-memory : TabButton {
                    label: "Memory";
                    active: root.active == SettingsTab.memory;
                    clicked => { root.active = SettingsTab.memory; }
                }
                TabButton {
                    label: "Privacy";
                    active: root.active == SettingsTab.privacy;
                    clicked => { root.active = SettingsTab.privacy; }
                }
                if root.show-cluster : TabButton {
                    label: "Cluster";
                    active: root.active == SettingsTab.cluster;
                    clicked => { root.active = SettingsTab.cluster; }
                }
                TabButton {
                    label: "Config";
                    active: root.active == SettingsTab.config;
                    clicked => { root.active = SettingsTab.config; }
                }
                if root.show-code-sessions : TabButton {
                    label: "Code Sessions";
                    active: root.active == SettingsTab.code-sessions;
                    clicked => { root.active = SettingsTab.code-sessions; }
                }
            }
        }

        Rectangle {
            background: Theme.bg-base;
            border-color: Theme.border-subtle;
            border-width: 1px;
            border-radius: Theme.radius-card;
            clip: true;

            // GUI-overhaul (gap panel wf_8ad7096a) — every tab body now SCROLLS
            // (vertical) so long tabs (Privacy rails / 118 Skills / Cluster) no
            // longer overflow the window + cut off the footer. The inner
            // VerticalLayout is pinned to the viewport width so content wraps
            // inside the margins instead of running off the right edge.
            ScrollView {
            VerticalLayout {
            width: parent.visible-width;
            // GUI-overhaul: pack the active tab at the top at its natural height.
            // Without this the layout stretched the single visible tab to fill the
            // whole viewport, spreading cards + fields apart with huge gaps
            // ("nicht aligned / spread out"). Extra space now stays below.
            alignment: start;
            // G-17 fix: replace internal "Pick #N" sprint labels with
            // operator-readable release identifiers. Internal tracking
            // belongs in PROGRESS.md, not in the settings UI.
            if root.active == SettingsTab.chat: VerticalBox {
                padding: Theme.space-base;
                spacing: Theme.space-base;
                PanelHeader {
                    title: "Chat";
                    subtitle: "Your day-to-day conversation surface — composer, scrollback, channel sidebar — lives in the main Chat view (it is the primary surface, not a settings sub-panel). Open it here.";
                    mirrors-slash: "(primary daily surface)";
                }
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-base;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "ACTIVE PROVIDER";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-medium;
                                letter-spacing: Theme.letter-spacing-tight;
                                color: Theme.accent-green;
                            }
                            Text {
                                text: root.provider-current;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                            }
                        }
                        Text {
                            text: "Press / in the chat composer to discover slash commands (provider, autonomy, skills, …).";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        NeothButton {
                            label: "Open chat";
                            primary: true;
                            clicked => { root.open-chat-clicked(); }
                        }
                    }
                }
                // ODY-11 — Chat density picker card.
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-base;
                        Text {
                            text: "CHAT DENSITY";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        Text {
                            text: "Controls the spacing between messages and inside each bubble. Takes effect immediately without restart.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            NeothButton {
                                label: "Compact";
                                primary: root.density-mode-current == 0;
                                clicked => {
                                    root.density-mode-current = 0;
                                    root.density-changed(0);
                                }
                            }
                            NeothButton {
                                label: "Normal";
                                primary: root.density-mode-current == 1;
                                clicked => {
                                    root.density-mode-current = 1;
                                    root.density-changed(1);
                                }
                            }
                            NeothButton {
                                label: "Spacious";
                                primary: root.density-mode-current == 2;
                                clicked => {
                                    root.density-mode-current = 2;
                                    root.density-changed(2);
                                }
                            }
                        }
                    }
                }
            }

            if root.active == SettingsTab.hemispheres: VerticalBox {
                padding: Theme.space-base;
                spacing: Theme.space-base;
                PanelHeader {
                    title: "Hemispheres";
                    subtitle: "NEOTH thinks across three roles: Left (fast, analytic), Right (deep, creative), Cerebellum (the orchestrator). Bind a provider to each via the CLI; this shows the live binding.";
                    mirrors-slash: "/provider [role] <kind>   |   neoth hemispheres set";
                }
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "TOPOLOGY";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-medium;
                                letter-spacing: Theme.letter-spacing-tight;
                                color: Theme.accent-green;
                            }
                            Text {
                                text: root.hemispheres-mode == "" ? "—" : root.hemispheres-mode;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                        if root.hemisphere-bindings.length == 0: Text {
                            text: "(start the daemon to read the live hemisphere bindings)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        for b in root.hemisphere-bindings: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: b.role;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-primary;
                            }
                            Text {
                                text: b.provider + (b.model == "" ? "" : " · " + b.model);
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: b.provider == "(unset)" ? Theme.text-muted : Theme.accent-green;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: b.has-key ? "key set" : "";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
                // SPEC-06 + GOLD-GUI-OVERHAUL — rebind a role from the GUI (shells
                // `neoth hemispheres set --role <r> --provider <p> [--model <m>]`).
                // Picking a provider populates the model combo with that provider's
                // options — local GGUF refs (abliterated-first, VRAM-fitting) for
                // local_qwen/ouro, else the live cloud catalog.
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "REBIND A ROLE";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        if root.provider-ids.length == 0: Text {
                            text: "(start the daemon to load the provider list)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.provider-ids.length > 0: VerticalLayout {
                            spacing: Theme.space-tight;
                            HorizontalLayout {
                                spacing: Theme.space-base;
                                role_combo := NeothComboBox {
                                    model: ["left", "right", "cerebellum"];
                                    horizontal-stretch: 1;
                                }
                                prov_combo := NeothComboBox {
                                    model: root.provider-ids;
                                    horizontal-stretch: 1;
                                    // Picking a provider refreshes the model combo
                                    // below with that provider's options (local
                                    // GGUF refs for local_qwen/ouro, else catalog).
                                    selected(i) => {
                                        if (i >= 0 && i < root.provider-ids.length) {
                                            root.hemisphere-provider-picked(root.provider-ids[i]);
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-base;
                                model_combo := NeothComboBox {
                                    model: root.hemisphere-model-ids;
                                    horizontal-stretch: 1;
                                }
                                NeothButton {
                                    label: "Set";
                                    primary: true;
                                    clicked => {
                                        root.hemisphere-set-clicked(
                                            role_combo.model[role_combo.current-index],
                                            prov_combo.model[prov_combo.current-index],
                                            model_combo.model[model_combo.current-index],
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.active == SettingsTab.channels: VerticalBox {
                padding: Theme.space-base;
                spacing: Theme.space-base;
                // GOLD-R3-04 — one add/reconfigure form for the canonical
                // registry. Reconfigure never reads existing secret values
                // back from the daemon; the operator supplies a complete new
                // credential set and the CLI commits it atomically.
                property <bool> add-channel-open: false;
                property <bool> form-editing: false;
                property <int> type-index: 0;
                property <string> selected-channel-type: type-index >= 0 && type-index < root.channel-types.length
                    ? root.channel-types[type-index]
                    : "";
                property <bool> ch-f1-secret: type-index >= 0 && type-index < root.channels.length ? root.channels[type-index].setup-secret-f1 : false;
                property <bool> ch-f2-secret: type-index >= 0 && type-index < root.channels.length ? root.channels[type-index].setup-secret-f2 : false;
                property <bool> ch-f3-secret: type-index >= 0 && type-index < root.channels.length ? root.channels[type-index].setup-secret-f3 : false;
                property <bool> ch-f4-secret: type-index >= 0 && type-index < root.channels.length ? root.channels[type-index].setup-secret-f4 : false;
                property <bool> ch-f5-secret: type-index >= 0 && type-index < root.channels.length ? root.channels[type-index].setup-secret-f5 : false;
                property <bool> ch-f6-secret: type-index >= 0 && type-index < root.channels.length ? root.channels[type-index].setup-secret-f6 : false;
                property <string> ch-f1: "";
                property <string> ch-f2: "";
                property <string> ch-f3: "";
                property <string> ch-f4: "";
                property <string> ch-f5: "";
                property <string> ch-f6: "";
                property <bool> ch-flag: false;
                // The six value slots are shared by every adapter. Clear them
                // whenever the effective registry selection changes so a
                // secret cannot become visible or be submitted to another
                // channel after a type switch / registry refresh.
                changed selected-channel-type => {
                    if add-channel-open {
                        ch-f1 = "";
                        ch-f2 = "";
                        ch-f3 = "";
                        ch-f4 = "";
                        ch-f5 = "";
                        ch-f6 = "";
                        ch-flag = false;
                        // Reconfigure is intentionally type-locked. If its
                        // backing registry row changes, close rather than
                        // silently targeting a different adapter.
                        if form-editing || selected-channel-type == "" {
                            add-channel-open = false;
                            form-editing = false;
                        }
                    }
                }
                property <int> observed-success: root.channel-add-success-seq;
                changed observed-success => {
                    if observed-success > 0 {
                        add-channel-open = false;
                        form-editing = false;
                        ch-f1 = "";
                        ch-f2 = "";
                        ch-f3 = "";
                        ch-f4 = "";
                        ch-f5 = "";
                        ch-f6 = "";
                        ch-flag = false;
                        type-index = 0;
                    }
                }
                PanelHeader {
                    title: "Channels";
                    subtitle: "All registered messaging surfaces, using the same validation and feature probes as the CLI. Secrets are never returned to the GUI.";
                    mirrors-slash: "/connect <channel>   |   /disconnect <channel>";
                }
                HorizontalLayout {
                    alignment: end;
                    NeothButton {
                        label: "Refresh";
                        primary: false;
                        clicked => { root.channels-refresh-clicked(); }
                    }
                    NeothButton {
                        label: "Add channel";
                        primary: true;
                        enabled: root.channel-types.length > 0;
                        clicked => {
                            add-channel-open = false;
                            form-editing = false;
                            type-index = 0;
                            ch-f1 = "";
                            ch-f2 = "";
                            ch-f3 = "";
                            ch-f4 = "";
                            ch-f5 = "";
                            ch-f6 = "";
                            ch-flag = false;
                            add-channel-open = true;
                        }
                    }
                }

                // GAP-19 — inline Add channel form, toggled by the button above.
                // Uses per-channel-type conditional field blocks to label fields correctly.
                // type-index follows the daemon registry projection exactly.
                if add-channel-open: Card {
                    shimmer: false;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-base;

                        Text {
                            text: form-editing ? "RECONFIGURE CHANNEL" : "ADD CHANNEL";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            color: Theme.accent-green;
                        }
                        if form-editing: Text {
                            text: "Existing secrets are never read back. Re-enter every required field; Save changes replaces the channel configuration atomically.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.accent-amber;
                            wrap: word-wrap;
                            accessible-role: text;
                            accessible-label: self.text;
                        }

                        // ── channel type picker ───────────────────────────────
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: "Channel type";
                                color: Theme.text-muted;
                                font-size: Theme.font-size-caption;
                                vertical-alignment: center;
                            }
                            if form-editing: Text {
                                text: selected-channel-type;
                                color: Theme.text-primary;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                accessible-role: text;
                                accessible-label: "Locked channel type " + self.text;
                            }
                            if !form-editing: NeothComboBox {
                                model: root.channel-types;
                                current-index <=> type-index;
                                horizontal-stretch: 1;
                            }
                        }

                        // ── per-channel hint + fields ─────────────────────────
                        // telegram: token + exact numeric sender allowlist
                        if selected-channel-type == "telegram": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "Bot token from @BotFather + your numeric Telegram user ID"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "Token (--token)"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "Allowed user ID (--telegram-user-id)  e.g. 123456789"; password: ch-f2-secret; text <=> ch-f2; }
                        }
                        // slack: bot-token + app-token
                        if selected-channel-type == "slack": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "Slack bot token (xoxb-…) + app-level token (xapp-…)"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "Bot token (--bot-token)"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "App token (--app-token)"; password: ch-f2-secret; text <=> ch-f2; }
                        }
                        // whatsapp_business: complete Cloud API send + verified inbound contract
                        if selected-channel-type == "whatsapp_business": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "WhatsApp Cloud API: outbound token/phone ID + inbound verify token/app secret"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "Token (--token)"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "Phone ID (--phone-id)"; password: ch-f2-secret; text <=> ch-f2; }
                            NeothLineEdit { placeholder-text: "Webhook verify token (--verify-token)"; password: ch-f3-secret; text <=> ch-f3; }
                            NeothLineEdit { placeholder-text: "Meta app secret (--app-secret)"; password: ch-f4-secret; text <=> ch-f4; }
                        }
                        // whatsapp_baileys: authenticated sidecar + sender policy
                        if selected-channel-type == "whatsapp_baileys": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "Repository-owned WhatsApp Web bridge; groups denied unless explicitly allowed"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "Bridge URL (--url)  e.g. http://127.0.0.1:9120"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "Bearer token, 32+ URL-safe chars (--token)"; password: ch-f2-secret; text <=> ch-f2; }
                            NeothLineEdit { placeholder-text: "Allowed senders CSV (--allowed-sender)"; password: ch-f3-secret; text <=> ch-f3; }
                            NeothLineEdit { placeholder-text: "Allowed group JIDs CSV (--allowed-rooms-csv, optional)"; password: ch-f4-secret; text <=> ch-f4; }
                        }
                        // keet: repository-owned full-duplex companion contract
                        if selected-channel-type == "keet": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "Keet/Pear companion: local authenticated full-duplex bridge + exact sender policy"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "Companion URL (--url)  e.g. http://127.0.0.1:9130"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "Bearer token, 32+ URL-safe chars (--token)"; password: ch-f2-secret; text <=> ch-f2; }
                            NeothLineEdit { placeholder-text: "Topic capability (--server, secret)"; password: ch-f3-secret; text <=> ch-f3; }
                            NeothLineEdit { placeholder-text: "Allowed sender IDs CSV (--allowed-sender)"; password: ch-f4-secret; text <=> ch-f4; }
                        }
                        // discord: token
                        if selected-channel-type == "discord": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "Discord bot token"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "Token (--token)"; password: ch-f1-secret; text <=> ch-f1; }
                        }
                        // signal: url + phone
                        if selected-channel-type == "signal": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "signal-cli REST URL + registered phone number"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "URL (--url)  e.g. http://localhost:8080"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "Phone (--phone)  e.g. +4917…"; password: ch-f2-secret; text <=> ch-f2; }
                        }
                        // line: token + password (optional)
                        if selected-channel-type == "line": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "LINE Messaging API channel access token; password optional"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "Token (--token)"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "Password (--password, optional)"; password: ch-f2-secret; text <=> ch-f2; }
                        }
                        // irc: server + nick + password (opt) + channels-csv (opt)
                        if selected-channel-type == "irc": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "IRC server host, nick, optional password + channel list (comma-separated)"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "Server (--server)  e.g. irc.libera.chat"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "Nick (--nick)"; password: ch-f2-secret; text <=> ch-f2; }
                            NeothLineEdit { placeholder-text: "Password (--password, optional)"; password: ch-f3-secret; text <=> ch-f3; }
                            NeothLineEdit { placeholder-text: "Channels CSV (--channels-csv, optional)  e.g. #general,#dev"; password: ch-f4-secret; text <=> ch-f4; }
                        }
                        // imessage_bluebubbles: url + password
                        if selected-channel-type == "imessage_bluebubbles": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "BlueBubbles server URL + password"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "URL (--url)  e.g. http://mac.local:1234"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "Password (--password)"; password: ch-f2-secret; text <=> ch-f2; }
                        }
                        // mattermost: url + token
                        if selected-channel-type == "mattermost": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "Mattermost server URL + personal access token"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "URL (--url)  e.g. https://chat.example.com"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "Token (--token)"; password: ch-f2-secret; text <=> ch-f2; }
                        }
                        // gchat: service-account path + subscription
                        if selected-channel-type == "gchat": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "Google Chat Pub/Sub service-account file + full subscription resource"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "Service-account JSON path (--url)"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "projects/<p>/subscriptions/<s> (--server)"; password: ch-f2-secret; text <=> ch-f2; }
                        }
                        // matrix: encrypted by default; access token or password
                        if selected-channel-type == "matrix": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "Matrix homeserver + bot user; encrypted rooms required unless explicitly disabled"; wrap: word-wrap; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "Homeserver URL (--url)"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "Bot user ID, @user:server (--nick)"; password: ch-f2-secret; text <=> ch-f2; }
                            NeothLineEdit { placeholder-text: "Access token (--token, preferred)"; password: ch-f3-secret; text <=> ch-f3; }
                            NeothLineEdit { placeholder-text: "Account password (--password, alternative)"; password: ch-f4-secret; text <=> ch-f4; }
                            NeothLineEdit { placeholder-text: "Allowed sender @user:server (--allowed-sender, optional)"; password: ch-f5-secret; text <=> ch-f5; }
                            NeothLineEdit { placeholder-text: "Allowed room IDs CSV (--allowed-rooms-csv, optional)"; password: ch-f6-secret; text <=> ch-f6; }
                            NeothCheckBox { text: "Allow plaintext rooms (--allow-plaintext)"; checked <=> ch-flag; }
                        }
                        // twitch: user + OAuth + rooms
                        if selected-channel-type == "twitch": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "Twitch IRC identity, OAuth token, and at least one channel"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "Bot username (--nick)"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "OAuth token (--token)"; password: ch-f2-secret; text <=> ch-f2; }
                            NeothLineEdit { placeholder-text: "Channels CSV (--channels-csv)"; password: ch-f3-secret; text <=> ch-f3; }
                        }
                        // nostr: private key + relay URLs
                        if selected-channel-type == "nostr": VerticalBox {
                            spacing: Theme.space-tight;
                            Text { text: "Nostr NIP-17 private key + secure relay URLs"; color: Theme.text-muted; font-size: Theme.font-size-caption; }
                            NeothLineEdit { placeholder-text: "nsec1… or 64-char hex key (--token)"; password: ch-f1-secret; text <=> ch-f1; }
                            NeothLineEdit { placeholder-text: "wss:// relay URLs CSV (--channels-csv)"; password: ch-f2-secret; text <=> ch-f2; }
                        }

                        // ── action row ────────────────────────────────────────
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            alignment: end;
                            NeothButton {
                                label: "Cancel";
                                primary: false;
                                clicked => {
                                    add-channel-open = false;
                                    form-editing = false;
                                    ch-f1 = "";
                                    ch-f2 = "";
                                    ch-f3 = "";
                                    ch-f4 = "";
                                    ch-f5 = "";
                                    ch-f6 = "";
                                    ch-flag = false;
                                    type-index = 0;
                                }
                            }
                            NeothButton {
                                label: form-editing ? "Save changes" : "Add";
                                primary: true;
                                enabled: selected-channel-type != "";
                                clicked => {
                                    root.channel-add-clicked(
                                        selected-channel-type,
                                        ch-f1, ch-f2, ch-f3, ch-f4, ch-f5, ch-f6, ch-flag
                                    );
                                    // Keep values and the form open until Rust confirms
                                    // `saved:true`. Failed submissions remain editable.
                                }
                            }
                        }
                    }
                }

                if root.channel-status-error != "": Card {
                    shimmer: false;
                    border-color: Theme.accent-pink;
                    Text {
                        text: "Channel status unavailable: " + root.channel-status-error;
                        color: Theme.accent-pink;
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                }

                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    accessible-role: list;
                    accessible-label: "Registered channel status";
                    accessible-item-count: root.channels.length;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        for c[index] in root.channels: HorizontalLayout {
                            spacing: Theme.space-base;
                            // Per-row confirm state (each for-instance gets its own).
                            property <bool> confirming: false;
                            accessible-role: list-item;
                            accessible-label: c.name + ": " + c.status + ". " + c.detail;
                            Text {
                                text: c.status == "ok" ? "✓ ready"
                                    : c.status == "warn" ? "⚠ warning"
                                    : c.status == "error" ? "✗ error"
                                    : c.status == "unavailable" ? "⊘ unavailable"
                                    : "· not configured";
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: c.status == "ok" ? Theme.accent-green
                                    : c.status == "warn" ? Theme.accent-amber
                                    : c.status == "error" ? Theme.accent-pink
                                    : Theme.text-muted;
                                vertical-alignment: center;
                                width: 132px;
                            }
                            VerticalBox {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: c.name;
                                    overflow: elide;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-caption;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: c.detail;
                                    font-family: Theme.font-display;
                                    font-size: Theme.font-size-2xs;
                                    color: Theme.text-tertiary;
                                    wrap: word-wrap;
                                }
                            }
                            // GUI-overhaul feature parity — live-test or remove a
                            // configured channel. Test is a safe connectivity check;
                            // Remove deletes the credential, so it takes an inline
                            // confirm.
                            if !confirming: NeothButton {
                                label: c.configured ? "Reconfigure" : "Configure";
                                primary: false;
                                clicked => {
                                    add-channel-open = false;
                                    form-editing = c.configured;
                                    type-index = index;
                                    ch-f1 = "";
                                    ch-f2 = "";
                                    ch-f3 = "";
                                    ch-f4 = "";
                                    ch-f5 = "";
                                    ch-f6 = "";
                                    ch-flag = false;
                                    add-channel-open = true;
                                }
                            }
                            if c.configured && !confirming: NeothButton {
                                label: "Test";
                                primary: false;
                                clicked => { root.channel-test-clicked(c.name); }
                            }
                            if c.configured && !confirming: NeothButton {
                                label: "Remove";
                                primary: false;
                                clicked => { confirming = true; }
                            }
                            if confirming: Text {
                                text: "Remove " + c.name + " credential?";
                                overflow: elide;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.accent-amber;
                                vertical-alignment: center;
                            }
                            if confirming: NeothButton {
                                label: "Confirm";
                                primary: false;
                                clicked => {
                                    confirming = false;
                                    root.channel-remove-clicked(c.name);
                                }
                            }
                            if confirming: NeothButton {
                                label: "Cancel";
                                primary: false;
                                clicked => { confirming = false; }
                            }
                        }
                    }
                }

                // DES-10 — live Channel Activity feed.
                // Shows traffic METADATA only: who/when/direction/bytes.
                // Message bodies are never stored (WAL is hashed by design).
                Card {
                    shimmer: false;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;

                        // ── header row ──────────────────────────────────────
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            alignment: start;
                            Text {
                                text: "CHANNEL ACTIVITY";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-2xs;
                                font-weight: Theme.weight-bold;
                                letter-spacing: Theme.letter-spacing-extra-wide;
                                color: Theme.text-disabled;
                                vertical-alignment: center;
                            }
                            Led {
                                state: "live";
                                dot-size: 6px;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "traffic metadata — message text is never stored";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-tertiary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        // ── feed list ────────────────────────────────────────
                        if root.channel-activity.length == 0: Text {
                            text: "no channel traffic yet";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-disabled;
                            horizontal-alignment: center;
                        }

                        ScrollView {
                            height: min(root.channel-activity.length * 28px, 280px);
                            VerticalLayout {
                                spacing: 2px;
                                for a in root.channel-activity: HorizontalLayout {
                                    spacing: Theme.space-tight;
                                    height: 26px;

                                    // direction chip — color-coded per direction
                                    Rectangle {
                                        width: 70px;
                                        height: 20px;
                                        border-radius: 4px;
                                        background: a.direction == "in"       ? Theme.accent-cyan.with-alpha(0.18)
                                                  : a.direction == "out"      ? Theme.accent-green.with-alpha(0.18)
                                                  : a.direction == "proactive"? Theme.accent-amber.with-alpha(0.18)
                                                  :                             Theme.accent-pink.with-alpha(0.18);
                                        y: (parent.height - self.height) / 2;
                                        Text {
                                            text: a.direction;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-caption;
                                            color: a.direction == "in"       ? Theme.accent-cyan
                                                 : a.direction == "out"      ? Theme.accent-green
                                                 : a.direction == "proactive"? Theme.accent-amber
                                                 :                             Theme.accent-pink;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                    }

                                    // channel (mono)
                                    Text {
                                        text: a.channel;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-caption;
                                        color: Theme.text-primary;
                                        width: 80px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    // peer (mono, tertiary, elide)
                                    Text {
                                        text: a.peer;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-caption;
                                        color: Theme.text-tertiary;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    // bytes
                                    Text {
                                        text: a.bytes;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-caption;
                                        color: Theme.text-muted;
                                        width: 56px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    // HH:MM:SS
                                    Text {
                                        text: a.ts;
                                        overflow: elide;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-caption;
                                        color: Theme.text-disabled;
                                        width: 60px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.active == SettingsTab.skills: VerticalBox {
                padding: Theme.space-base;
                spacing: Theme.space-base;
                PanelHeader {
                    title: "Skills";
                    subtitle: "Skill packs teach NEOTH about a domain — each loads automatically when its trigger words appear.";
                    mirrors-slash: "/skill list   |   neoth skills --install <path>";
                }
                // ── Skills action row — Install + New ─────────────────────
                HorizontalLayout {
                    spacing: Theme.space-tight;
                    NeothButton {
                        label: "Install skill…";
                        primary: false;
                        size: "sm";
                        clicked => { root.skill-install-clicked(); }
                    }
                    NeothButton {
                        label: "New skill…";
                        primary: false;
                        size: "sm";
                        clicked => { skill-create-open = !skill-create-open; }
                    }
                    Text {
                        text: "Or ask in chat: 'build me a skill that…' — NEOTH creates it.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                }
                // ── Inline create form (toggled) ───────────────────────────
                property <bool> skill-create-open: false;
                property <string> sc-id: "";
                property <string> sc-desc: "";
                property <string> sc-keywords: "";
                property <string> sc-prompt: "";
                if skill-create-open: Card {
                    shimmer: false;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "NEW SKILL";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        NeothLineEdit {
                            text <=> sc-id;
                            placeholder-text: "id (kebab-case, e.g. rust-security)";
                        }
                        NeothLineEdit {
                            text <=> sc-desc;
                            placeholder-text: "description — one line";
                        }
                        NeothLineEdit {
                            text <=> sc-keywords;
                            placeholder-text: "keywords — comma-separated (e.g. rust,unsafe,security)";
                        }
                        NeothLineEdit {
                            text <=> sc-prompt;
                            placeholder-text: "system prompt — what this skill teaches NEOTH";
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            NeothButton {
                                label: "Create";
                                primary: true;
                                size: "sm";
                                enabled: sc-id != "" && sc-desc != "" && sc-prompt != "";
                                clicked => {
                                    root.skill-create-clicked(sc-id, sc-desc, sc-keywords, sc-prompt);
                                    skill-create-open = false;
                                    sc-id = "";
                                    sc-desc = "";
                                    sc-keywords = "";
                                    sc-prompt = "";
                                }
                            }
                            NeothButton {
                                label: "Cancel";
                                primary: false;
                                size: "sm";
                                clicked => { skill-create-open = false; }
                            }
                        }
                    }
                }
                // PF-01-GUI — skill auto-routing toggle (skills.always_embed_route).
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        NeothCheckBox {
                            text: "Auto-route skills (embed a skill's prompt when its triggers fire)";
                            checked: root.skills-always-embed-route;
                            toggled(checked) => {
                                root.skills-always-embed-route = checked;
                                root.skills-always-embed-route-changed(checked);
                            }
                        }
                        Text {
                            text: "Off = skills load only when you ask explicitly. Writes skills.always_embed_route in freedom.yaml; the daemon hot-reloads.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                // GOLD-ADAPT-AOS-01 — searchable, domain-grouped index.
                // Rust rebuilds the grouped model on every keystroke
                // (`group_skill_rows` over the cached full list).
                NeothLineEdit {
                    text <=> root.skills-filter;
                    placeholder-text: "Search skills — name, description, trigger, tag…";
                    edited(t) => { root.skills-filter-edited(t); }
                }
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: root.skills-total + " skill(s) installed";
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                        }
                        if root.skills.length == 0 && root.skills-filter == "": Text {
                            text: "(no skills installed — `neoth skills --install <path>`)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.skills.length == 0 && root.skills-filter != "": Text {
                            text: "(no skill matches \"" + root.skills-filter + "\")";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        for s in root.skills: VerticalBox {
                            spacing: 2px;
                            // Domain header row (first manifest tag).
                            if s.is-header: Text {
                                text: s.id;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-2xs;
                                letter-spacing: Theme.letter-spacing-wide;
                                color: Theme.accent;
                            }
                            if !s.is-header: HorizontalLayout {
                                spacing: Theme.space-base;
                                // GUI-overhaul — feature parity: enable/disable a
                                // skill from the GUI (was a read-only on/off label).
                                // Fires `neoth skills --enable/--disable <id>`.
                                NeothCheckBox {
                                    // Bare (label-less) checkbox: pin to the box
                                    // width so it doesn't stretch and shove the id
                                    // to mid-row (NeothCheckBox inherits Rectangle,
                                    // which fills by default).
                                    width: 28px;
                                    checked: s.enabled;
                                    toggled(v) => { root.skill-toggle-clicked(s.id, v); }
                                }
                                Text {
                                    text: s.id;
                                    overflow: elide;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-caption;
                                    color: Theme.text-primary;
                                    horizontal-stretch: 1;
                                }
                                if s.tags != "": Text {
                                    text: s.tags;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-2xs;
                                    color: Theme.text-tertiary;
                                    vertical-alignment: center;
                                }
                                // Per-row uninstall. The daemon no-ops gracefully if
                                // the skill is built-in / already absent.
                                property <bool> sk-confirming: false;
                                if !sk-confirming: NeothButton {
                                    label: "Uninstall";
                                    primary: false;
                                    danger: true;
                                    size: "sm";
                                    clicked => { sk-confirming = true; }
                                }
                                if sk-confirming: NeothButton {
                                    label: "Confirm";
                                    primary: false;
                                    danger: true;
                                    size: "sm";
                                    clicked => {
                                        sk-confirming = false;
                                        root.skill-uninstall-clicked(s.id);
                                    }
                                }
                                if sk-confirming: NeothButton {
                                    label: "Cancel";
                                    primary: false;
                                    size: "sm";
                                    clicked => { sk-confirming = false; }
                                }
                            }
                            if !s.is-header && s.description != "": Text {
                                text: s.description;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                            // GOLD-ADAPT-AOS-05 — WHY this skill activates:
                            // the trigger phrases, previously parsed but
                            // never rendered.
                            if !s.is-header && s.keywords != "": Text {
                                text: "activates on: " + s.keywords;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-2xs;
                                color: Theme.text-tertiary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            if root.active == SettingsTab.plugins: VerticalBox {
                padding: Theme.space-base;
                spacing: Theme.space-base;
                PanelHeader {
                    title: "Plugins";
                    subtitle: "Sandboxed WebAssembly plugins. Any permission, manifest, or binary change is stopped until you review and enable it again.";
                    mirrors-slash: "/plugin list   |   neoth plugin install <dir>";
                }
                // ── Plugins action row ─────────────────────────────────────
                HorizontalLayout {
                    spacing: Theme.space-tight;
                    NeothButton {
                        label: "Install plugin…";
                        primary: false;
                        size: "sm";
                        clicked => { root.plugin-install-clicked(); }
                    }
                }
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: root.plugins.length + " plugin(s) discovered";
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                        }
                        if root.plugins.length == 0: Text {
                            text: "(none — install a plugin directory via the button above or `neoth plugin install <dir>`)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        for p in root.plugins: HorizontalLayout {
                            spacing: Theme.space-base;
                            // GUI-overhaul feature parity: enable/disable a plugin
                            // from the GUI (was a read-only activation label).
                            // Fires `neoth plugin enable/disable <id>`.
                            NeothCheckBox {
                                width: 28px;
                                checked: p.activation == "active";
                                toggled(v) => { root.plugin-toggle-clicked(p.id, v); }
                            }
                            Text {
                                text: p.id;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: p.activation == "reconsent_required" ? "review again" : p.activation;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: p.activation == "active"
                                    ? Theme.accent-green
                                    : p.activation == "reconsent_required"
                                        ? Theme.accent-amber
                                        : Theme.text-muted;
                            }
                            Text {
                                text: "permission: " + p.requested-permission;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-2xs;
                                color: p.requested-permission == "dangerous"
                                    || p.requested-permission == "execute"
                                    ? Theme.accent-amber
                                    : Theme.text-muted;
                            }
                            // DES-12 — Activity button appears only for plugins with ui_surface.
                            if p.has-ui-surface: NeothButton {
                                label: p.ui-title != "" ? p.ui-title : "Activity";
                                primary: root.plugin-detail-id == p.id;
                                size: "sm";
                                clicked => { root.plugin-detail-clicked(p.id); }
                            }
                            // Per-row remove — inline confirm guards against fat-finger.
                            property <bool> pl-confirming: false;
                            if !pl-confirming: NeothButton {
                                label: "Remove";
                                primary: false;
                                danger: true;
                                size: "sm";
                                clicked => { pl-confirming = true; }
                            }
                            if pl-confirming: NeothButton {
                                label: "Confirm";
                                primary: false;
                                danger: true;
                                size: "sm";
                                clicked => {
                                    pl-confirming = false;
                                    root.plugin-remove-clicked(p.id);
                                }
                            }
                            if pl-confirming: NeothButton {
                                label: "Cancel";
                                primary: false;
                                size: "sm";
                                clicked => { pl-confirming = false; }
                            }
                        }
                    }
                }
                // DES-12 — inline WAL-feed detail pane.
                // Shown below the plugins list when operator clicks "Activity".
                // Removed from the layout entirely when no plugin is selected.
                if root.plugin-detail-id != "": Card {
                    shimmer: false;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        // Header row: title + close button
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: root.plugin-detail-title != ""
                                    ? root.plugin-detail-title
                                    : root.plugin-detail-id;
                                overflow: elide;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: 600;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            NeothButton {
                                label: "Close";
                                primary: false;
                                size: "sm";
                                clicked => { root.plugin-detail-close(); }
                            }
                        }
                        // Event list — 200px scrollable area.
                        // SECURITY: kind is plugin-controlled text; rendered as plain
                        // Text only — never as markup, links, or rich content.
                        if root.plugin-detail-events.length == 0: Text {
                            text: "no activity recorded";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                        }
                        if root.plugin-detail-events.length > 0: Rectangle {
                            height: 200px;
                            clip: true;
                            ScrollView {
                                VerticalLayout {
                                    spacing: Theme.space-tight;
                                    padding: 2px;
                                    for ev in root.plugin-detail-events: HorizontalLayout {
                                        spacing: Theme.space-base;
                                        // ts
                                        Text {
                                            text: ev.ts;
                                            overflow: elide;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-caption;
                                            color: Theme.text-muted;
                                            min-width: 64px;
                                        }
                                        // kind — plain Text only, never parsed as markup
                                        Text {
                                            text: ev.kind;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-caption;
                                            color: Theme.text-primary;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        // bytes
                                        Text {
                                            text: ev.bytes;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-caption;
                                            color: Theme.text-muted;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.active == SettingsTab.memory: VerticalBox {
                padding: Theme.space-base;
                spacing: Theme.space-base;
                PanelHeader {
                    title: "Memory";
                    subtitle: "What NEOTH loads as context — global/project/rule files + the memory tier. Sizes only; inspect or erase content via the CLI.";
                    mirrors-slash: "/memory view [topic]   |   /memory forget <topic>";
                }
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "total " + root.memory-total;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                        }
                        if root.memory-blocks.length == 0: Text {
                            text: "(no memory blocks loaded yet)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        for m in root.memory-blocks: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: m.source;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.accent-green;
                            }
                            Text {
                                text: m.path;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            Text {
                                text: m.bytes;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
                // GUI-overhaul feature parity — forget a topic from the GUI (was
                // "inspect or erase via the CLI" only). Preview is a dry-run; the
                // permanent wipe (`neoth memory --forget <t> --confirm`) is gated
                // behind an inline confirm because it is irreversible.
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        property <bool> forget-confirming: false;
                        Text {
                            text: "FORGET A TOPIC";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        Text {
                            text: "GDPR wipe — removes matching episodes from hot/warm/long-term memory, embeddings + ground-truth. Preview is a dry run; the wipe is permanent.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            forget_input := NeothLineEdit {
                                placeholder-text: "topic / keyword to forget";
                                horizontal-stretch: 1;
                            }
                        }
                        if !forget-confirming: HorizontalLayout {
                            spacing: Theme.space-base;
                            NeothButton {
                                label: "Preview matches";
                                primary: false;
                                clicked => {
                                    if (forget_input.text != "") {
                                        root.memory-forget-preview-clicked(forget_input.text);
                                    }
                                }
                            }
                            NeothButton {
                                label: "Forget…";
                                primary: false;
                                clicked => {
                                    if (forget_input.text != "") {
                                        forget-confirming = true;
                                    }
                                }
                            }
                        }
                        if forget-confirming: Text {
                            text: "⚠ Permanently wipe everything matching \"" + forget_input.text + "\"? This cannot be undone.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.accent-amber;
                            wrap: word-wrap;
                        }
                        if forget-confirming: HorizontalLayout {
                            spacing: Theme.space-base;
                            NeothButton {
                                label: "Wipe permanently";
                                clicked => {
                                    forget-confirming = false;
                                    root.memory-forget-confirm-clicked(forget_input.text);
                                }
                            }
                            NeothButton {
                                label: "Cancel";
                                primary: false;
                                clicked => { forget-confirming = false; }
                            }
                        }
                    }
                }
                // GAP-04 — Memory search: full-text recall across hot/warm/cold tiers.
                // Empty query → no-op (Search button disabled). Output is plain text
                // from `neoth recall <query>` (same as CLI), rendered in a mono area.
                Card {
                    shimmer: false;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "SEARCH MEMORY";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        Text {
                            text: "Recall across hot / warm / cold memory tiers. Results mirror `neoth recall <query>`.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            mem_search_input := NeothLineEdit {
                                placeholder-text: "search query";
                                text: root.memory-search-query;
                                horizontal-stretch: 1;
                                edited(t) => { root.memory-search-query = t; }
                            }
                            NeothButton {
                                label: root.memory-search-running ? "searching…" : "Search";
                                primary: true;
                                clicked => {
                                    if (mem_search_input.text != "" && !root.memory-search-running) {
                                        root.memory-search-clicked(mem_search_input.text);
                                    }
                                }
                            }
                        }
                        if root.memory-search-output != "": Rectangle {
                            height: 180px;
                            border-radius: Theme.radius-lg;
                            background: Theme.bg-void;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            Flickable {
                                viewport-width: self.width;
                                Text {
                                    x: 14px; y: 12px;
                                    width: parent.width - 28px;
                                    text: root.memory-search-output;
                                    color: Theme.text-secondary;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-caption;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
                // DES-09 Welle C — memory settings editors
                Card {
                    shimmer: false;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "MEMORY SETTINGS";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        NeothCheckBox {
                            text: "Name sessions automatically";
                            checked: root.cfg-memory-name-sessions;
                            toggled(v) => {
                                root.cfg-memory-name-sessions = v;
                                root.cfg-memory-name-sessions-changed(v);
                            }
                        }
                        NeothCheckBox {
                            text: "Recall shortcut (auto-prepend relevant memories)";
                            checked: root.cfg-memory-recall-shortcut;
                            toggled(v) => {
                                root.cfg-memory-recall-shortcut = v;
                                root.cfg-memory-recall-shortcut-changed(v);
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            alignment: center;
                            Text {
                                text: "vector index backend";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            NeothComboBox {
                                model: ["brute_force", "hnsw"];
                                current-index: root.cfg-memory-vector-backend-idx;
                                selected(idx) => {
                                    root.cfg-memory-vector-backend-idx = idx;
                                    root.cfg-memory-vector-backend-changed(idx);
                                }
                            }
                        }
                        Text {
                            text: "After switching vector backend, run: neoth memory --rebuild-index";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        NeothCheckBox {
                            text: "Consolidation sweep (cluster hot memories → groundtruth)";
                            checked: root.cfg-consolidation-enabled;
                            toggled(v) => {
                                root.cfg-consolidation-enabled = v;
                                root.cfg-consolidation-enabled-changed(v);
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            alignment: center;
                            Text {
                                text: "sweep interval (s)";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                width: 160px;
                            }
                            NeothLineEdit {
                                placeholder-text: "e.g. 21600 (6h)";
                                text: root.cfg-consolidation-interval-secs;
                                horizontal-stretch: 1;
                                edited(t) => {
                                    root.cfg-consolidation-interval-secs = t;
                                    root.cfg-consolidation-interval-secs-changed(t);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            alignment: center;
                            Text {
                                text: "cosine threshold";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                width: 160px;
                            }
                            NeothLineEdit {
                                placeholder-text: "0.0–1.0 (e.g. 0.65)";
                                text: root.cfg-consolidation-cosine;
                                horizontal-stretch: 1;
                                edited(t) => {
                                    root.cfg-consolidation-cosine = t;
                                    root.cfg-consolidation-cosine-changed(t);
                                }
                            }
                        }
                    }
                }
            }

            if root.active == SettingsTab.privacy: VerticalBox {
                padding: Theme.space-base;
                spacing: Theme.space-base;
                PanelHeader {
                    title: "Privacy";
                    subtitle: "Outbound-LLM consent state + autonomy level. Cloud providers only run after explicit consent (V03-08).";
                    mirrors-slash: "/consent list   |   /autonomy <level>";
                }
                Card {
                    shimmer: false;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "OMI · CONVERSATIONS & MEDIA";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-medium;
                                color: Theme.accent-green;
                            }
                            Text {
                                text: "runtime " + root.omi-runtime-state + " · pending " + root.omi-pending-audits;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: root.omi-runtime-state == "healthy" ? Theme.accent-green : Theme.accent-amber;
                            }
                        }
                        Text {
                            text: root.omi-config-valid
                                ? (root.omi-runtime-detail == "" ? "Configuration valid" : root.omi-runtime-detail)
                                : "Configuration invalid: " + root.omi-config-error;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: root.omi-config-valid ? Theme.text-muted : Theme.accent-pink;
                            wrap: word-wrap;
                        }
                        NeothCheckBox {
                            text: "Enable OMI ingestion (explicit opt-in)";
                            checked <=> root.omi-enabled;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            Text { text: "Mode"; color: Theme.text-secondary; vertical-alignment: center; width: 130px; }
                            NeothComboBox {
                                model: ["developer_api", "native_ingest", "both", "legacy_memories"];
                                current-index: root.omi-mode == "native_ingest" ? 1
                                    : root.omi-mode == "both" ? 2
                                    : root.omi-mode == "legacy_memories" ? 3 : 0;
                                selected(i) => {
                                    root.omi-mode = i == 1 ? "native_ingest"
                                        : i == 2 ? "both"
                                        : i == 3 ? "legacy_memories" : "developer_api";
                                }
                            }
                        }
                        if root.omi-mode == "both": Text {
                            text: "Both imports OMI conversations and exports completed native transcripts to the configured Developer API endpoint.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.accent-amber;
                            wrap: word-wrap;
                        }
                        NeothLineEdit { placeholder-text: "Developer/local endpoint"; text <=> root.omi-endpoint; }
                        NeothLineEdit { placeholder-text: "Native listener, e.g. 127.0.0.1:8003"; text <=> root.omi-listen-addr; }
                        NeothLineEdit { placeholder-text: "Retention days"; text <=> root.omi-retention-days; }
                        Text {
                            text: "Developer key: " + (root.omi-developer-key-present ? "stored" : "missing")
                                + " · Native token: " + (root.omi-native-token-present ? "stored" : "missing")
                                + ". Existing secrets are never displayed.";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        NeothLineEdit { placeholder-text: "New omi_dev_* key (leave blank to keep)"; password: true; text <=> root.omi-developer-key-draft; }
                        NeothLineEdit { placeholder-text: "New native bearer token, min. 32 bytes (leave blank to keep)"; password: true; text <=> root.omi-native-token-draft; }
                        Text {
                            text: "Independent data and effect consents";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-secondary;
                        }
                        NeothCheckBox { text: "Retain raw transcripts locally"; checked <=> root.omi-retain-transcripts; }
                        NeothCheckBox { text: "Accept/process audio"; checked <=> root.omi-audio-enabled; }
                        NeothCheckBox { text: "Accept/process images"; checked <=> root.omi-image-enabled; }
                        NeothCheckBox { text: "Accept/process video"; checked <=> root.omi-video-enabled; }
                        NeothCheckBox { text: "Allow public Developer API reads + both-mode transcript exports (HTTPS only)"; checked <=> root.omi-allow-cloud-api; }
                        NeothCheckBox { text: "Create bounded summaries"; checked <=> root.omi-summary-enabled; }
                        NeothCheckBox { text: "Allow cloud model for summaries"; checked <=> root.omi-allow-cloud-summary; }
                        NeothCheckBox { text: "Promote action items into local tasks"; checked <=> root.omi-create-actions; }
                        NeothCheckBox { text: "Seed corroborated statements into ground truth"; checked <=> root.omi-seed-groundtruth; }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            NeothButton {
                                label: "Save & reload";
                                clicked => {
                                    root.omi-save-clicked(
                                        root.omi-enabled, root.omi-mode, root.omi-endpoint,
                                        root.omi-listen-addr, root.omi-retention-days,
                                        root.omi-retain-transcripts, root.omi-audio-enabled,
                                        root.omi-image-enabled, root.omi-video-enabled,
                                        root.omi-allow-cloud-api, root.omi-allow-cloud-summary,
                                        root.omi-create-actions, root.omi-seed-groundtruth,
                                        root.omi-summary-enabled, root.omi-developer-key-draft,
                                        root.omi-native-token-draft);
                                }
                            }
                            NeothButton { label: "Refresh"; primary: false; clicked => { root.omi-refresh-clicked(); } }
                            NeothButton { label: "Probe local"; primary: false; clicked => { root.omi-probe-clicked(); } }
                            NeothButton { label: "Run retention"; primary: false; clicked => { root.omi-retention-clicked(); } }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            NeothLineEdit { placeholder-text: "SC-18 review note"; text <=> root.omi-review-note; horizontal-stretch: 1; }
                            NeothButton {
                                label: "Resume sanitizer";
                                primary: false;
                                enabled: root.omi-review-note != "";
                                clicked => { root.omi-resume-clicked(root.omi-review-note); }
                            }
                        }
                        NeothLineEdit { placeholder-text: "Conversation id for purge / allow-reimport"; text <=> root.omi-conversation-id; }
                        NeothCheckBox {
                            text: "Confirm permanent purge + anti-reimport tombstone";
                            checked <=> root.omi-purge-confirm;
                        }
                        NeothButton {
                            label: "Permanently purge conversation";
                            danger: true;
                            enabled: root.omi-purge-confirm && root.omi-conversation-id != "";
                            clicked => {
                                root.omi-purge-clicked(root.omi-conversation-id);
                                root.omi-purge-confirm = false;
                            }
                        }
                        NeothCheckBox {
                            text: "Confirm remote source may restore purged data";
                            checked <=> root.omi-reimport-confirm;
                        }
                        NeothButton {
                            label: "Allow re-import";
                            danger: true;
                            enabled: root.omi-reimport-confirm && root.omi-conversation-id != "";
                            clicked => {
                                root.omi-reimport-clicked(root.omi-conversation-id);
                                root.omi-reimport-confirm = false;
                            }
                        }
                    }
                }
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "Current autonomy";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        // True current level (source of truth — always reflects
                        // freedom.yaml, even when the combo below is mid-select).
                        Text {
                            text: root.autonomy-current;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                        }
                        // GUI-overhaul feature parity: pick the autonomy level
                        // directly (was a read-only label that said "switch via the
                        // CLI"). strict/standard/elevated/custom write freedom.yaml
                        // immediately via `neoth autonomy set <level>`. "full" is the
                        // guarded sudomode level — a plain `autonomy set full` is
                        // TTY-fail-closed, so selecting it routes to the two-step
                        // confirm below (which invokes the CLI with --gui-confirmed).
                        NeothComboBox {
                            model: ["strict", "standard", "elevated", "full", "custom"];
                            current-index: root.autonomy-current == "strict" ? 0
                                : root.autonomy-current == "standard" ? 1
                                : root.autonomy-current == "elevated" ? 2
                                : root.autonomy-current == "full" ? 3
                                : root.autonomy-current == "custom" ? 4
                                : 1;
                            selected(i) => {
                                if (i == 3) {
                                    root.full-auto-pending = true;
                                } else {
                                    root.autonomy-set-clicked(
                                        i == 0 ? "strict"
                                        : i == 1 ? "standard"
                                        : i == 2 ? "elevated"
                                        : "custom");
                                }
                            }
                        }
                        // GOLD-ADAPT-AOS-05 — WHY the current level behaves the
                        // way it does (agent-os "include reasoning" pattern):
                        // concrete gate consequences, not a name.
                        Text {
                            text: root.autonomy-current == "strict"
                                ? "Why: every action needs your explicit YES — no writes, no sends, no spends without a per-action consent prompt."
                                : root.autonomy-current == "standard"
                                ? "Why: routine reads + local writes run free; anything leaving the machine (messages, cloud calls, spends) still prompts you."
                                : root.autonomy-current == "elevated"
                                ? "Why: NEOTH acts first and reports after for most operations; only destructive or costly actions (deletes, payments, new channels) prompt."
                                : root.autonomy-current == "full"
                                ? "Why: sudomode — NEOTH self-directs including self-updates and spends inside your budget caps. Every action still lands in the WAL audit chain."
                                : "Why: custom — your per-capability matrix in freedom.yaml decides; capabilities not listed there fall back to standard prompting.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "strict / standard / elevated / custom apply immediately. \"full\" (sudomode) needs the confirm below. Writes freedom.yaml::autonomy + a WAL audit frame.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        // GOLD-FEAT-01c — full-auto (sudomode) toggle. Enabling is a
                        // deliberate two-step action (button → consequence + confirm);
                        // disabling is one click (the safe direction). The in-GUI
                        // confirm IS the consent, so the CLI is invoked with
                        // --gui-confirmed (the bare CLI path stays TTY-fail-closed).
                        if !root.full-auto-active && !root.full-auto-pending: NeothButton {
                            label: "Enable full-auto (sudomode)…";
                            primary: false;
                            clicked => {
                                root.full-auto-pending = true;
                            }
                        }
                        if root.full-auto-pending: Text {
                            text: "⚠ FULL-AUTO: NEOTH acts WITHOUT asking — shell commands, channel sends, file writes, and token spend happen automatically. (Self-replace · dangerous targets · unsigned plugins stay blocked.)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.accent-amber;
                            wrap: word-wrap;
                        }
                        if root.full-auto-pending: HorizontalLayout {
                            spacing: Theme.space-base;
                            NeothButton {
                                label: "Enable full-auto";
                                clicked => {
                                    root.full-auto-pending = false;
                                    root.full-auto-confirmed();
                                }
                            }
                            NeothButton {
                                label: "Cancel";
                                primary: false;
                                clicked => {
                                    root.full-auto-pending = false;
                                }
                            }
                        }
                        if root.full-auto-active: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: "● FULL-AUTO ACTIVE — NEOTH acts without asking.";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.accent-amber;
                                vertical-alignment: center;
                            }
                            NeothButton {
                                label: "Switch to gated";
                                primary: false;
                                clicked => {
                                    root.full-auto-gated();
                                }
                            }
                        }
                    }
                }
                // C2 — per-action permissions matrix. Shows the effective
                // decision for every guarded action (merged from the active
                // autonomy level + any custom overrides). Overrides require the
                // "custom" autonomy level; the header line reminds the operator.
                Expander {
                    title: "Per-action permissions";
                    hint: "custom overrides";
                    expanded: false;
                    // Header: active level label + override-level hint
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "active level: " + root.cfg-perm-level;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-2xs;
                            color: Theme.text-tertiary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "overrides require the custom level";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-2xs;
                            color: Theme.text-disabled;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    if root.cfg-perm-rows.length == 0: Text {
                        text: "(no permissions loaded — start the daemon)";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    for r in root.cfg-perm-rows: HorizontalLayout {
                        spacing: Theme.space-tight;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        // Action name (mono caption)
                        Text {
                            text: r.action;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        // 3-way segmented control — pill style matching ComplexitySeg
                        // grammar: active = accent-tint bg + border-accent;
                        // DENY active uses consent-pink tint.
                        HorizontalLayout {
                            spacing: 2px;
                            // ALLOW segment
                            Rectangle {
                                width: 54px;
                                height: 22px;
                                border-radius: 4px;
                                border-width: 1px;
                                background: r.decision == "allow"
                                    ? Theme.accent-green.with-alpha(0.12)
                                    : transparent;
                                border-color: r.decision == "allow"
                                    ? Theme.accent-green
                                    : Theme.border-subtle;
                                animate background { duration: Theme.duration-fast; easing: ease-out; }
                                TouchArea {
                                    clicked => { root.cfg-perm-set(r.action, "allow"); }
                                }
                                Text {
                                    text: "ALLOW";
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-2xs;
                                    font-weight: Theme.weight-medium;
                                    color: r.decision == "allow"
                                        ? Theme.accent-green
                                        : Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                            // CONFIRM segment
                            Rectangle {
                                width: 62px;
                                height: 22px;
                                border-radius: 4px;
                                border-width: 1px;
                                background: r.decision == "confirm"
                                    ? Theme.accent-amber.with-alpha(0.12)
                                    : transparent;
                                border-color: r.decision == "confirm"
                                    ? Theme.accent-amber
                                    : Theme.border-subtle;
                                animate background { duration: Theme.duration-fast; easing: ease-out; }
                                TouchArea {
                                    clicked => { root.cfg-perm-set(r.action, "confirm"); }
                                }
                                Text {
                                    text: "CONFIRM";
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-2xs;
                                    font-weight: Theme.weight-medium;
                                    color: r.decision == "confirm"
                                        ? Theme.accent-amber
                                        : Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                            // DENY segment — consent-pink tint when active
                            Rectangle {
                                width: 46px;
                                height: 22px;
                                border-radius: 4px;
                                border-width: 1px;
                                background: r.decision == "deny"
                                    ? Theme.accent-pink.with-alpha(0.12)
                                    : transparent;
                                border-color: r.decision == "deny"
                                    ? Theme.accent-pink
                                    : Theme.border-subtle;
                                animate background { duration: Theme.duration-fast; easing: ease-out; }
                                TouchArea {
                                    clicked => { root.cfg-perm-set(r.action, "deny"); }
                                }
                                Text {
                                    text: "DENY";
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-2xs;
                                    font-weight: Theme.weight-medium;
                                    color: r.decision == "deny"
                                        ? Theme.accent-pink
                                        : Theme.text-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                        }
                        // Clear glyph — visible only on overridden rows.
                        // Fires cfg-perm-clear to drop the override back to the
                        // active level default. Hover turns text consent-pink.
                        if r.overridden: Rectangle {
                            width: 20px;
                            height: 22px;
                            background: transparent;
                            perm-clear-ta := TouchArea {
                                clicked => { root.cfg-perm-clear(r.action); }
                            }
                            Text {
                                text: "✕";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-2xs;
                                color: perm-clear-ta.has-hover
                                    ? Theme.accent-pink
                                    : Theme.text-tertiary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }
                }

                // GOLD-PROG-08 — live token budget (council-path meter), polled
                // from ~/.neoth/usage_meter.json (daemon writes it every 10s).
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "LIVE TOKEN BUDGET";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        if !root.usage-available: Text {
                            text: "(start the daemon — live token usage appears once it runs)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.usage-available: Text {
                            text: root.usage-responses;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        if root.usage-available: Text {
                            text: root.usage-tokens;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        if root.usage-available: Text {
                            text: root.usage-note;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                // GR-10 — Safety Rails card: which restrictions are actively
                // engaged on the daemon (`neoth security safe-mode --json`).
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "SAFETY RAILS";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-medium;
                                letter-spacing: Theme.letter-spacing-tight;
                                color: Theme.accent-green;
                            }
                            Text {
                                text: root.rails-engaged-count + " / " + root.rails-total + " engaged";
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                        if root.safety-rails.length == 0: Text {
                            text: "(start the daemon to read live safe-mode rails)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        for rail in root.safety-rails: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: rail.engaged ? "engaged" : "open";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: rail.engaged ? Theme.accent-green : Theme.text-muted;
                            }
                            Text {
                                text: rail.name;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                            }
                            Text {
                                text: rail.detail;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // GR-03 — Trust card: autonomy posture, privacy switches,
                // recovery-key readiness, and the WAL trust-ledger size — the
                // single "what protects me + what I can prove" surface
                // (`neoth trust --output json`).
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "TRUST · POSTURE & PROOF";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        if root.trust-autonomy-level == "": Text {
                            text: "(start the daemon to read live trust posture)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.trust-autonomy-level != "": Text {
                            text: "autonomy: " + root.trust-autonomy-level + " — " + root.trust-autonomy-behavior;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                        for row in root.trust-privacy: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: "privacy";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                            Text {
                                text: row.label;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                        for row in root.trust-recovery: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: "recovery";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                            Text {
                                text: row.label;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: row.value == "present" ? Theme.accent-green : Theme.text-muted;
                            }
                        }
                        for row in root.trust-ledger: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: "ledger";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                            Text {
                                text: row.label;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
                // DES-09 Welle B — review gate
                Card {
                    shimmer: false;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "REVIEW GATE";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        NeothCheckBox {
                            text: "Review gate enabled (confirm before each council dispatch)";
                            checked: root.cfg-review-gate-enabled;
                            toggled(v) => {
                                root.cfg-review-gate-enabled = v;
                                root.cfg-review-gate-enabled-changed(v);
                            }
                        }
                    }
                }
                // DES-09 Welle B — cloud media toggles
                Card {
                    shimmer: false;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "CLOUD MEDIA";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        Text {
                            text: "⚠ Sends audio / images to your configured cloud provider.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.accent-amber;
                            wrap: word-wrap;
                        }
                        NeothCheckBox {
                            text: "Cloud speech-to-text (STT)";
                            checked: root.cfg-cloud-stt-enabled;
                            toggled(v) => {
                                root.cfg-cloud-stt-enabled = v;
                                root.cfg-cloud-stt-enabled-changed(v);
                            }
                        }
                        NeothCheckBox {
                            text: "Cloud text-to-speech (TTS)";
                            checked: root.cfg-cloud-tts-enabled;
                            toggled(v) => {
                                root.cfg-cloud-tts-enabled = v;
                                root.cfg-cloud-tts-enabled-changed(v);
                            }
                        }
                        NeothCheckBox {
                            text: "Cloud vision (image understanding)";
                            checked: root.cfg-cloud-vision-enabled;
                            toggled(v) => {
                                root.cfg-cloud-vision-enabled = v;
                                root.cfg-cloud-vision-enabled-changed(v);
                            }
                        }
                    }
                }
                // DES-09 Welle B — local media + proactive
                Card {
                    shimmer: false;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "LOCAL MEDIA & PROACTIVE";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        NeothCheckBox {
                            text: "Voice activity detection (VAD) — local mic trigger";
                            checked: root.cfg-vad-enabled;
                            toggled(v) => {
                                root.cfg-vad-enabled = v;
                                root.cfg-vad-enabled-changed(v);
                            }
                        }
                        NeothCheckBox {
                            text: "Dictation mode (auto-transcribe mic input)";
                            checked: root.cfg-dictation-enabled;
                            toggled(v) => {
                                root.cfg-dictation-enabled = v;
                                root.cfg-dictation-enabled-changed(v);
                            }
                        }
                        NeothCheckBox {
                            text: "Proactive messages only when idle (quieter)";
                            checked: root.cfg-proactive-idle-only;
                            toggled(v) => {
                                root.cfg-proactive-idle-only = v;
                                root.cfg-proactive-idle-only-changed(v);
                            }
                        }
                        // DES-09 G37 — proactive quiet hours (UTC). Wrap-around
                        // supported daemon-side ([22, 7] silences 22:00–06:59).
                        NeothCheckBox {
                            text: "Quiet hours — silence proactive delivery (UTC window)";
                            checked: root.cfg-quiet-hours-enabled;
                            toggled(v) => {
                                root.cfg-quiet-hours-enabled = v;
                                root.cfg-quiet-hours-changed(v, root.cfg-quiet-hours-start, root.cfg-quiet-hours-end);
                            }
                        }
                        if root.cfg-quiet-hours-enabled: HorizontalLayout {
                            spacing: Theme.space-tight;
                            padding-left: Theme.space-loose;
                            Text {
                                text: "from"; color: Theme.text-tertiary;
                                font-family: Theme.font-mono; font-size: Theme.font-size-xs;
                                vertical-alignment: center;
                            }
                            NeothLineEdit {
                                width: 72px;
                                text <=> root.cfg-quiet-hours-start;
                                placeholder-text: "22";
                                accepted(v) => {
                                    root.cfg-quiet-hours-changed(root.cfg-quiet-hours-enabled, v, root.cfg-quiet-hours-end);
                                }
                            }
                            Text {
                                text: "to"; color: Theme.text-tertiary;
                                font-family: Theme.font-mono; font-size: Theme.font-size-xs;
                                vertical-alignment: center;
                            }
                            NeothLineEdit {
                                width: 72px;
                                text <=> root.cfg-quiet-hours-end;
                                placeholder-text: "7";
                                accepted(v) => {
                                    root.cfg-quiet-hours-changed(root.cfg-quiet-hours-enabled, root.cfg-quiet-hours-start, v);
                                }
                            }
                            Text {
                                text: "hour 0–23 · UTC"; color: Theme.text-disabled;
                                font-family: Theme.font-mono; font-size: Theme.font-size-2xs;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Bite #5 (2026-05-23): cluster auto-discovery panel.
            // Mirrors the wizard's Q4-ratified cluster step so an
            // already-onboarded operator can flip mDNS announce
            // on/off without re-running the wizard or editing
            // freedom.yaml by hand. CLI parity: `neoth cluster
            // enable` / `disable`.
            if root.active == SettingsTab.cluster: VerticalBox {
                padding: Theme.space-base;
                spacing: Theme.space-base;
                PanelHeader {
                    title: "Cluster";
                    subtitle: "Pair NEOTH nodes through authenticated discovery and replicated cluster state. Transport, bootstrap peers and LAN privacy policy are applied as one validated configuration.";
                    mirrors-slash: "neoth cluster configure   |   neoth cluster status   |   neoth cluster discover";
                }
                // C6 — one complete desired-state transaction. Controls edit
                // local drafts; only Apply crosses the typed CLI boundary.
                Card {
                    shimmer: false;
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "TRANSPORT";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        NeothCheckBox {
                            text: "Cluster transport enabled (DHT stays inert while off)";
                            checked: root.cfg-cluster-enabled;
                            toggled(v) => {
                                root.cfg-cluster-enabled = v;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            Text {
                                text: "Cluster name"; color: Theme.text-secondary;
                                font-family: Theme.font-sans; font-size: Theme.font-size-sm;
                                vertical-alignment: center; width: 130px;
                            }
                            NeothLineEdit {
                                placeholder-text: "e.g. home-lab (empty = no identity)";
                                text: root.cfg-cluster-name;
                                horizontal-stretch: 1;
                                edited(t) => {
                                    root.cfg-cluster-name = t;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            Text {
                                text: "Carrier"; color: Theme.text-secondary;
                                font-family: Theme.font-sans; font-size: Theme.font-size-sm;
                                vertical-alignment: center; width: 130px;
                            }
                            NeothComboBox {
                                model: ["peeroxide", "iroh"];
                                current-index: root.cfg-cluster-transport-idx;
                                width: 200px;
                                selected(i) => {
                                    root.cfg-cluster-transport-idx = i;
                                }
                            }
                            Text {
                                text: "Both carriers ship in the desktop release";
                                color: Theme.text-disabled;
                                font-family: Theme.font-mono; font-size: Theme.font-size-2xs;
                                vertical-alignment: center;
                            }
                        }
                        NeothCheckBox {
                            text: "Announce on untrusted Wi-Fi (mDNS privacy gate)";
                            checked: root.cfg-cluster-announce-untrusted;
                            toggled(v) => {
                                root.cfg-cluster-announce-untrusted = v;
                            }
                        }
                        NeothCheckBox {
                            text: "Replicate raw channel messages (privacy-sensitive)";
                            checked: root.cfg-cluster-replicate-raw-ingress;
                            toggled(v) => {
                                root.cfg-cluster-replicate-raw-ingress = v;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            Text {
                                text: "Replay window";
                                color: Theme.text-secondary;
                                font-family: Theme.font-sans;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                width: 130px;
                            }
                            NeothLineEdit {
                                placeholder-text: "30";
                                text <=> root.cfg-cluster-replay-days-text;
                                width: 100px;
                            }
                            Text {
                                text: "days (live-reloadable; raw sync stays off by default)";
                                color: Theme.text-disabled;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-2xs;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "BOOTSTRAP PEERS — one endpoint id per line; commas and spaces are preserved.";
                                color: Theme.text-secondary;
                                font-family: Theme.font-sans;
                                font-size: Theme.font-size-sm;
                            }
                            TextEdit {
                                text <=> root.cfg-cluster-peers;
                                height: 72px;
                                horizontal-stretch: 1;
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "TRUSTED SSIDS — one exact wifi name per line; case and spaces are preserved.";
                                color: Theme.text-secondary;
                                font-family: Theme.font-sans;
                                font-size: Theme.font-size-sm;
                            }
                            TextEdit {
                                text <=> root.cfg-cluster-ssids;
                                height: 72px;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            Text {
                                text: "Listen port";
                                color: Theme.text-secondary;
                                font-family: Theme.font-sans;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                width: 130px;
                            }
                            NeothLineEdit {
                                placeholder-text: "49737";
                                text <=> root.cfg-cluster-listen-port-text;
                                width: 180px;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            Text {
                                text: "Shared secret";
                                color: Theme.text-secondary;
                                font-family: Theme.font-sans;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                width: 130px;
                            }
                            NeothLineEdit {
                                placeholder-text: root.cfg-cluster-passphrase-set
                                    ? "Already set — leave blank to keep it"
                                    : "Required before enabling the cluster";
                                password: true;
                                text <=> root.cfg-cluster-passphrase;
                                horizontal-stretch: 1;
                            }
                        }
                        Text {
                            text: root.cfg-cluster-passphrase-set
                                ? "Secret status: configured. Existing secret values are never read back into the GUI."
                                : "Secret status: not configured. Enter one above before enabling.";
                            color: root.cfg-cluster-passphrase-set ? Theme.accent-green : Theme.accent-amber;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            NeothButton {
                                label: "Apply cluster settings";
                                primary: true;
                                loading: root.cfg-cluster-apply-in-flight;
                                enabled: !root.cfg-cluster-apply-in-flight;
                                clicked => {
                                    root.cfg-cluster-apply-clicked(
                                        root.cfg-cluster-enabled,
                                        root.cfg-cluster-name,
                                        root.cfg-cluster-transport-idx,
                                        root.cfg-cluster-peers,
                                        root.cluster-mdns-enabled,
                                        root.cfg-cluster-announce-untrusted,
                                        root.cfg-cluster-ssids,
                                        root.cfg-cluster-replicate-raw-ingress,
                                        root.cfg-cluster-replay-days-text,
                                        root.cfg-cluster-listen-port-text,
                                        root.cfg-cluster-passphrase,
                                    );
                                }
                            }
                            Text {
                                text: root.cfg-cluster-apply-status;
                                color: Theme.text-muted;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
                // SL-03 — Local resources card: CPU / memory / accelerator /
                // VRAM / disk + cached local models (`neoth hardware --output
                // json`). Read-only; the operator sees node capacity at a glance.
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "LOCAL RESOURCES";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        if root.hw-cpu == "": Text {
                            text: "(start the daemon to read local hardware)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.hw-cpu != "": Text {
                            text: "cpu:  " + root.hw-cpu;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                        if root.hw-cpu != "": Text {
                            text: "mem:  " + root.hw-memory;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        if root.hw-cpu != "": Text {
                            text: "accel: " + root.hw-accelerator;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        if root.hw-cpu != "": Text {
                            text: "vram: " + root.hw-vram;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        // GOLD-PROG-07 — live VRAM utilisation meter. Shown only
                        // when a GPU is present (fraction > 0). GOLD-ADAPT-GUI-03:
                        // stepped SegBar (12 segments) instead of a continuous pill.
                        if root.hw-vram-fraction > 0.0: SegBar {
                            height: 8px;
                            segments: 12;
                            fraction: root.hw-vram-fraction;
                            fill: Theme.accent-green;
                        }
                        // GUI-HARDWARE-RESOURCES-01 — compact load readout (CPU/GPU/temp/power).
                        if root.hw-load-readout != "": Text {
                            text: "load: " + root.hw-load-readout;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                        if root.hw-cpu != "": Text {
                            text: "disk: " + root.hw-disk;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        for row in root.hw-models: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: "model";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                            Text {
                                text: row.label;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: row.value == "cached" ? Theme.accent-green : Theme.text-muted;
                            }
                        }
                    }
                }
                // GOLD-PROG-05 (SL-02) — cluster peer topology. Confirmed peers
                // from `neoth cluster topology --output json`; live RTT/stability
                // populate only while the daemon runs. Empty until a peer pairs.
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "CLUSTER PEERS";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        if root.cluster-peers.length == 0: Text {
                            text: "No confirmed peers — run `neoth cluster discover`, then `neoth cluster confirm <pub_key>`.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        for peer in root.cluster-peers: VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: Theme.space-base;
                                Text {
                                    text: peer.label;
                                    overflow: elide;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-caption;
                                    color: Theme.text-primary;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: peer.status;
                                    overflow: elide;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-caption;
                                    color: peer.status == "recent" ? Theme.accent-green : (peer.status == "stale" ? Theme.accent-amber : Theme.text-muted);
                                }
                            }
                            Text {
                                text: peer.addr + "  ·  rtt " + peer.rtt-ms + "  ·  " + peer.stability + " stable  ·  " + peer.last-seen;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "mDNS ANNOUNCE";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.accent-green;
                        }
                        NeothCheckBox {
                            text: "Auto-discover other NEOTH instances on this network";
                            checked: root.cluster-mdns-enabled;
                            toggled(checked) => {
                                root.cluster-mdns-enabled = checked;
                            }
                        }
                        Text {
                            text: "On a home or office LAN this is safe; on a shared or public network it reveals your instance label and public key to other devices on the subnet. Disable if you only ever run one NEOTH instance.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "LISTEN PORT";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.accent-green;
                        }
                        Text {
                            text: root.cluster-listen-port + "  (default 49737)";
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "Change the shared port in the Transport card above, then Apply once. The mDNS announcer and Tailscale TCP probe use the same value.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                Card {
                    shimmer: false;  // design-taste B8: 20 cards on one dense surface = gradient noise
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "TRUSTED SSIDS";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.accent-green;
                        }
                        Text {
                            text: root.cluster-trusted-ssids-summary != ""
                                ? root.cluster-trusted-ssids-summary
                                : "(no trusted SSIDs set — announcer stays silent on every wifi)";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: root.cluster-trusted-ssids-summary != ""
                                ? Theme.text-primary
                                : Theme.text-dim;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Edit the exact-name list in the Transport card above, then Apply. The discover command surfaces the active policy verdict before scanning.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.active == SettingsTab.code-sessions: VerticalBox {
                padding: Theme.space-base;
                spacing: Theme.space-base;
                PanelHeader {
                    title: "Code Sessions";
                    subtitle: "Hermes-style autonomous coding workflow. Decompose a prompt with Cerebellum, dispatch tasks to Left (fast) + Right (deep) hemispheres, watch the kanban board fill.";
                    mirrors-slash: "/code <prompt>   |   neoth kanban {list,show,task,add,move,assign,comment,archive,watch,review}";
                }

                // GOLD-ADAPT-AOS-06 — spec-shape entry (agent-os shape-spec):
                // guided 3-field "New Spec" that seeds the board via
                // `neoth kanban add` (collapsed by default — the board is
                // the primary surface).
                Expander {
                    title: "NEW SPEC";
                    hint: "shape a task before work starts";
                    expanded: false;
                    NeothLineEdit {
                        text <=> root.spec-title;
                        placeholder-text: "What — one-line task title";
                    }
                    NeothLineEdit {
                        text <=> root.spec-goal;
                        placeholder-text: "Why — the goal / problem this solves";
                    }
                    NeothLineEdit {
                        text <=> root.spec-acceptance;
                        placeholder-text: "Done when — acceptance criteria";
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-base;
                        NeothButton {
                            label: "Create task";
                            size: "sm";
                            enabled: root.spec-title != "";
                            clicked => {
                                root.spec-create-clicked(root.spec-title, root.spec-goal, root.spec-acceptance);
                                root.spec-title = "";
                                root.spec-goal = "";
                                root.spec-acceptance = "";
                            }
                        }
                        Text {
                            text: "Lands in Backlog; the dispatcher picks it up like any decomposed task.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-2xs;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                // HO-02: no-Cerebellum fallback banner. Without a bound
                // Cerebellum the decompose step can't run, so `neoth code`
                // silently produces nothing — surface the fix loudly.
                if !root.cerebellum-bound: Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.accent-pink;
                    height: txt.preferred-height + 2 * Theme.space-base;
                    txt := Text {
                        x: Theme.space-base;
                        width: parent.width - 2 * Theme.space-base;
                        text: "⚠  No Cerebellum bound — run wizard step 5d (`neoth hemispheres set --role cerebellum --provider <p>`) to enable autonomous decomposition. `neoth code` can't decompose prompts until then.";
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.accent-pink;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                // Session selector + summary + refresh. Empty
                // `kanban-session-summary` means no `neoth code` run yet.
                HorizontalLayout {
                    alignment: space-between;
                    spacing: Theme.space-base;
                    // A3 — pick any session, not just the latest.
                    if root.kanban-sessions.length > 1: NeothComboBox {
                        width: 300px;
                        model: root.kanban-sessions;
                        current-index: root.kanban-session-idx;
                        selected(i) => { root.kanban-session-selected(i); }
                    }
                    Text {
                        text: root.kanban-session-summary != ""
                            ? root.kanban-session-summary
                            : "No active session. Run `neoth code \"...\"` in your terminal, then refresh.";
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: root.kanban-session-summary != "" ? Theme.text-primary : Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    NeothButton {
                        label: "Refresh";
                        primary: false;
                        clicked => { root.kanban-refresh-clicked(); }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-loose;

                    // ── Board (5 columns) ────────────────────────────
                    VerticalLayout {
                        spacing: Theme.space-base;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            alignment: stretch;

                            KanbanColumn {
                                label: "BACKLOG";
                                accent: Theme.text-muted;
                                horizontal-stretch: 1;
                                tasks: root.kanban-backlog;
                                selected-task-id: root.kanban-selected-task-id;
                                task-clicked(id) => { root.kanban-task-selected(id); }
                                task-context(id, x, y) => { root.kanban-task-context(id, x, y); }
                            }
                            KanbanColumn {
                                label: "TODO";
                                accent: Theme.text-primary;
                                horizontal-stretch: 1;
                                tasks: root.kanban-todo;
                                selected-task-id: root.kanban-selected-task-id;
                                task-clicked(id) => { root.kanban-task-selected(id); }
                                task-context(id, x, y) => { root.kanban-task-context(id, x, y); }
                            }
                            KanbanColumn {
                                label: "IN PROGRESS";
                                // GU-02: amber = active/attention, distinct from the
                                // green "done/safe" + the blue/green backlog columns.
                                accent: Theme.accent-amber;
                                horizontal-stretch: 1;
                                wip-limit: 3;   // dispatcher concurrency default
                                tasks: root.kanban-in-progress;
                                selected-task-id: root.kanban-selected-task-id;
                                task-clicked(id) => { root.kanban-task-selected(id); }
                                task-context(id, x, y) => { root.kanban-task-context(id, x, y); }
                            }
                            KanbanColumn {
                                label: "REVIEW";
                                accent: Theme.accent-pink;
                                horizontal-stretch: 1;
                                wip-limit: 5;   // review queue soft cap
                                tasks: root.kanban-review;
                                selected-task-id: root.kanban-selected-task-id;
                                task-clicked(id) => { root.kanban-task-selected(id); }
                                task-context(id, x, y) => { root.kanban-task-context(id, x, y); }
                            }
                            KanbanColumn {
                                label: "DONE";
                                accent: Theme.accent-green;
                                horizontal-stretch: 1;
                                tasks: root.kanban-done;
                                selected-task-id: root.kanban-selected-task-id;
                                task-clicked(id) => { root.kanban-task-selected(id); }
                                task-context(id, x, y) => { root.kanban-task-context(id, x, y); }
                            }
                        }
                    }

                    // ── Activity feed (right rail) ───────────────────
                    // G-22 fix: width shrinks proportionally on narrow
                    // windows so the 5-column board keeps breathing
                    // room instead of being eaten by a fixed-320 rail.
                    Rectangle {
                        width: min(320px, parent.width * 0.28);
                        background: Theme.bg-card;
                        border-radius: Theme.radius-card;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: Theme.space-base;
                            spacing: Theme.space-tight;

                            Text {
                                text: "ACTIVITY";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: Theme.letter-spacing-extra-wide;
                                color: Theme.accent-green;
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.border-subtle;
                            }
                            if root.kanban-feed.length == 0: Text {
                                text: "No activity yet.";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-dim;
                            }
                            for entry[i] in root.kanban-feed: ActivityFeedEntry {
                                ts: entry.ts;
                                actor: entry.actor;
                                message: entry.message;
                            }
                        }
                    }
                }

                // Step 5 (2026-05-20): detail pane appears under the
                // board when a task card is clicked. Mirrors
                // `neoth kanban task <id>` content: title + status +
                // hemisphere + (optional) description. "Close detail"
                // button clears the selection.
                if root.kanban-selected-task-id != "": Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;

                        HorizontalLayout {
                            alignment: space-between;
                            spacing: Theme.space-base;
                            Text {
                                text: root.kanban-selected-task-id + "  " + root.kanban-selected-title;
                                overflow: elide;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-h2;
                                font-weight: Theme.weight-light;
                                color: Theme.text-primary;
                            }
                            NeothButton {
                                label: "Close detail";
                                primary: false;
                                clicked => {
                                    root.kanban-selected-task-id = "";
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-loose;
                            Text {
                                text: "Status: " + root.kanban-selected-status;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.accent-green;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Hemisphere: " + root.kanban-selected-hemisphere;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: root.kanban-selected-hemisphere == "right"
                                    ? Theme.accent-pink
                                    : (root.kanban-selected-hemisphere == "cerebellum"
                                        ? Theme.accent-green
                                        : Theme.text-muted);
                                vertical-alignment: center;
                            }
                        }

                        if root.kanban-selected-description != "": Text {
                            text: root.kanban-selected-description;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-body;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }

                        // Comments thread (2026-05-20): when the
                        // operator clicks a task card the Rust side
                        // fetches `kanban task <id> --output json`
                        // and populates kanban-selected-comments.
                        // Empty list renders nothing — the next
                        // separator line gives the action row a clean
                        // top edge regardless.
                        if root.kanban-selected-comments.length > 0: Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                        if root.kanban-selected-comments.length > 0: Text {
                            text: "COMMENTS (" + root.kanban-selected-comments.length + ")";
                            overflow: elide;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.text-dim;
                        }
                        for c[i] in root.kanban-selected-comments: HorizontalLayout {
                            spacing: Theme.space-tight;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            Text {
                                text: c.ts;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-dim;
                                width: 48px;
                            }
                            Text {
                                text: c.author;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: Theme.letter-spacing-tight;
                                color: c.author == "operator"
                                    ? Theme.accent-pink
                                    : (c.author == "cerebellum"
                                        ? Theme.accent-green
                                        : Theme.text-muted);
                                width: 84px;
                            }
                            Text {
                                text: c.body;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                wrap: word-wrap;
                            }
                        }

                        // Step 6 (2026-05-20): operator action row.
                        // Move + Promote subprocess into the daemon CLI;
                        // the 2s live-tail picks up the resulting
                        // status change automatically.
                        Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            alignment: start;
                            NeothButton {
                                label: "→ Backlog";
                                primary: false;
                                clicked => {
                                    root.kanban-task-move(root.kanban-selected-task-id, "backlog");
                                }
                            }
                            NeothButton {
                                label: "→ Todo";
                                primary: false;
                                clicked => {
                                    root.kanban-task-move(root.kanban-selected-task-id, "todo");
                                }
                            }
                            NeothButton {
                                label: "→ In Progress";
                                primary: false;
                                clicked => {
                                    root.kanban-task-move(root.kanban-selected-task-id, "in_progress");
                                }
                            }
                            NeothButton {
                                label: "→ Review";
                                primary: false;
                                clicked => {
                                    root.kanban-task-move(root.kanban-selected-task-id, "review");
                                }
                            }
                            NeothButton {
                                label: "→ Done";
                                primary: false;
                                clicked => {
                                    root.kanban-task-move(root.kanban-selected-task-id, "done");
                                }
                            }
                        }
                        if root.kanban-selected-status == "review": HorizontalLayout {
                            alignment: end;
                            NeothButton {
                                label: "✓ Promote REVIEW → DONE";
                                primary: true;
                                clicked => {
                                    root.kanban-task-promote(root.kanban-selected-task-id);
                                }
                            }
                        }

                        // v0.2 complete (2026-05-20): assign-row.
                        // Reroute a task to a different hemisphere when
                        // the heuristic / second-opinion classifier
                        // mis-routed it. Four buttons mirror the four
                        // wire-form variants; pressing one fires the
                        // subprocess + the 2s live-tail picks up the
                        // hemisphere change.
                        Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            alignment: start;
                            Text {
                                text: "Assign to:";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                            NeothButton {
                                label: "Left";
                                primary: false;
                                clicked => {
                                    root.kanban-task-assign(root.kanban-selected-task-id, "left");
                                }
                            }
                            NeothButton {
                                label: "Right";
                                primary: false;
                                clicked => {
                                    root.kanban-task-assign(root.kanban-selected-task-id, "right");
                                }
                            }
                            NeothButton {
                                label: "Cerebellum";
                                primary: false;
                                clicked => {
                                    root.kanban-task-assign(root.kanban-selected-task-id, "cerebellum");
                                }
                            }
                            NeothButton {
                                label: "Unassigned";
                                primary: false;
                                clicked => {
                                    root.kanban-task-assign(root.kanban-selected-task-id, "unassigned");
                                }
                            }
                        }

                        // GAP-03: Finish task — marks the selected task
                        // done via `neoth kanban finish <id>`.
                        Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            alignment: end;
                            NeothButton {
                                label: "✓ Finish Task";
                                primary: true;
                                clicked => {
                                    root.kanban-task-finish(root.kanban-selected-task-id);
                                }
                            }
                        }

                        // v0.2 complete: comment composer. Slint's
                        // `LineEdit` carries the draft; pressing Enter
                        // OR clicking "Add" fires the callback + clears
                        // the input so the operator can append again.
                        Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            alignment: stretch;
                            comment_input := NeothLineEdit {
                                placeholder-text: "Add a comment to this task — press Enter or click Add";
                                horizontal-stretch: 1;
                                accepted(text) => {
                                    if (text != "") {
                                        root.kanban-task-comment(root.kanban-selected-task-id, text);
                                        self.text = "";
                                    }
                                }
                            }
                            NeothButton {
                                label: "Add";
                                primary: false;
                                clicked => {
                                    if (comment_input.text != "") {
                                        root.kanban-task-comment(
                                            root.kanban-selected-task-id,
                                            comment_input.text,
                                        );
                                        comment_input.text = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // G-12 fix: Config tab now exposes an in-place provider
            // selector instead of asking the operator to "edit
            // freedom.yaml with your editor of choice" — that would
            // break the noob-operator contract. Change fires the
            // `provider-changed` callback; Rust mutates freedom.yaml
            // + drops the reload sentinel automatically.
            if root.active == SettingsTab.config: VerticalBox {
                padding: Theme.space-base;
                spacing: Theme.space-base;
                PanelHeader {
                    title: "Config";
                    subtitle: "Change the LLM provider, force a config reload, or restart the setup wizard. Every choice writes back to ~/.neoth/freedom.yaml — no manual YAML editing required.";
                    mirrors-slash: "/config   |   /wizard   |   /reload";
                }

                // GOLD-ADAPT-AOS-04 — the Config surface is grouped into
                // collapsible domain sections (agent-os standards layout):
                // PROVIDER · PRESETS · COUNCIL · MAINTENANCE below; Channels
                // and Autonomy keep their own tabs (duplicating them here
                // would be a second write path to the same yaml keys).

                // ── PROVIDER ─────────────────────────────────────────
                Expander {
                    title: "PROVIDER";
                    hint: root.provider-current;
                    NeothComboBox {
                        // GUI-improve — the LIVE implemented-provider list
                        // (Rust sets provider-ids from `neoth provider list`),
                        // not a hardcoded subset that silently dropped new
                        // providers (anthropic_api / codex / antigravity / …)
                        // and forced an unknown provider to row 0 = claude_cli.
                        model: root.provider-ids;
                        current-index: root.provider-current-index;
                        selected(i) => {
                            if (i >= 0 && i < root.provider-ids.length) {
                                root.provider-current-index = i;
                                root.provider-current = root.provider-ids[i];
                                root.provider-changed(root.provider-ids[i]);
                            }
                        }
                    }
                    Text {
                        text: "Click Reload config (Maintenance below) after any provider change so the daemon picks it up within ~2 seconds.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }

                // ── PRESETS (AOS-02 — surfaces config/presets.rs here) ──
                // ── PRESETS (AOS-02 — builtin + operator sections) ───────
                // Rust injects two sentinel header rows (is-header=true):
                //   name="BUILT-IN" before the four built-ins,
                //   name="YOURS"    before operator presets (omitted when none).
                // This is the same flat-row pattern as the Skills expander.
                Expander {
                    title: "PRESETS";
                    hint: "saved config bundles";

                    // Empty state (daemon not running or no presets yet).
                    if root.preset-list.length == 0: Text {
                        text: root.preset-summary != "" ? root.preset-summary : "(no presets — `neoth preset save <name>`)";
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }

                    // ── Consent panel (inline flat layout — no popup) ─────────
                    // Shown when Rust sets consent-visible=true after dry-run.
                    if root.consent-visible: Text {
                        text: "Apply " + root.consent-preset-name + " — review changes:";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    if root.consent-visible && root.consent-warn-text != "": Text {
                        text: root.consent-warn-text;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.accent-amber;
                        wrap: word-wrap;
                    }
                    if root.consent-visible && root.consent-needs-fullauto: Text {
                        text: "Full autonomy: NEOTH acts without asking (audited)";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.accent-pink;
                        wrap: word-wrap;
                    }
                    if root.consent-visible: HorizontalLayout {
                        spacing: Theme.space-tight;
                        NeothButton {
                            label: "Apply";
                            size: "sm";
                            clicked => { root.preset-consent-confirmed(); }
                        }
                        NeothButton {
                            label: "Cancel";
                            size: "sm";
                            primary: false;
                            clicked => { root.preset-consent-cancelled(); }
                        }
                    }

                    // ── Flat preset rows (header sentinels + data rows) ───────
                    for p in root.preset-list: VerticalLayout {
                        spacing: 2px;
                        // Section header sentinel row (is-header=true injected by Rust).
                        if p.is-header: Text {
                            text: p.name;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.text-muted;
                        }
                        // Data row.
                        if !p.is-header: HorizontalLayout {
                            spacing: Theme.space-tight;
                            // Active marker.
                            Text {
                                text: p.active ? "●" : "○";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: p.active ? Theme.accent-green : Theme.text-muted;
                                vertical-alignment: center;
                            }
                            // Name + optional description.
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: p.name;
                                    overflow: elide;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-caption;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                                if p.description != "": Text {
                                    text: p.description;
                                    font-family: Theme.font-display;
                                    font-size: Theme.font-size-caption;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                            // Apply button for every data row.
                            NeothButton {
                                label: "Apply";
                                size: "sm";
                                clicked => { root.preset-apply-named-clicked(p.name); }
                            }
                            // Delete only for non-builtin operator presets.
                            if !p.builtin: NeothButton {
                                label: "Delete";
                                size: "sm";
                                primary: false;
                                clicked => { root.preset-delete-clicked(p.name); }
                            }
                        }
                    }

                    // Legacy "Apply active preset" (activate + apply path).
                    if root.preset-list.length > 0: NeothButton {
                        label: "Apply active preset";
                        size: "sm";
                        clicked => { root.preset-apply-clicked(); }
                    }
                }

                // ── COUNCIL ──────────────────────────────────────────
                // KF-08 — Council budget meter: the per-message council call cap
                // + the last debate's live usage (`neoth council budget --json`).
                Expander {
                    title: "COUNCIL";
                    hint: root.council-cap != "" ? "cap " + root.council-cap : "";
                        if root.council-cap == "": Text {
                            text: "(start the daemon to read the council budget)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.council-cap != "": Text {
                            text: "cap:   " + root.council-cap;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        if root.council-cap != "": Text {
                            text: "daily: " + root.council-daily-usd;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        // GOLD-HON-13 — 3^depth cost warning (depth > 1).
                        if root.council-depth-warning != "": Text {
                            text: root.council-depth-warning;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.accent-amber;
                            wrap: word-wrap;
                        }
                        if root.council-cap != "" && root.council-last-debate.length == 0: Text {
                            text: "(no council debate has run yet)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                        }
                        for row in root.council-last-debate: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: row.label;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                        // DES-09 Welle A — editable council fields
                        Rectangle { height: Theme.space-base; }
                        Text {
                            text: "EDIT COUNCIL LIMITS";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            alignment: center;
                            Text {
                                text: "daily USD cap";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                width: 160px;
                            }
                            NeothLineEdit {
                                placeholder-text: "e.g. 5.0";
                                text: root.cfg-council-daily-usd;
                                horizontal-stretch: 1;
                                edited(t) => {
                                    root.cfg-council-daily-usd = t;
                                    root.cfg-council-daily-usd-changed(t);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            alignment: center;
                            Text {
                                text: "max calls / message";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                width: 160px;
                            }
                            NeothLineEdit {
                                placeholder-text: "e.g. 4";
                                text: root.cfg-council-max-calls;
                                horizontal-stretch: 1;
                                edited(t) => {
                                    root.cfg-council-max-calls = t;
                                    root.cfg-council-max-calls-changed(t);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            alignment: center;
                            Text {
                                text: "max recursion depth (1-4)";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                width: 160px;
                            }
                            NeothLineEdit {
                                placeholder-text: "1..4";
                                text: root.cfg-council-max-depth;
                                horizontal-stretch: 1;
                                edited(t) => {
                                    root.cfg-council-max-depth = t;
                                    root.cfg-council-max-depth-changed(t);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            alignment: center;
                            Text {
                                text: "selection mode";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                width: 160px;
                            }
                            NeothComboBox {
                                model: ["legacy_majority", "consensus_or_best", "best_always"];  // FIX 5
                                current-index: root.cfg-council-selection-mode-idx;
                                horizontal-stretch: 1;
                                selected(idx) => {
                                    root.cfg-council-selection-mode-idx = idx;
                                    root.cfg-council-selection-mode-changed(idx);
                                }
                            }
                        }
                }

                // ── PROVIDER DETAILS (DES-09 Welle A) ────────────────
                Expander {
                    title: "PROVIDER DETAILS";
                    hint: "model · endpoint · region";
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        alignment: center;
                        Text {
                            text: "model";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            width: 140px;
                        }
                        NeothLineEdit {
                            placeholder-text: "e.g. claude-opus-4-5";
                            text: root.cfg-provider-model;
                            horizontal-stretch: 1;
                            edited(t) => {
                                root.cfg-provider-model = t;
                                root.cfg-provider-model-changed(t);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        alignment: center;
                        Text {
                            text: "endpoint";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            width: 140px;
                        }
                        NeothLineEdit {
                            placeholder-text: "https://api.anthropic.com";
                            text: root.cfg-provider-endpoint;
                            horizontal-stretch: 1;
                            edited(t) => {
                                root.cfg-provider-endpoint = t;
                                root.cfg-provider-endpoint-changed(t);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        alignment: center;
                        Text {
                            text: "region";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            width: 140px;
                        }
                        NeothLineEdit {
                            placeholder-text: "e.g. us-east-1";
                            text: root.cfg-provider-region;
                            horizontal-stretch: 1;
                            edited(t) => {
                                root.cfg-provider-region = t;
                                root.cfg-provider-region-changed(t);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        alignment: center;
                        Text {
                            text: "api-version";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            width: 140px;
                        }
                        NeothLineEdit {
                            placeholder-text: "e.g. 2024-01-01";
                            text: root.cfg-provider-api-version;
                            horizontal-stretch: 1;
                            edited(t) => {
                                root.cfg-provider-api-version = t;
                                root.cfg-provider-api-version-changed(t);
                            }
                        }
                    }
                }

                // ── PROFILE + BEHAVIOR (DES-09 Welle A) ──────────────
                Expander {
                    title: "PROFILE & BEHAVIOR";
                    hint: "persona · timezone · elicitation";
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        alignment: center;
                        Text {
                            text: "persona mode";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            width: 160px;
                        }
                        NeothComboBox {
                            model: ["(none)", "loyal_buddy"];
                            current-index: root.cfg-persona-mode-idx;
                            horizontal-stretch: 1;
                            selected(idx) => {
                                root.cfg-persona-mode-idx = idx;
                                root.cfg-persona-mode-changed(idx);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        alignment: center;
                        Text {
                            text: "timezone";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            width: 160px;
                        }
                        NeothLineEdit {
                            placeholder-text: "e.g. Europe/Berlin";
                            text: root.cfg-user-tz;
                            horizontal-stretch: 1;
                            edited(t) => {
                                root.cfg-user-tz = t;
                                root.cfg-user-tz-changed(t);
                            }
                        }
                    }
                    // C3 — operator identity (operator_id, language, role).
                    HorizontalLayout {
                        spacing: Theme.space-tight;
                        Text {
                            text: "Operator id"; color: Theme.text-secondary;
                            font-family: Theme.font-sans; font-size: Theme.font-size-sm;
                            vertical-alignment: center; width: 130px;
                        }
                        NeothLineEdit {
                            placeholder-text: "how NEOTH addresses you";
                            text: root.cfg-operator-id;
                            horizontal-stretch: 1;
                            edited(t) => {
                                root.cfg-operator-id = t;
                                root.cfg-operator-id-changed(t);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-tight;
                        Text {
                            text: "Language"; color: Theme.text-secondary;
                            font-family: Theme.font-sans; font-size: Theme.font-size-sm;
                            vertical-alignment: center; width: 130px;
                        }
                        NeothLineEdit {
                            placeholder-text: "e.g. Deutsch";
                            text: root.cfg-language-primary;
                            horizontal-stretch: 1;
                            edited(t) => {
                                root.cfg-language-primary = t;
                                root.cfg-language-primary-changed(t);
                            }
                        }
                        NeothLineEdit {
                            placeholder-text: "code, e.g. de";
                            text: root.cfg-language-code;
                            width: 110px;
                            edited(t) => {
                                root.cfg-language-code = t;
                                root.cfg-language-code-changed(t);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-tight;
                        Text {
                            text: "Role"; color: Theme.text-secondary;
                            font-family: Theme.font-sans; font-size: Theme.font-size-sm;
                            vertical-alignment: center; width: 130px;
                        }
                        NeothComboBox {
                            model: ["developer", "security-researcher", "founder", "data-scientist", "writer", "none"];
                            current-index: root.cfg-role-idx;
                            horizontal-stretch: 1;
                            selected(i) => {
                                root.cfg-role-idx = i;
                                root.cfg-role-changed(i);
                            }
                        }
                        NeothLineEdit {
                            placeholder-text: "custom role (optional)";
                            text: root.cfg-role-custom;
                            horizontal-stretch: 1;
                            edited(t) => {
                                root.cfg-role-custom = t;
                                root.cfg-role-custom-changed(t);
                            }
                        }
                    }
                    NeothCheckBox {
                        text: "Elicitation (daemon asks clarifying questions)";
                        checked: root.cfg-elicitation-enabled;
                        toggled(v) => {
                            root.cfg-elicitation-enabled = v;
                            root.cfg-elicitation-enabled-changed(v);
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        alignment: center;
                        Text {
                            text: "min intensity";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                            width: 160px;
                        }
                        NeothComboBox {
                            model: ["low", "medium", "high", "urgent"];
                            current-index: root.cfg-elicitation-min-intensity-idx;
                            horizontal-stretch: 1;
                            selected(idx) => {
                                root.cfg-elicitation-min-intensity-idx = idx;
                                root.cfg-elicitation-min-intensity-changed(idx);
                            }
                        }
                    }
                    NeothCheckBox {
                        text: "Tone modifier (adaptive response style)";
                        checked: root.cfg-tone-modifier-enabled;
                        toggled(v) => {
                            root.cfg-tone-modifier-enabled = v;
                            root.cfg-tone-modifier-enabled-changed(v);
                        }
                    }
                }

                // ── MAINTENANCE ──────────────────────────────────────
                Expander {
                    title: "MAINTENANCE";
                    hint: "reload · wizard · backup";
                    Text {
                        text: "Reload pushes freedom.yaml changes to the running daemon within ~2s (the ~/.neoth/.reload-requested sentinel). Re-run wizard restarts first-run setup without wiping your config.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        NeothButton {
                            label: "Reload config";
                            clicked => { root.reload-config-clicked(); }
                        }
                        NeothButton {
                            label: "Open CLI";
                            primary: false;
                            clicked => { root.open-cli-clicked(); }
                        }
                        NeothButton {
                            label: "Re-run wizard";
                            primary: false;
                            clicked => { root.wizard-rerun-clicked(); }
                        }
                    }
                    // GAP-07 — Backup + rollback preview (read-only).
                    // "Backup now" shells `neoth backup`; output shown in status-line.
                    // "Preview rollback" shells `neoth rollback list` (dry-run,
                    // no --confirm) and shows available snapshots in status-line.
                    Text {
                        text: "Backup exports a snapshot of config + memory to ~/.neoth/backups/. Preview rollback lists available WAL snapshots (read-only — no restore from the GUI).";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        NeothButton {
                            label: "Backup now";
                            primary: false;
                            clicked => { root.backup-now-clicked(); }
                        }
                        NeothButton {
                            label: "Preview rollback";
                            primary: false;
                            clicked => { root.rollback-preview-clicked(); }
                        }
                    }
                    // Auto-update config (research P0 — was CLI-only).
                    Text {
                        text: "AUTO-UPDATE";
                        font-family: Theme.font-display; font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium; color: Theme.accent-green;
                    }
                    NeothCheckBox {
                        text: "Automatic update checks";
                        checked: root.cfg-autoupdate-enabled;
                        toggled(v) => { root.cfg-autoupdate-enabled = v; root.cfg-autoupdate-enabled-changed(v); }
                    }
                    NeothCheckBox {
                        text: "Auto-apply updates (unattended — off = notify only)";
                        checked: root.cfg-autoupdate-apply;
                        toggled(v) => { root.cfg-autoupdate-apply = v; root.cfg-autoupdate-apply-changed(v); }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-tight;
                        Text {
                            text: "Channel"; color: Theme.text-secondary;
                            font-family: Theme.font-sans; font-size: Theme.font-size-sm;
                            vertical-alignment: center; width: 130px;
                        }
                        NeothComboBox {
                            model: ["stable", "rc", "nightly"];
                            current-index: root.cfg-autoupdate-channel-idx;
                            width: 200px;
                            selected(i) => { root.cfg-autoupdate-channel-idx = i; root.cfg-autoupdate-channel-changed(i); }
                        }
                        NeothLineEdit {
                            placeholder-text: "check interval secs";
                            text: root.cfg-autoupdate-interval;
                            horizontal-stretch: 1;
                            accepted(t) => { root.cfg-autoupdate-interval = t; root.cfg-autoupdate-interval-changed(t); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        NeothButton {
                            label: root.autoupdate-check-running ? "checking…" : "Check now";
                            primary: false;
                            clicked => { if (!root.autoupdate-check-running) { root.autoupdate-check-clicked(); } }
                        }
                    }
                    if root.autoupdate-check-output != "": Text {
                        text: root.autoupdate-check-output;
                        font-family: Theme.font-mono; font-size: Theme.font-size-caption;
                        color: Theme.text-secondary; wrap: word-wrap;
                    }
                }
            }
            }
            }
        }
    }
}
