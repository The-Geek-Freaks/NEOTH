// NEOTH Settings — Pick #32. Post-onboarding tab surface that mirrors
// the 12 slash-action commands (memory rule
// `neoth-slash-commands-and-settings-parity`).
//
// Layout: left sidebar with 8 tab buttons, right content panel that
// swaps based on the active tab. Auto-save semantics — every edit
// fires the `~/.neoth/.reload-requested` sentinel via the Rust side
// so the daemon picks up changes within 2s without an explicit
// "Apply" button.

import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NeothButton, Card, NeothComboBox, NeothCheckBox, NeothLineEdit } from "components.slint";

export enum SettingsTab {
    chat,
    hemispheres,
    channels,
    skills,
    plugins,
    memory,
    privacy,
    cluster,
    config,
    code-sessions,
}

/// One task entry in the Code Sessions board. Rust side populates via
/// `neothd kanban show <id> --output json`; Slint groups by status into
/// the 5 board columns. Pick #8 step 2 — subprocess data binding.
export struct KanbanTaskRow {
    task-id: string,          // pre-formatted `#42` so Slint avoids int-to-str
    title: string,
    hemisphere: string,       // "left" | "right" | "cerebellum" | "unassigned"
}

/// One row in the Code Sessions activity feed (right rail). Rust side
/// populates via `neothd kanban watch --output json` (Pick #8 step 3
/// will land that CLI path; today this carries fixture entries).
export struct KanbanFeedRow {
    ts: string,
    actor: string,
    message: string,
}

/// One comment in the Code Sessions detail-pane comment thread.
/// Rust side populates via `neoth kanban task <id> --output json`
/// after the operator clicks a task card. v0.2-complete: shipping in
/// v0.1 because `kanban task --output json` already exists.
export struct KanbanCommentRow {
    ts: string,       // pre-formatted HH:MM by Rust
    author: string,   // "operator" | "left" | "right" | "cerebellum" | …
    body: string,
}

// GR-10 — one row in the Safety Rails panel, from `neoth security safe-mode --json`.
export struct SafeRailRow {
    name: string,
    engaged: bool,
    detail: string,
}

// GR-03 — one label→value row in the Trust panel, from `neoth trust --output json`.
export struct TrustRow {
    label: string,
    value: string,
}

// GU-01 — one role→provider binding for the Hemispheres panel.
export struct HemisphereRow {
    role: string,      // "left" | "right" | "cerebellum"
    provider: string,  // canonical id or "(unset)"
    model: string,     // "" when provider-default
    has-key: bool,
}

// GU-01 — one installed skill for the Skills panel.
export struct SkillRow {
    id: string,
    description: string,
    enabled: bool,
    keywords: string,  // joined trigger keywords
}

// GU-01 — one discovered plugin for the Plugins panel.
export struct PluginRow {
    id: string,
    name: string,
    activation: string,  // "enabled" | "pending" | "disabled" | …
}

// GU-01 — one memory block (metadata only) for the Memory panel.
export struct MemoryRow {
    source: string,   // "global" | "project" | "rule" | "memory"
    path: string,
    bytes: string,    // pre-formatted by Rust
}

// GU-01 — one channel's connection state (bool only, never a secret).
export struct ChannelRow {
    name: string,
    connected: bool,
}

component TabButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    height: 44px;
    background: root.active ? Theme.bg-card : transparent;
    border-radius: Theme.radius-button;

    animate background {
        duration: Theme.duration-micro;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    Rectangle {
        x: 0;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        background: root.active ? Theme.accent-green : transparent;
        border-radius: 2px;
    }

    txt := Text {
        x: Theme.space-base;
        text: root.label;
        font-family: Theme.font-display;
        font-size: Theme.font-size-body;
        font-weight: root.active ? Theme.weight-medium : Theme.weight-regular;
        letter-spacing: Theme.letter-spacing-body;
        color: root.active ? Theme.text-primary : Theme.text-muted;
        vertical-alignment: center;
        height: parent.height;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // G-25 fix: subtle hover affordance for desktop mouse pointers.
    // Inactive tabs lift to a 50% bg-card overlay + text moves to
    // primary for a frame; never overrides the active-state styling.
    states [
        hovered when touch.has-hover && !root.active: {
            background: Theme.bg-card.with-alpha(0.5);
            txt.color: Theme.text-primary;
        }
    ]
}

// ── KanbanTaskCard ───────────────────────────────────────────────────
// Single task tile in a board column. Title + 2-line description clip,
// hemisphere badge (cerebellum / left / right), status colour bar.
// Pick #8 step 1 — static fixture, no callbacks yet.

// G-8/G-21 fix: larger padding for readability, 90 px min height,
// hemisphere badge handles "unassigned" explicitly + widens to fit
// "cerebellum" (10 chars).
component KanbanTaskCard inherits Rectangle {
    in property <string> title: "";
    in property <string> hemisphere: "";       // "left" | "right" | "cerebellum" | "unassigned"
    in property <string> task-id: "";
    /// Step 5 (2026-05-20): selected state lights the card border in
    /// accent-green when the operator picked it for the detail pane.
    in property <bool> selected: false;
    callback clicked();

    min-height: 90px;
    background: Theme.bg-card;
    border-radius: Theme.radius-button;
    border-width: 1px;
    border-color: root.selected ? Theme.accent-green : Theme.border-subtle;

    animate border-color {
        duration: Theme.duration-micro;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: Theme.space-base;
        spacing: Theme.space-tight;

        HorizontalLayout {
            alignment: space-between;
            spacing: Theme.space-tight;
            Text {
                text: root.task-id;
                font-family: Theme.font-mono;
                font-size: Theme.font-size-caption;
                color: Theme.text-dim;
            }
            Rectangle {
                width: 72px;
                height: 18px;
                background: transparent;
                border-width: 1px;
                border-radius: 4px;
                border-color:
                    root.hemisphere == "cerebellum" ? Theme.accent-green :
                    root.hemisphere == "right"      ? Theme.accent-pink :
                    root.hemisphere == "left"       ? Theme.text-muted :
                                                       Theme.border-subtle;
                Text {
                    text: root.hemisphere == "unassigned" ? "—" : root.hemisphere;
                    font-family: Theme.font-display;
                    font-size: 9px;
                    font-weight: Theme.weight-bold;
                    letter-spacing: Theme.letter-spacing-tight;
                    color:
                        root.hemisphere == "cerebellum" ? Theme.accent-green :
                        root.hemisphere == "right"      ? Theme.accent-pink :
                        root.hemisphere == "left"       ? Theme.text-muted :
                                                           Theme.text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.title;
            font-family: Theme.font-display;
            font-size: Theme.font-size-body;
            font-weight: Theme.weight-regular;
            color: Theme.text-primary;
            wrap: word-wrap;
        }
    }
}

// ── KanbanColumn ─────────────────────────────────────────────────────
// One of 5 board columns. Header with status label + task count, then a
// vertical stack of KanbanTaskCard rendered from the `tasks` array.
// Pick #8 step 2 — array-driven, no more @children fixture.

component KanbanColumn inherits Rectangle {
    in property <string> label: "";
    in property <color> accent: Theme.text-muted;
    in property <[KanbanTaskRow]> tasks: [];
    in property <string> selected-task-id: "";
    callback task-clicked(string);

    background: Theme.bg-base;
    border-radius: Theme.radius-button;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.space-tight;
        spacing: Theme.space-tight;

        HorizontalLayout {
            alignment: space-between;
            spacing: Theme.space-tight;
            Text {
                text: root.label;
                font-family: Theme.font-display;
                font-size: Theme.font-size-caption;
                font-weight: Theme.weight-bold;
                letter-spacing: Theme.letter-spacing-wide;
                color: root.accent;
            }
            Text {
                text: root.tasks.length;
                font-family: Theme.font-mono;
                font-size: Theme.font-size-caption;
                color: Theme.text-dim;
            }
        }
        Rectangle {
            height: 2px;
            background: root.accent;
            opacity: 0.4;
            border-radius: 1px;
        }
        VerticalLayout {
            spacing: Theme.space-tight;
            for entry[i] in root.tasks: KanbanTaskCard {
                task-id: entry.task-id;
                title: entry.title;
                hemisphere: entry.hemisphere;
                selected: entry.task-id == root.selected-task-id;
                clicked => { root.task-clicked(entry.task-id); }
            }
        }
    }
}

// ── ActivityFeedEntry ────────────────────────────────────────────────
// One row in the right-rail activity feed. Mono timestamp, actor badge,
// message body. Static fixture for Pick #8 step 1.

component ActivityFeedEntry inherits HorizontalLayout {
    in property <string> ts: "";
    in property <string> actor: "";
    in property <string> message: "";

    spacing: Theme.space-tight;
    padding-top: 4px;
    padding-bottom: 4px;

    Text {
        text: root.ts;
        font-family: Theme.font-mono;
        font-size: Theme.font-size-caption;
        color: Theme.text-dim;
        width: 48px;
    }
    Text {
        text: root.actor;
        font-family: Theme.font-display;
        font-size: Theme.font-size-caption;
        font-weight: Theme.weight-bold;
        letter-spacing: Theme.letter-spacing-tight;
        color: root.actor == "cerebellum"
            ? Theme.accent-green
            : (root.actor == "right" ? Theme.accent-pink : Theme.text-muted);
        width: 72px;
    }
    Text {
        text: root.message;
        font-family: Theme.font-display;
        font-size: Theme.font-size-caption;
        color: Theme.text-primary;
        wrap: word-wrap;
    }
}

component PanelHeader inherits VerticalLayout {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> mirrors-slash: "";

    spacing: Theme.space-tight;

    Text {
        text: root.title;
        font-family: Theme.font-display;
        font-size: Theme.font-size-h2;
        font-weight: Theme.weight-light;
        color: Theme.text-primary;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        font-family: Theme.font-display;
        font-size: Theme.font-size-body;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if root.mirrors-slash != "": Text {
        text: "CLI mirror: " + root.mirrors-slash;
        font-family: Theme.font-mono;
        font-size: Theme.font-size-caption;
        color: Theme.accent-green;
    }
}

// GU-01: the PendingPanel "coming in vX" stub component was removed once all
// six settings tabs became real panels — every former stub now renders live data.

export component SettingsView inherits Rectangle {
    in-out property <SettingsTab> active: SettingsTab.chat;
    in-out property <string> autonomy-current: "standard";
    in-out property <string> provider-current: "claude_cli";

    // GR-10 — Safety Rails (from `neoth security safe-mode --json`), rendered in
    // the Privacy tab. Rust populates these on startup; `engaged` rails are the
    // ones actively restricting the daemon.
    in property <[SafeRailRow]> safety-rails: [];
    in property <int> rails-engaged-count: 0;
    in property <int> rails-total: 0;

    // GR-03 — Trust panel (from `neoth trust --output json`): autonomy posture,
    // privacy switches, recovery-key readiness, and WAL trust-ledger size. Rust
    // populates these on startup; all read-only.
    in property <string> trust-autonomy-level: "";
    in property <string> trust-autonomy-behavior: "";
    in property <[TrustRow]> trust-privacy: [];
    in property <[TrustRow]> trust-recovery: [];
    in property <[TrustRow]> trust-ledger: [];

    // SL-03 — Local resources (Cluster tab), from `neoth hardware --output json`:
    // CPU / memory / accelerator / VRAM / disk headlines + cached-model rows.
    in property <string> hw-cpu: "";
    in property <string> hw-memory: "";
    in property <string> hw-accelerator: "";
    in property <string> hw-vram: "";
    // GOLD-PROG-07 — VRAM used/total as a 0.0..=1.0 fraction for the live meter.
    in property <float> hw-vram-fraction: 0.0;
    in property <string> hw-disk: "";
    in property <[TrustRow]> hw-models: [];

    // KF-08 — Council budget meter (Config tab), from `neoth council budget
    // --output json`: the per-message cap + last debate's live usage.
    in property <string> council-cap: "";
    in property <string> council-daily-usd: "";
    in property <string> council-depth-warning: "";
    in property <[TrustRow]> council-last-debate: [];

    // GU-01 — Hemispheres + Skills panels. Rust populates these on startup from
    // `neoth hemispheres show --output json` / `neoth skills --list --output json`.
    in property <[HemisphereRow]> hemisphere-bindings: [];
    in property <string> hemispheres-mode: "";
    // SPEC-06 — implemented provider ids for the per-role rebind picker.
    in property <[string]> provider-ids: [];
    in property <[SkillRow]> skills: [];
    // PF-01-GUI — skills.always_embed_route toggle (freedom.yaml write-back).
    in-out property <bool> skills-always-embed-route: true;
    callback skills-always-embed-route-changed(bool);
    // GU-01 — Channels / Plugins / Memory panels.
    in property <[ChannelRow]> channels: [];
    in property <[PluginRow]> plugins: [];
    in property <[MemoryRow]> memory-blocks: [];
    in property <string> memory-total: "";

    // GU-03 — persona-adaptive panel visibility. Rust (`panel_logic::panels_for`)
    // sets these from the operator's complexity level on startup; each gated
    // sidebar tab is conditionally created (`if`), so a hidden tab is removed
    // from the layout entirely. `chat`/`privacy`/`config` are never gated.
    in property <bool> show-hemispheres: true;
    in property <bool> show-channels: true;
    in property <bool> show-skills: true;
    in property <bool> show-plugins: true;
    in property <bool> show-memory: true;
    in property <bool> show-cluster: true;
    in property <bool> show-code-sessions: true;

    // Bite #5 — Cluster settings (post-onboarding mirror of the
    // wizard step). Rust side loads cluster.mdns.enabled from
    // freedom.yaml on settings-open + sets `cluster-mdns-enabled`;
    // toggle fires `cluster-mdns-enabled-changed(bool)` which
    // mutates freedom.yaml + drops the reload sentinel.
    in-out property <bool> cluster-mdns-enabled: true;
    in-out property <int> cluster-listen-port: 49737;
    /// Operator-readable summary of `cluster.policy.trusted_ssids`.
    /// Empty string renders the "no trusted SSIDs set" placeholder.
    in-out property <string> cluster-trusted-ssids-summary: "";
    callback cluster-mdns-enabled-changed(bool);

    // ── Code Sessions tab state (Pick #8 step 2) ────────────────────
    // Rust side fetches `neothd kanban list/show --output json` on tab
    // open + populates the five status-bucket arrays here. Empty
    // arrays render an empty column with header + 0 count — that's
    // the steady state when the operator hasn't run `neoth code` yet.
    in property <[KanbanTaskRow]> kanban-backlog: [];
    in property <[KanbanTaskRow]> kanban-todo: [];
    in property <[KanbanTaskRow]> kanban-in-progress: [];
    in property <[KanbanTaskRow]> kanban-review: [];
    in property <[KanbanTaskRow]> kanban-done: [];
    in property <[KanbanFeedRow]> kanban-feed: [];
    /// One-line summary above the board: which session is showing,
    /// when it was opened, what the operator's prompt was. Empty
    /// string means "no sessions yet — operator has not run `neoth
    /// code` on this machine".
    in property <string> kanban-session-summary: "";
    /// HO-02: whether a Cerebellum hemisphere is bound (wizard step 5d).
    /// `false` surfaces a warning banner in the Code Sessions tab —
    /// without a Cerebellum the decompose step can't run, so `neoth code`
    /// is degraded. Defaults true so a probe failure doesn't false-alarm.
    in property <bool> cerebellum-bound: true;
    /// Step 5 (2026-05-20): currently-focused task. Operator clicks a
    /// card → property updates → detail pane below the board renders
    /// title / hemisphere / status. Empty string hides the pane.
    in-out property <string> kanban-selected-task-id: "";
    /// Step 5 — details for the focused task. Populated by Rust on the
    /// `kanban-task-selected` callback so the detail pane can render
    /// without re-walking the board snapshot.
    in property <string> kanban-selected-title: "";
    in property <string> kanban-selected-status: "";
    in property <string> kanban-selected-hemisphere: "";
    in property <string> kanban-selected-description: "";
    in property <[KanbanCommentRow]> kanban-selected-comments: [];

    callback wizard-rerun-clicked;
    callback reload-config-clicked;
    // GU-01 — Chat tab "Open chat" button → MainWindow switches to the chat view.
    callback open-chat-clicked;
    // SPEC-06 — operator picked (role, provider) in the Hemispheres rebind
    // control → MainWindow shells `neoth hemispheres set`.
    callback hemisphere-set-clicked(string, string);
    /// G-12 fix — operator picked a different provider in the
    /// Config tab. Rust persists the change to freedom.yaml + drops
    /// the reload sentinel.
    callback provider-changed(string);
    /// Operator clicked "Refresh" on the Code Sessions tab. Rust side
    /// re-runs `neothd kanban list/show` + re-populates the 5 board
    /// properties. Live-tail (Pick #8 step 4) will replace this with
    /// a WAL-driven push.
    callback kanban-refresh-clicked;
    /// Step 5 (2026-05-20): operator clicked a KanbanTaskCard. Rust
    /// looks up the full task detail (title/status/hemisphere/desc)
    /// + sets the 4 `kanban-selected-*` properties so the detail pane
    /// renders. Passing the id string is enough — Rust already holds
    /// the snapshot.
    callback kanban-task-selected(string);
    /// Step 6 (2026-05-20): move a task to a target status column.
    /// Rust subprocesses `neoth kanban move <task-id> <status>`; the
    /// 2s live-tail picks up the change. `task-id` is the bare numeric
    /// id (no "#" prefix); status is the wire-form
    /// (backlog/todo/in_progress/review/done/blocked/archived).
    callback kanban-task-move(string, string);
    /// Step 6: REVIEW → DONE promote when the auto-promote check
    /// passes. Subprocess `neoth kanban review <task-id> --promote`.
    callback kanban-task-promote(string);
    /// v0.2 complete (2026-05-20): append a comment to the selected
    /// task. Subprocess `neoth kanban comment <id> <body> --author
    /// operator`. Args: (task_id, body).
    callback kanban-task-comment(string, string);
    /// v0.2 complete (2026-05-20): re-assign the task to a different
    /// hemisphere. Args: (task_id, hemisphere_wire_form). Wire form
    /// is one of "left" / "right" / "cerebellum" / "unassigned" —
    /// subprocess `neoth kanban assign <id> <hemisphere>`.
    callback kanban-task-assign(string, string);
    /// G-5 fix — operator clicked "← Chat" in the sidebar header so
    /// they can leave Settings. Without this they were trapped
    /// because the ⚙ icon lives in the Chat sidebar (not visible
    /// from Settings).
    callback back-clicked;

    background: Theme.bg-base;

    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: Theme.bg-base;
            VerticalLayout {
                padding: Theme.space-base;
                spacing: Theme.space-tight;

                // G-5 fix: "← Chat" lives at the top of the sidebar so
                // the operator always has an obvious exit. Mirrors the
                // back-button pattern from every wizard step.
                NeothButton {
                    label: "← Chat";
                    primary: false;
                    clicked => { root.back-clicked(); }
                }

                Text {
                    text: "SETTINGS";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-caption;
                    font-weight: Theme.weight-bold;
                    letter-spacing: Theme.letter-spacing-extra-wide;
                    color: Theme.text-dim;
                }

                TabButton {
                    label: "Chat";
                    active: root.active == SettingsTab.chat;
                    clicked => { root.active = SettingsTab.chat; }
                }
                if root.show-hemispheres : TabButton {
                    label: "Hemispheres";
                    active: root.active == SettingsTab.hemispheres;
                    clicked => { root.active = SettingsTab.hemispheres; }
                }
                if root.show-channels : TabButton {
                    label: "Channels";
                    active: root.active == SettingsTab.channels;
                    clicked => { root.active = SettingsTab.channels; }
                }
                if root.show-skills : TabButton {
                    label: "Skills";
                    active: root.active == SettingsTab.skills;
                    clicked => { root.active = SettingsTab.skills; }
                }
                if root.show-plugins : TabButton {
                    label: "Plugins";
                    active: root.active == SettingsTab.plugins;
                    clicked => { root.active = SettingsTab.plugins; }
                }
                if root.show-memory : TabButton {
                    label: "Memory";
                    active: root.active == SettingsTab.memory;
                    clicked => { root.active = SettingsTab.memory; }
                }
                TabButton {
                    label: "Privacy";
                    active: root.active == SettingsTab.privacy;
                    clicked => { root.active = SettingsTab.privacy; }
                }
                if root.show-cluster : TabButton {
                    label: "Cluster";
                    active: root.active == SettingsTab.cluster;
                    clicked => { root.active = SettingsTab.cluster; }
                }
                TabButton {
                    label: "Config";
                    active: root.active == SettingsTab.config;
                    clicked => { root.active = SettingsTab.config; }
                }
                if root.show-code-sessions : TabButton {
                    label: "Code Sessions";
                    active: root.active == SettingsTab.code-sessions;
                    clicked => { root.active = SettingsTab.code-sessions; }
                }
            }
        }

        Rectangle {
            background: Theme.bg-base;
            border-color: Theme.border-subtle;
            border-width: 1px;
            border-radius: Theme.radius-card;

            // G-17 fix: replace internal "Pick #N" sprint labels with
            // operator-readable release identifiers. Internal tracking
            // belongs in PROGRESS.md, not in the settings UI.
            if root.active == SettingsTab.chat: VerticalBox {
                padding: Theme.space-loose;
                spacing: Theme.space-loose;
                PanelHeader {
                    title: "Chat";
                    subtitle: "Your day-to-day conversation surface — composer, scrollback, channel sidebar — lives in the main Chat view (it is the primary surface, not a settings sub-panel). Open it here.";
                    mirrors-slash: "(primary daily surface)";
                }
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-base;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "ACTIVE PROVIDER";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-medium;
                                letter-spacing: Theme.letter-spacing-tight;
                                color: Theme.accent-green;
                            }
                            Text {
                                text: root.provider-current;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                            }
                        }
                        Text {
                            text: "Press / in the chat composer to discover slash commands (provider, autonomy, skills, …).";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        NeothButton {
                            label: "Open chat";
                            primary: true;
                            clicked => { root.open-chat-clicked(); }
                        }
                    }
                }
            }

            if root.active == SettingsTab.hemispheres: VerticalBox {
                padding: Theme.space-loose;
                spacing: Theme.space-loose;
                PanelHeader {
                    title: "Hemispheres";
                    subtitle: "NEOTH thinks across three roles: Left (fast, analytic), Right (deep, creative), Cerebellum (the orchestrator). Bind a provider to each via the CLI; this shows the live binding.";
                    mirrors-slash: "/provider [role] <kind>   |   neoth hemispheres set";
                }
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "TOPOLOGY";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-medium;
                                letter-spacing: Theme.letter-spacing-tight;
                                color: Theme.accent-green;
                            }
                            Text {
                                text: root.hemispheres-mode == "" ? "—" : root.hemispheres-mode;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                        if root.hemisphere-bindings.length == 0: Text {
                            text: "(start the daemon to read the live hemisphere bindings)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        for b in root.hemisphere-bindings: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: b.role;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-primary;
                            }
                            Text {
                                text: b.provider + (b.model == "" ? "" : " · " + b.model);
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: b.provider == "(unset)" ? Theme.text-muted : Theme.accent-green;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: b.has-key ? "key set" : "";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
                // SPEC-06 — rebind a role from the GUI (shells `neoth hemispheres
                // set --role <r> --provider <p>`). The model id stays a CLI/key
                // concern — this only swaps the provider adapter for a role.
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "REBIND A ROLE";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        if root.provider-ids.length == 0: Text {
                            text: "(start the daemon to load the provider list)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.provider-ids.length > 0: HorizontalLayout {
                            spacing: Theme.space-base;
                            role_combo := NeothComboBox {
                                model: ["left", "right", "cerebellum"];
                                horizontal-stretch: 1;
                            }
                            prov_combo := NeothComboBox {
                                model: root.provider-ids;
                                horizontal-stretch: 1;
                            }
                            NeothButton {
                                label: "Set";
                                primary: true;
                                clicked => {
                                    root.hemisphere-set-clicked(
                                        role_combo.model[role_combo.current-index],
                                        prov_combo.model[prov_combo.current-index],
                                    );
                                }
                            }
                        }
                    }
                }
            }

            if root.active == SettingsTab.channels: VerticalBox {
                padding: Theme.space-loose;
                spacing: Theme.space-loose;
                PanelHeader {
                    title: "Channels";
                    subtitle: "Messaging surfaces NEOTH can reach. Connect/disconnect via the CLI; this shows which have credentials configured — the secrets themselves never leave ~/.neoth/credentials.yaml.";
                    mirrors-slash: "/connect <channel>   |   /disconnect <channel>";
                }
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        for c in root.channels: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: c.connected ? "connected" : "—";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: c.connected ? Theme.accent-green : Theme.text-muted;
                            }
                            Text {
                                text: c.name;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }

            if root.active == SettingsTab.skills: VerticalBox {
                padding: Theme.space-loose;
                spacing: Theme.space-loose;
                PanelHeader {
                    title: "Skills";
                    subtitle: "Skill packs teach NEOTH about a domain — each loads automatically when its trigger words appear. Manage them via the CLI; this lists the installed set.";
                    mirrors-slash: "/skill list   |   neoth skills --install <path>";
                }
                // PF-01-GUI — skill auto-routing toggle (skills.always_embed_route).
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        NeothCheckBox {
                            text: "Auto-route skills (embed a skill's prompt when its triggers fire)";
                            checked: root.skills-always-embed-route;
                            toggled(checked) => {
                                root.skills-always-embed-route = checked;
                                root.skills-always-embed-route-changed(checked);
                            }
                        }
                        Text {
                            text: "Off = skills load only when you ask explicitly. Writes skills.always_embed_route in freedom.yaml; the daemon hot-reloads.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: root.skills.length + " skill(s) installed";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                        }
                        if root.skills.length == 0: Text {
                            text: "(no skills installed — `neoth skills --install <path>`)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        for s in root.skills: VerticalBox {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: Theme.space-base;
                                Text {
                                    text: s.enabled ? "on" : "off";
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-caption;
                                    color: s.enabled ? Theme.accent-green : Theme.text-muted;
                                }
                                Text {
                                    text: s.id;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-caption;
                                    color: Theme.text-primary;
                                    horizontal-stretch: 1;
                                }
                            }
                            if s.description != "": Text {
                                text: s.description;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            if root.active == SettingsTab.plugins: VerticalBox {
                padding: Theme.space-loose;
                spacing: Theme.space-loose;
                PanelHeader {
                    title: "Plugins";
                    subtitle: "Sandboxed WebAssembly plugins. Drop a .wasm into ~/.neoth/plugins/ and enable via the CLI; this lists the discovered set + activation state.";
                    mirrors-slash: "/plugin list   |   neoth plugin enable <id>";
                }
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: root.plugins.length + " plugin(s) discovered";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                        }
                        if root.plugins.length == 0: Text {
                            text: "(none — drop a .wasm into ~/.neoth/plugins/)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        for p in root.plugins: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: p.activation;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: p.activation == "enabled" ? Theme.accent-green : Theme.text-muted;
                            }
                            Text {
                                text: p.id;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: p.name;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
            }

            if root.active == SettingsTab.memory: VerticalBox {
                padding: Theme.space-loose;
                spacing: Theme.space-loose;
                PanelHeader {
                    title: "Memory";
                    subtitle: "What NEOTH loads as context — global/project/rule files + the memory tier. Sizes only; inspect or erase content via the CLI.";
                    mirrors-slash: "/memory view [topic]   |   /memory forget <topic>";
                }
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "total " + root.memory-total;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                        }
                        if root.memory-blocks.length == 0: Text {
                            text: "(no memory blocks loaded yet)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        for m in root.memory-blocks: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: m.source;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.accent-green;
                            }
                            Text {
                                text: m.path;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            Text {
                                text: m.bytes;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
            }

            if root.active == SettingsTab.privacy: VerticalBox {
                padding: Theme.space-loose;
                spacing: Theme.space-loose;
                PanelHeader {
                    title: "Privacy";
                    subtitle: "Outbound-LLM consent state + autonomy level. Cloud providers only run after explicit consent (V03-08).";
                    mirrors-slash: "/consent list   |   /autonomy <level>";
                }
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "Current autonomy";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        Text {
                            text: root.autonomy-current;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "Five levels: strict / standard / elevated / full / custom. Switch via the CLI: /autonomy <level>. Slider UI lands in the autonomy-ui Pick.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                // GR-10 — Safety Rails card: which restrictions are actively
                // engaged on the daemon (`neoth security safe-mode --json`).
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "SAFETY RAILS";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-medium;
                                letter-spacing: Theme.letter-spacing-tight;
                                color: Theme.accent-green;
                            }
                            Text {
                                text: root.rails-engaged-count + " / " + root.rails-total + " engaged";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                        if root.safety-rails.length == 0: Text {
                            text: "(start the daemon to read live safe-mode rails)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        for rail in root.safety-rails: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: rail.engaged ? "engaged" : "open";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: rail.engaged ? Theme.accent-green : Theme.text-muted;
                            }
                            Text {
                                text: rail.name;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                            }
                            Text {
                                text: rail.detail;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // GR-03 — Trust card: autonomy posture, privacy switches,
                // recovery-key readiness, and the WAL trust-ledger size — the
                // single "what protects me + what I can prove" surface
                // (`neoth trust --output json`).
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "TRUST · POSTURE & PROOF";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        if root.trust-autonomy-level == "": Text {
                            text: "(start the daemon to read live trust posture)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.trust-autonomy-level != "": Text {
                            text: "autonomy: " + root.trust-autonomy-level + " — " + root.trust-autonomy-behavior;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                        for row in root.trust-privacy: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: "privacy";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                            Text {
                                text: row.label;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                        for row in root.trust-recovery: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: "recovery";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                            Text {
                                text: row.label;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: row.value == "present" ? Theme.accent-green : Theme.text-muted;
                            }
                        }
                        for row in root.trust-ledger: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: "ledger";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                            Text {
                                text: row.label;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
            }

            // Bite #5 (2026-05-23): cluster auto-discovery panel.
            // Mirrors the wizard's Q4-ratified cluster step so an
            // already-onboarded operator can flip mDNS announce
            // on/off without re-running the wizard or editing
            // freedom.yaml by hand. CLI parity: `neoth cluster
            // enable` / `disable`.
            if root.active == SettingsTab.cluster: VerticalBox {
                padding: Theme.space-loose;
                spacing: Theme.space-loose;
                PanelHeader {
                    title: "Cluster";
                    subtitle: "Auto-discover other NEOTH instances on your network and connect them into one team — shared memory, shared chat, shared task board. Uses lightweight mDNS broadcasts (same tech as AirPlay and Chromecast).";
                    mirrors-slash: "/cluster enable   |   /cluster disable   |   neoth cluster discover";
                }
                // SL-03 — Local resources card: CPU / memory / accelerator /
                // VRAM / disk + cached local models (`neoth hardware --output
                // json`). Read-only; the operator sees node capacity at a glance.
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "LOCAL RESOURCES";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        if root.hw-cpu == "": Text {
                            text: "(start the daemon to read local hardware)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.hw-cpu != "": Text {
                            text: "cpu:  " + root.hw-cpu;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                        if root.hw-cpu != "": Text {
                            text: "mem:  " + root.hw-memory;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        if root.hw-cpu != "": Text {
                            text: "accel: " + root.hw-accelerator;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        if root.hw-cpu != "": Text {
                            text: "vram: " + root.hw-vram;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        // GOLD-PROG-07 — live VRAM utilisation meter. Shown only
                        // when a GPU is present (fraction > 0): a pill track with
                        // an accent fill whose width tracks used/total.
                        if root.hw-vram-fraction > 0.0: Rectangle {
                            height: 8px;
                            background: Theme.border-subtle;
                            border-radius: Theme.radius-button;
                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width * root.hw-vram-fraction;
                                height: parent.height;
                                background: Theme.accent-green;
                                border-radius: Theme.radius-button;
                            }
                        }
                        if root.hw-cpu != "": Text {
                            text: "disk: " + root.hw-disk;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        for row in root.hw-models: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: "model";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                            Text {
                                text: row.label;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: row.value == "cached" ? Theme.accent-green : Theme.text-muted;
                            }
                        }
                    }
                }
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "mDNS ANNOUNCE";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.accent-green;
                        }
                        NeothCheckBox {
                            text: "Auto-discover other NEOTH instances on this network";
                            checked: root.cluster-mdns-enabled;
                            // GU-02: NeothCheckBox passes the new state as a callback arg
                            // (toggled(bool)), unlike std-widgets CheckBox (toggled()).
                            toggled(checked) => {
                                root.cluster-mdns-enabled = checked;
                                root.cluster-mdns-enabled-changed(checked);
                            }
                        }
                        Text {
                            text: "On a home or office LAN this is safe; on a shared or public network it reveals your instance label and public key to other devices on the subnet. Disable if you only ever run one NEOTH instance.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "LISTEN PORT";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.accent-green;
                        }
                        Text {
                            text: root.cluster-listen-port + "  (default 49737)";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "Edit `cluster.listen_port` in ~/.neoth/freedom.yaml to change. The mDNS announcer + Tailscale TCP probe both use this port — operator must keep them aligned.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "TRUSTED SSIDS";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.accent-green;
                        }
                        Text {
                            text: root.cluster-trusted-ssids-summary != ""
                                ? root.cluster-trusted-ssids-summary
                                : "(no trusted SSIDs set — announcer stays silent on every wifi)";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: root.cluster-trusted-ssids-summary != ""
                                ? Theme.text-primary
                                : Theme.text-dim;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Edit `cluster.policy.trusted_ssids` in freedom.yaml (YAML list of wifi names). Or set `cluster.policy.announce_on_untrusted_wifi: true` to broadcast on every network. `neoth cluster discover` surfaces the current verdict before scanning.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.active == SettingsTab.code-sessions: VerticalBox {
                padding: Theme.space-loose;
                spacing: Theme.space-loose;
                PanelHeader {
                    title: "Code Sessions";
                    subtitle: "Hermes-style autonomous coding workflow. Decompose a prompt with Cerebellum, dispatch tasks to Left (fast) + Right (deep) hemispheres, watch the kanban board fill.";
                    mirrors-slash: "/code <prompt>   |   neoth kanban {list,show,task,move,assign,comment,archive,watch,review}";
                }

                // HO-02: no-Cerebellum fallback banner. Without a bound
                // Cerebellum the decompose step can't run, so `neoth code`
                // silently produces nothing — surface the fix loudly.
                if !root.cerebellum-bound: Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.accent-pink;
                    height: txt.preferred-height + 2 * Theme.space-base;
                    txt := Text {
                        x: Theme.space-base;
                        width: parent.width - 2 * Theme.space-base;
                        text: "⚠  No Cerebellum bound — run wizard step 5d (`neoth hemispheres set --role cerebellum --provider <p>`) to enable autonomous decomposition. `neoth code` can't decompose prompts until then.";
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.accent-pink;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                // Session summary + refresh button. Empty
                // `kanban-session-summary` means no `neoth code` run yet.
                HorizontalLayout {
                    alignment: space-between;
                    spacing: Theme.space-base;
                    Text {
                        text: root.kanban-session-summary != ""
                            ? root.kanban-session-summary
                            : "No active session. Run `neoth code \"...\"` in your terminal, then refresh.";
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: root.kanban-session-summary != "" ? Theme.text-primary : Theme.text-muted;
                        vertical-alignment: center;
                    }
                    NeothButton {
                        label: "Refresh";
                        primary: false;
                        clicked => { root.kanban-refresh-clicked(); }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-loose;

                    // ── Board (5 columns) ────────────────────────────
                    VerticalLayout {
                        spacing: Theme.space-base;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            alignment: stretch;

                            KanbanColumn {
                                label: "BACKLOG";
                                accent: Theme.text-muted;
                                horizontal-stretch: 1;
                                tasks: root.kanban-backlog;
                                selected-task-id: root.kanban-selected-task-id;
                                task-clicked(id) => { root.kanban-task-selected(id); }
                            }
                            KanbanColumn {
                                label: "TODO";
                                accent: Theme.text-primary;
                                horizontal-stretch: 1;
                                tasks: root.kanban-todo;
                                selected-task-id: root.kanban-selected-task-id;
                                task-clicked(id) => { root.kanban-task-selected(id); }
                            }
                            KanbanColumn {
                                label: "IN PROGRESS";
                                // GU-02: amber = active/attention, distinct from the
                                // green "done/safe" + the blue/green backlog columns.
                                accent: Theme.accent-amber;
                                horizontal-stretch: 1;
                                tasks: root.kanban-in-progress;
                                selected-task-id: root.kanban-selected-task-id;
                                task-clicked(id) => { root.kanban-task-selected(id); }
                            }
                            KanbanColumn {
                                label: "REVIEW";
                                accent: Theme.accent-pink;
                                horizontal-stretch: 1;
                                tasks: root.kanban-review;
                                selected-task-id: root.kanban-selected-task-id;
                                task-clicked(id) => { root.kanban-task-selected(id); }
                            }
                            KanbanColumn {
                                label: "DONE";
                                accent: Theme.accent-green;
                                horizontal-stretch: 1;
                                tasks: root.kanban-done;
                                selected-task-id: root.kanban-selected-task-id;
                                task-clicked(id) => { root.kanban-task-selected(id); }
                            }
                        }
                    }

                    // ── Activity feed (right rail) ───────────────────
                    // G-22 fix: width shrinks proportionally on narrow
                    // windows so the 5-column board keeps breathing
                    // room instead of being eaten by a fixed-320 rail.
                    Rectangle {
                        width: min(320px, parent.width * 0.28);
                        background: Theme.bg-card;
                        border-radius: Theme.radius-card;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: Theme.space-base;
                            spacing: Theme.space-tight;

                            Text {
                                text: "ACTIVITY";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: Theme.letter-spacing-extra-wide;
                                color: Theme.accent-green;
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.border-subtle;
                            }
                            if root.kanban-feed.length == 0: Text {
                                text: "No activity yet.";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-dim;
                            }
                            for entry[i] in root.kanban-feed: ActivityFeedEntry {
                                ts: entry.ts;
                                actor: entry.actor;
                                message: entry.message;
                            }
                        }
                    }
                }

                // Step 5 (2026-05-20): detail pane appears under the
                // board when a task card is clicked. Mirrors
                // `neoth kanban task <id>` content: title + status +
                // hemisphere + (optional) description. "Close detail"
                // button clears the selection.
                if root.kanban-selected-task-id != "": Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;

                        HorizontalLayout {
                            alignment: space-between;
                            spacing: Theme.space-base;
                            Text {
                                text: root.kanban-selected-task-id + "  " + root.kanban-selected-title;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-h2;
                                font-weight: Theme.weight-light;
                                color: Theme.text-primary;
                            }
                            NeothButton {
                                label: "Close detail";
                                primary: false;
                                clicked => {
                                    root.kanban-selected-task-id = "";
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-loose;
                            Text {
                                text: "Status: " + root.kanban-selected-status;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.accent-green;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Hemisphere: " + root.kanban-selected-hemisphere;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: root.kanban-selected-hemisphere == "right"
                                    ? Theme.accent-pink
                                    : (root.kanban-selected-hemisphere == "cerebellum"
                                        ? Theme.accent-green
                                        : Theme.text-muted);
                                vertical-alignment: center;
                            }
                        }

                        if root.kanban-selected-description != "": Text {
                            text: root.kanban-selected-description;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-body;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }

                        // Comments thread (2026-05-20): when the
                        // operator clicks a task card the Rust side
                        // fetches `kanban task <id> --output json`
                        // and populates kanban-selected-comments.
                        // Empty list renders nothing — the next
                        // separator line gives the action row a clean
                        // top edge regardless.
                        if root.kanban-selected-comments.length > 0: Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                        if root.kanban-selected-comments.length > 0: Text {
                            text: "COMMENTS (" + root.kanban-selected-comments.length + ")";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.text-dim;
                        }
                        for c[i] in root.kanban-selected-comments: HorizontalLayout {
                            spacing: Theme.space-tight;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            Text {
                                text: c.ts;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-dim;
                                width: 48px;
                            }
                            Text {
                                text: c.author;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-bold;
                                letter-spacing: Theme.letter-spacing-tight;
                                color: c.author == "operator"
                                    ? Theme.accent-pink
                                    : (c.author == "cerebellum"
                                        ? Theme.accent-green
                                        : Theme.text-muted);
                                width: 84px;
                            }
                            Text {
                                text: c.body;
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                wrap: word-wrap;
                            }
                        }

                        // Step 6 (2026-05-20): operator action row.
                        // Move + Promote subprocess into the daemon CLI;
                        // the 2s live-tail picks up the resulting
                        // status change automatically.
                        Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            alignment: start;
                            NeothButton {
                                label: "→ Backlog";
                                primary: false;
                                clicked => {
                                    root.kanban-task-move(root.kanban-selected-task-id, "backlog");
                                }
                            }
                            NeothButton {
                                label: "→ Todo";
                                primary: false;
                                clicked => {
                                    root.kanban-task-move(root.kanban-selected-task-id, "todo");
                                }
                            }
                            NeothButton {
                                label: "→ In Progress";
                                primary: false;
                                clicked => {
                                    root.kanban-task-move(root.kanban-selected-task-id, "in_progress");
                                }
                            }
                            NeothButton {
                                label: "→ Review";
                                primary: false;
                                clicked => {
                                    root.kanban-task-move(root.kanban-selected-task-id, "review");
                                }
                            }
                            NeothButton {
                                label: "→ Done";
                                primary: false;
                                clicked => {
                                    root.kanban-task-move(root.kanban-selected-task-id, "done");
                                }
                            }
                        }
                        if root.kanban-selected-status == "review": HorizontalLayout {
                            alignment: end;
                            NeothButton {
                                label: "✓ Promote REVIEW → DONE";
                                primary: true;
                                clicked => {
                                    root.kanban-task-promote(root.kanban-selected-task-id);
                                }
                            }
                        }

                        // v0.2 complete (2026-05-20): assign-row.
                        // Reroute a task to a different hemisphere when
                        // the heuristic / second-opinion classifier
                        // mis-routed it. Four buttons mirror the four
                        // wire-form variants; pressing one fires the
                        // subprocess + the 2s live-tail picks up the
                        // hemisphere change.
                        Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            alignment: start;
                            Text {
                                text: "Assign to:";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                            NeothButton {
                                label: "Left";
                                primary: false;
                                clicked => {
                                    root.kanban-task-assign(root.kanban-selected-task-id, "left");
                                }
                            }
                            NeothButton {
                                label: "Right";
                                primary: false;
                                clicked => {
                                    root.kanban-task-assign(root.kanban-selected-task-id, "right");
                                }
                            }
                            NeothButton {
                                label: "Cerebellum";
                                primary: false;
                                clicked => {
                                    root.kanban-task-assign(root.kanban-selected-task-id, "cerebellum");
                                }
                            }
                            NeothButton {
                                label: "Unassigned";
                                primary: false;
                                clicked => {
                                    root.kanban-task-assign(root.kanban-selected-task-id, "unassigned");
                                }
                            }
                        }

                        // v0.2 complete: comment composer. Slint's
                        // `LineEdit` carries the draft; pressing Enter
                        // OR clicking "Add" fires the callback + clears
                        // the input so the operator can append again.
                        Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-tight;
                            alignment: stretch;
                            comment_input := NeothLineEdit {
                                placeholder-text: "Add a comment to this task — press Enter or click Add";
                                horizontal-stretch: 1;
                                accepted(text) => {
                                    if (text != "") {
                                        root.kanban-task-comment(root.kanban-selected-task-id, text);
                                        self.text = "";
                                    }
                                }
                            }
                            NeothButton {
                                label: "Add";
                                primary: false;
                                clicked => {
                                    if (comment_input.text != "") {
                                        root.kanban-task-comment(
                                            root.kanban-selected-task-id,
                                            comment_input.text,
                                        );
                                        comment_input.text = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // G-12 fix: Config tab now exposes an in-place provider
            // selector instead of asking the operator to "edit
            // freedom.yaml with your editor of choice" — that would
            // break the noob-operator contract. Change fires the
            // `provider-changed` callback; Rust mutates freedom.yaml
            // + drops the reload sentinel automatically.
            if root.active == SettingsTab.config: VerticalBox {
                padding: Theme.space-loose;
                spacing: Theme.space-loose;
                PanelHeader {
                    title: "Config";
                    subtitle: "Change the LLM provider, force a config reload, or restart the setup wizard. Every choice writes back to ~/.neoth/freedom.yaml — no manual YAML editing required.";
                    mirrors-slash: "/config   |   /wizard   |   /reload";
                }
                // KF-08 — Council budget meter: the per-message council call cap
                // + the last debate's live usage (`neoth council budget --json`).
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-tight;
                        Text {
                            text: "COUNCIL BUDGET";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        if root.council-cap == "": Text {
                            text: "(start the daemon to read the council budget)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.council-cap != "": Text {
                            text: "cap:   " + root.council-cap;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        if root.council-cap != "": Text {
                            text: "daily: " + root.council-daily-usd;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-primary;
                        }
                        // GOLD-HON-13 — 3^depth cost warning (depth > 1).
                        if root.council-depth-warning != "": Text {
                            text: root.council-depth-warning;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.accent-amber;
                            wrap: word-wrap;
                        }
                        if root.council-cap != "" && root.council-last-debate.length == 0: Text {
                            text: "(no council debate has run yet)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                        }
                        for row in root.council-last-debate: HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: row.label;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: row.value;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
                Card {
                    VerticalBox {
                        padding: Theme.space-base;
                        spacing: Theme.space-base;

                        Text {
                            text: "ACTIVE PROVIDER";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.accent-green;
                        }
                        NeothComboBox {
                            model: [
                                "claude_cli",
                                "openai_api",
                                "openai_compat",
                                "gemini_api",
                                "local_qwen",
                                "local_ouro",
                                "hermes",
                                "openclaw",
                            ];
                            current-index:
                                root.provider-current == "claude_cli"    ? 0 :
                                root.provider-current == "openai_api"    ? 1 :
                                root.provider-current == "openai_compat" ? 2 :
                                root.provider-current == "gemini_api"    ? 3 :
                                root.provider-current == "local_qwen"    ? 4 :
                                root.provider-current == "local_ouro"    ? 5 :
                                root.provider-current == "hermes"        ? 6 :
                                root.provider-current == "openclaw"      ? 7 :
                                                                            0;
                            selected(i) => {
                                if (i == 0) { root.provider-current = "claude_cli"; }
                                if (i == 1) { root.provider-current = "openai_api"; }
                                if (i == 2) { root.provider-current = "openai_compat"; }
                                if (i == 3) { root.provider-current = "gemini_api"; }
                                if (i == 4) { root.provider-current = "local_qwen"; }
                                if (i == 5) { root.provider-current = "local_ouro"; }
                                if (i == 6) { root.provider-current = "hermes"; }
                                if (i == 7) { root.provider-current = "openclaw"; }
                                root.provider-changed(root.provider-current);
                            }
                        }

                        Text {
                            text: "Click Reload config below after any provider change so the daemon picks it up within ~2 seconds — the sentinel file at ~/.neoth/.reload-requested handles the dispatch.";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }

                        HorizontalLayout {
                            spacing: Theme.space-base;
                            NeothButton {
                                label: "Reload config";
                                clicked => { root.reload-config-clicked(); }
                            }
                            NeothButton {
                                label: "Re-run wizard";
                                primary: false;
                                clicked => { root.wizard-rerun-clicked(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
