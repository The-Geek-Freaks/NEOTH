// NEOTH — Overview / Mission Control dashboard.
// "everything, at a glance" — single surface for status, tokens, hemispheres,
// agents, skills/plugins, calendar, and consent. Design Wave 3.
//
// Layout: EntranceFade-wrapped scroll area; two-column grid emulated via
// HorizontalLayout of two VerticalLayouts (Slint 1.8 has no CSS grid).
// Left column: STATUS + TOKENS + AGENTS.
// Right column: HEMISPHERES + SKILLS & PLUGINS + CALENDAR + CONSENT.
// All cards use the existing Card + Theme tokens. No inline hex codes.
//
// Slint 1.8 rules observed:
//   - `if` used instead of `visible` for removed-from-layout semantics
//     (visible still reserves space in layouts).
//   - No `starts-with` / `ends-with` — use equality checks instead.
//   - @children inside `if` blocks is unsupported — avoided entirely.
//   - ScrollView requires the inner element to have an explicit height when
//     used inside a stretched container.

import { Theme } from "theme.slint";
import { Card, Led, SegBar, EntranceFade, NeothButton, Kicker, InfoRow, RefreshFooter } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// ── Wire structs (exported so main.rs can construct them) ─────────────────────

/// One hemisphere row: role kicker + provider name + model id.
export struct HemiCard {
    role: string,       // "left" | "right" | "cerebellum"
    provider: string,
    model: string,
    ok: bool,           // live tick led
}

/// A generic key-value stat for the header band.
export struct OverviewStat {
    label: string,
    value: string,
    tone: string,       // "" | "accent" | "memory" | "audit" | "consent" | "warning"
}

/// One calendar event row.
export struct CalEvent {
    time: string,
    summary: string,
}

/// One consent entry row.
export struct ConsentEntry {
    provider: string,
    granted: bool,
}

/// One row in the COST & USAGE top-sessions table.
export struct CostSessionRow {
    session: string,    // short session name / id
    provider: string,   // provider slug, e.g. "anthropic" | "openai"
    tokens: string,     // formatted token count, e.g. "42 k"
    cost: string,       // formatted cost, e.g. "€ 0.18"
}

// ── OverviewView ───────────────────────────────────────────────────────────────

export component OverviewView inherits Rectangle {
    // ── Data properties — set by Rust via invoke_from_event_loop ──────────────

    // STATUS card
    in property <string> ov-operating-mode: "";
    in property <string> ov-autonomy: "";
    in property <string> ov-daemon-state: "connecting";  // "live"|"connecting"|"error"
    in property <string> ov-channel-health: "";          // free-form summary line
    in property <string> ov-wal-bytes: "";
    in property <string> ov-tier-counts: "";

    // TOKENS card
    in property <string> ov-tokens-in: "";
    in property <string> ov-tokens-out: "";
    in property <string> ov-responses: "";
    in property <string> ov-cost: "";
    in property <float>  ov-token-fraction: 0.0;  // 0.0..1.0 vs daily cap

    // HEMISPHERES card
    in property <[HemiCard]> ov-hemispheres: [];

    // AGENTS card
    in property <string> ov-agents-count: "";
    in property <[string]> ov-agent-names: [];

    // SKILLS & PLUGINS card
    in property <string> ov-skills-active: "";
    in property <string> ov-plugins-active: "";
    in property <[string]> ov-skill-names: [];
    in property <[string]> ov-plugin-names: [];

    // CALENDAR card
    in property <[CalEvent]> ov-calendar-events: [];
    in property <bool> ov-calendar-configured: true;

    // CONSENT card
    in property <[ConsentEntry]> ov-consent-entries: [];
    in property <string> ov-smart-approve: "";

    // shared refresh timestamp & refresh trigger
    in property <string> ov-refreshed-at: "";
    callback overview-refresh-clicked();

    // COST & USAGE card
    in property <[CostSessionRow]> ov-cost-sessions: [];
    // 7 normalized (0..1) daily spend values; index 0 = oldest day.
    in property <[float]> ov-usage-days: [];
    // mono caption beneath the sparkline, e.g. "eur 0.42 this week".
    in property <string> ov-usage-days-label: "";
    // fired when the operator clicks the card chevron (orchestrator can
    // deep-link to a dedicated cost/billing panel from here).
    callback ov-cost-open-clicked();

    // ── Layout ────────────────────────────────────────────────────────────────
    background: Theme.bg-base;

    EntranceFade {

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            // ── View header ──────────────────────────────────────────────────
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                height: 44px;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Mission Control";
                        color: Theme.text-primary;
                        font-family: Theme.font-sans;
                        font-size: Theme.font-size-md;
                        letter-spacing: Theme.letter-spacing-tight;
                    }
                    Text {
                        text: "everything, at a glance";
                        color: Theme.text-tertiary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                        letter-spacing: Theme.letter-spacing-wide;
                    }
                }

                // spacer
                Rectangle { horizontal-stretch: 1; }

                // Refresh button
                NeothButton {
                    label: "Refresh";
                    size: "sm";
                    primary: false;
                    clicked => { root.overview-refresh-clicked(); }
                }
            }

            // hairline separator — spacing via padding on parent VerticalLayout
            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            // ── Scrollable two-column grid ───────────────────────────────────
            ScrollView {
                // Give scroll view an explicit height so Slint can compute
                // the viewport height (required when placed inside a layout).

                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    padding: 0px;

                    // ── LEFT COLUMN ─────────────────────────────────────────
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 14px;
                        alignment: start;

                        // ── STATUS card ──────────────────────────────────────
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                alignment: start;

                                // Card header: kicker + led
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    height: 18px;
                                    Kicker { label: "STATUS"; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Led {
                                        state: root.ov-daemon-state;
                                        dot-size: 7px;
                                    }
                                }

                                InfoRow {
                                    label: "MODE";
                                    value: root.ov-operating-mode;
                                }
                                InfoRow {
                                    label: "AUTONOMY";
                                    value: root.ov-autonomy;
                                }
                                InfoRow {
                                    label: "CHANNELS";
                                    value: root.ov-channel-health;
                                }
                                if root.ov-wal-bytes != "": InfoRow {
                                    label: "WAL";
                                    value: root.ov-wal-bytes;
                                }
                                if root.ov-tier-counts != "": InfoRow {
                                    label: "TIERS";
                                    value: root.ov-tier-counts;
                                }

                                RefreshFooter { ts: root.ov-refreshed-at; }
                            }
                        }

                        // ── TOKENS card ──────────────────────────────────────
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                alignment: start;

                                Kicker { label: "TOKENS"; }

                                // Hero: total output (primary scannable number)
                                Text {
                                    text: root.ov-tokens-out != "" ? root.ov-tokens-out : "—";
                                    color: Theme.accent;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-display-sm;
                                    letter-spacing: Theme.letter-spacing-tight;
                                }

                                // Subordinate: input + output labels
                                HorizontalLayout {
                                    spacing: 18px;
                                    alignment: start;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: root.ov-tokens-in != "" ? root.ov-tokens-in : "—";
                                            color: Theme.audit;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-sm;
                                        }
                                        Text {
                                            text: "INPUT";
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            letter-spacing: Theme.letter-spacing-wide;
                                        }
                                    }

                                    Rectangle {
                                        width: 1px;
                                        background: Theme.border-default;
                                        height: 28px;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: root.ov-tokens-out != "" ? root.ov-tokens-out : "—";
                                            color: Theme.memory;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-sm;
                                        }
                                        Text {
                                            text: "OUTPUT";
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            letter-spacing: Theme.letter-spacing-wide;
                                        }
                                    }
                                }

                                // SegBar vs daily cap
                                if root.ov-token-fraction > 0.0: SegBar {
                                    segments: 16;
                                    fraction: root.ov-token-fraction;
                                    fill: Theme.audit;
                                }

                                InfoRow { label: "CALLS"; value: root.ov-responses; }
                                InfoRow {
                                    label: "COST";
                                    value: root.ov-cost;
                                    value-color: root.ov-cost != "" ? Theme.warning : Theme.text-primary;
                                }

                                RefreshFooter { ts: root.ov-refreshed-at; }
                            }
                        }

                        // ── AGENTS card ──────────────────────────────────────
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    height: 18px;
                                    Kicker { label: "AGENTS"; }
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.ov-agents-count != "": Text {
                                        text: root.ov-agents-count;
                                        color: Theme.memory;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-xs;
                                        letter-spacing: Theme.letter-spacing-tight;
                                        vertical-alignment: center;
                                    }
                                }

                                // Agent name list — up to 5 entries
                                for name[i] in root.ov-agent-names: Rectangle {
                                    height: 28px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    visible: i < 5;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: start;
                                        spacing: 8px;
                                        Text {
                                            text: "⚇";
                                            color: Theme.text-disabled;
                                            font-size: Theme.font-size-xs;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: name;
                                            color: Theme.text-secondary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-xs;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if root.ov-agent-names.length == 0: Text {
                                    text: "No agents running.";
                                    color: Theme.text-disabled;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-xs;
                                }

                                RefreshFooter { ts: root.ov-refreshed-at; }
                            }
                        }

                        // ── COST & USAGE card ─────────────────────────────────
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                alignment: start;

                                // Card header: kicker + chevron deep-link
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    height: 18px;
                                    Kicker { label: "COST & USAGE"; }
                                    Rectangle { horizontal-stretch: 1; }
                                    // Small chevron — fires ov-cost-open-clicked for
                                    // the orchestrator to handle deep-linking.
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        border-radius: Theme.radius-xs;
                                        background: cvu-chevron.has-hover ? Theme.surface-2 : transparent;
                                        animate background {
                                            duration: Theme.duration-fast;
                                            easing: ease-out;
                                        }
                                        Text {
                                            text: "▸";
                                            color: Theme.text-tertiary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-xs;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        cvu-chevron := TouchArea {
                                            clicked => { root.ov-cost-open-clicked(); }
                                        }
                                    }
                                }

                                // ── 7-bar daily spend sparkline ──────────────────
                                if root.ov-usage-days.length > 0: Rectangle {
                                    height: 36px;
                                    background: transparent;
                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: start;
                                        // Each wrapper rect is 14px wide × 36px tall;
                                        // the inner bar is bottom-anchored via explicit y.
                                        for val[i] in root.ov-usage-days: Rectangle {
                                            width: 14px;
                                            height: 36px;
                                            background: transparent;
                                            Rectangle {
                                                x: 0;
                                                y: parent.height - max(2px, val * parent.height);
                                                width: parent.width;
                                                height: max(2px, val * parent.height);
                                                border-radius: 2px;
                                                background: Theme.accent;
                                                // brighter bars for higher spend days
                                                opacity: 0.55 + val * 0.45;
                                            }
                                        }
                                    }
                                }

                                // Sparkline caption (e.g. "eur 0.42 this week")
                                if root.ov-usage-days-label != "": Text {
                                    text: root.ov-usage-days-label;
                                    color: Theme.text-tertiary;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-2xs;
                                    letter-spacing: Theme.letter-spacing-tight;
                                }

                                // ── TOP SESSIONS table ───────────────────────────
                                Kicker { label: "TOP SESSIONS"; }

                                // Column header row — only shown when data exists
                                if root.ov-cost-sessions.length > 0: Rectangle {
                                    height: 22px;
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: start;
                                        Text {
                                            text: "SESSION";
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            letter-spacing: Theme.letter-spacing-wide;
                                            horizontal-stretch: 2;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "PROVIDER";
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            letter-spacing: Theme.letter-spacing-wide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "TOKENS";
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            letter-spacing: Theme.letter-spacing-wide;
                                            horizontal-alignment: right;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "COST";
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            letter-spacing: Theme.letter-spacing-wide;
                                            horizontal-alignment: right;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Data rows — max 8 visible (visible: false keeps
                                // layout space; acceptable at low row counts)
                                for entry[i] in root.ov-cost-sessions: Rectangle {
                                    height: 28px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    visible: i < 8;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: start;
                                        Text {
                                            text: entry.session;
                                            color: Theme.text-secondary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            horizontal-stretch: 2;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: entry.provider;
                                            color: Theme.audit;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: entry.tokens;
                                            color: Theme.text-primary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            horizontal-alignment: right;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: entry.cost;
                                            color: Theme.warning;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            horizontal-alignment: right;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Empty state
                                if root.ov-cost-sessions.length == 0: Text {
                                    text: "no spend recorded yet";
                                    color: Theme.text-disabled;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-xs;
                                }

                                RefreshFooter { ts: root.ov-refreshed-at; }
                            }
                        }
                    }

                    // ── RIGHT COLUMN ─────────────────────────────────────────
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 14px;
                        alignment: start;

                        // ── HEMISPHERES card ─────────────────────────────────
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                alignment: start;

                                Kicker { label: "HEMISPHERES"; }

                                for hemi in root.ov-hemispheres: Rectangle {
                                    height: 52px;
                                    border-radius: Theme.radius-md;
                                    background: Theme.surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: start;
                                        spacing: 10px;

                                        // tick led
                                        Led {
                                            state: hemi.ok ? "live" : "connecting";
                                            dot-size: 6px;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            // role kicker
                                            Text {
                                                text: hemi.role;
                                                color: Theme.text-disabled;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.font-size-2xs;
                                                letter-spacing: Theme.letter-spacing-extra-wide;
                                            }
                                            // provider + model
                                            Text {
                                                text: hemi.provider != "" ? "\{hemi.provider} · \{hemi.model}" : "not configured";
                                                color: hemi.ok ? Theme.audit : Theme.text-tertiary;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.font-size-xs;
                                            }
                                        }
                                    }
                                }

                                if root.ov-hemispheres.length == 0: Text {
                                    text: "Hemisphere data unavailable.";
                                    color: Theme.text-disabled;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-xs;
                                }

                                RefreshFooter { ts: root.ov-refreshed-at; }
                            }
                        }

                        // ── SKILLS & PLUGINS card ────────────────────────────
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                alignment: start;

                                Kicker { label: "SKILLS & PLUGINS"; }

                                HorizontalLayout {
                                    spacing: 18px;
                                    alignment: start;
                                    height: 36px;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: root.ov-skills-active != "" ? root.ov-skills-active : "—";
                                            color: Theme.memory;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-lg;
                                        }
                                        Text {
                                            text: "SKILLS";
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            letter-spacing: Theme.letter-spacing-wide;
                                        }
                                    }

                                    Rectangle {
                                        width: 1px;
                                        background: Theme.border-default;
                                        height: 28px;
                                        y: 4px;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: root.ov-plugins-active != "" ? root.ov-plugins-active : "—";
                                            color: Theme.audit;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-lg;
                                        }
                                        Text {
                                            text: "PLUGINS";
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            letter-spacing: Theme.letter-spacing-wide;
                                        }
                                    }
                                }

                                // Top skill names
                                for name[i] in root.ov-skill-names: Rectangle {
                                    height: 26px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.memory-tint;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    visible: i < 3;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        alignment: start;
                                        Text {
                                            text: name;
                                            color: Theme.memory;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Top plugin names
                                for name[i] in root.ov-plugin-names: Rectangle {
                                    height: 26px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.audit-tint;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    visible: i < 3;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        alignment: start;
                                        Text {
                                            text: name;
                                            color: Theme.audit;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                RefreshFooter { ts: root.ov-refreshed-at; }
                            }
                        }

                        // ── CALENDAR card ─────────────────────────────────────
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    height: 18px;
                                    Kicker { label: "CALENDAR"; }
                                    Rectangle { horizontal-stretch: 1; }
                                    if !root.ov-calendar-configured: Text {
                                        text: "not configured";
                                        color: Theme.text-disabled;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.ov-calendar-configured: VerticalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    for ev[i] in root.ov-calendar-events: Rectangle {
                                        height: 36px;
                                        border-radius: Theme.radius-sm;
                                        background: Theme.surface-1;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;
                                        visible: i < 3;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            alignment: start;
                                            spacing: 10px;
                                            Text {
                                                text: ev.time;
                                                color: Theme.memory;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.font-size-2xs;
                                                letter-spacing: Theme.letter-spacing-tight;
                                                vertical-alignment: center;
                                                width: 54px;
                                            }
                                            Text {
                                                text: ev.summary;
                                                color: Theme.text-secondary;
                                                font-family: Theme.font-sans;
                                                font-size: Theme.font-size-sm;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    if root.ov-calendar-events.length == 0: Text {
                                        text: "No upcoming events.";
                                        color: Theme.text-disabled;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-xs;
                                    }
                                }

                                if !root.ov-calendar-configured: Text {
                                    text: "Configure CalDAV in Settings → Channels to enable.";
                                    color: Theme.text-disabled;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-xs;
                                }

                                RefreshFooter { ts: root.ov-refreshed-at; }
                            }
                        }

                        // ── CONSENT card ──────────────────────────────────────
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                alignment: start;

                                Kicker { label: "CONSENT"; }

                                for entry in root.ov-consent-entries: Rectangle {
                                    height: 30px;
                                    border-radius: Theme.radius-sm;
                                    background: entry.granted ? Theme.consent-tint : Theme.surface-1;
                                    border-width: 1px;
                                    border-color: entry.granted ? Theme.consent : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: start;
                                        spacing: 8px;
                                        Led {
                                            state: entry.granted ? "live" : "off";
                                            dot-size: 6px;
                                            // Led color: "live"=memory-green, "off"=text-disabled.
                                            // Consent semantics (pink) expressed via parent bg-tint above.
                                        }
                                        Text {
                                            text: entry.provider;
                                            color: entry.granted ? Theme.consent : Theme.text-tertiary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-xs;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: entry.granted ? "GRANTED" : "PENDING";
                                            color: entry.granted ? Theme.consent : Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            letter-spacing: Theme.letter-spacing-wide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if root.ov-consent-entries.length == 0: Text {
                                    text: "No consent records found.";
                                    color: Theme.text-disabled;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-xs;
                                }

                                if root.ov-smart-approve != "": Rectangle {
                                    height: 30px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.surface-1;
                                    border-width: 1px;
                                    border-color: Theme.border-default;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        alignment: start;
                                        spacing: 6px;
                                        Text {
                                            text: "★";
                                            color: Theme.consent;
                                            font-size: Theme.font-size-xs;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "smart-approve: \{root.ov-smart-approve}";
                                            color: Theme.text-tertiary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                RefreshFooter { ts: root.ov-refreshed-at; }
                            }
                        }
                    }
                }
            }
        }
    }
}
