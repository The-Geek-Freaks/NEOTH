// NEOTH app-shell content tabs that are net-new vs the legacy GUI — the
// design mockup (ui_kits/desktop) carries them as top-level surfaces. Each is
// a real, wired view (not a placeholder): Resources reads the live hardware
// probe; Doctor runs `neoth doctor`.

import { Theme } from "theme.slint";
import { SegBar, Skeleton, Led, Kicker, NeothButton, RefreshFooter, EmptyState } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// One labelled stat row (mono eyebrow + value).
component StatRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 52px;
    border-radius: Theme.radius-md;
    background: Theme.surface-1;
    border-width: 1px; border-color: Theme.border-subtle;
    HorizontalLayout {
        padding-left: 16px; padding-right: 16px; alignment: space-between;
        VerticalLayout {
            alignment: center; spacing: 3px;
            Text {
                text: root.label; color: Theme.text-tertiary;
                overflow: elide;
                font-family: Theme.font-mono; font-size: Theme.font-size-2xs;
                letter-spacing: Theme.letter-spacing-wide;
            }
            Text {
                text: root.value != "" ? root.value : "—";
                overflow: elide;
                color: Theme.text-primary; font-family: Theme.font-sans; font-size: Theme.font-size-base;
            }
        }
    }
}

// W185 typed daemon-owned local-model row. Readiness is already projected by
// Rust; only a core `ready` record can say "Ready (probe verified)".
export struct LocalModelRow {
    model: string,
    readiness: string,
    progress: string,
    resources: string,
    operation-id: string,
    can-pull: bool,
    can-update: bool,
    can-prune: bool,
    can-cancel: bool,
    can-retry: bool,
}

// Resources — the live hardware probe (CPU / memory / accelerator / VRAM /
// disk / local models), the mockup's "neoth-core" surface.
export component ResourcesView inherits Rectangle {
    // Entrance fade — same contract as EntranceFade (E-wave homogeneity).
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Theme.duration-entrance; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    in property <string> cpu;
    in property <string> memory;
    in property <string> accelerator;
    in property <string> vram;
    in property <float> vram-fraction;
    in property <string> disk;
    in property <int> models-count: 0;
    // GUI-HARDWARE-RESOURCES-01 — runtime load readout, e.g. "CPU 23% · GPU 41% · 62°C · 118W".
    in property <string> load-readout;
    in property <[LocalModelRow]> local-models: [];
    in property <string> local-model-endpoint: "Checking local-model status…";
    in property <bool> local-model-status-valid: false;
    in property <string> local-model-status-error: "";
    in property <bool> local-model-in-flight: false;
    in property <string> local-model-refreshed: "";
    callback local-model-pull(string);
    callback local-model-update(string);
    callback local-model-prune(string);
    callback local-model-cancel(string);
    callback local-model-retry(string);

    background: Theme.bg-base;
    VerticalLayout {
        padding: 28px; spacing: 14px; alignment: start;

        Text {
            text: "Local hardware — your compute, your machine.";
            color: Theme.text-secondary; font-family: Theme.font-sans; font-size: Theme.font-size-md;
        }

        StatRow { label: "CPU"; value: root.cpu; }
        StatRow { label: "MEMORY"; value: root.memory; }
        StatRow { label: "ACCELERATOR"; value: root.accelerator; }

        // VRAM with a usage meter
        Rectangle {
            height: 72px; border-radius: Theme.radius-md;
            background: Theme.surface-1; border-width: 1px; border-color: Theme.border-subtle;
            VerticalLayout {
                padding: 16px; spacing: 8px;
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "VRAM"; color: Theme.text-tertiary; font-family: Theme.font-mono;
                           font-size: Theme.font-size-2xs; letter-spacing: Theme.letter-spacing-wide; }
                    Text { text: root.vram != "" ? root.vram : "—"; color: Theme.text-primary;
                           font-family: Theme.font-sans; font-size: Theme.font-size-base;
                           overflow: elide; }
                }
                // GOLD-ADAPT-GUI-03 — stepped SegBar replaces the continuous
                // fill: 12 segments read like an instrument meter.
                SegBar {
                    segments: 12;
                    fraction: root.vram-fraction;
                    fill: Theme.audit;   // cyan = compute/info
                }
            }
        }

        // GUI-HARDWARE-RESOURCES-01 — compact load readout (CPU % · GPU % · temp · power).
        // Absent when all four metrics are None (CPU-only host / first probe not yet complete).
        if root.load-readout != "": StatRow { label: "LOAD"; value: root.load-readout; }
        StatRow { label: "DISK"; value: root.disk; }
        StatRow { label: "LOCAL MODELS"; value: root.models-count > 0 ? "\{root.models-count} installed" : "none"; }

        Rectangle {
            // This is a VerticalLayout child. Let that layout assign the
            // width; deriving it from parent.width feeds its intrinsic width
            // calculation back into the shell. The card's natural height is
            // the body's preferred height, not the body's assigned height.
            horizontal-stretch: 1;
            height: local-models-body.preferred-height + 42px;
            border-radius: Theme.radius-lg; background: Theme.surface-1;
            border-width: 1px; border-color: root.local-model-status-valid ? Theme.border-subtle : Theme.border-accent;
            local-models-body := VerticalLayout {
                x: 16px; y: 16px; width: parent.width - 32px; spacing: 10px;
                HorizontalLayout {
                    Text { text: "OLLAMA MODELS"; color: Theme.text-primary; font-family: Theme.font-mono; font-size: Theme.font-size-sm; }
                    Text { horizontal-stretch: 1; text: root.local-model-in-flight ? "action in progress…" : root.local-model-endpoint; color: Theme.text-secondary; font-family: Theme.font-sans; font-size: Theme.font-size-sm; overflow: elide; horizontal-alignment: right; }
                }
                if root.local-model-status-error != "": Text { text: root.local-model-status-error; color: Theme.warning; font-family: Theme.font-sans; font-size: Theme.font-size-sm; wrap: word-wrap; }
                if root.local-models.length == 0: Text { text: root.local-model-status-valid ? "No local model inventory returned." : "Local-model status has not been verified."; color: Theme.text-tertiary; font-family: Theme.font-sans; font-size: Theme.font-size-sm; }
                for row in root.local-models: Rectangle {
                    // As above, use the row's intrinsic height and let the
                    // enclosing VerticalLayout own its allocated width.
                    horizontal-stretch: 1;
                    height: model-row-body.preferred-height + 24px; border-radius: Theme.radius-md;
                    background: Theme.surface-2; border-width: 1px; border-color: Theme.border-subtle;
                    model-row-body := VerticalLayout {
                        x: 12px; y: 12px; width: parent.width - 24px; spacing: 7px;
                        HorizontalLayout {
                            Text { text: row.model; horizontal-stretch: 1; color: Theme.text-primary; font-family: Theme.font-mono; font-size: Theme.font-size-sm; overflow: elide; }
                            Text { text: row.readiness; color: row.readiness == "Ready (probe verified)" ? Theme.accent : Theme.text-secondary; font-family: Theme.font-sans; font-size: Theme.font-size-sm; overflow: elide; }
                        }
                        Text { text: row.resources; color: Theme.text-tertiary; font-family: Theme.font-mono; font-size: Theme.font-size-2xs; overflow: elide; }
                        if row.progress != "" || row.operation-id != "": Text { text: row.progress != "" ? "Progress: " + row.progress : "Operation: " + row.operation-id; color: Theme.text-tertiary; font-family: Theme.font-mono; font-size: Theme.font-size-2xs; overflow: elide; }
                        HorizontalLayout { spacing: 6px;
                            Rectangle { width: pull.width + 16px; height: 28px; border-radius: Theme.radius-pill; background: row.can-pull && !root.local-model-in-flight ? Theme.accent-tint : Theme.surface-1; accessible-role: button; accessible-label: "Pull " + row.model; accessible-enabled: row.can-pull && !root.local-model-in-flight; accessible-action-default => { if (row.can-pull && !root.local-model-in-flight) { root.local-model-pull(row.model); } } pull := Text { text: "Pull"; color: row.can-pull && !root.local-model-in-flight ? Theme.accent : Theme.text-tertiary; font-family: Theme.font-sans; font-size: Theme.font-size-2xs; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (row.can-pull && !root.local-model-in-flight) { root.local-model-pull(row.model); } } } }
                            Rectangle { width: update.width + 16px; height: 28px; border-radius: Theme.radius-pill; background: row.can-update && !root.local-model-in-flight ? Theme.accent-tint : Theme.surface-1; accessible-role: button; accessible-label: "Update " + row.model; accessible-enabled: row.can-update && !root.local-model-in-flight; accessible-action-default => { if (row.can-update && !root.local-model-in-flight) { root.local-model-update(row.model); } } update := Text { text: "Update"; color: row.can-update && !root.local-model-in-flight ? Theme.accent : Theme.text-tertiary; font-family: Theme.font-sans; font-size: Theme.font-size-2xs; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (row.can-update && !root.local-model-in-flight) { root.local-model-update(row.model); } } } }
                            Rectangle { width: prune.width + 16px; height: 28px; border-radius: Theme.radius-pill; background: row.can-prune && !root.local-model-in-flight ? Theme.accent-tint : Theme.surface-1; accessible-role: button; accessible-label: "Prune " + row.model; accessible-enabled: row.can-prune && !root.local-model-in-flight; accessible-action-default => { if (row.can-prune && !root.local-model-in-flight) { root.local-model-prune(row.model); } } prune := Text { text: "Prune"; color: row.can-prune && !root.local-model-in-flight ? Theme.accent : Theme.text-tertiary; font-family: Theme.font-sans; font-size: Theme.font-size-2xs; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (row.can-prune && !root.local-model-in-flight) { root.local-model-prune(row.model); } } } }
                            Rectangle { width: cancel.width + 16px; height: 28px; border-radius: Theme.radius-pill; background: row.can-cancel && !root.local-model-in-flight ? Theme.warning-tint : Theme.surface-1; accessible-role: button; accessible-label: "Cancel " + row.operation-id; accessible-enabled: row.can-cancel && !root.local-model-in-flight; accessible-action-default => { if (row.can-cancel && !root.local-model-in-flight) { root.local-model-cancel(row.operation-id); } } cancel := Text { text: "Cancel"; color: row.can-cancel && !root.local-model-in-flight ? Theme.warning : Theme.text-tertiary; font-family: Theme.font-sans; font-size: Theme.font-size-2xs; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (row.can-cancel && !root.local-model-in-flight) { root.local-model-cancel(row.operation-id); } } } }
                            Rectangle { width: retry.width + 16px; height: 28px; border-radius: Theme.radius-pill; background: row.can-retry && !root.local-model-in-flight ? Theme.accent-tint : Theme.surface-1; accessible-role: button; accessible-label: "Retry " + row.operation-id; accessible-enabled: row.can-retry && !root.local-model-in-flight; accessible-action-default => { if (row.can-retry && !root.local-model-in-flight) { root.local-model-retry(row.operation-id); } } retry := Text { text: "Retry"; color: row.can-retry && !root.local-model-in-flight ? Theme.accent : Theme.text-tertiary; font-family: Theme.font-sans; font-size: Theme.font-size-2xs; horizontal-alignment: center; vertical-alignment: center; } TouchArea { clicked => { if (row.can-retry && !root.local-model-in-flight) { root.local-model-retry(row.operation-id); } } } }
                        }
                    }
                }
                if root.local-model-refreshed != "": Text { text: root.local-model-refreshed; color: Theme.text-tertiary; font-family: Theme.font-mono; font-size: Theme.font-size-2xs; }
            }
        }
    }
}

// Reusable read-only probe surface: a header line, a refresh action, and a
// mono output panel. Used by Agents (cluster/agent topology) and Automation
// (cron jobs + n8n). The Buddy reacts via the caller's GuiActivity.
export component ProbeView inherits Rectangle {
    // Entrance fade — same contract as EntranceFade (E-wave homogeneity).
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Theme.duration-entrance; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    in property <string> blurb;
    in property <string> action-label: "Refresh";
    in property <string> output: "";
    in property <bool> running: false;
    in property <string> empty-hint: "Click refresh to load.";
    callback run-clicked();

    background: Theme.bg-base;
    VerticalLayout {
        padding: 28px; spacing: 14px;
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: root.blurb; color: Theme.text-secondary;
                font-family: Theme.font-sans; font-size: Theme.font-size-md; vertical-alignment: center;
                wrap: word-wrap;
            }
            Rectangle {
                width: btn.width + 32px; height: 38px; border-radius: Theme.radius-pill;
                background: root.running ? Theme.surface-2 : Theme.accent-tint;
                border-width: probe-focus.has-focus ? 2px : 1px;
                border-color: probe-focus.has-focus ? Theme.focus-ring : Theme.border-accent;
                accessible-role: button;
                accessible-label: root.action-label;
                accessible-enabled: !root.running;
                accessible-action-default => { if (!root.running) { root.run-clicked(); } }
                btn := Text {
                    text: root.running ? "running…" : root.action-label;
                    color: root.running ? Theme.text-tertiary : Theme.accent;
                    font-family: Theme.font-sans; font-size: Theme.font-size-sm; vertical-alignment: center;
                }
                probe-focus := FocusScope {
                    enabled: !root.running;
                    key-pressed(event) => {
                        if event.text == "\n" || event.text == " " {
                            root.run-clicked();
                            return accept;
                        }
                        return reject;
                    }
                }
                TouchArea {
                    clicked => { if (!root.running) { probe-focus.focus(); root.run-clicked(); } }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1; border-radius: Theme.radius-lg;
            background: Theme.bg-void; border-width: 1px; border-color: Theme.border-subtle;
            // E2 — shape-matched shimmer while the first probe is in flight.
            if root.running && root.output == "": Skeleton {
                x: 18px; y: 16px; width: parent.width - 36px;
                rows: 5;
            }
            if !(root.running && root.output == ""): Flickable {
                viewport-width: self.width;
                Text {
                    x: 18px; y: 16px; width: parent.width - 36px;
                    text: root.output != "" ? root.output : root.empty-hint;
                    color: root.output != "" ? Theme.text-secondary : Theme.text-tertiary;
                    font-family: Theme.font-mono; font-size: Theme.font-size-sm; wrap: word-wrap;
                }
            }
        }
    }
}

// Doctor — runs `neoth doctor` and renders the check output. min:0 in the
// mockup nav (always available); a one-click health probe.
// GAP-05: second probe section "Status" → `neoth status`.
// GAP-13: third probe section "Security audit" → `neoth security audit`.
export component DoctorView inherits Rectangle {
    // Entrance fade — same contract as EntranceFade (E-wave homogeneity).
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Theme.duration-entrance; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    in property <string> output: "";
    in property <bool> running: false;
    callback run-clicked();

    // GAP-05 — Status probe.
    in property <string> status-output: "";
    in property <bool> status-running: false;
    callback status-run-clicked();

    // GAP-13 — Security audit probe.
    in property <string> security-output: "";
    in property <bool> security-running: false;
    callback security-run-clicked();

    // C4/undo — reversible-actions probe (neoth undo, read-only list).
    in property <string> undo-output: "";
    in property <bool> undo-running: false;
    callback undo-run-clicked();

    background: Theme.bg-base;
    VerticalLayout {
        padding: 28px; spacing: 14px;

        // ── Doctor ────────────────────────────────────────────────────
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                alignment: center; spacing: 3px;
                Text {
                    text: "System health — read-only checks across providers, storage, channels, cluster.";
                    color: Theme.text-secondary; font-family: Theme.font-sans; font-size: Theme.font-size-md;
                }
            }
            Rectangle {
                width: btn.width + 32px; height: 38px; border-radius: Theme.radius-pill;
                background: root.running ? Theme.surface-2 : Theme.accent-tint;
                border-width: doc-focus.has-focus ? 2px : 1px;
                border-color: doc-focus.has-focus ? Theme.focus-ring : Theme.border-accent;
                accessible-role: button;
                accessible-label: "Run neoth doctor";
                accessible-enabled: !root.running;
                accessible-action-default => { if (!root.running) { root.run-clicked(); } }
                btn := Text {
                    text: root.running ? "running…" : "Run neoth doctor";
                    color: root.running ? Theme.text-tertiary : Theme.accent;
                    font-family: Theme.font-sans; font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                doc-focus := FocusScope {
                    enabled: !root.running;
                    key-pressed(event) => {
                        if event.text == "\n" || event.text == " " {
                            root.run-clicked();
                            return accept;
                        }
                        return reject;
                    }
                }
                TouchArea {
                    clicked => { if (!root.running) { doc-focus.focus(); root.run-clicked(); } }
                }
            }
        }

        Rectangle {
            height: 220px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-void;
            border-width: 1px; border-color: Theme.border-subtle;
            Flickable {
                viewport-width: self.width;
                Text {
                    x: 18px; y: 16px; width: parent.width - 36px;
                    text: root.output != "" ? root.output : "Click \"Run neoth doctor\" to probe the system.";
                    color: root.output != "" ? Theme.text-secondary : Theme.text-tertiary;
                    font-family: Theme.font-mono; font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }
        }

        // ── GAP-05: Status ────────────────────────────────────────────
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                alignment: center; spacing: 3px;
                Text {
                    text: "Status — daemon, providers, channels, cluster (neoth status).";
                    color: Theme.text-secondary; font-family: Theme.font-sans; font-size: Theme.font-size-md;
                }
            }
            Rectangle {
                width: sbtn.width + 32px; height: 38px; border-radius: Theme.radius-pill;
                background: root.status-running ? Theme.surface-2 : Theme.accent-tint;
                border-width: stat-focus.has-focus ? 2px : 1px;
                border-color: stat-focus.has-focus ? Theme.focus-ring : Theme.border-accent;
                accessible-role: button;
                accessible-label: "Run status";
                accessible-enabled: !root.status-running;
                accessible-action-default => { if (!root.status-running) { root.status-run-clicked(); } }
                sbtn := Text {
                    text: root.status-running ? "running…" : "Run";
                    overflow: elide;
                    color: root.status-running ? Theme.text-tertiary : Theme.accent;
                    font-family: Theme.font-sans; font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                stat-focus := FocusScope {
                    enabled: !root.status-running;
                    key-pressed(event) => {
                        if event.text == "\n" || event.text == " " {
                            root.status-run-clicked();
                            return accept;
                        }
                        return reject;
                    }
                }
                TouchArea {
                    clicked => { if (!root.status-running) { stat-focus.focus(); root.status-run-clicked(); } }
                }
            }
        }

        Rectangle {
            height: 160px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-void;
            border-width: 1px; border-color: Theme.border-subtle;
            Flickable {
                viewport-width: self.width;
                Text {
                    x: 18px; y: 16px; width: parent.width - 36px;
                    text: root.status-output != "" ? root.status-output : "Click \"Run\" to fetch status.";
                    color: root.status-output != "" ? Theme.text-secondary : Theme.text-tertiary;
                    font-family: Theme.font-mono; font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }
        }

        // ── GAP-13: Security audit ────────────────────────────────────
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                alignment: center; spacing: 3px;
                Text {
                    text: "Security audit — OWASP checks, WAL integrity, credential hygiene (neoth security audit).";
                    color: Theme.text-secondary; font-family: Theme.font-sans; font-size: Theme.font-size-md;
                }
            }
            Rectangle {
                width: abtn.width + 32px; height: 38px; border-radius: Theme.radius-pill;
                background: root.security-running ? Theme.surface-2 : Theme.accent-tint;
                border-width: audit-focus.has-focus ? 2px : 1px;
                border-color: audit-focus.has-focus ? Theme.focus-ring : Theme.border-accent;
                accessible-role: button;
                accessible-label: "Run audit";
                accessible-enabled: !root.security-running;
                accessible-action-default => { if (!root.security-running) { root.security-run-clicked(); } }
                abtn := Text {
                    text: root.security-running ? "running…" : "Run audit";
                    color: root.security-running ? Theme.text-tertiary : Theme.accent;
                    font-family: Theme.font-sans; font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                audit-focus := FocusScope {
                    enabled: !root.security-running;
                    key-pressed(event) => {
                        if event.text == "\n" || event.text == " " {
                            root.security-run-clicked();
                            return accept;
                        }
                        return reject;
                    }
                }
                TouchArea {
                    clicked => { if (!root.security-running) { audit-focus.focus(); root.security-run-clicked(); } }
                }
            }
        }

        Rectangle {
            height: 160px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-void;
            border-width: 1px; border-color: Theme.border-subtle;
            Flickable {
                viewport-width: self.width;
                Text {
                    x: 18px; y: 16px; width: parent.width - 36px;
                    text: root.security-output != "" ? root.security-output : "Click \"Run audit\" to check security posture.";
                    color: root.security-output != "" ? Theme.text-secondary : Theme.text-tertiary;
                    font-family: Theme.font-mono; font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }
        }

        // ── C4/undo: recent reversible actions (neoth undo) ───────────
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                alignment: center; spacing: 3px;
                Text {
                    text: "Undo — recent state-mutating actions with a reversible inverse (neoth undo). Read-only list; reverse from the CLI with neoth undo apply <n>.";
                    color: Theme.text-secondary; font-family: Theme.font-sans; font-size: Theme.font-size-md;
                }
            }
            Rectangle {
                width: ubtn.width + 32px; height: 38px; border-radius: Theme.radius-pill;
                background: root.undo-running ? Theme.surface-2 : Theme.accent-tint;
                border-width: 1px; border-color: Theme.border-accent;
                ubtn := Text {
                    text: root.undo-running ? "running…" : "Show";
                    color: root.undo-running ? Theme.text-tertiary : Theme.accent;
                    font-family: Theme.font-sans; font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { if (!root.undo-running) { root.undo-run-clicked(); } }
                    accessible-role: button;
                    accessible-label: "show reversible actions";
                    accessible-action-default => { if (!root.undo-running) { root.undo-run-clicked(); } }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-lg;
            background: Theme.bg-void;
            border-width: 1px; border-color: Theme.border-subtle;
            Flickable {
                viewport-width: self.width;
                Text {
                    x: 18px; y: 16px; width: parent.width - 36px;
                    text: root.undo-output != "" ? root.undo-output : "Click \"Show\" to list recent reversible actions.";
                    color: root.undo-output != "" ? Theme.text-secondary : Theme.text-tertiary;
                    font-family: Theme.font-mono; font-size: Theme.font-size-sm;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ── I14 — Slash-command browser ───────────────────────────────────────
// Structured rendering of `neoth slash list --output json`. Read-only by
// design: `slash add/remove` verbs do not exist (R4-05 dead-button rule);
// operator overrides live in ~/.neoth/commands/*.toml.
export struct SlashCmdRow {
    name: string,         // "/recall"
    source: string,       // "builtin" | "operator"
    description: string,
    enabled: bool,
}

component SlashCmdCard inherits Rectangle {
    in property <SlashCmdRow> cmd;

    background: Theme.bg-card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding: 12px; spacing: 10px;

        Led {
            state: root.cmd.enabled ? "live" : "off";
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.cmd.name;
            color: Theme.text-primary;
            font-family: Theme.font-mono;
            font-size: Theme.font-size-xs;
            vertical-alignment: center;
        }
        // source chip — operator overrides stand out from builtins
        Rectangle {
            width: src-txt.preferred-width + 12px; height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-pill;
            background: root.cmd.source == "operator" ? Theme.surface-3 : Theme.surface-1;
            border-width: 1px; border-color: Theme.border-subtle;
            src-txt := Text {
                text: root.cmd.source;
                color: root.cmd.source == "operator" ? Theme.accent : Theme.text-tertiary;
                font-family: Theme.font-mono;
                font-size: Theme.font-size-2xs;
                horizontal-alignment: center; vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }
        Text {
            text: root.cmd.description;
            color: Theme.text-secondary;
            font-family: Theme.font-sans;
            font-size: Theme.font-size-2xs;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    accessible-role: AccessibleRole.text;
    accessible-label: "slash command " + root.cmd.name + " — "
        + (root.cmd.enabled ? "enabled" : "disabled") + ", " + root.cmd.source;
}

export component SlashCmdsView inherits Rectangle {
    // Entrance fade — same contract as EntranceFade (E-wave homogeneity).
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Theme.duration-entrance; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    in property <[SlashCmdRow]> slash-cmds: [];
    in property <bool>   slash-loading: false;
    in property <string> slash-refreshed-at: "";
    in property <bool>   slash-valid: true;
    in property <string> slash-error: "";

    callback slash-refresh();

    ScrollView {
        VerticalLayout {
            padding: Theme.space-base;
            spacing: 14px;

            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Kicker { text: "CHAT SURFACE"; }
                    Text {
                        text: "Slash Commands";
                        color: Theme.text-primary;
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-lg;
                    }
                    Text {
                        text: "builtins + operator overrides from ~/.neoth/commands/*.toml (read-only here)";
                        color: Theme.text-tertiary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                    }
                }
                NeothButton {
                    label: root.slash-loading ? "Loading…" : "Refresh";
                    size: "sm";
                    primary: false;
                    enabled: !root.slash-loading;
                    clicked => { root.slash-refresh(); }
                }
            }

            if !root.slash-valid: Rectangle {
                min-height: 54px;
                border-radius: Theme.radius-sm;
                background: Theme.consent-tint;
                border-width: 1px;
                border-color: Theme.consent;
                Text {
                    text: "Slash commands could not be loaded: " + root.slash-error;
                    color: Theme.consent;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-size-2xs;
                    wrap: word-wrap;
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                }
                accessible-role: AccessibleRole.text;
                accessible-label: "Slash commands invalid: " + root.slash-error;
            }
            if root.slash-valid && root.slash-cmds.length == 0: EmptyState {
                glyph: "⧸";
                title: "No slash commands loaded";
                hint: "The CLI returned a valid empty command registry.";
            }
            for c in root.slash-cmds: SlashCmdCard { cmd: c; }

            RefreshFooter { ts: root.slash-refreshed-at; }
        }
    }
}
