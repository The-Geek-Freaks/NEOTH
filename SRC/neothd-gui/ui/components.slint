// NEOTH reusable components. Composed from `Theme` tokens so every
// screen lands on the same visual rhythm. No screen reaches past these
// for layout — if a new pattern emerges, lift it here first.
//
// Coherence rule: every interactive element MUST go through one of
// these components. No inline `Button { ... }`, no ad-hoc `Rectangle`
// for cards, no raw `Text` for screen titles. The 12/10 polish lives
// in tokens + components, not in per-screen hex codes.

import { Theme } from "theme.slint";

// ── NeothButton ──────────────────────────────────────────────────────
// Primary: dark fill, accent-green underline on hover (the "Neural
// Pulse" the brand spec calls for, simplified to a 2px bar).
// Secondary: ghost — transparent fill, accent-green border only.
//
// Both honour the disabled state with text-dim colour + no hover
// reaction.

export component NeothButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: true;
    in property <bool> enabled: true;
    // GOLD-ADAPT-GUI-07 — async in-flight state (yaak Button isLoading):
    // a rotating spinner replaces the label; clicks are ignored until the
    // caller flips `loading` back off.
    in property <bool> loading: false;
    // GOLD-ADAPT-GUI-08 — density variants (yaak ButtonSize): "md" (default
    // 44px), "sm" (32px), "xs" (28px) for dense settings rows.
    in property <string> size: "md";
    // Destructive accent (kill/delete actions): consent-pink instead of
    // memory-green. Same shape, different meaning-colour.
    in property <bool> danger: false;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled && !root.loading;
    accessible-action-default => {
        if root.enabled && !root.loading { root.clicked(); }
    }

    property <color> accent-color: root.danger ? Theme.accent-pink : Theme.accent-green;

    height: root.size == "sm" ? 32px : (root.size == "xs" ? 28px : 44px);
    width: max(root.size == "md" ? 120px : 64px,
        txt.preferred-width + (root.size == "md" ? Theme.space-loose : Theme.space-base) * 2);
    border-radius: Theme.radius-button;
    // GUI-overhaul: primary actions were a flat bg-card fill — indistinguishable
    // from the surrounding cards. An accent-tinted fill + accent border reads as
    // a clear primary CTA (secondary stays outline-only), without being flashy.
    background: root.primary ? root.accent-color.with-alpha(0.16) : transparent;
    border-width: key-focus.has-focus ? 2px : 1px;
    border-color: key-focus.has-focus ? Theme.focus-ring
        : root.enabled ? root.accent-color : Theme.border-subtle;
    opacity: root.enabled ? 1.0 : 0.4;

    // Sovereign-Curve hover lift via a thin accent bar at the
    // bottom. Subtle because the spec says "majestic, not flashy".
    underline := Rectangle {
        x: Theme.space-base;
        y: parent.height - 2px;
        height: 2px;
        width: 0;
        background: root.accent-color;
        animate width {
            duration: Theme.duration-micro;
            easing: cubic-bezier(0.2, 0.8, 0.2, 1);
        }
    }

    txt := Text {
        text: root.label;
        font-family: Theme.font-display;
        font-size: root.size == "md" ? Theme.font-size-body : Theme.font-size-caption;
        font-weight: Theme.weight-medium;
        letter-spacing: Theme.letter-spacing-body;
        color: root.enabled ? root.accent-color : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
        // Keep the button width stable while the spinner shows — the label
        // goes invisible but still drives preferred-width.
        opacity: root.loading ? 0.0 : 1.0;
    }

    if root.loading: Text {
        text: "◐";
        font-size: root.size == "md" ? Theme.font-size-body : Theme.font-size-caption;
        color: root.accent-color;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
        transform-rotation: 360deg * (animation-tick() / Theme.duration-spin);
    }

    key-focus := FocusScope {
        enabled: root.enabled && !root.loading;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled && !root.loading;
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }

    states [
        hovered when touch.has-hover && root.enabled && !root.loading: {
            underline.width: root.width - Theme.space-base * 2;
            txt.color: Theme.text-primary;
        }
    ]
}

// ── Card ─────────────────────────────────────────────────────────────
// 16px Noble-Curve radius, card-surface background, subtle border
// hairline. Every content block on every screen sits in one of these
// (or in a vertical-stack of them).

export component Card inherits Rectangle {
    // GOLD-ADAPT-GUI-01 — hover shimmer-sweep (nullframe .card.sweep).
    // Opt-out via `shimmer: false` for cards where any motion distracts.
    in property <bool> shimmer: true;

    background: Theme.bg-card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border-subtle;
    // FIX-5 — subtle elevation: ambient accent-glow halo.
    // A very-low-alpha glow lifts the card 1px above the canvas read.
    // No binding loop: drop-shadow props are static, no self-reference.
    drop-shadow-blur: 10px;
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: Theme.accent-glow;

    // Clipped overlay so the gradient never spills past the Noble Curve.
    // Declared before the instantiation children, so content (transparent
    // backgrounds throughout) renders above the sweep.
    if root.shimmer: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        clip: true;
        sweep := Rectangle {
            width: parent.width * 0.45;
            height: parent.height;
            x: -self.width;
            // Slint has no skewX; a soft translating gradient carries the
            // same "light passes over the card" read. Colours via the
            // ink-0 token (contract: no inline hex outside theme.slint).
            background: @linear-gradient(90deg,
                Theme.ink-0.with-alpha(0.0) 0%,
                Theme.ink-0.with-alpha(0.063) 50%,
                Theme.ink-0.with-alpha(0.0) 100%);
        }
        shim-touch := TouchArea {}
        states [
            sweeping when shim-touch.has-hover: {
                sweep.x: root.width;
                in {
                    animate sweep.x { duration: Theme.duration-sweep; easing: ease-out; }
                }
                out {
                    // Instant reset so re-hover always starts from the
                    // left edge (a symmetric reverse would read broken).
                    animate sweep.x { duration: 0ms; }
                }
            }
        ]
    }
}

// ── SegBar ───────────────────────────────────────────────────────────
// GOLD-ADAPT-GUI-03 — stepped-fill meter (nullframe Segbar.tsx): n
// discrete segments, the first round(fraction·n) light up in the given
// fill colour. Reads more "instrument panel" than a continuous bar.

export component SegBar inherits Rectangle {
    in property <int> segments: 12;
    in property <float> fraction: 0.0;
    in property <color> fill: Theme.audit;

    height: 6px;
    background: transparent;

    HorizontalLayout {
        spacing: 3px;
        for i in root.segments: Rectangle {
            border-radius: 2px;
            horizontal-stretch: 1;
            background: i < round(clamp(root.fraction, 0.0, 1.0) * root.segments)
                ? root.fill
                : Theme.surface-3;
        }
    }
}

// ── Expander ─────────────────────────────────────────────────────────
// GOLD-ADAPT-AOS-04 — collapsible domain section (agent-os standards/
// folder layout, translated to UI): mono eyebrow header + chevron, body
// mounts only while expanded (Slint `if` removes it from layout).

export component Expander inherits Rectangle {
    in property <string> title: "";
    in property <string> hint: "";
    in-out property <bool> expanded: true;

    background: Theme.bg-card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        // Header row — the whole strip toggles.
        Rectangle {
            height: 44px;
            background: head-touch.has-hover ? Theme.surface-2 : transparent;
            border-radius: Theme.radius-card;
            animate background { duration: Theme.duration-fast; easing: ease-out; }
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 10px;
                Text {
                    text: root.expanded ? "▾" : "▸";
                    color: Theme.accent;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    width: 14px;
                }
                Text {
                    text: root.title;
                    color: Theme.text-primary;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-size-2xs;
                    letter-spacing: Theme.letter-spacing-wide;
                    vertical-alignment: center;
                }
                Text {
                    text: root.hint;
                    color: Theme.text-tertiary;
                    font-family: Theme.font-sans;
                    font-size: Theme.font-size-2xs;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    horizontal-alignment: right;
                }
            }
            head-touch := TouchArea {
                clicked => { root.expanded = !root.expanded; }
            }
        }
        // @children can't sit in an `if` — collapse via animated clip
        // height instead (which also gives the fold a sovereign settle).
        Rectangle {
            clip: true;
            height: root.expanded ? body.preferred-height : 0px;
            animate height { duration: Theme.duration-base; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            body := VerticalLayout {
                width: 100%;
                padding: 16px;
                padding-top: 4px;
                spacing: 8px;
                @children
            }
        }
    }
}

// ── Led ──────────────────────────────────────────────────────────────
// GOLD-ADAPT-GUI-04 — live-state dot (nullframe .led): colour carries
// the daemon state (green=live · amber=connecting · pink=error), a slow
// opacity breathe signals "this is a live reading, not a static icon".

export component Led inherits Rectangle {
    in property <string> state: "live";   // "live" | "connecting" | "error" | "off"
    in property <length> dot-size: 7px;

    property <color> dot-color: root.state == "live" ? Theme.memory
        : (root.state == "connecting" ? Theme.warning
        : (root.state == "error" ? Theme.consent : Theme.text-disabled));

    width: root.dot-size;
    height: root.dot-size;
    border-radius: root.dot-size / 2;
    background: root.dot-color;
    opacity: root.state == "off"
        ? 0.5
        : 0.55 + 0.45 * sin(360deg * (animation-tick() / Theme.duration-breathe));
}

// ── ScreenHeader ─────────────────────────────────────────────────────
// Section title + one-line subtitle. Pinned typography per the brand
// spec — title is light-weight + tight letter-spacing, subtitle is
// muted body with the standard +2% spacing.

export component ScreenHeader inherits VerticalLayout {
    in property <string> title: "";
    in property <string> subtitle: "";

    spacing: Theme.space-tight;

    Text {
        text: root.title;
        font-family: Theme.font-display;
        font-size: Theme.font-size-h1;
        font-weight: Theme.weight-light;
        letter-spacing: Theme.letter-spacing-tight;
        color: Theme.text-primary;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        font-family: Theme.font-display;
        font-size: Theme.font-size-body;
        font-weight: Theme.weight-regular;
        letter-spacing: Theme.letter-spacing-body;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}

// ── ProgressIndicator ────────────────────────────────────────────────
// Top-of-window step counter + thin progress bar. Operator sees "where
// am I + how much further". Sovereign-Curve animation on the fill bar
// so step transitions feel intentional.

export component ProgressIndicator inherits Rectangle {
    in property <int> current-step: 1;
    in property <int> total-steps: 8;
    in property <string> step-label: "";

    height: 56px;
    background: Theme.bg-base;

    VerticalLayout {
        padding-left: Theme.space-screen;
        padding-right: Theme.space-screen;
        padding-top: Theme.space-base;
        spacing: Theme.space-tight;

        HorizontalLayout {
            alignment: space-between;
            spacing: Theme.space-base;
            Text {
                text: "NEOTH";
                font-family: Theme.font-display;
                font-size: Theme.font-size-body;
                font-weight: Theme.weight-ultralight;
                letter-spacing: Theme.letter-spacing-brand-bar;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Theme.space-base;
                Text {
                    text: root.step-label;
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-caption;
                    font-weight: Theme.weight-regular;
                    letter-spacing: Theme.letter-spacing-body;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Text {
                    text: "Step " + root.current-step + " of " + root.total-steps;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-size-caption;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }
            }
        }

        // Progress track — thin bar at the bottom, fills left-to-right.
        Rectangle {
            height: 2px;
            background: Theme.border-subtle;
            border-radius: 1px;
            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: parent.width * (root.current-step / root.total-steps);
                background: Theme.accent-green;
                border-radius: 1px;
                animate width {
                    duration: Theme.duration-screen-min;
                    easing: cubic-bezier(0.2, 0.8, 0.2, 1);
                }
            }
        }
    }
}

// ── ModeCard ─────────────────────────────────────────────────────────
// Big-tile mode picker for the very first screen (CLI vs GUI flow).
// Carries a hand-drawn SVG glyph + title + one-line subtitle + a
// "recommended" pill when applicable. Card surface, 16px Noble curve,
// accent-green border on hover.
//
// Each option is a full visual decision — the operator can pick at a
// glance without reading paragraphs.

export component ModeCard inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <bool> recommended: false;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <image> glyph;
    callback clicked();

    accessible-role: radio-button;
    accessible-label: root.title + ". " + root.subtitle
        + (root.recommended ? " Recommended." : "");
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }
    forward-focus: key-focus;

    width: 260px;
    height: 320px;
    background: root.selected ? Theme.bg-card : Theme.bg-base;
    border-width: key-focus.has-focus ? 3px : 2px;
    border-color: key-focus.has-focus ? Theme.focus-ring
        : root.selected ? Theme.accent-green
        : touch.has-hover && root.enabled ? Theme.accent-green.with-alpha(0.6)
        : Theme.border-subtle;
    border-radius: Theme.radius-card;
    opacity: root.enabled ? 1.0 : 0.55;

    animate border-color {
        duration: Theme.duration-micro;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    animate background {
        duration: Theme.duration-micro;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    VerticalLayout {
        padding: Theme.space-loose;
        spacing: Theme.space-base;

        // SVG glyph — operator's first visual anchor.
        Image {
            source: root.glyph;
            width: 100%;
            height: 140px;
            image-fit: contain;
        }

        VerticalLayout {
            spacing: Theme.space-tight;
            Text {
                text: root.title;
                font-family: Theme.font-display;
                font-size: Theme.font-size-h2;
                font-weight: Theme.weight-light;
                letter-spacing: Theme.letter-spacing-tight;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }
            Text {
                text: root.subtitle;
                font-family: Theme.font-display;
                font-size: Theme.font-size-caption;
                font-weight: Theme.weight-regular;
                letter-spacing: Theme.letter-spacing-body;
                color: Theme.text-muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // G-24 fix: token-driven sizes so high-DPI / font-scaling
        // doesn't clip the pill. Width derived from text + padding,
        // height tracks caption font size.
        if root.recommended: Rectangle {
            width: pill-text.preferred-width + Theme.space-loose;
            height: max(22px, Theme.font-size-caption + 8px);
            background: transparent;
            border-color: Theme.accent-green;
            border-width: 1px;
            border-radius: Theme.radius-button;
            pill-text := Text {
                text: "RECOMMENDED";
                font-family: Theme.font-display;
                font-size: Theme.font-size-caption;
                font-weight: Theme.weight-bold;
                letter-spacing: Theme.letter-spacing-wide;
                color: Theme.accent-green;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    key-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }
}

// ── SovereignFade ────────────────────────────────────────────────────
// G-27 (2026-05-21): screen-entry opacity fade per the design
// system's sovereign-curve specification. Wrap any screen body in
// this component to get a 600ms ease-in fade-in on mount. Slint
// remounts the inner block when the parent `if root.step == X:`
// condition flips, so `init` re-fires + the animation re-plays.
//
// Exit fades are NOT possible in Slint 1.8 (component is unmounted
// before any animation can run). Operator gets entry-only polish;
// the spec accepts this trade-off because exit perception is
// dominated by the new screen's entry.

export component SovereignFade inherits Rectangle {
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity {
        duration: Theme.duration-screen-min;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }
}

// ── EntranceFade ─────────────────────────────────────────────────────
// Wave-1 primitive. Mirrors CSS `nh-in` keyframe intent:
//   opacity 0→1, 500ms cubic-bezier(0.16,1,0.3,1).
//
// Slint 1.8 layout constraint: `x`/`y` set on a child of VerticalLayout /
// HorizontalLayout are overridden by the layout engine — the offset part of
// `nh-in` (translateY 10px→0) cannot be expressed on a layout child.
// The component therefore animates opacity only when placed inside a layout.
// For absolute overlays (not in a layout) the caller may also set `y` to
// create the offset effect — the opacity animation still fires via `init`.
// Exit fades are NOT possible in Slint 1.8 (unmount precedes animation).
export component EntranceFade inherits Rectangle {
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Theme.duration-entrance; easing: cubic-bezier(0.16, 1, 0.3, 1); }
}

// ── SideIn ───────────────────────────────────────────────────────────
// Wave-1 primitive. Mirrors CSS `nh-side-in` keyframe intent:
//   opacity 0→1, 440ms cubic-bezier(0.16,1,0.3,1).
//
// Same Slint 1.8 layout constraint as EntranceFade: the translateX(22px→0)
// part of nh-side-in cannot fire on a layout child. The component animates
// opacity only. For absolute-position callers, pair with a manual `x` bind.
export component SideIn inherits Rectangle {
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Theme.duration-side-in; easing: cubic-bezier(0.16, 1, 0.3, 1); }
}

// ── ToastData struct ─────────────────────────────────────────────────
// Wire type shared between components.slint and main.slint (and Rust).
// `kind` drives the coloured led:
//   "info"    → audit cyan
//   "success" → accent green
//   "warn"    → warning amber
//   "consent" → consent pink
export struct ToastData {
    id: int,
    kind: string,      // "info" | "success" | "warn" | "consent"
    title: string,
    body: string,
}

// ── Toast ─────────────────────────────────────────────────────────────
// Single glass-card toast. Slides in from the right (x +30px→0), drains
// a 2px progress bar over duration-toast-life.
//
// Rust owns lifetime: it appends via push_toast() and removes via
// prune_toast() after 6 s (matches duration-toast-life exactly) — or
// immediately when the operator clicks the card (dismissed()).
component Toast inherits Rectangle {
    in property <ToastData> data;
    callback dismissed();

    // led colour by kind
    property <color> led-color:
        root.data.kind == "success" ? Theme.accent
        : root.data.kind == "warn"  ? Theme.warning
        : root.data.kind == "consent" ? Theme.consent
        : Theme.audit;                              // "info" default

    width: 290px;
    // height driven by content
    border-radius: Theme.radius-md;           // 11px — matches "Medium card"
    background: Theme.surface-glass;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    // Fade-in on mount. The CSS nh-toast-in translateX(30px→0) cannot fire
    // because Toast is a VerticalLayout child — the layout engine owns `x`.
    // Opacity-only fade is the correct Slint 1.8 equivalent.
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Theme.duration-toast-in; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    VerticalLayout {
        padding: 12px; spacing: 6px;

        HorizontalLayout {
            spacing: 8px; alignment: start;
            // Coloured led dot (4px, matching Led primitive radius).
            Rectangle {
                width: 6px; height: 6px; border-radius: 3px;
                background: root.led-color;
                y: (16px - self.height) / 2;   // vertically centred against title
            }
            Text {
                text: root.data.title;
                color: Theme.text-primary;
                font-family: Theme.font-sans;
                font-size: 12px;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        if root.data.body != "": Text {
            text: root.data.body;
            color: Theme.text-secondary;
            font-family: Theme.font-sans;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    // 2px progress bar: width 100%→0 over duration-toast-life, linear.
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        border-radius: 1px;
        background: root.led-color;
        // Drain starts at full width; animate to 0 on init.
        property <float> _drain: 1.0;
        width: parent.width * self._drain;
        init => { self._drain = 0; }
        animate _drain { duration: Theme.duration-toast-life; easing: linear; }
    }

    // Click anywhere on the card dismisses it immediately.
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.dismissed(); }
    }
}

// ── ToastStack ────────────────────────────────────────────────────────
// Top-right overlay stack of Toasts, 290px wide, fixed position.
// Caller provides `x`, `y` (typically right edge − 290px − 12px, 78px
// from top) and the `toasts` model. Pointer-events pass through the
// transparent gap between cards to content below.
export component ToastStack inherits Rectangle {
    in property <[ToastData]> toasts;
    // Fired with the toast's id when the operator clicks a card.
    callback dismissed(int);

    // Transparent background so only the cards themselves catch events.
    background: transparent;
    width: 290px;

    VerticalLayout {
        spacing: 8px; padding: 0px;
        for t in root.toasts: Toast {
            data: t;
            dismissed => { root.dismissed(t.id); }
        }
    }
}

// ── NeothComboBox ────────────────────────────────────────────────────
// G-3 fix: dark-mode-compliant dropdown. Replaces `std-widgets::ComboBox`
// which renders a platform-native (light-mode on Windows) background
// that breaks the brand-spec dark contract. Built from primitives so
// every colour comes from `Theme` and the popup respects card surface +
// border tokens.
//
// API mirrors `std-widgets::ComboBox`:
//   in property <[string]> model    — list of items to show
//   in-out property <int> current-index — selected row index
//   callback selected(int)          — fires when operator picks a row

export component NeothComboBox inherits Rectangle {
    in property <[string]> model: [];
    in-out property <int> current-index: 0;
    callback selected(int);

    accessible-role: combobox;
    accessible-label: root.model.length > 0 && root.current-index >= 0 && root.current-index < root.model.length
        ? "Selected " + root.model[root.current-index]
        : "No selection";
    accessible-expandable: true;
    accessible-action-expand => { popup.show(); }
    accessible-action-default => { popup.show(); }

    height: 44px;
    background: Theme.bg-card;
    border-radius: Theme.radius-button;
    border-width: 1px;
    border-color: combo-focus.has-focus ? Theme.focus-ring
        : trigger.has-hover ? Theme.accent-green : Theme.border-subtle;

    animate border-color {
        duration: Theme.duration-micro;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    HorizontalLayout {
        padding-left: Theme.space-base;
        padding-right: Theme.space-base;
        spacing: Theme.space-tight;

        Text {
            text: root.model.length > 0 && root.current-index >= 0 && root.current-index < root.model.length
                ? root.model[root.current-index]
                : "—";
            font-family: Theme.font-display;
            font-size: Theme.font-size-body;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: "▾";
            font-family: Theme.font-display;
            font-size: Theme.font-size-body;
            color: Theme.accent-green;
            vertical-alignment: center;
        }
    }

    combo-focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                popup.show();
                return accept;
            }
            return reject;
        }
    }

    trigger := TouchArea {
        clicked => {
            combo-focus.focus();
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;

        Rectangle {
            background: Theme.bg-card;
            border-radius: Theme.radius-card;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;

                for entry[i] in root.model: Rectangle {
                    accessible-role: radio-button;
                    accessible-label: entry;
                    accessible-checked: i == root.current-index;
                    accessible-action-default => {
                        root.current-index = i;
                        root.selected(i);
                        popup.close();
                    }
                    height: 36px;
                    background: row-touch.has-hover ? Theme.bg-base : transparent;
                    border-radius: Theme.radius-button;
                    animate background {
                        duration: Theme.duration-micro;
                        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-base;
                        padding-right: Theme.space-base;
                        spacing: Theme.space-tight;

                        Text {
                            text: i == root.current-index ? "●" : "○";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: i == root.current-index ? Theme.accent-green : Theme.text-dim;
                            vertical-alignment: center;
                        }
                        Text {
                            text: entry;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    row-touch := TouchArea {
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// ── NeothCheckBox ────────────────────────────────────────────────────
// G-16 fix: dark-mode-compliant checkbox. Replaces `std-widgets::CheckBox`
// which paints a platform-native white box on Windows. Built from
// primitives so background, border, and check glyph all use Theme
// tokens.

export component NeothCheckBox inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <string> text: "";
    callback toggled(bool);

    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    height: 32px;
    background: transparent;

    HorizontalLayout {
        spacing: Theme.space-base;
        alignment: start;

        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - 20px) / 2;
            background: root.checked ? Theme.accent-green.with-alpha(0.18) : Theme.bg-card;
            border-radius: Theme.radius-xs;
            border-width: check-focus.has-focus ? 2px : 1px;
            border-color:
                !root.enabled              ? Theme.border-subtle :
                check-focus.has-focus      ? Theme.focus-ring :
                root.checked               ? Theme.accent-green :
                touch.has-hover            ? Theme.accent-green.with-alpha(0.6) :
                                              Theme.border-subtle;

            animate border-color {
                duration: Theme.duration-micro;
                easing: cubic-bezier(0.2, 0.8, 0.2, 1);
            }
            animate background {
                duration: Theme.duration-micro;
                easing: cubic-bezier(0.2, 0.8, 0.2, 1);
            }

            if root.checked: Text {
                text: "✓";
                font-family: Theme.font-display;
                font-size: 14px;
                font-weight: Theme.weight-bold;
                color: Theme.accent-green;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.text;
            font-family: Theme.font-display;
            font-size: Theme.font-size-body;
            color: root.enabled ? Theme.text-primary : Theme.text-dim;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }

    check-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            check-focus.focus();
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ── NeothLineEdit ────────────────────────────────────────────────────
// G-16 fix: dark-mode-compliant single-line text input. Wraps Slint's
// primitive `TextInput` with Theme-driven background + border + focus
// ring. Replaces `std-widgets::LineEdit` which renders a white field on
// Windows.

export component NeothLineEdit inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder-text: "";
    in property <bool> password: false;
    in property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);

    height: 44px;
    // GUI-overhaul: fields mostly sit inside Cards (also bg-card), where a
    // bg-card field was invisible. bg-base reads as a recessed input box that
    // delineates clearly against the card surface.
    background: Theme.bg-base;
    border-radius: Theme.radius-button;
    border-width: 1px;
    border-color:
        !root.enabled        ? Theme.border-subtle :
        input.has-focus      ? Theme.accent-green :
        touch.has-hover      ? Theme.accent-green.with-alpha(0.6) :
                                Theme.border-subtle;

    animate border-color {
        duration: Theme.duration-micro;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    HorizontalLayout {
        padding-left: Theme.space-base;
        padding-right: Theme.space-base;

        Rectangle {
            // Stacked layer: placeholder shows behind the TextInput
            // when text is empty + the field is not focused.
            // GUI-overhaul: Slint centers non-layout children, so without an
            // explicit full width these left-aligned to nothing and the
            // placeholder/caret rendered mid-field. Pin both to parent.width so
            // horizontal-alignment:left actually takes effect.
            if root.text == "" && !input.has-focus: Text {
                x: 0;
                width: parent.width;
                text: root.placeholder-text;
                font-family: Theme.font-display;
                font-size: Theme.font-size-body;
                color: Theme.text-dim;
                vertical-alignment: center;
                horizontal-alignment: left;
            }

            input := TextInput {
                x: 0;
                width: parent.width;
                text <=> root.text;
                font-family: Theme.font-display;
                font-size: Theme.font-size-body;
                color: root.enabled ? Theme.text-primary : Theme.text-dim;
                selection-background-color: Theme.accent-green.with-alpha(0.4);
                selection-foreground-color: Theme.text-primary;
                input-type: root.password ? InputType.password : InputType.text;
                single-line: true;
                vertical-alignment: center;
                horizontal-alignment: left;
                enabled: root.enabled;
                accessible-label: root.placeholder-text;
                accessible-placeholder-text: root.placeholder-text;
                accessible-enabled: root.enabled;
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
            }
        }
    }

    touch := TouchArea {
        clicked => { input.focus(); }
    }
}

// ── Kicker ───────────────────────────────────────────────────────────
// Mono 11px (font-size-2xs) uppercase card-section eyebrow.
// Wide letter-spacing, text-disabled colour. Used by every dashboard tab.
export component Kicker inherits Text {
    in property <string> label;
    text: root.label;
    color: Theme.text-disabled;
    font-family: Theme.font-mono;
    font-size: Theme.font-size-2xs;
    letter-spacing: Theme.letter-spacing-extra-wide;
}

// ── InfoRow ──────────────────────────────────────────────────────────
// One-line label+value pill inside a Card.
//
// Default (right-align: false): 90px fixed mono-label column on the left,
// value left-aligned beside it — used by dashboard-style tabs.
//
// right-align: true: label left (no fixed width), value mono right-aligned —
// used by observer / stats tabs (babel, n8n, selfimprove).
export component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text-primary;
    // When true: no fixed label width; value right-aligns (observer style).
    in property <bool> right-align: false;

    height: 36px;
    border-radius: Theme.radius-md;
    background: Theme.surface-1;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: start;
        spacing: Theme.space-3;
        Text {
            text: root.label;
            color: root.right-align ? Theme.text-secondary : Theme.text-tertiary;
            font-family: Theme.font-mono;
            font-size: root.right-align ? Theme.font-size-sm : Theme.font-size-2xs;
            letter-spacing: root.right-align ? 0px : Theme.letter-spacing-wide;
            vertical-alignment: center;
            width: root.right-align ? 0px : 90px;
            horizontal-stretch: root.right-align ? 0 : -1;
        }
        Text {
            text: root.value != "" ? root.value : "—";
            color: root.value-color;
            font-family: Theme.font-mono;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
            horizontal-alignment: root.right-align ? right : left;
            horizontal-stretch: root.right-align ? 1 : -1;
        }
    }
}

// ── RefreshFooter ─────────────────────────────────────────────────────
// Timestamp line at the bottom of a card. Right-aligned, 2xs mono,
// text-tertiary (dim but readable). Text reads "refreshed <ts>".
export component RefreshFooter inherits Text {
    in property <string> ts;
    text: root.ts != "" ? "refreshed \{root.ts}" : "";
    color: Theme.text-tertiary;
    font-family: Theme.font-mono;
    font-size: Theme.font-size-2xs;
    letter-spacing: Theme.letter-spacing-tight;
    horizontal-alignment: right;
}

// ── FooterBar ────────────────────────────────────────────────────────
// Bottom-of-window status line. Small + dim, never fights the content.
// Carries one or two operator-readable strings: hardware probe summary,
// daemon version, current home path.

export component FooterBar inherits Rectangle {
    in property <string> status: "";

    height: 36px;
    background: Theme.bg-base;
    // GUI-overhaul: the footer is one 36px row. Clip defends the layout so a
    // long / accidentally multi-line status can never spill past the bar and
    // get cut off by the window edge (the "footer abgeschnitten" bug).
    clip: true;

    Rectangle {
        x: Theme.space-screen;
        y: 0;
        width: parent.width - Theme.space-screen * 2;
        height: 1px;
        background: Theme.border-subtle;
    }

    Text {
        x: Theme.space-screen;
        text: root.status;
        font-family: Theme.font-mono;
        font-size: Theme.font-size-caption;
        color: Theme.text-dim;
        vertical-alignment: center;
        height: parent.height;
    }
}

// ── Command Palette (Ctrl+K) ─────────────────────────────────────────
// Linear/Raycast-grammar quick switcher: scrim + centered glass card,
// filter-as-you-type input, arrow-key selection, Enter activates. Rust
// owns filtering (palette-query-edited → palette-results); activation
// routes through the same nav path as the sidebar.

export struct PaletteItem {
    label: string,
    glyph: string,
    tab: string,      // nav destination key ("chat", "memory", …)
    hint: string,     // group eyebrow (CORE / WORK / SYSTEM)
}

export component CommandPalette inherits Rectangle {
    in property <[PaletteItem]> results;
    in-out property <string> query;
    in-out property <int> selected: 0;
    callback query-edited(string);
    callback activated(string);
    callback closed();

    background: Theme.scrim;

    // Scrim click closes; the card swallows its own clicks below.
    TouchArea { clicked => { root.closed(); } }

    Rectangle {
        width: min(560px, root.width - 80px);
        height: min(64px + 44px * min(root.results.length, 8) + 20px, root.height - 140px);
        x: (root.width - self.width) / 2;
        y: 96px;
        border-radius: Theme.radius-lg;
        background: Theme.surface-2;
        border-width: 1px; border-color: Theme.border-strong;
        drop-shadow-blur: 42px;
        drop-shadow-color: Theme.bg-void.with-alpha(0.65);
        clip: true;

        // Entrance: sovereign-curve fade.
        opacity: 0;
        init => { self.opacity = 1; pal-input.focus(); }
        animate opacity { duration: Theme.duration-fast; easing: cubic-bezier(0.16, 1, 0.3, 1); }

        TouchArea { }   // swallow card clicks

        VerticalLayout {
            padding: 10px; spacing: 6px;

            // input row
            Rectangle {
                height: 44px;
                border-radius: Theme.radius-md;
                background: Theme.bg-base;
                border-width: 1px; border-color: Theme.border-accent;
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                    Text {
                        text: "⌘";
                        color: Theme.accent; font-family: Theme.font-mono;
                        font-size: Theme.font-size-sm; vertical-alignment: center;
                    }
                    Rectangle {
                        if root.query == "": Text {
                            x: 0; width: parent.width;
                            text: "Jump to… (type to filter)";
                            color: Theme.text-tertiary;
                            font-family: Theme.font-sans; font-size: Theme.font-size-base;
                            vertical-alignment: center; horizontal-alignment: left;
                        }
                        pal-input := TextInput {
                            x: 0; width: parent.width;
                            text <=> root.query;
                            color: Theme.text-primary;
                            font-family: Theme.font-sans; font-size: Theme.font-size-base;
                            selection-background-color: Theme.accent.with-alpha(0.4);
                            selection-foreground-color: Theme.text-primary;
                            single-line: true;
                            vertical-alignment: center;
                            accessible-label: "command palette filter";
                            edited => { root.selected = 0; root.query-edited(self.text); }
                            accepted => {
                                if (root.results.length > 0) {
                                    root.activated(root.results[min(root.selected, root.results.length - 1)].tab);
                                }
                            }
                        }
                    }
                }
            }

            // results list — Up/Down handled by the enclosing FocusScope in
            // main.slint (single-line TextInput rejects them, so they bubble).
            Flickable {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 2px;
                    for item[i] in root.results: Rectangle {
                        height: 42px;
                        border-radius: Theme.radius-sm;
                        background: i == root.selected ? Theme.surface-3
                            : row-ta.has-hover ? Theme.surface-1 : transparent;
                        animate background { duration: Theme.duration-fast; easing: ease-out; }
                        // active rail — same grammar as the sidebar NavBtn
                        Rectangle {
                            x: 0; width: 2px;
                            height: i == root.selected ? parent.height - 14px : 0px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 2px;
                            background: Theme.accent;
                            animate height { duration: Theme.duration-fast; easing: ease-out; }
                        }
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; spacing: 11px;
                            Rectangle {
                                width: 18px;
                                Text {
                                    text: item.glyph;
                                    color: i == root.selected ? Theme.accent : Theme.text-tertiary;
                                    font-size: Theme.font-size-sm; font-family: Theme.font-mono;
                                    vertical-alignment: center; horizontal-alignment: center;
                                }
                            }
                            Text {
                                text: item.label;
                                color: i == root.selected ? Theme.text-primary : Theme.text-secondary;
                                font-size: Theme.font-size-sm; font-family: Theme.font-sans;
                                vertical-alignment: center; horizontal-stretch: 1;
                            }
                            Text {
                                text: item.hint;
                                color: Theme.text-disabled;
                                font-family: Theme.font-mono; font-size: Theme.font-size-2xs;
                                letter-spacing: Theme.letter-spacing-wide;
                                vertical-alignment: center;
                            }
                        }
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.activated(item.tab); }
                        }
                    }
                    if root.results.length == 0: Text {
                        height: 42px;
                        text: "No matches — Esc to close";
                        color: Theme.text-tertiary;
                        font-family: Theme.font-sans; font-size: Theme.font-size-sm;
                        vertical-alignment: center; horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
