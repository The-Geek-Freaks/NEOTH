// NEOTH — Self-Improvement panel (Design Wave 4a).
//
// Displays self-improve status, pending proposals (with per-row Accept/Rollback),
// history log (capped 10), and top-level Enable/Disable/Run dry-run controls.
//
// Consent-pink accents on accept actions (operator authorization theme).
// Layout: EntranceFade > ScrollView > STATUS card + PENDING card + HISTORY card.

import { Theme } from "theme.slint";
import { Card, Led, EntranceFade, NeothButton, Kicker, InfoRow, RefreshFooter, ConfirmDialog } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// ── Wire structs ──────────────────────────────────────────────────────────────

/// One pending proposal row (from `self-improve review --output json`).
export struct SiProposalRow {
    id: string,
    title: string,
    description: string,
    status: string,
    quality_state: string,
    quality_reason: string,
    quality_metric: string,
    score_delta: string,
    evaluator_source_short_id: string,
    corpus_manifest_short_sha256: string,
    regression_summary: string,
    evidence_short_sha256: string,
    evidence_sha256: string,
    accept_ready: bool,
}

/// One history log row (from `self-improve log --output json`).
export struct SiLogRow {
    id: string,
    title: string,
    status: string,   // "accepted" | "rolled-back" | "pending" | …
    ts: string,
}

// One proposal card: id + title + description + Accept + Rollback buttons.
// Accept uses consent-pink accent (operator authorization action).
component ProposalCard inherits Rectangle {
    in property <string> proposal-id;
    in property <string> title;
    in property <string> description;
    in property <string> status;
    in property <string> quality-state;
    in property <string> quality-reason;
    in property <string> quality-metric;
    in property <string> score-delta;
    in property <string> evaluator-source-short-id;
    in property <string> corpus-manifest-short-sha256;
    in property <string> regression-summary;
    in property <string> evidence-short-sha256;
    in property <string> evidence-sha256;
    in property <bool> accept-ready;
    in property <bool> accept-enabled;
    callback accept-clicked();
    callback rollback-clicked();

    border-radius: Theme.radius-md;
    background: Theme.surface-1;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: 12px; spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: root.title;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    font-weight: Theme.weight-semibold;
                    overflow: elide;
                }
                if root.description != "": Text {
                    text: root.description;
                    color: Theme.text-secondary;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.proposal-id;
                    overflow: elide;
                    color: Theme.text-disabled;
                    font-family: Theme.font-mono;
                    font-size: 9px;
                }
            }
        }

        Text {
            text: "Quality: " + root.quality-state + " · " + root.regression-summary;
            color: root.quality-state == "current" ? Theme.audit
                : root.quality-state == "stale" || root.quality-state == "failed" ? Theme.consent
                : Theme.warning;
            font-size: Theme.font-size-caption;
            font-family: Theme.font-mono;
            overflow: elide;
        }
        if root.quality-metric != "": Text {
            text: root.quality-metric + " " + root.score-delta;
            color: Theme.text-secondary;
            font-size: Theme.font-size-caption;
            font-family: Theme.font-mono;
            overflow: elide;
        }
        if root.evaluator-source-short-id != "": Text {
            text: "Verifier " + root.evaluator-source-short-id + " · corpus " + root.corpus-manifest-short-sha256 + " · evidence " + root.evidence-short-sha256;
            color: Theme.text-secondary;
            font-size: Theme.font-size-caption;
            font-family: Theme.font-mono;
            overflow: elide;
        }
        if root.quality-reason != "": Text {
            text: root.quality-reason;
            color: Theme.warning;
            font-size: Theme.font-size-caption;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end; spacing: 8px;
            // Accept — consent-pink backing (authorization action)
            Rectangle {
                width: 80px; height: 28px;
                border-radius: Theme.radius-md;
                background: root.accept-ready && root.accept-enabled ? Theme.consent : Theme.surface-2;
                TouchArea {
                    enabled: root.accept-ready && root.accept-enabled;
                    clicked => { root.accept-clicked(); }
                    accessible-role: button;
                    accessible-label: "accept proposal";
                    accessible-action-default => { root.accept-clicked(); }
                }
                Text {
                    text: root.accept-ready ? root.accept-enabled ? "Accept" : "Working" : "Not ready";
                    color: root.accept-ready && root.accept-enabled ? Theme.text-primary : Theme.text-disabled;
                    font-size: Theme.font-size-sm;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            NeothButton {
                label: "Rollback";
                width: 84px; height: 28px;
                clicked => { root.rollback-clicked(); }
            }
        }
    }
}

// One history log row: id chip + title + status + ts.
component LogRow inherits Rectangle {
    in property <string> log-id;
    in property <string> title;
    in property <string> status;
    in property <string> ts;

    height: 40px;
    border-radius: Theme.radius-md;
    background: Theme.surface-1;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 8px;
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.status;
            overflow: elide;
            color: root.status == "accepted" ? Theme.accent
                : root.status == "rolled-back" ? Theme.consent
                : Theme.text-secondary;
            font-family: Theme.font-mono;
            font-size: 10px;
            vertical-alignment: center;
            width: 90px;
            horizontal-alignment: right;
        }
        Text {
            text: root.ts;
            overflow: elide;
            color: Theme.text-disabled;
            font-family: Theme.font-mono;
            font-size: 9px;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
}

// ── Public component ──────────────────────────────────────────────────────────

export component SelfImproveView inherits Rectangle {
    // STATUS props
    in property <bool>   si-enabled: false;
    in property <bool>   si-auto: false;
    in property <bool>   si-skillopt-installed: false;
    in property <string> si-last-run: "";
    in property <string> si-autonomy: "";

    // PENDING proposals
    in property <[SiProposalRow]> si-proposals: [];
    in property <bool> si-accept-in-flight: false;

    // HISTORY log (capped 10 by Rust)
    in property <[SiLogRow]> si-log: [];

    // Refresh + control callbacks
    in property <string> si-refreshed-at: "";
    callback si-refresh-clicked();
    callback si-enable-clicked();
    callback si-disable-clicked();
    callback si-run-dry-clicked();
    callback si-accept-clicked(string, string); // proposal id, bound evidence digest
    callback si-rollback-clicked(string);  // proposal id
    // Proposal id awaiting rollback confirmation; "" = no dialog.
    property <string> rollback-confirm-id: "";

    background: transparent;

    EntranceFade {
        ScrollView {
            VerticalLayout {
                padding: 16px; spacing: 12px;
                min-height: 1000px;

                // ── HEADER ────────────────────────────────────────────────
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "✦  Self-Improvement";
                        color: Theme.text-primary;
                        font-size: Theme.font-size-lg;
                        font-weight: Theme.weight-bold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    NeothButton {
                        label: "Refresh";
                        size: "sm";
                        primary: false;
                        clicked => { root.si-refresh-clicked(); }
                    }
                }

                // ── STATUS CARD ───────────────────────────────────────────
                Card {
                    VerticalLayout {
                        padding: 16px; spacing: 8px;

                        Kicker { label: "STATUS"; }

                        HorizontalLayout {
                            height: 36px; spacing: 8px;
                            Text {
                                text: "enabled";
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Led { state: root.si-enabled ? "live" : "off"; }
                            NeothButton {
                                label: "Enable";
                                width: 72px; height: 28px;
                                clicked => { root.si-enable-clicked(); }
                            }
                            NeothButton {
                                label: "Disable";
                                width: 72px; height: 28px;
                                clicked => { root.si-disable-clicked(); }
                            }
                        }

                        HorizontalLayout {
                            height: 36px; spacing: 8px;
                            Text {
                                text: "auto";
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Led { state: root.si-auto ? "live" : "off"; }
                        }

                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        HorizontalLayout {
                            height: 36px; spacing: 8px;
                            Text {
                                text: "skillopt installed";
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Led { state: root.si-skillopt-installed ? "live" : "off"; }
                        }

                        if root.si-autonomy != "": InfoRow {
                            label: "autonomy level";
                            value: root.si-autonomy;
                            right-align: true;
                        }
                        if root.si-last-run != "": InfoRow {
                            label: "last run";
                            value: root.si-last-run;
                            value-color: Theme.text-secondary;
                            right-align: true;
                        }

                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // Run dry-run button row
                        HorizontalLayout {
                            alignment: end;
                            NeothButton {
                                label: "Run (dry-run)";
                                width: 130px; height: 32px;
                                clicked => { root.si-run-dry-clicked(); }
                            }
                        }

                        RefreshFooter { ts: root.si-refreshed-at; }
                    }
                }

                // ── PENDING PROPOSALS CARD ────────────────────────────────
                Card {
                    VerticalLayout {
                        padding: 16px; spacing: 8px;

                        Kicker { label: "PENDING PROPOSALS"; }

                        if root.si-proposals.length == 0: Rectangle {
                            height: 48px;
                            Text {
                                text: "no pending proposals";
                                color: Theme.text-disabled;
                                font-size: Theme.font-size-sm;
                                font-family: Theme.font-mono;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        for p in root.si-proposals: ProposalCard {
                            proposal-id: p.id;
                            title: p.title;
                            description: p.description;
                            status: p.status;
                            quality-state: p.quality_state;
                            quality-reason: p.quality_reason;
                            quality-metric: p.quality_metric;
                            score-delta: p.score_delta;
                            evaluator-source-short-id: p.evaluator_source_short_id;
                            corpus-manifest-short-sha256: p.corpus_manifest_short_sha256;
                            regression-summary: p.regression_summary;
                            evidence-short-sha256: p.evidence_short_sha256;
                            evidence-sha256: p.evidence_sha256;
                            accept-ready: p.accept_ready;
                            accept-enabled: !root.si-accept-in-flight;
                            accept-clicked => { root.si-accept-clicked(p.id, p.evidence_sha256); }
                            // Destructive — reverts an applied proposal;
                            // route through the confirm gate.
                            rollback-clicked => { root.rollback-confirm-id = p.id; }
                        }
                    }
                }

                // ── HISTORY CARD ──────────────────────────────────────────
                if root.si-log.length > 0: Card {
                    VerticalLayout {
                        padding: 16px; spacing: 8px;

                        Kicker { label: "HISTORY (last 10)"; }

                        for entry in root.si-log: LogRow {
                            log-id: entry.id;
                            title: entry.title;
                            status: entry.status;
                            ts: entry.ts;
                        }
                    }
                }
            }
        }
    }

    // ── Rollback confirm gate (SAFE-GAPS HIGH) ────────────────────────
    if root.rollback-confirm-id != "": ConfirmDialog {
        width: 100%; height: 100%;
        title: "Roll back proposal?";
        body: "Reverts applied proposal " + root.rollback-confirm-id + ". The change is undone on next reload.";
        confirm-label: "Roll back";
        danger: true;
        confirmed => {
            root.si-rollback-clicked(root.rollback-confirm-id);
            root.rollback-confirm-id = "";
        }
        cancelled => { root.rollback-confirm-id = ""; }
    }
}
