// NEOTH desktop app shell — the persistent-sidebar layout from the design
// mockup (design-system/, ui_kits/desktop/shell.jsx): a 248px rail with the
// brand + Buddy, a tier-coloured nav, a complexity selector, and the operator
// card; a 68px topbar; a 34px mono status footer. This replaces the old
// wizard-only navigation for the main experience — the wizard stays for
// first-run, the shell is the home.

import { Theme } from "theme.slint";
import { Buddy } from "buddy.slint";
import { Led } from "components.slint";

// Nav group header label — mono 8px, letter-spacing 2.4px (≈.24em on 10px),
// uppercase, text-disabled, padding 12px 10px 5px. Only renders when at
// least one child button is visible (caller wraps in `if`).
component NavGroup inherits Rectangle {
    in property <string> label;
    height: 28px;
    HorizontalLayout {
        padding-left: 10px; padding-top: 12px; padding-bottom: 5px;
        Text {
            text: root.label;
            overflow: elide;
            color: Theme.text-disabled;
            font-family: Theme.font-mono;
            font-size: Theme.font-size-2xs;
            letter-spacing: Theme.letter-spacing-extra-wide;    // ≈ .24em on ~10px base
        }
    }
}

// One sidebar nav entry. `tier` tints the active state by meaning
// (memory=green, consent=pink, default=accent-green), per the mockup.
component NavBtn inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <string> tier;          // "memory" | "consent" | ""
    in property <bool> active;
    in property <int> count: -1;        // ≥0 shows a count chip
    callback clicked();

    // R4-09 — screen-reader / keyboard support on primary navigation.
    accessible-role: button;
    accessible-label: root.label + " tab";
    accessible-action-default => { root.clicked(); }

    property <color> tier-color: root.tier == "memory" ? Theme.memory
        : root.tier == "consent" ? Theme.consent
        : Theme.accent;

    height: 38px;
    border-radius: Theme.radius-md;
    background: root.active ? Theme.surface-2 : transparent;
    animate background { duration: Theme.duration-fast; easing: ease-out; }

    // active rail (left, 2px, tier-coloured). GOLD-ADAPT-GUI-02: the rail
    // grows from the centre with the ease-back overshoot — tab switches
    // read snappy instead of fading in.
    Rectangle {
        x: 0; width: 2px;
        height: root.active ? parent.height - 16px : 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: root.tier-color;
        opacity: root.active ? 1.0 : 0.0;
        animate height { duration: Theme.duration-base; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        animate opacity { duration: Theme.duration-fast; easing: ease-out; }
    }

    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 11px;
        alignment: start;
        Rectangle {
            width: 18px; vertical-stretch: 0;
            Text {
                text: root.glyph;
                color: root.active ? root.tier-color : Theme.text-tertiary;
                font-size: Theme.font-size-sm; font-family: Theme.font-mono;
                vertical-alignment: center; horizontal-alignment: center;
            }
        }
        Text {
            text: root.label;
            overflow: elide;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.font-size-sm; font-family: Theme.font-sans;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // count chip
        Rectangle {
            visible: root.count >= 0;
            y: (parent.height - self.height) / 2; height: 16px;
            width: cnt.width + 14px;
            border-radius: Theme.radius-pill;
            background: Theme.surface-3;
            cnt := Text {
                text: root.count >= 0 ? "\{root.count}" : "";
                color: Theme.text-tertiary; font-family: Theme.font-mono; font-size: 10px;
                x: 7px; vertical-alignment: center;
            }
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Complexity segment (minimal / standard / full) — mirrors NEOTH's persona
// panel_logic; reveals more nav as the operator levels up.
component ComplexitySeg inherits Rectangle {
    in property <int> level;            // 0..2
    callback set-level(int);
    height: 30px;
    border-radius: Theme.radius-md;
    background: Theme.bg-sunken;
    border-width: 1px; border-color: Theme.border-default;
    HorizontalLayout {
        padding: 3px; spacing: 3px;
        for seg[i] in ["MIN", "STD", "FULL"]: Rectangle {
            accessible-role: button;
            accessible-label: "complexity " + seg;
            accessible-action-default => { root.set-level(i); }
            border-radius: Theme.radius-sm;
            background: root.level == i ? Theme.accent-tint : transparent;
            border-width: root.level == i ? 1px : 0px;
            border-color: Theme.border-accent;
            Text {
                text: seg; color: root.level == i ? Theme.accent : Theme.text-tertiary;
                font-family: Theme.font-mono; font-size: 10px;
                letter-spacing: Theme.letter-spacing-tight;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.set-level(i); } }
        }
    }
}

// The full left rail.
export component Sidebar inherits Rectangle {
    in property <string> active-tab: "chat";
    in property <int> complexity: 2;             // 0 minimal .. 2 full
    // GOLD-LOOP-03 — Rust sets this from the `gui-loop` cargo feature.
    in property <bool> show-loops: false;
    // GOLD-ADAPT-AOS-03 — project domain from the wizard's context step.
    in property <string> project-domain: "";
    in property <bool> theme-dark: true;
    // Living-companion: the brand-bar orb reflects real daemon activity.
    in property <string> buddy-mood: "idle";
    in property <string> operator-name: "operator";
    in property <int> channels-count: 0;
    // Version line under the wordmark — Rust binds CARGO_PKG_VERSION so
    // the sidebar never lies about the running build.
    in property <string> version-line: "v1.0 · sovereign";
    callback nav(string);
    callback set-complexity(int);
    callback toggle-theme();
    // E4 — version line opens the About / What's-new overlay.
    callback version-clicked();

    width: Theme.sidebar-w;   // B23: driven by tweaks.toml sidebar_width_px or 248px built-in
    background: Theme.bg-sunken;
    // right hairline
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border-subtle; }

    VerticalLayout {
        padding: 18px; padding-top: 18px; spacing: 2px;

        // brand
        HorizontalLayout {
            spacing: 12px; alignment: start;
            padding-bottom: 16px;
            Buddy { mood: root.buddy-mood; orb-size: 34px; show-face: true; }
            VerticalLayout {
                alignment: center; spacing: 3px;
                Text {
                    text: "NEOTH"; color: Theme.accent;
                    font-family: Theme.font-wordmark; font-size: 23px; font-weight: Theme.weight-bold;
                    letter-spacing: Theme.letter-spacing-tight;
                }
                Rectangle {
                    height: ver-txt.height;
                    ver-txt := Text {
                        x: 0;
                        // Wave-1: design report spec — 8.5px mono, .26em letter-spacing,
                        // text-tertiary, lowercase. letter-spacing-mono-caps is 2.6px ≈ .26em.
                        text: root.version-line;
                        overflow: elide;
                        color: ver-ta.has-hover ? Theme.text-secondary : Theme.text-tertiary;
                        font-family: Theme.font-mono; font-size: Theme.font-size-2xs;
                        letter-spacing: Theme.letter-spacing-mono-caps;
                        animate color { duration: Theme.duration-fast; easing: ease-out; }
                    }
                    // E4 — click opens About / What's new.
                    ver-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.version-clicked(); }
                    }
                }
            }
        }

        // nav (filtered by complexity) — Wave-1: structured into 3 named groups.
        // Group labels only appear when ≥1 child is visible (gated by `if`).
        // The CORE group always has Chat, so its label always shows. WORK and
        // SYSTEM labels use `if` because all their children may be gated off
        // at complexity 0 (minimal).
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 2px;

                // ── CORE ─────────────────────────────────────────────────
                // Always visible: Chat is the primary surface.
                NavGroup { label: "CORE"; }
                NavBtn { label: "Chat"; glyph: "💬"; active: root.active-tab == "chat"; clicked => { root.nav("chat"); } }
                NavBtn { label: "Overview"; glyph: "◎"; active: root.active-tab == "overview"; clicked => { root.nav("overview"); } }

                // ── WORK ─────────────────────────────────────────────────
                // Visible at complexity ≥ 1. The label is shown when any WORK
                // item is visible (complexity >= 1 is the minimum gate).
                if root.complexity >= 1: NavGroup { label: "WORK"; }
                NavBtn { label: "Coding"; glyph: "⌘"; visible: root.complexity >= 1; active: root.active-tab == "coding"; clicked => { root.nav("coding"); } }
                NavBtn { label: "Agents"; glyph: "⚇"; visible: root.complexity >= 2; active: root.active-tab == "agents"; clicked => { root.nav("agents"); } }
                NavBtn { label: "Automation"; glyph: "⟳"; visible: root.complexity >= 2; active: root.active-tab == "automation"; clicked => { root.nav("automation"); } }
                NavBtn { label: "Loops"; glyph: "∞"; visible: root.complexity >= 2 && root.show-loops; active: root.active-tab == "loops"; clicked => { root.nav("loops"); } }
                NavBtn { label: "BG Jobs"; glyph: "⊛"; visible: root.complexity >= 2; active: root.active-tab == "bg-jobs"; clicked => { root.nav("bg-jobs"); } }
                // Wave 4a — WORK additions (≥1 gate matches Automation).
                // Glyph dedup: n8n had Plugins' ⧉, Calendar had Resources' ▦ —
                // every nav glyph is unique so icons stay meaning-bearing.
                NavBtn { label: "n8n"; glyph: "⇶"; visible: root.complexity >= 1; active: root.active-tab == "n8n"; clicked => { root.nav("n8n"); } }
                NavBtn { label: "Calendar"; glyph: "◷"; visible: root.complexity >= 1; active: root.active-tab == "calendar"; clicked => { root.nav("calendar"); } }
                NavBtn { label: "Evolve"; glyph: "✦"; visible: root.complexity >= 1; active: root.active-tab == "evolve"; clicked => { root.nav("evolve"); } }
                // FEAT-05 — Self-Dev Proposal Review (same gate as Evolve: complexity ≥ 1).
                NavBtn { label: "Self-Dev"; glyph: "⊞"; visible: root.complexity >= 1; active: root.active-tab == "selfdev"; clicked => { root.nav("selfdev"); } }
                // Wave 4b — CORE additions.
                NavBtn { label: "Dreaming"; glyph: "☽"; visible: root.complexity >= 1; active: root.active-tab == "dreaming"; clicked => { root.nav("dreaming"); } }
                NavBtn { label: "Buddy Config"; glyph: "⊙"; visible: root.complexity >= 1; active: root.active-tab == "buddyconfig"; clicked => { root.nav("buddyconfig"); } }

                // ── SYSTEM ───────────────────────────────────────────────
                // Always has Memory (≥1), Hemispheres (≥1), Channels, Privacy,
                // Plugins (≥2), Mesh (≥2), Resources (≥2), Doctor, Config.
                // Wave 4a adds Babel (≥2, observer).
                // Label shows when complexity ≥ 1 (Memory/Hemispheres gate).
                NavGroup { label: "SYSTEM"; }
                NavBtn { label: "Memory"; glyph: "◈"; tier: "memory"; visible: root.complexity >= 1; active: root.active-tab == "memory"; clicked => { root.nav("memory"); } }
                NavBtn { label: "Graph"; glyph: "❋"; tier: "memory"; visible: root.complexity >= 1; active: root.active-tab == "memgraph"; clicked => { root.nav("memgraph"); } }
                NavBtn { label: "Groundtruth"; glyph: "⊨"; tier: "memory"; visible: root.complexity >= 1; active: root.active-tab == "groundtruth"; clicked => { root.nav("groundtruth"); } }
                NavBtn { label: "ADR Browser"; glyph: "◆"; visible: root.complexity >= 2; active: root.active-tab == "adr-browser"; clicked => { root.nav("adr-browser"); } }
                NavBtn { label: "Hemispheres"; glyph: "◐"; visible: root.complexity >= 1; active: root.active-tab == "hemispheres"; clicked => { root.nav("hemispheres"); } }
                NavBtn { label: "Channels"; glyph: "⇄"; count: root.channels-count; active: root.active-tab == "channels"; clicked => { root.nav("channels"); } }
                NavBtn { label: "Privacy"; glyph: "⛨"; tier: "consent"; active: root.active-tab == "privacy"; clicked => { root.nav("privacy"); } }
                NavBtn { label: "Plugins"; glyph: "⧉"; visible: root.complexity >= 2; active: root.active-tab == "plugins"; clicked => { root.nav("plugins"); } }
                NavBtn { label: "MCP"; glyph: "⧟"; visible: root.complexity >= 2; active: root.active-tab == "mcp"; clicked => { root.nav("mcp"); } }
                NavBtn { label: "Hooks"; glyph: "⋔"; visible: root.complexity >= 2; active: root.active-tab == "hooks"; clicked => { root.nav("hooks"); } }
                NavBtn { label: "Model Catalog"; glyph: "⊚"; visible: root.complexity >= 2; active: root.active-tab == "catalog"; clicked => { root.nav("catalog"); } }
                NavBtn { label: "Quota"; glyph: "⊘"; visible: root.complexity >= 2; active: root.active-tab == "quota"; clicked => { root.nav("quota"); } }
                NavBtn { label: "Tweaks"; glyph: "⚗"; visible: root.complexity >= 2; active: root.active-tab == "tweaks"; clicked => { root.nav("tweaks"); } }
                NavBtn { label: "Council Weights"; glyph: "⚖"; visible: root.complexity >= 2; active: root.active-tab == "council-weights"; clicked => { root.nav("council-weights"); } }
                NavBtn { label: "Mode Registry"; glyph: "⊡"; visible: root.complexity >= 2; active: root.active-tab == "mode-registry"; clicked => { root.nav("mode-registry"); } }
                NavBtn { label: "Cluster"; glyph: "⬡"; visible: root.complexity >= 2; active: root.active-tab == "cluster"; clicked => { root.nav("cluster"); } }
                NavBtn { label: "Resources"; glyph: "▦"; visible: root.complexity >= 2; active: root.active-tab == "resources"; clicked => { root.nav("resources"); } }
                // Wave 4a — Babel observer in SYSTEM (≥2, technical observer).
                NavBtn { label: "Babel"; glyph: "◬"; visible: root.complexity >= 2; active: root.active-tab == "babel"; clicked => { root.nav("babel"); } }
                // Wave 4b — SYSTEM additions.
                NavBtn { label: "Obsidian"; glyph: "◉"; visible: root.complexity >= 1; active: root.active-tab == "obsidian"; clicked => { root.nav("obsidian"); } }
                NavBtn { label: "Wiki"; glyph: "⌗"; visible: root.complexity >= 1; active: root.active-tab == "wiki"; clicked => { root.nav("wiki"); } }
                NavBtn { label: "Companion"; glyph: "⊕"; active: root.active-tab == "companion"; clicked => { root.nav("companion"); } }
                NavBtn { label: "Mesh"; glyph: "◇"; visible: root.complexity >= 2; active: root.active-tab == "mesh"; clicked => { root.nav("mesh"); } }
                NavBtn { label: "WAL"; glyph: "≣"; visible: root.complexity >= 2; active: root.active-tab == "wal"; clicked => { root.nav("wal"); } }
                NavBtn { label: "Doctor"; glyph: "✚"; active: root.active-tab == "doctor"; clicked => { root.nav("doctor"); } }
                NavBtn { label: "Migrations"; glyph: "⊸"; visible: root.complexity >= 2; active: root.active-tab == "migrate-history"; clicked => { root.nav("migrate-history"); } }
                NavBtn { label: "Config"; glyph: "⚙"; active: root.active-tab == "config"; clicked => { root.nav("config"); } }
            }
        }

        // complexity selector
        Rectangle {
            height: 1px; background: Theme.border-subtle;
        }
        VerticalLayout {
            padding-top: 12px; padding-bottom: 12px; spacing: 8px;
            Text {
                text: "COMPLEXITY"; color: Theme.text-tertiary;
                font-family: Theme.font-mono; font-size: 9px; letter-spacing: Theme.letter-spacing-wide;
            }
            ComplexitySeg { level: root.complexity; set-level(l) => { root.set-complexity(l); } }
        }

        // operator footer
        Rectangle { height: 1px; background: Theme.border-subtle; }
        HorizontalLayout {
            padding-top: 12px; spacing: 10px; alignment: start;
            Rectangle {
                width: 32px; height: 32px;
                border-radius: Theme.radius-sm;
                background: Theme.accent-tint;
                border-width: 1px; border-color: Theme.border-accent;
                Text {
                    text: "NH"; color: Theme.accent;
                    font-family: Theme.font-mono; font-size: Theme.font-size-2xs;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text {
                    text: root.operator-name; color: Theme.text-primary; font-size: Theme.font-size-sm;
                    overflow: elide;
                }
                Text {
                    // AOS-03: the project domain rides the operator card
                    // when captured ("OPERATOR · security research").
                    text: root.project-domain != ""
                        ? "OPERATOR · " + root.project-domain
                        : "OPERATOR";
                    color: Theme.text-tertiary;
                    font-family: Theme.font-mono; font-size: 9px; letter-spacing: Theme.letter-spacing-wide;
                    overflow: elide;
                }
            }
            Rectangle {
                width: 28px; height: 28px; border-radius: Theme.radius-sm;
                background: ta.has-hover ? Theme.surface-2 : transparent;
                Text {
                    text: Theme.dark ? "☀" : "☾"; color: Theme.text-secondary; font-size: Theme.font-size-sm;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                // Flip the global theme immediately (live), then bubble up so
                // Rust can persist the choice.
                accessible-role: button;
                accessible-label: Theme.dark ? "switch to light theme" : "switch to dark theme";
                accessible-action-default => { Theme.dark = !Theme.dark; root.toggle-theme(); }
                ta := TouchArea { clicked => { Theme.dark = !Theme.dark; root.toggle-theme(); } }
            }
        }
    }
}

// Topbar — mono kicker + display title; a right slot via `@children`.
export component TopBar inherits Rectangle {
    in property <string> kicker;
    in property <string> title;
    height: 68px;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
    HorizontalLayout {
        padding-left: 28px; padding-right: 28px; alignment: space-between;
        VerticalLayout {
            alignment: center; spacing: 2px;
            Text {
                text: root.kicker; color: Theme.text-tertiary;
                overflow: elide;
                font-family: Theme.font-mono; font-size: 10px; letter-spacing: Theme.letter-spacing-extra-wide;
            }
            Text {
                text: root.title; color: Theme.text-primary;
                overflow: elide;
                font-family: Theme.font-display; font-size: 26px;
            }
        }
        HorizontalLayout {
            alignment: end; spacing: 16px;
            // Persistent command-palette hint (Raycast/Linear affordance).
            // Decorative — the Ctrl+K binding lives in main.slint's FocusScope.
            Rectangle {
                width: kbd-hint.width + 16px; height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-pill;
                background: Theme.surface-2;
                border-width: 1px; border-color: Theme.border-subtle;
                kbd-hint := Text {
                    text: "Ctrl K";
                    color: Theme.text-tertiary;
                    font-family: Theme.font-mono; font-size: Theme.font-size-2xs;
                    letter-spacing: Theme.letter-spacing-wide;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                accessible-role: AccessibleRole.text;
                accessible-label: "press Ctrl K to open the command palette";
            }
            @children
        }
    }
}

// Status footer — live hardware + cluster + WAL state, mono.
export component StatusFooter inherits Rectangle {
    in property <string> hardware: "";
    in property <string> cluster-id: "";
    in property <int> peers: 0;
    in property <bool> wal-ok: true;
    in property <bool> local: true;
    // GOLD-ADAPT-GUI-04 — daemon live-state for the Led (green=live /
    // connecting=amber / error=pink). Rust derives it from probe outcomes.
    in property <string> daemon-state: "connecting";
    // GOLD-ADAPT-GUI-05 — TypedStatus ticker line. Rust types it in
    // character-by-character on a timer; mono keeps the typing read.
    in property <string> status-message: "";

    height: 34px;
    background: Theme.bg-sunken;
    Rectangle { y: 0; height: 1px; background: Theme.border-subtle; }
    HorizontalLayout {
        padding-left: 22px; padding-right: 22px; alignment: space-between;
        HorizontalLayout {
            alignment: start; spacing: 10px;
            Led { state: root.daemon-state; y: (parent.height - self.height) / 2; }
            Text { text: "⬡"; color: Theme.accent; font-family: Theme.font-mono; font-size: Theme.font-size-2xs; vertical-alignment: center; }
            Text { text: "neoth-core"; color: Theme.text-secondary; font-family: Theme.font-mono; font-size: Theme.font-size-2xs; vertical-alignment: center; }
            Text {
                text: root.hardware != "" ? "· " + root.hardware : "";
                color: Theme.text-tertiary; font-family: Theme.font-mono; font-size: Theme.font-size-2xs; vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.status-message != "" ? "· " + root.status-message : "";
                color: Theme.text-tertiary; font-family: Theme.font-mono; font-size: Theme.font-size-2xs; vertical-alignment: center;
                overflow: elide; horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            alignment: end; spacing: 10px;
            Text {
                text: root.cluster-id != "" ? "cluster " + root.cluster-id : "cluster off";
                overflow: elide;
                color: Theme.text-tertiary; font-family: Theme.font-mono; font-size: Theme.font-size-2xs; vertical-alignment: center;
            }
            Text {
                text: root.peers > 0 ? "· \{root.peers} peers" : "";
                overflow: elide;
                color: Theme.text-tertiary; font-family: Theme.font-mono; font-size: Theme.font-size-2xs; vertical-alignment: center;
            }
            Rectangle {
                width: 7px; height: 7px; border-radius: 3.5px;
                background: root.wal-ok ? Theme.audit : Theme.text-disabled;
                y: (parent.height - self.height) / 2;
            }
            Text { text: "WAL"; color: Theme.text-tertiary; font-family: Theme.font-mono; font-size: Theme.font-size-2xs; vertical-alignment: center; }
            Rectangle {
                width: 7px; height: 7px; border-radius: 3.5px;
                background: root.local ? Theme.memory : Theme.text-disabled;
                y: (parent.height - self.height) / 2;
            }
            Text { text: "local"; color: Theme.text-tertiary; font-family: Theme.font-mono; font-size: Theme.font-size-2xs; vertical-alignment: center; }
            // Operator-requested footer copyright — the always-visible
            // ownership line, tying every screen back to the product.
            Text {
                text: "· © 2026 The Geek Freaks";
                color: Theme.text-disabled; font-family: Theme.font-mono; font-size: Theme.font-size-2xs;
                vertical-alignment: center;
            }
        }
    }
}
