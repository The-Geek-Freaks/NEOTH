// NEOTH Chat surface — Pick #33. Post-onboarding daily view.
//
// WIRING (new in this revision — orchestrator wires in main.rs / panel_logic.rs):
//
//   NEW CALLBACKS on ChatView:
//     message-copy(index: int)
//       → arboard (or slint clipboard) write of messages[index].text
//     message-retry(index: int)
//       → find the last "operator" message before `index`, re-send its text
//         through the existing send_clicked handler
//     message-delete(index: int)
//       → remove entry at `index` from the Rust-side Vec<ChatMessage>,
//         then push the updated slice back via ChatView.set_messages(…)
//     scroll-to-bottom-clicked()
//       → informational hook; Slint already writes viewport-y directly,
//         so use this to reset `unseen-count` to 0 on the Rust side
//     starter-clicked(prompt: string)
//       → equivalent to send_clicked(prompt); auto-populates the draft
//         and fires a send immediately
//
//   NEW PROPERTIES on ChatView:
//     unseen-count: int
//       → increment on each appended message when auto_follow is false
//         (detect via the scrolled signal or a Rust-side tracking bool);
//         reset to 0 when the FAB is clicked or the viewport snaps to bottom
//     starter-prompts: [string]
//       → pre-fill with ["What can you do?", "Show me a demo",
//         "Help me get started"]; override from startup config if desired
//
//   CODE BLOCKS: messages are plain text; no code-block sub-renderer exists
//   in this component, so no per-block copy affordance is added. When a
//   code-block renderer is introduced, wire it to message-copy(index) with
//   the block text as the clipboard payload. (Noted in wiring_notes.)
//
// Three-column layout:
//   - Left: conversation sidebar (channels + active thread)
//   - Center: scrollback + composer (input box + send button)
//   - Bottom: composer textarea + send + slash autocomplete dropdown
//
// Inspiration: `QUELLEN/openhuman/app/src/pages/conversations/` —
// AgentMessageBubble pattern + role-based right/left alignment.
// Slint-native version, no React idioms ported verbatim.
//
// Streaming strategy (Session 16 Pick #33 design decision, flagged
// in handoff §7 for future Chorus-gremium review):
// - Property updates per chunk. Rust side appends to a `pending-text`
//   string property; Slint's reactive layer re-renders the last
//   bubble on every update. Simplest path, no buffer-flush logic.
// - Operator sees the daemon's stream surface in real time.

import { ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NeothButton, Card, Led, ConfirmDialog, NeothComboBox } from "components.slint";

/// One message in the scrollback. Owned by the Rust side; Slint
/// renders the list reactively.
export struct ChatMessage {
    role: string,        // "operator" | "neoth"/"assistant" | "system" | "error"
    text: string,
    /// Display timestamp, pre-formatted by the Rust side. Keeps
    /// Slint's expression layer free of date logic.
    timestamp: string,
    /// Canonical Rust-owned request identity. Empty for persisted/history
    /// rows; live callbacks may mutate only the row with their exact id.
    request-id: string,
    /// `waiting | receiving | finalizing | complete | cancelled | failed`.
    /// Timers may animate an active phase but never advance it.
    stream-phase: string,
    /// GOLD-ADAPT-ODY-02/05 — per-message metrics chip ("ctx 6% · 38 tok/s")
    /// + the click-popup detail block. Pre-formatted Rust-side
    /// (`panel_logic::format_stream_metrics`); empty = no chip.
    metrics: string,
    metrics-detail: string,
    /// Exact provider response model from the stream done-sentinel.
    model: string,
    /// H19-lite: pre-extracted fenced code blocks joined by a blank line;
    /// empty string means no code panel is shown. The Rust side runs a
    /// fenced-block regex over the reply text and joins matches with "\n\n".
    code-block: string,
    /// Language tag of the first fenced block (e.g. "rust", "python", "sh").
    /// May be empty if the opening fence had no language specifier.
    code-lang: string,
}

/// A chat-sidebar channel is either the real local CLI route or a read-only
/// discovery row for a configured external channel.  Keeping route state in
/// the model prevents a configured channel from looking selected while Send
/// still targets the local CLI.
export struct ChatChannelRow {
    id: string,
    label: string,
    detail: string,
    last-message: string,
    last-timestamp: string,
    route-bound: bool,
    configurable: bool,
}

/// GOLD-ADAPT-ODY-01 — one recent session in the sidebar (from the
/// hindsight cards). `label` = display-name or one-line summary.
export struct SessionRow {
    id: string,
    label: string,
    meta: string,
    preview: string,
    last-timestamp: string,
}

/// GOLD-ADAPT-ODY-12/14 — one clickable deep-link chip extracted from
/// the last reply's `[label](#kind-id)` anchors (done-sentinel `links`
/// field). `nav-<panel>` chips are the UI-control events; entity chips
/// (e.g. `kanban-<task_id>`) navigate + focus.
export struct LinkChip {
    label: string,
    kind: string,
    id: string,
}

/// Chat-surface consent strip — one row per provider grant.
/// Rust constructs from `neoth consent list --output json`.
export struct ConsentGrant {
    provider: string,
    granted: bool,
    detail: string,
    status: string,
    grantable: bool,
    revokable: bool,
}

// ── ChatBubble ───────────────────────────────────────────────────────
// One message. Operator messages right-align with accent-green tint;
// NEOTH messages left-align with card surface; system messages
// center-align with muted text.
//
// Hover-action bar: on bubble hover a glass chip row fades in at the
// top-right of the bubble — Copy (⧉), Retry (↺, assistant only),
// Delete (✕, consent-pink on hover). Callbacks bubble up to ChatView.

component ChatBubble inherits Rectangle {
    in property <ChatMessage> message;
    /// Retry/Delete mutate the live feed and are absent in read-only history.
    in property <bool> mutation-actions-enabled: true;
    in property <length> bubble-max-width: 600px;
    /// Index of this bubble in the messages model — passed from the
    /// for loop so action callbacks carry the right index.
    in property <int> bubble-index: 0;

    callback copy-clicked();
    callback retry-clicked();
    callback delete-clicked();
    /// Fired when the Copy chip inside the code panel is clicked.
    /// The ChatView for-loop forwards this as code-copy(bubble-index).
    callback code-copy();

    /// Per-bubble collapse state for the code panel body. Starts expanded.
    private property <bool> code-collapsed: false;
    private property <bool> stream-active:
        root.message.stream-phase == "waiting"
        || root.message.stream-phase == "receiving"
        || root.message.stream-phase == "finalizing";
    private property <string> stream-label:
        root.message.stream-phase == "waiting" ? "Waiting for provider"
        : root.message.stream-phase == "receiving" ? "Receiving response"
        : root.message.stream-phase == "finalizing" ? "Finalizing response"
        : "";

    // Height now tracks the named inner VerticalLayout so the code panel
    // (when present) contributes to the bubble's natural height.
    height: max(40px, bubble-content.preferred-height);

    HorizontalLayout {
        alignment: root.message.role == "operator" ? end : (root.message.role == "system" ? center : start);
        padding-left: Theme.space-base;
        padding-right: Theme.space-base;

        Rectangle {
            // GOLD-SEC-31 / E-16: `error` bubbles render in the destructive
            // accent so a failed turn is visibly distinct — the Rust side
            // emits role "error"/"assistant"; "assistant" falls through to
            // the NEOTH card default, "error" now has its own red arm.
            background: Theme.chat-bubble-style == 2 && root.message.role != "error"
                ? transparent
                : (root.message.role == "operator"
                ? Theme.accent-green.with-alpha(0.18)
                : (root.message.role == "error"
                    ? Theme.accent-pink.with-alpha(0.18)
                    : (root.message.role == "system" ? transparent : Theme.bg-card)));
            border-color: root.message.role == "operator"
                ? Theme.accent-green.with-alpha(0.4)
                : (root.message.role == "error"
                    ? Theme.accent-pink.with-alpha(0.55)
                    : (root.message.role == "system" ? transparent : Theme.border-subtle));
            border-width: root.message.role == "system" || Theme.chat-bubble-style == 2 ? 0px : 1px;
            border-radius: Theme.chat-bubble-style == 1 ? Theme.radius-xs : Theme.radius-card;
            max-width: root.bubble-max-width;

            // ── Z-layer 0: full-bubble hover tracker ─────────────────
            // Declared first (lowest z-order) so its has-hover fires
            // on the full rect area while action-bar's inner TouchAreas
            // (declared later, higher z) still capture click events.
            bubble-hover := TouchArea {}

            // ── Z-layer 1: message content ────────────────────────────
            bubble-content := VerticalLayout {
                // ODY-11: density-aware padding (compact 8px / normal 16px / spacious 24px).
                padding: Theme.bubble-padding;
                spacing: Theme.space-tight;

                body := Text {
                    // Receiving caret blinks ▋↔▏ (block-element glyphs share
                    // one advance width — no reflow jitter). Static ▋ when
                    // motion is off or reduced (Theme.animation-mode 0/1).
                    // Waiting and Finalizing have their own truthful status row.
                    text: root.message.text + (root.message.stream-phase == "receiving"
                        ? (Theme.animation-mode != 2 || mod(animation-tick(), 1060ms) < 530ms
                            ? " ▋" : " ▏")
                        : "");
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-body;
                    font-weight: root.message.role == "system" ? Theme.weight-light : Theme.weight-regular;
                    letter-spacing: Theme.letter-spacing-body;
                    color: root.message.role == "error"
                        ? Theme.accent-pink
                        : (root.message.role == "system" ? Theme.text-muted : Theme.text-primary);
                    wrap: word-wrap;
                }

                if root.stream-active: Text {
                    text: root.stream-label
                        + (root.message.stream-phase == "waiting"
                            && Theme.animation-mode == 2
                            ? (mod(animation-tick(), 1200ms) < 400ms ? " ."
                                : (mod(animation-tick(), 1200ms) < 800ms ? " .." : " ..."))
                            : "");
                    font-family: Theme.font-mono;
                    font-size: Theme.font-size-caption;
                    color: root.message.stream-phase == "finalizing"
                        ? Theme.accent-cyan
                        : Theme.text-muted;
                    accessible-role: progress-indicator;
                    accessible-label: "Response status";
                    accessible-value: root.stream-label;
                }

                if root.message.timestamp != "": HorizontalLayout {
                    spacing: Theme.space-tight;
                    alignment: start;
                    Text {
                        text: root.message.timestamp;
                        overflow: elide;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                    // ODY-02/05 — context/throughput chip; click pops the
                    // full metrics detail.
                    if Theme.show-token-count && root.message.metrics != "": Rectangle {
                        width: chip-txt.preferred-width + 14px;
                        height: 18px;
                        border-radius: Theme.radius-pill;
                        background: Theme.audit-tint;
                        border-width: 1px;
                        border-color: chip-touch.has-hover ? Theme.audit : Theme.border-subtle;
                        animate border-color { duration: Theme.duration-micro; easing: ease-out; }
                        chip-txt := Text {
                            text: root.message.metrics;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-2xs;
                            color: Theme.audit;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                        }
                        chip-touch := TouchArea { clicked => { metrics-popup.show(); } }
                        metrics-popup := PopupWindow {
                            x: 0; y: parent.height + 4px;
                            Rectangle {
                                background: Theme.surface-2;
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.border-default;
                                VerticalLayout {
                                    padding: 12px;
                                    Text {
                                        text: root.message.metrics-detail;
                                        overflow: elide;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        color: Theme.text-secondary;
                                    }
                                }
                            }
                        }
                    }
                    if Theme.show-model-badge && root.message.model != "": Rectangle {
                        width: model-txt.preferred-width + 14px;
                        height: 18px;
                        border-radius: Theme.radius-pill;
                        background: Theme.accent-tint;
                        border-width: 1px;
                        border-color: Theme.border-accent;
                        model-txt := Text {
                            text: root.message.model;
                            overflow: elide;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-2xs;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                        }
                    }
                }

                // ── H19-lite: code-block panel ────────────────────────
                // Shown below the message text when code-block is non-empty.
                // bg-void surface gives visual depth distinct from the bubble
                // background. Chevron collapses the body; Copy chip copies the
                // raw code text via root.code-copy() → ChatView.code-copy(idx).
                if root.message.code-block != "": Rectangle {
                    background: Theme.bg-void;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {

                        // ── Header: lang tag · Copy chip · Collapse chevron ──
                        HorizontalLayout {
                            padding-left: Theme.space-base;
                            padding-right: Theme.space-tight;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: Theme.space-tight;

                            // Language tag — mono 2xs, text-muted, letter-spaced
                            // for an uppercase-like aesthetic (Slint has no
                            // text-transform, so extra letter-spacing approximates it).
                            Text {
                                text: root.message.code-lang;
                                overflow: elide;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-2xs;
                                color: Theme.text-muted;
                                letter-spacing: Theme.letter-spacing-extra-wide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            // Copy chip — glass pill, mono label, surface-2 on hover.
                            Rectangle {
                                width: code-copy-lbl.preferred-width + Theme.space-base;
                                height: 22px;
                                border-radius: Theme.radius-pill;
                                background: code-copy-ta.has-hover
                                    ? Theme.surface-2
                                    : Theme.surface-glass;
                                border-width: 1px;
                                border-color: Theme.border-default;
                                animate background {
                                    duration: Theme.duration-fast;
                                    easing: ease-out;
                                }
                                accessible-role: button;
                                accessible-label: "Copy code";
                                HorizontalLayout {
                                    alignment: center;
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    code-copy-lbl := Text {
                                        text: "Copy";
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        color: code-copy-ta.has-hover
                                            ? Theme.text-primary
                                            : Theme.text-secondary;
                                        animate color {
                                            duration: Theme.duration-fast;
                                            easing: ease-out;
                                        }
                                        vertical-alignment: center;
                                    }
                                }
                                code-copy-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.code-copy(); }
                                }
                            }

                            // Collapse / expand chevron (▾ = open, ▸ = folded).
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: Theme.radius-xs;
                                background: collapse-ta.has-hover
                                    ? Theme.surface-2
                                    : transparent;
                                animate background {
                                    duration: Theme.duration-fast;
                                    easing: ease-out;
                                }
                                accessible-role: button;
                                accessible-label: root.code-collapsed
                                    ? "Expand code"
                                    : "Collapse code";
                                Text {
                                    text: root.code-collapsed ? "▸" : "▾";
                                    font-family: Theme.font-display;
                                    font-size: Theme.font-size-caption;
                                    color: collapse-ta.has-hover
                                        ? Theme.text-primary
                                        : Theme.text-secondary;
                                    animate color {
                                        duration: Theme.duration-fast;
                                        easing: ease-out;
                                    }
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                collapse-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.code-collapsed = !root.code-collapsed;
                                    }
                                }
                            }
                        }

                        // Thin separator between header and code body.
                        Rectangle {
                            height: 1px;
                            background: Theme.border-subtle;
                        }

                        // ── Body: clips to 0 height when collapsed ────────
                        // `clip: true` + animated height produces the fold.
                        // preferred-height is read from the child Text so the
                        // animation targets the exact content height.
                        Rectangle {
                            clip: true;
                            height: root.code-collapsed
                                ? 0px
                                : code-body-txt.preferred-height + Theme.space-base * 2;
                            animate height {
                                duration: Theme.duration-fast;
                                easing: ease-out;
                            }

                            code-body-txt := Text {
                                x: Theme.space-base;
                                y: Theme.space-base;
                                width: parent.width - Theme.space-base * 2;
                                text: root.message.code-block;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // ── Z-layer 2: hover action bar ───────────────────────────
            // Glass chip row that fades in when the bubble is hovered.
            // Width: 3 chips (Copy + Retry + Delete) for assistant roles;
            // 2 chips (Copy + Delete) for operator — using fixed widths
            // so the reactive layout stays stable during the fade.
            // Anchored to top-right of the bubble inner rect.
            Rectangle {
                x: parent.width - self.width - 8px;
                y: 8px;
                // 2-chip width: (22+2+22) inner + 12px padding = 58px
                // 3-chip width: (22+2+22+2+22) inner + 12px padding = 82px
                width: !root.mutation-actions-enabled ? 34px
                    : (root.message.role != "operator" ? 82px : 58px);
                height: 28px;
                border-radius: Theme.radius-pill;
                background: Theme.surface-glass;
                border-width: 1px;
                border-color: Theme.border-default;
                opacity: bubble-hover.has-hover ? 1.0 : 0.0;
                animate opacity { duration: Theme.duration-fast; easing: ease-out; }

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 2px;
                    alignment: center;

                    // ── Copy ⧉ ───────────────────────────────────────
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: Theme.radius-xs;
                        background: copy-ta.has-hover ? Theme.surface-2 : transparent;
                        animate background { duration: Theme.duration-fast; easing: ease-out; }
                        accessible-role: button;
                        accessible-label: "Copy message";
                        Text {
                            text: "⧉";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: copy-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                            animate color { duration: Theme.duration-fast; easing: ease-out; }
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        copy-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.copy-clicked(); }
                        }
                    }

                    // ── Retry ↺ (assistant / error / system bubbles only) ──
                    if root.mutation-actions-enabled && root.message.role != "operator": Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: Theme.radius-xs;
                        background: retry-ta.has-hover ? Theme.surface-2 : transparent;
                        animate background { duration: Theme.duration-fast; easing: ease-out; }
                        accessible-role: button;
                        accessible-label: "Retry";
                        Text {
                            text: "↺";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: retry-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                            animate color { duration: Theme.duration-fast; easing: ease-out; }
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        retry-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.retry-clicked(); }
                        }
                    }

                    // ── Delete ✕ (consent-pink danger hover) ─────────
                    if root.mutation-actions-enabled: Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: Theme.radius-xs;
                        background: del-ta.has-hover ? Theme.consent-tint : transparent;
                        animate background { duration: Theme.duration-fast; easing: ease-out; }
                        accessible-role: button;
                        accessible-label: "Delete message";
                        Text {
                            text: "✕";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            color: del-ta.has-hover ? Theme.consent : Theme.text-secondary;
                            animate color { duration: Theme.duration-fast; easing: ease-out; }
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        del-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.delete-clicked(); }
                        }
                    }
                }
            }
        }
    }
}

// ── ConversationItem ─────────────────────────────────────────────────
// One row in the left sidebar — channel name + last-message preview +
// unread indicator.

component ConversationItem inherits Rectangle {
    in property <string> label: "";
    in property <string> last-message: "";
    in property <string> last-timestamp: "";
    in property <int> unread-count: 0;
    in property <bool> active: false;
    in property <bool> route-bound: false;
    in property <bool> configurable: false;
    callback context-menu(string /*channel*/, length /*x*/, length /*y*/);
    callback selected();

    accessible-role: button;
    accessible-enabled: root.route-bound;
    accessible-label: root.label + ": " + root.last-message
        + (root.last-timestamp != "" ? ", " + root.last-timestamp : "")
        + (root.unread-count > 0 ? " (\{root.unread-count} unread)" : "")
        + (root.active ? ". Current conversation." : "");
    accessible-action-default => {
        if (root.route-bound) { root.selected(); }
    }
    forward-focus: key-focus;

    height: max(64px, row-body.preferred-height + Theme.space-tight * 2);
    background: root.active ? Theme.bg-card : transparent;
    border-radius: Theme.radius-button;
    border-width: 2px;
    border-color: key-focus.has-focus ? Theme.focus-ring : transparent;

    animate background {
        duration: Theme.duration-micro;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    // GOLD-ADAPT-GUI-02: active bar grows from the centre with the
    // ease-back overshoot (same motion as the sidebar NavBtn rail).
    Rectangle {
        x: 0;
        width: 3px;
        height: root.active ? parent.height - 16px : 0px;
        y: (parent.height - self.height) / 2;
        background: Theme.accent-green;
        border-radius: 2px;
        animate height { duration: Theme.duration-base; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    }

    row-body := VerticalLayout {
        x: Theme.space-base;
        y: Theme.space-tight;
        width: parent.width - Theme.space-base * 2;
        spacing: 2px;

        HorizontalLayout {
            alignment: space-between;
            spacing: Theme.space-tight;
            Text {
                text: root.label;
                overflow: elide;
                font-family: Theme.font-display;
                font-size: Theme.font-size-body;
                font-weight: root.active ? Theme.weight-medium : Theme.weight-regular;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            if root.last-timestamp != "": Text {
                text: root.last-timestamp;
                font-family: Theme.font-mono;
                font-size: Theme.font-size-2xs;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
            if root.unread-count > 0: Rectangle {
                width: 22px;
                height: 18px;
                background: Theme.accent-green;
                border-radius: Theme.radius-pill;
                Text {
                    text: root.unread-count > 9 ? "9+" : root.unread-count;
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-2xs;
                    font-weight: Theme.weight-bold;
                    color: Theme.bg-base;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if root.last-message != "": Text {
            text: root.last-message;
            font-family: Theme.font-display;
            font-size: Theme.font-size-caption;
            color: Theme.text-secondary;
            overflow: elide;
        }
    }

    key-focus := FocusScope {
        enabled: root.route-bound;
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " ") {
                root.selected();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        clicked => {
            if (root.route-bound) {
                key-focus.focus();
                root.selected();
            }
        }
        pointer-event(ev) => {
            if (root.configurable && ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.context-menu(root.label,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// ── Composer ─────────────────────────────────────────────────────────
// Input box + send button + slash-autocomplete dropdown. Single-line
// for v0.1 (Enter sends). Multi-line lands when an operator complains.

component Composer inherits Rectangle {
    in-out property <string> draft: "";
    in property <bool> send-enabled: true;
    /// GOLD-ADAPT-GUI-07 — true while a chat subprocess is streaming a
    /// reply; the Send button shows its spinner and re-sends are blocked.
    in property <bool> send-in-flight: false;
    /// Whether the operator's draft starts with `/` — Rust side
    /// surfaces the slash-autocomplete dropdown when this is true.
    in property <bool> slash-active: false;
    /// GOLD-ADAPT-ODY-03 — display names of pending attachments; the
    /// paths live Rust-side (Arc<Mutex<Vec<PathBuf>>>).
    in property <[string]> pending-attachments: [];
    /// Operator-visible Skill labels. Rust owns the parallel canonical IDs.
    in property <[string]> skill-options: [];
    /// Shared explicit Skill selection. Index 0 is the Rust-provided auto route.
    in-out property <int> selected-skill-index: 0;
    /// Typed result of the Skill router for this composer surface.
    in property <string> skill-route-status: "";
    callback send-clicked(string);
    callback skill-selected(int);
    callback attach-clicked();
    callback remove-attachment(int);
    /// Fires when the operator taps the Stop button while send-in-flight
    /// is true. Rust kills the chat subprocess and finalises the partial text.
    callback stop-stream-clicked();
    /// Operator pressed ArrowUp with an empty composer — fires so Rust
    /// can write the last sent input back into `draft`.
    callback recall-requested();

    // Reviewer-3 P1-B (2026-05-20): persistent label + helper line so
    // the operator always sees what the input is for, even after the
    // placeholder vanishes on first keystroke.
    // Chat-feel #2: height now tracks the body so the multi-line composer
    // grows with the draft instead of clipping at a fixed bar height.
    height: body.preferred-height;
    background: Theme.bg-base;

    Rectangle {
        x: Theme.space-screen;
        y: 0;
        width: parent.width - Theme.space-screen * 2;
        height: 1px;
        background: Theme.border-subtle;
    }

    body := VerticalLayout {
        padding-left: Theme.space-screen;
        padding-right: Theme.space-screen;
        // ODY-11: density-aware composer padding (compact 6px / normal 8px / spacious 16px).
        padding-top: Theme.composer-padding;
        padding-bottom: Theme.composer-padding;
        spacing: 4px;

        // Persistent label above the input — accessible name for
        // assistive tech, visual anchor for noobs.
        Text {
            text: "Message";
            font-family: Theme.font-display;
            font-size: Theme.font-size-caption;
            font-weight: Theme.weight-medium;
            letter-spacing: Theme.letter-spacing-tight;
            color: Theme.text-tertiary;
        }

        // ODY-03 — pending-attachment strip: one removable chip per file.
        if root.pending-attachments.length > 0: HorizontalLayout {
            spacing: Theme.space-tight;
            alignment: start;
            for name[i] in root.pending-attachments: Rectangle {
                height: 24px;
                width: att-txt.preferred-width + att-x.preferred-width + 26px;
                border-radius: Theme.radius-pill;
                background: Theme.accent-tint;
                border-width: 1px;
                border-color: Theme.border-accent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 6px; spacing: 6px;
                    att-txt := Text {
                        text: name;
                        overflow: elide;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                    att-x := Text {
                        text: "✕";
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                        color: x-touch.has-hover ? Theme.consent : Theme.text-tertiary;
                        vertical-alignment: center;
                        x-touch := TouchArea {
                            enabled: !root.send-in-flight;
                            clicked => { root.remove-attachment(i); }
                        }
                    }
                }
            }
        }

        // R4-05 — slash quick-entry: one-tap prefill for built-in slash commands
        // that otherwise required typing. Sets the draft; the existing slash
        // dispatch (slash-active cue) runs it on send. Discoverability, not
        // auto-execute — the operator still presses send.
        HorizontalLayout {
            spacing: Theme.space-tight;
            alignment: start;
            for cmd in ["/critic", "/background", "/quit"]: Rectangle {
                height: 24px;
                border-radius: Theme.radius-pill;
                background: qa-touch.has-hover ? Theme.accent-green.with-alpha(0.18) : Theme.surface-2;
                border-width: 1px;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: cmd;
                        color: Theme.text-secondary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                        vertical-alignment: center;
                    }
                }
                qa-touch := TouchArea {
                    enabled: !root.send-in-flight;
                    mouse-cursor: pointer;
                    clicked => { root.draft = cmd + " "; }
                }
            }
        }

        // ADOPT31-B10 — explicit Skill selection stays visible beside the
        // router result. The route status is intentionally not folded into
        // the generic chat/helper status line.
        HorizontalLayout {
            spacing: Theme.space-base;
            alignment: center;

            Text {
                text: "Skill";
                font-family: Theme.font-display;
                font-size: Theme.font-size-caption;
                font-weight: Theme.weight-medium;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }

            NeothComboBox {
                width: 300px;
                model: root.skill-options;
                current-index <=> root.selected-skill-index;
                enabled: root.skill-options.length > 0 && !root.send-in-flight;
                selected(i) => { root.skill-selected(i); }
            }

            Text {
                text: root.skill-route-status;
                visible: root.skill-route-status != "";
                horizontal-stretch: 1;
                overflow: elide;
                font-family: Theme.font-mono;
                font-size: Theme.font-size-2xs;
                color: Theme.text-tertiary;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: Theme.space-base;

        // ODY-03 — attach button (native picker via Rust callback).
        NeothButton {
            label: "⊕";
            primary: false;
            width: 44px;
            height: 44px;
            enabled: !root.send-in-flight;
            clicked => { root.attach-clicked(); }
        }

        // Slash hint — visible only when the draft starts with `/`,
        // gives the operator a discoverable cue that they can run a
        // command without first reading docs.
        if root.slash-active: Rectangle {
            width: 32px;
            height: 32px;
            border-radius: Theme.radius-button;
            background: Theme.accent-green.with-alpha(0.2);
            border-color: Theme.accent-green;
            border-width: 1px;
            Text {
                text: "/";
                font-family: Theme.font-mono;
                font-size: Theme.font-size-body;
                font-weight: Theme.weight-bold;
                color: Theme.accent-green;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Chat-feel parity #2 (beat-openhuman): multi-line composer.
        // Bare TextInput (NOT std TextEdit — its key-pressed fires after
        // the char is inserted, so Enter can't be intercepted). ENTER
        // sends; SHIFT+ENTER inserts a newline. Auto-grows with content
        // between min/max; word-wraps. Slint represents Return as "\n"
        // (U+000A) in event.text.
        Rectangle {
            horizontal-stretch: 1;
            // Auto-grow: height tracks the TextInput's reactive
            // preferred-height between a 1-line floor and a ~6-line cap.
            height: max(Theme.input-height, min(160px, composer-input.preferred-height + Theme.space-base));
            background: Theme.bg-card;
            border-radius: Theme.radius-button;
            border-width: 1px;
            border-color: composer-input.has-focus ? Theme.accent-green : Theme.border-subtle;
            animate border-color {
                duration: Theme.duration-micro;
                easing: cubic-bezier(0.2, 0.8, 0.2, 1);
            }

            // Placeholder layer — visible only when empty + unfocused.
            if root.draft == "" && !composer-input.has-focus: Text {
                x: Theme.space-tight;
                y: Theme.space-tight;
                text: "Type message or /command…  (Enter sends · Shift+Enter = newline)";
                font-family: Theme.font-display;
                font-size: Theme.font-size-body;
                color: Theme.text-dim;
                vertical-alignment: top;
            }

            composer-input := TextInput {
                x: Theme.space-tight;
                y: Theme.space-tight;
                width: parent.width - Theme.space-tight * 2;
                height: parent.height - Theme.space-tight * 2;
                text <=> root.draft;
                enabled: !root.send-in-flight;
                font-family: Theme.font-display;
                font-size: Theme.font-size-body;
                color: Theme.text-primary;
                selection-background-color: Theme.accent-green.with-alpha(0.4);
                single-line: false;
                wrap: word-wrap;
                vertical-alignment: top;

                key-pressed(event) => {
                    if (root.send-in-flight) {
                        return accept;
                    }
                    if (event.text == "\n") {
                        // Shift+Enter → let TextInput insert the newline.
                        if (event.modifiers.shift) {
                            return reject;
                        }
                        // Plain Enter → request send. Rust clears only after
                        // typed consent preflight accepts this exact draft.
                        // GUI-07: swallowed while a reply is in flight.
                        if (root.send-enabled && root.draft != "" && !root.send-in-flight) {
                            root.send-clicked(root.draft);
                        }
                        return accept;
                    }
                    // ArrowUp on an empty composer → recall last sent input.
                    // Non-empty composer: reject so native cursor-up navigation
                    // works normally in the multi-line TextInput.
                    if (event.text == Key.UpArrow) {
                        if (root.draft == "") {
                            root.recall-requested();
                            return accept;
                        }
                        return reject;
                    }
                    return reject;
                }
            }

            TouchArea {
                enabled: !root.send-in-flight;
                clicked => { composer-input.focus(); }
            }
        }

        // ALWAYS-VISIBLE STOP (H19-lite): while send-in-flight the Send
        // button is replaced by a danger/Stop button that fires
        // stop-stream-clicked(). Enter-to-send is already gated in
        // key-pressed by !root.send-in-flight, so it stays disabled.
        if !root.send-in-flight: NeothButton {
            label: "Send →";
            enabled: root.send-enabled && root.draft != "";
            clicked => {
                if (root.draft != "") {
                    root.send-clicked(root.draft);
                }
            }
        }
        if root.send-in-flight: NeothButton {
            label: "Stop";
            danger: true;
            clicked => { root.stop-stream-clicked(); }
        }
        }

        // Constant helper line below — visible at all times.
        Text {
            text: "Enter sends · Shift+Enter for newline";
            font-family: Theme.font-display;
            font-size: Theme.font-size-caption;
            color: Theme.text-dim;
        }
    }
}

// ── ChatView ─────────────────────────────────────────────────────────
// Top-level chat layout — left sidebar + main scrollback + bottom composer.

export component ChatView inherits Rectangle {
    // Entrance fade — same contract as EntranceFade (E-wave homogeneity).
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: Theme.duration-entrance; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    in property <[ChatMessage]> messages: [];
    in-out property <string> composer-draft: "";
    in property <bool> send-enabled: true;
    /// GUI-07 — a reply subprocess is running; Send shows its spinner.
    in property <bool> send-in-flight: false;
    /// Set by the Rust side when `composer-draft` starts with `/`.
    /// Slint can't run `.starts-with()` in property expressions, so
    /// the host owns the boolean.
    in property <bool> slash-active: false;
    /// The local CLI route plus read-only configured-channel discovery rows.
    /// Only a row whose `route-bound` flag is true may look active.
    in property <[ChatChannelRow]> channels: [];
    /// Per-channel unread count, parallel-indexed with `channels`.
    in property <[int]> unread-counts: [0, 0, 0];
    /// GOLD-ADAPT-ODY-01 — recent sessions (hindsight cards, newest first).
    in property <[SessionRow]> session-history: [];
    /// Canonical hindsight/raw-turn id while `history-active` is true.
    /// Live/history is deliberately a separate typed flag so a real session
    /// id such as `live` cannot acquire mutation privileges.
    in property <string> active-session-id: "";
    in property <bool> history-active: false;
    /// GOLD-LF-P1-21 — request-bound diagnostic after 120 seconds without
    /// meaningful stream/provider progress. Rust owns the request binding.
    in property <bool> stall-active: false;
    /// GOLD-ADAPT-ODY-03 — pending attachment display names.
    in property <[string]> pending-attachments: [];
    /// ADOPT31-B10 — explicit Skill picker labels, shared selection and the
    /// resolver's dedicated status line. Canonical Skill IDs remain Rust-owned.
    in property <[string]> skill-options: [];
    in-out property <int> selected-skill-index: 0;
    in property <string> skill-route-status: "";
    /// GOLD-ADAPT-ODY-12/14 — deep-link chips for the LAST reply.
    /// Rendered above the composer; replaced on every completed turn.
    in property <[LinkChip]> link-chips: [];
    /// Number of messages received while the user was scrolled away from
    /// the bottom. Rust increments on each new message when auto-follow
    /// is disengaged; resets to 0 when scroll-to-bottom-clicked fires.
    in property <int> unseen-count: 0;
    /// Starter-prompt chips shown in the empty transcript state.
    /// Rust may override these from startup config; defaults shown here.
    in property <[string]> starter-prompts: ["What can you do?", "Show me a demo", "Help me get started"];

    callback send-clicked(string);
    callback skill-selected(int);
    callback channel-ctx(string /*channel*/, length /*x*/, length /*y*/);
    callback live-session-selected();
    callback session-selected(string);
    callback open-settings();
    callback attach-clicked();
    callback remove-attachment(int);
    /// Watchdog diagnostic actions. Retry first cancels the bound request;
    /// Rust creates a fresh request only after that cancellation settles.
    callback stall-retry-clicked();
    callback stall-stop-clicked();
    /// ODY-12/14 — a deep-link chip was clicked: (kind, id).
    callback link-chip-clicked(string, string);
    /// Operator pressed ArrowUp with an empty composer — bubbles up to
    /// Rust so it can write the last sent input back into `composer-draft`.
    callback recall-requested();
    /// Hover-action bar callbacks — index is the position in `messages`.
    callback message-copy(int);
    callback message-retry(int);
    callback message-delete(int);
    /// Index awaiting delete confirmation; -1 = no dialog. The bubble's
    /// delete action arms this instead of firing message-delete directly.
    property <int> delete-confirm-idx: -1;
    /// FAB tapped — Rust should reset `unseen-count` to 0.
    callback scroll-to-bottom-clicked();
    /// Empty state starter chip tapped — fire the prompt as if the operator
    /// sent it. Rust handler is identical to send-clicked.
    callback starter-clicked(string);
    /// Code panel copy chip clicked — `index` is the position in `messages`.
    /// Rust side copies `messages[index].code-block` to the clipboard.
    callback code-copy(int);
    /// Operator tapped Stop while a reply is streaming (H19-lite).
    /// Rust kills the chat subprocess and finalises the partial message text.
    callback stop-stream-clicked();

    // ── Consent strip (chat-surface quick-access) ─────────────────────
    /// Current operating mode string: "gated" | "full-auto" | "sovereign-buddy" | "advanced"
    /// Rust sets from `neoth autonomy show --output json` .mode field.
    in property <string> consent-mode: "gated";
    /// Per-provider consent grants. Rust sets from `neoth consent list --output json`.
    in property <[ConsentGrant]> consent-grants: [];
    /// Shared Grant/Revoke in-flight state across Chat and Overview.
    in property <bool> consent-busy: false;
    /// Operator clicked Gated or Full-Auto pill: fires with "gated" or "full".
    callback consent-set-mode(string);
    /// Operator clicked Grant for the provider's currently configured route.
    callback consent-grant(string);
    /// Operator clicked Revoke for a provider.
    callback consent-revoke(string);
    /// Operator asked for a manual refresh of consent data.
    callback consent-refresh();

    // Chat-feel #2 (beat-openhuman): auto-scroll-to-bottom. `auto-follow`
    // stays true while the operator is at/near the bottom; a manual
    // scroll-up disengages it (so reading history isn't yanked away by a
    // new reply), and scrolling back to the bottom re-engages it.
    private property <bool> auto-follow: true;
    // Pin the scrollback to the newest message when a message is appended
    // AND the operator is following. `min(0px, …)` guards the
    // content-fits-in-viewport case (no negative scroll).
    changed messages => {
        if (root.auto-follow) {
            scrollback.viewport-y = min(0px, -(scrollback.viewport-height - scrollback.visible-height));
        }
    }

    background: Theme.bg-base;

    HorizontalLayout {
        // ── Conversation sidebar ─────────────────────────────────
        Rectangle {
            width: 240px;
            background: Theme.bg-base;
            border-color: Theme.border-subtle;
            border-width: 0px;

            VerticalLayout {
                padding: Theme.space-base;
                spacing: Theme.space-tight;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "CHANNELS";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-bold;
                        letter-spacing: Theme.letter-spacing-extra-wide;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                    // G-18 fix: desktop hit target 44×44 minimum.
                    // The cog stays as the visible glyph; the larger
                    // hit box makes mouse acquisition reliable.
                    NeothButton {
                        label: "⚙";
                        primary: false;
                        width: 44px;
                        height: 44px;
                        clicked => { root.open-settings(); }
                    }
                }

                // Render one ConversationItem per channel. Slint's
                // `for ... in` iterates the model reactively.
                for ch[idx] in root.channels: ConversationItem {
                    label: ch.label;
                    last-message: ch.last-message != "" ? ch.last-message : ch.detail;
                    last-timestamp: ch.last-timestamp;
                    unread-count: idx < root.unread-counts.length ? root.unread-counts[idx] : 0;
                    active: ch.route-bound && !root.history-active;
                    route-bound: ch.route-bound;
                    configurable: ch.configurable;
                    selected => { root.live-session-selected(); }
                    context-menu(name, x, y) => { root.channel-ctx(name, x, y); }
                }

                // Truthful affordance: rows surface channel status only —
                // chat routing not available from the sidebar.
                Text {
                    text: "Channel status only · chat routing not available";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-2xs;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }

                // ── ODY-01: recent sessions (hindsight cards) ─────────
                if root.session-history.length > 0: Rectangle {
                    height: 1px; background: Theme.border-subtle;
                }
                if root.session-history.length > 0: Text {
                    text: "SESSIONS";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-caption;
                    font-weight: Theme.weight-bold;
                    letter-spacing: Theme.letter-spacing-extra-wide;
                    color: Theme.text-dim;
                }
                if root.session-history.length > 0: Text {
                    text: "Read-only history · select a session to inspect";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-2xs;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        for s in root.session-history: Rectangle {
                            height: max(62px, session-body.preferred-height + Theme.space-tight * 2);
                            border-radius: Theme.radius-button;
                            accessible-role: button;
                            accessible-enabled: true;
                            accessible-label: "\{s.label}: "
                                + (s.preview != "" ? s.preview : "No retained transcript preview")
                                + ", " + (s.last-timestamp != "" ? s.last-timestamp : s.meta)
                                + (root.history-active && root.active-session-id == s.id
                                    ? ". Current read-only history session."
                                    : ". Read-only history session.");
                            accessible-action-default => { root.session-selected(s.id); }
                            forward-focus: session-focus;
                            background: root.history-active && root.active-session-id == s.id ? Theme.bg-card : transparent;
                            border-width: 2px;
                            border-color: session-focus.has-focus ? Theme.focus-ring
                                : root.history-active && root.active-session-id == s.id ? Theme.border-accent
                                : transparent;
                            session-body := VerticalLayout {
                                x: Theme.space-base;
                                y: Theme.space-tight;
                                width: parent.width - Theme.space-base * 2;
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: s.label;
                                    font-family: Theme.font-display;
                                    font-size: Theme.font-size-caption;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: s.preview != "" ? s.preview : "No retained transcript preview";
                                    font-family: Theme.font-display;
                                    font-size: Theme.font-size-2xs;
                                    color: Theme.text-secondary;
                                    overflow: elide;
                                }
                                Text {
                                    text: s.last-timestamp != "" ? s.last-timestamp : s.meta;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-2xs;
                                    color: Theme.text-tertiary;
                                    overflow: elide;
                                }
                            }
                            session-focus := FocusScope {
                                key-pressed(event) => {
                                    if (event.text == "\n" || event.text == " ") {
                                        root.session-selected(s.id);
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    session-focus.focus();
                                    root.session-selected(s.id);
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Main pane: scrollback + composer ─────────────────────
        VerticalLayout {
            // The only route currently bound to this composer is the local
            // CLI. Remote configured channels are discovery rows until the
            // Plan-001/003 route controller can bind send + transcript state.
            Rectangle {
                height: 44px;
                background: Theme.bg-base;
                Rectangle {
                    x: Theme.space-base;
                    y: parent.height - 1px;
                    width: parent.width - Theme.space-base * 2;
                    height: 1px;
                    background: Theme.border-subtle;
                }
                HorizontalLayout {
                    padding-left: Theme.space-base;
                    padding-right: Theme.space-base;
                    spacing: Theme.space-tight;
                    alignment: start;
                    Text {
                        text: "●";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        color: Theme.accent-green;
                        vertical-alignment: center;
                    }
                    Text {
                        text: !root.history-active ? "Local CLI chat" : "Read-only session history";
                        overflow: elide;
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        font-weight: Theme.weight-medium;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }
            }
            // ── CONSENT STRIP ─────────────────────────────────────────────
            // Thin ~34px bar giving quick access to operating-mode and
            // per-provider consent without leaving the chat surface.
            // Tool-call auto-approve follows the mode. Per-channel
            // smart-approve lives in Channels.
            Rectangle {
                height: 34px;
                background: Theme.bg-sunken;
                // Bottom separator line.
                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: parent.width; height: 1px;
                    background: Theme.border-subtle;
                }

                // Consent popover — shows below the strip via popup.show().
                // PopupWindow x/y are relative to the instantiating element
                // (the outer 34px Rectangle). Named so the button can call
                // consent-popup.show() without a private bool toggle.
                consent-popup := PopupWindow {
                    x: parent.width - 460px;
                    y: parent.height;
                    width: 460px;
                    Rectangle {
                        background: Theme.bg-card;
                        border-color: Theme.border-default;
                        border-width: 1px;
                        border-radius: Theme.radius-card;

                        VerticalLayout {
                            padding: Theme.space-base;
                            spacing: Theme.space-tight;

                            // Popover header
                            Text {
                                text: "Provider consent";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-caption;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-primary;
                            }

                            // Hint line
                            Text {
                                text: "Tool-call auto-approve follows the mode above. Per-channel smart-approve lives in Channels.";
                                font-family: Theme.font-display;
                                font-size: Theme.font-size-2xs;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                            }

                            // Separator
                            Rectangle { height: 1px; background: Theme.border-subtle; }

                            // Grant rows — one per provider
                            if root.consent-grants.length == 0: Text {
                                text: "No provider grants recorded. Cloud providers require one-time consent before NEOTH routes any text to them.";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-2xs;
                                color: Theme.text-dim;
                                wrap: word-wrap;
                            }
                            for g in root.consent-grants: Rectangle {
                                height: 68px;
                                border-radius: Theme.radius-sm;
                                background: g.granted && g.status == "granted" ? Theme.consent-tint : Theme.surface-1;
                                border-width: 1px;
                                border-color: g.granted && g.status == "granted" ? Theme.consent : Theme.border-subtle;

                                HorizontalLayout {
                                    padding: Theme.space-tight;
                                    spacing: Theme.space-tight;
                                    alignment: start;
                                    Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        Led { state: g.granted && g.status == "granted" ? "live" : (g.status == "invalid" ? "error" : "off"); }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: Theme.space-tight;
                                            Text {
                                                text: g.provider;
                                                overflow: elide;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.font-size-2xs;
                                                color: g.granted && g.status == "granted" ? Theme.text-primary : Theme.text-tertiary;
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: g.status;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.font-size-2xs;
                                                color: g.granted && g.status == "granted" ? Theme.consent : (g.status == "invalid" ? Theme.consent : Theme.text-disabled);
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: g.detail;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            color: g.status == "invalid" ? Theme.consent : Theme.text-dim;
                                            wrap: word-wrap;
                                            max-height: 34px;
                                        }
                                    }
                                    if g.grantable: NeothButton {
                                        label: "Grant";
                                        primary: true;
                                        size: "sm";
                                        enabled: !root.consent-busy;
                                        clicked => { root.consent-grant(g.provider); }
                                    }
                                    if g.revokable: NeothButton {
                                        label: "Revoke";
                                        primary: false;
                                        danger: true;
                                        size: "sm";
                                        enabled: !root.consent-busy;
                                        clicked => { root.consent-revoke(g.provider); }
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: Theme.space-base;
                    padding-right: Theme.space-base;
                    spacing: Theme.space-tight;
                    alignment: start;

                    // Kicker label
                    Text {
                        text: "CONSENT";
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                        letter-spacing: Theme.letter-spacing-extra-wide;
                        color: Theme.text-disabled;
                        vertical-alignment: center;
                    }

                    // Spacer
                    Rectangle { width: Theme.space-tight; }

                    // Operating-mode Led dot + mode label.
                    // Wrap Led in a fixed-size container — Led inherits Rectangle
                    // which has no vertical-alignment; the container centres it.
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        Led {
                            state: root.consent-mode == "gated" ? "live"
                                : (root.consent-mode == "full-auto" ? "connecting"
                                : (root.consent-mode == "sovereign-buddy" ? "error" : "off"));
                        }
                    }
                    Text {
                        text: root.consent-mode;
                        overflow: elide;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }

                    // Spacer
                    Rectangle { width: Theme.space-tight; }

                    // Mode toggle — Gated button (primary when active)
                    NeothButton {
                        label: "Gated";
                        primary: root.consent-mode == "gated";
                        size: "sm";
                        enabled: root.consent-mode != "gated";
                        clicked => { root.consent-set-mode("gated"); }
                    }
                    // Full-Auto button (primary when active)
                    NeothButton {
                        label: "Full-Auto";
                        primary: root.consent-mode == "full-auto";
                        size: "sm";
                        enabled: root.consent-mode != "full-auto";
                        clicked => { root.consent-set-mode("full"); }
                    }

                    // Spacer fills remaining width, pushing Consent… right.
                    Rectangle { horizontal-stretch: 1; }

                    // Consent popover trigger — ghost button on the right.
                    NeothButton {
                        label: "Consent…";
                        primary: false;
                        size: "sm";
                        clicked => {
                            root.consent-refresh();
                            consent-popup.show();
                        }
                    }
                }
            }

            // ── Scrollback + scroll-to-bottom FAB wrapper ─────────────
            // A wrapping Rectangle lets the FAB float as an absolute
            // overlay over the ScrollView without affecting layout flow.
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                scrollback := ScrollView {
                    width: parent.width;
                    height: parent.height;

                    // Manual-scroll opt-out: `scrolled` fires only on
                    // user-initiated drag/flick (NOT on the programmatic
                    // viewport-y write above), so re-derive auto-follow from
                    // proximity to the bottom (within 12px = still following).
                    scrolled => {
                        root.auto-follow =
                            self.viewport-y <= -(self.viewport-height - self.visible-height) + 12px;
                    }

                    VerticalLayout {
                        padding: Theme.space-base;
                        // ODY-11: density-aware inter-bubble gap (compact 4px / normal 8px / spacious 16px).
                        spacing: Theme.bubble-gap;

                        // ── Empty transcript state ─────────────────────
                        // Shown when no messages exist. Replaced by the
                        // bubble list as soon as the first message arrives.
                        if root.messages.length == 0: Rectangle {
                            height: 360px;

                            VerticalLayout {
                                alignment: center;
                                spacing: Theme.space-base;

                                // Buddy-orb glyph — neon green, large
                                Text {
                                    text: "◎";
                                    font-family: Theme.font-display;
                                    font-size: 56px;
                                    color: Theme.accent-green.with-alpha(0.7);
                                    horizontal-alignment: center;
                                }

                                // Hint headline
                                Text {
                                    text: "Say hello…";
                                    font-family: Theme.font-display;
                                    font-size: Theme.font-size-h2;
                                    font-weight: Theme.weight-light;
                                    color: Theme.text-muted;
                                    horizontal-alignment: center;
                                }

                                // Sub-hint
                                Text {
                                    text: "Type a message below or pick a starter.";
                                    font-family: Theme.font-display;
                                    font-size: Theme.font-size-body;
                                    color: Theme.text-dim;
                                    horizontal-alignment: center;
                                }

                                // Starter-prompt chips — horizontal row, centred.
                                // Wraps to a new line naturally when the row is too
                                // narrow; each chip fires starter-clicked(prompt).
                                if root.starter-prompts.length > 0: HorizontalLayout {
                                    alignment: center;
                                    spacing: Theme.space-tight;
                                    for prompt in root.starter-prompts: Rectangle {
                                        height: 34px;
                                        width: starter-lbl.preferred-width + Theme.space-base * 2;
                                        border-radius: Theme.radius-pill;
                                        background: starter-ta.has-hover ? Theme.accent-tint : transparent;
                                        border-width: 1px;
                                        border-color: starter-ta.has-hover ? Theme.border-accent : Theme.border-default;
                                        animate background { duration: Theme.duration-fast; easing: ease-out; }
                                        animate border-color { duration: Theme.duration-fast; easing: ease-out; }
                                        accessible-role: button;
                                        accessible-label: prompt;

                                        starter-lbl := Text {
                                            text: prompt;
                                            font-family: Theme.font-display;
                                            font-size: Theme.font-size-caption;
                                            color: starter-ta.has-hover ? Theme.accent : Theme.text-secondary;
                                            animate color { duration: Theme.duration-fast; easing: ease-out; }
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width - Theme.space-base * 2;
                                            x: Theme.space-base;
                                        }
                                        starter-ta := TouchArea {
                                            enabled: !root.send-in-flight;
                                            mouse-cursor: pointer;
                                            clicked => { root.starter-clicked(prompt); }
                                        }
                                    }
                                }
                            }
                        }

                        for msg[idx] in root.messages: ChatBubble {
                            message: msg;
                            mutation-actions-enabled: !root.history-active && !root.send-in-flight;
                            bubble-index: idx;
                            bubble-max-width: 560px;
                            copy-clicked => { root.message-copy(idx); }
                            retry-clicked => { root.message-retry(idx); }
                            // Destructive — route through the confirm gate
                            // (single mis-click must not destroy a message).
                            delete-clicked => { root.delete-confirm-idx = idx; }
                            code-copy => { root.code-copy(idx); }
                        }
                    }
                }

                // ── Scroll-to-bottom FAB ───────────────────────────────
                // Floating pill bottom-right. Visible when the user has
                // scrolled away from the bottom (auto-follow = false).
                // Clicking snaps the viewport back to the bottom and fires
                // scroll-to-bottom-clicked so Rust can reset unseen-count.
                if !root.auto-follow: Rectangle {
                    // Ease in when the user scrolls away instead of popping.
                    opacity: 0; init => { self.opacity = 1; }
                    animate opacity { duration: Theme.duration-fast; easing: ease-out; }
                    x: parent.width - self.width - Theme.space-base;
                    y: parent.height - self.height - Theme.space-base;
                    width: fab-row.preferred-width + Theme.space-base;
                    height: 36px;
                    border-radius: Theme.radius-pill;
                    background: Theme.accent-tint;
                    border-width: 1px;
                    border-color: Theme.border-accent;
                    accessible-role: button;
                    accessible-label: "Scroll to bottom";

                    fab-row := HorizontalLayout {
                        padding-left: Theme.space-base;
                        padding-right: Theme.space-base;
                        spacing: Theme.space-tight;
                        alignment: center;

                        Text {
                            text: "↓";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }

                        if root.unseen-count > 0: Rectangle {
                            height: 18px;
                            width: unseen-lbl.preferred-width + 10px;
                            border-radius: Theme.radius-pill;
                            background: Theme.accent-tint;
                            unseen-lbl := Text {
                                text: root.unseen-count > 99 ? "99+" : root.unseen-count;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-2xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                            }
                        }
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            scrollback.viewport-y = min(0px, -(scrollback.viewport-height - scrollback.visible-height));
                            root.auto-follow = true;
                            root.scroll-to-bottom-clicked();
                        }
                    }
                }
            }

            // P1-21 — a typed request-bound watchdog diagnostic. It names
            // silence honestly; it does not claim that a short read timeout
            // means the provider is healthy or unhealthy.
            if root.stall-active: Rectangle {
                height: 52px;
                background: Theme.warning-tint;
                border-width: 1px;
                border-color: Theme.warning;
                HorizontalLayout {
                    padding-left: Theme.space-base;
                    padding-right: Theme.space-base;
                    spacing: Theme.space-base;
                    Text {
                        text: "No meaningful provider or stream progress for 120s.";
                        font-family: Theme.font-sans;
                        font-size: Theme.font-size-caption;
                        color: Theme.warning;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    NeothButton {
                        label: "Retry";
                        primary: false;
                        size: "sm";
                        accessible-label: "Cancel this silent request and retry it as a new request";
                        clicked => { root.stall-retry-clicked(); }
                    }
                    NeothButton {
                        label: "Cancel";
                        danger: true;
                        size: "sm";
                        accessible-label: "Cancel this silent request";
                        clicked => { root.stall-stop-clicked(); }
                    }
                }
            }

            // GOLD-ADAPT-ODY-12/14 — deep-link chips from the last reply,
            // above the composer (survives scrollback without per-bubble
            // model plumbing). Same visual language as the metrics chip.
            if !root.history-active && root.link-chips.length > 0: HorizontalLayout {
                padding-left: Theme.space-base;
                padding-right: Theme.space-base;
                spacing: Theme.space-base / 2;
                alignment: start;
                for chip in root.link-chips: Rectangle {
                    width: link-chip-txt.preferred-width + 14px;
                    height: 18px;
                    border-radius: Theme.radius-pill;
                    accessible-role: button;
                    accessible-label: chip.label;
                    accessible-action-default => { root.link-chip-clicked(chip.kind, chip.id); }
                    background: Theme.audit-tint;
                    border-width: 1px;
                    border-color: link-chip-ta.has-hover ? Theme.audit : Theme.border-subtle;
                    animate border-color { duration: Theme.duration-micro; easing: ease-out; }
                    link-chip-txt := Text {
                        text: chip.label;
                        overflow: elide;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                        color: Theme.audit;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                    }
                    link-chip-ta := TouchArea {
                        clicked => { root.link-chip-clicked(chip.kind, chip.id); }
                    }
                }
            }

            if !root.history-active: Composer {
                draft <=> root.composer-draft;
                send-enabled: root.send-enabled;
                send-in-flight: root.send-in-flight;
                slash-active: root.slash-active;
                pending-attachments: root.pending-attachments;
                skill-options: root.skill-options;
                selected-skill-index <=> root.selected-skill-index;
                skill-route-status: root.skill-route-status;
                send-clicked(text) => { root.send-clicked(text); }
                skill-selected(i) => { root.skill-selected(i); }
                attach-clicked => { root.attach-clicked(); }
                remove-attachment(i) => { root.remove-attachment(i); }
                recall-requested => { root.recall-requested(); }
                stop-stream-clicked => { root.stop-stream-clicked(); }
            }
            if root.history-active: Rectangle {
                height: max(52px, history-readonly-body.preferred-height + Theme.space-base * 2);
                background: Theme.bg-base;
                border-width: 1px;
                border-color: Theme.border-subtle;

                history-readonly-body := VerticalLayout {
                    x: Theme.space-screen;
                    y: Theme.space-base;
                    width: parent.width - Theme.space-screen * 2;
                    spacing: Theme.space-tight;

                    history-readonly-label := Text {
                        text: "This retained session is read-only. Return to Local CLI to compose, attach, retry or edit.";
                        wrap: word-wrap;
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: text;
                        accessible-label: self.text;
                    }

                    // History can be selected while a live response is active.
                    // Keep cancellation immediately operable without requiring
                    // the operator to navigate back to the live transcript.
                    if root.send-in-flight: HorizontalLayout {
                        alignment: center;

                        NeothButton {
                            label: "Stop";
                            danger: true;
                            width: 120px;
                            height: 44px;
                            clicked => { root.stop-stream-clicked(); }
                        }
                    }
                }
            }
        }
    }

    // ── Delete-message confirm gate (SAFE-GAPS HIGH) ──────────────────
    // Mounted last so it scrims the whole chat surface.
    if root.delete-confirm-idx >= 0: ConfirmDialog {
        width: 100%; height: 100%;
        title: "Delete message?";
        body: "Removes it from this session's transcript view. This cannot be undone.";
        confirm-label: "Delete";
        danger: true;
        confirmed => {
            root.message-delete(root.delete-confirm-idx);
            root.delete-confirm-idx = -1;
        }
        cancelled => { root.delete-confirm-idx = -1; }
    }
}
