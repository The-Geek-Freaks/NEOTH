    callback channels-refresh-clicked;
    callback channel-test(string);
    callback channel-remove(string);
    /// GAP-19 — add a new channel credential from the GUI.
    /// Args: (channel_type, f1, f2, f3, f4) — field mapping per channel type.
    callback channel-add(string, string, string, string, string, string, string, bool);
    callback memory-forget-preview(string);
    callback memory-forget-confirm(string);
