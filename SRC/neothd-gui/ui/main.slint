    }

        // Wizard footer — the app-shell uses its own StatusFooter, so this only
        // shows for the first-run wizard steps (avoids a double footer).
        if (root.step != WizardStep.chat && root.step != WizardStep.settings): FooterBar {
            // GUI-overhaul: the footer is the single status surface for EVERY
            // screen. status-line (set by Settings actions — skill/plugin/autonomy
            // toggles, channel tests, hemisphere rebinds, memory ops) takes
            // priority so the operator gets visible confirmation there too — it
            // was previously only rendered on the wizard's Done step, so Settings
            // actions silently gave no feedback. Falls back to the hardware probe.
            status: root.status-line != ""
                ? root.status-line
                : (root.hardware-summary != ""
                    ? root.hardware-summary
                    : "NEOTH — Your buddy. Your life.");
        }
    }

    // ── Docked Buddy overlay — floats bottom-right above all screens ───
    // Declared last so it sits on top; positioned with explicit x/y.
    if root.buddy-visible: BuddyDock {
        mood: root.buddy-mood;
        caption: root.buddy-caption;
        orb-size: 88px;
        x: root.width - self.width - 24px;
        y: root.height - self.height - 24px;
        clicked => { root.buddy-clicked(); }
    }

    // ── Wave-1 toast overlay ───────────────────────────────────────────
    // Top-right of the content area (right of sidebar), 78px from top,
    // z-above the shell layout (declared after Buddy) but below the tour.
    // Only visible in the shell steps; pointer-events are transparent in
    // the gap between cards (ToastStack background is transparent).
    // Design report: z-index 70, 290px wide, 78px top offset.
    if (root.step == WizardStep.chat || root.step == WizardStep.settings)
            && root.toasts.length > 0: ToastStack {
        toasts: root.toasts;
        x: root.width - self.width - 12px;
        y: 78px;
        // height is driven by content; no explicit height needed.
    }

    // ── GOLD-ADAPT-OH-12 — first-run guided tour ───────────────────────
    // Declared after the Buddy so it covers everything. A scrim + one
    // walkthrough card per step; no per-element spotlight (Slint has no
    // mask primitive — the card TEXT names each surface instead, honest).
    if root.tour-active && root.step == WizardStep.chat: Rectangle {
        background: Theme.scrim;
        // Swallow clicks so the surfaces below stay untouched mid-tour.
        TouchArea { }
        tour-card := Rectangle {
            width: min(520px, root.width - 48px);
            height: card-body.preferred-height + 48px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.surface-2;
            border-radius: Theme.radius-xl;
            border-width: 1px;
            border-color: Theme.border-accent;
            card-body := VerticalLayout {
                x: 24px; y: 24px;
                width: parent.width - 48px;
                spacing: Theme.space-base;
                Text {
                    text: "TOUR " + (root.tour-step + 1) + " / 5";
                    font-family: Theme.font-mono;
                    font-size: Theme.font-size-2xs;
                    letter-spacing: Theme.letter-spacing-wide;
                    color: Theme.accent;
                }
                Text {
                    text: root.tour-step == 0
                        ? "The rail (left) — Chat, Memory, Channels, Loops and more. The COMPLEXITY switch at the bottom (MIN/STD/FULL) decides how much of it you see."
                        : root.tour-step == 1
                        ? "Chat — your primary surface. Enter sends, Shift+Enter breaks lines, ArrowUp recalls your last message, 📎 attaches files to a turn."
                        : root.tour-step == 2
                        ? "The Buddy (bottom-right orb) — it mirrors what NEOTH is doing right now: thinking, streaming, celebrating, erroring."
                        : root.tour-step == 3
                        ? "The footer — live daemon LED, your hardware line, WAL + local dots, and a status ticker. Machine truth, always visible."
                        : "Settings ⚙ — every slash command has a panel twin: skills index, presets, autonomy, private mesh, the coding kanban.";
                    font-family: Theme.font-sans;
                    font-size: Theme.font-size-base;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: space-between;
                    NeothButton {
                        label: "Skip tour";
                        primary: false;
                        size: "sm";
                        clicked => { root.tour-dismissed(); }
                    }
                    NeothButton {
                        label: root.tour-step >= 4 ? "Finish" : "Next →";
                        size: "sm";
                        clicked => {
                            if (root.tour-step >= 4) {
                                root.tour-dismissed();
                            } else {
                                root.tour-step += 1;
                            }
                        }
                    }
                }
            }
        }
    }
}
