            kanban-task-assign(id, hemi) => { root.kanban-task-assign(id, hemi); }
            kanban-task-finish(id) => { root.kanban-task-finish(id); }
            // G-12 fix: provider change in Settings → Config flows
            // up to MainWindow where Rust persists it.
            provider-changed(name) => {
                root.provider-choice = name;
                root.provider-changed(name);
            }
            // Bite #5: cluster auto-discovery state. Read flows
            // root → SettingsView via two-way bind (`<=>` lets the
            // checkbox toggle propagate back into root so callbacks
            // see the latest value); the changed-callback bubbles
            // up to MainWindow where Rust mutates freedom.yaml.
            cluster-mdns-enabled <=> root.cluster-mdns-enabled;
            cluster-listen-port: root.cluster-listen-port;
            cluster-trusted-ssids-summary: root.cluster-trusted-ssids-summary;
            cluster-mdns-enabled-changed(enabled) => {
