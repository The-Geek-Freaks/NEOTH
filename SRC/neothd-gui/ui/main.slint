    property <string> shell-title:
        root.nav-active == "chat"        ? "Chat"
        : root.nav-active == "overview"    ? "Mission Control"
        : root.nav-active == "memory"      ? "Memory"
        : root.nav-active == "hemispheres" ? "Hemispheres"
        : root.nav-active == "channels"    ? "Channels"
        : root.nav-active == "coding"      ? "Coding"
        : root.nav-active == "agents"      ? "Agents"
        : root.nav-active == "automation"  ? "Automation"
        : root.nav-active == "privacy"     ? "Privacy"
        : root.nav-active == "plugins"     ? "Plugins"
        : root.nav-active == "cluster"     ? "Private Mesh"
        : root.nav-active == "resources"   ? "Resources"
        : root.nav-active == "doctor"      ? "Doctor"
        : root.nav-active == "loops"       ? "Loops"
        : root.nav-active == "n8n"         ? "Automation Bridge"
        : root.nav-active == "babel"       ? "Babel Observer"
        : root.nav-active == "calendar"    ? "Calendar"
        : root.nav-active == "evolve"      ? "Self-Improvement"
        : root.nav-active == "selfdev"     ? "Proposal Review"
        : root.nav-active == "obsidian"    ? "Obsidian Vault"
        : root.nav-active == "dreaming"    ? "Dreaming - Memory & Self-Awareness"
        : root.nav-active == "wiki"        ? "Capability Map"
        : root.nav-active == "buddyconfig" ? "Buddy Configuration"
        : root.nav-active == "companion"   ? "Companion - Smartphone Pairing"
        : root.nav-active == "mesh"        ? "Mesh & Cluster"
        : "Config";

    /// QM-8 Phase 2.5 — operator clicked "Apply Active" on the
    /// preset tile. Rust shells `neothd preset apply <active>`
    /// + refreshes the summary. The string carries the operator
    /// hint string for logging — the active preset is resolved
    /// Rust-side from a fresh `neoth preset list` probe.
    callback preset-apply-clicked();
    /// SPEC-05 — operator clicked a preset row in the selector. Rust shells
    /// `neoth preset activate <name>` (sets the active marker) + refreshes the
    /// list. `apply-active` then merges the active preset into freedom.yaml.
    callback preset-activate-clicked(string);
    // ZF-01 — per-row Apply on a built-in/operator preset (dry-run first).
    callback preset-apply-named-clicked(string);
    // ZF-01 — Delete on an operator preset row.
    callback preset-delete-clicked(string);
    // ZF-01 — consent modal state, populated by Rust from `preset apply
    // --dry-run`; confirmed/cancelled route back to Rust.
    in-out property <string> consent-preset-name: "";
    in-out property <string> consent-warn-text: "";
    in-out property <bool> consent-needs-fullauto: false;
    in-out property <int> consent-fields-count: 0;
    in-out property <bool> consent-visible: false;
    callback preset-consent-confirmed();
    callback preset-consent-cancelled();
    // SPEC-05 step5c: operator picked a behavioural profile — Rust runs
    // `neoth profile preset apply <name>` + refreshes the list.
    callback profile-preset-apply-clicked(string);

    // ── Chat surface state (Pick #33) ─────────────────────────────────
    /// Scrollback feed. Rust pushes ChatMessage rows as the daemon
    /// emits PROVIDER_RESPONSE / CHANNEL_INGRESS frames. The
    /// streaming-bubble pattern flips `streaming: true` on the
    /// last entry while chunks arrive, then `false` when the
    /// completion settles.
    in property <[ChatMessage]> chat-messages: [];
    in-out property <string> chat-composer-draft: "";
    in property <bool> chat-send-enabled: true;
    /// GOLD-ADAPT-GUI-07 — a reply subprocess is streaming; the Send
    /// button spins and re-sends are blocked until it settles.
    in property <bool> chat-send-in-flight: false;
    /// GOLD-ADAPT-ODY-01 — recent sessions for the chat sidebar.
    in property <[SessionRow]> chat-session-history: [];
    in property <string> chat-active-session-id: "";
    callback chat-session-selected(string);
    /// GOLD-ADAPT-ODY-04 — stall watchdog banner state + actions.
    in property <bool> chat-stall-active: false;
    callback chat-stall-continue();
    callback chat-stall-stop();
    /// GOLD-ADAPT-ODY-03 — pending attachments (names for the strip;
    /// the paths live Rust-side).
    in property <[string]> chat-pending-attachments: [];
    /// ODY-12/14 — deep-link chips for the last completed reply.
    in property <[LinkChip]> chat-link-chips: [];
    /// ODY-12/14 — chip click: (kind, id) → Rust routes nav/entity focus.
    callback chat-link-chip-clicked(string, string);
    // Wave-2 — activity sidecar state. Rust pushes rows; toggle flips open.
    in-out property <bool> activity-open: false;
    in property <[ActivityRow]> activity-rows: [];
    callback activity-toggle();
    callback chat-attach-clicked();
    callback chat-remove-attachment(int);
    /// Channel labels for the chat sidebar. CLI is always first
    /// + always available; the rest reflect the operator's
    /// configured channels from freedom.yaml.
    in property <[string]> chat-channels: ["CLI", "Telegram", "WhatsApp"];
    in-out property <int> chat-active-channel: 0;
    in property <[int]> chat-unread-counts: [0, 0, 0];
    /// Rust sets this from the composer-draft via a text-edited
    /// callback (Slint can't run `starts-with` in expressions). When
    /// `true` the chat view renders the slash-discovery hint.
    in property <bool> chat-slash-active: false;
    // ODY-11 — current density (0=compact 1=normal 2=spacious). Rust sets at
    // startup from ~/.neoth/.gui-density; on_density_changed handler persists +
    // updates Theme.density-mode so the chat surface reflws in real time.
    in-out property <int> chat-density-mode: 1;
    /// Operator picked a density level in Settings → Chat. Rust persists the
    /// choice to ~/.neoth/.gui-density + calls Theme.set_density_mode(val).
    callback density-changed(int);

    /// Operator typed + sent a message. Rust dispatches through
    /// `cli::chat::run_chat_with`.
    callback chat-send-clicked(string);
    /// Operator pressed ArrowUp with an empty composer — Rust writes the
    /// last operator body back into `chat-composer-draft`.
    callback chat-composer-recall-requested();
    /// Operator switched channels in the sidebar.
    callback chat-channel-switched(int);

    // ── Chat-surface consent strip ────────────────────────────────────
    /// Current operating-mode string for the consent strip pill.
    /// Rust sets from `neoth autonomy show --output json` .mode field.
    in property <string> chat-consent-mode: "gated";
    /// Per-provider consent grants for the consent strip popover.
    /// Rust sets from `neoth consent list --output json`.
    in property <[ConsentGrant]> chat-consent-grants: [];
    /// Operator switched mode from the chat strip: "gated" | "full".
    callback chat-consent-set-mode(string);
    /// Operator revoked a provider from the chat strip.
    callback chat-consent-revoke(string);
    /// Chat strip requests a consent data refresh.
    callback chat-consent-refresh();

    // ── Code Sessions tab state (Pick #8 step 2) ────────────────────
    // Rust populates these from `neothd kanban list/show --output json`
