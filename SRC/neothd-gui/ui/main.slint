    callback skill-install();
    callback skill-uninstall(string);
    callback skill-create(string, string, string, string);
    callback plugin-toggle(string, bool);
    callback plugin-install();
    callback plugin-remove(string);
    // DES-12 — plugin WAL-feed detail pane.
    in-out property <string> plugin-detail-id: "";
    in property <string> plugin-detail-title: "";
    in property <[PluginEventRow]> plugin-detail-events: [];
    callback plugin-detail-clicked(string);
    callback plugin-detail-close();
    callback autonomy-set(string);
    /// Step 5 (2026-05-20): operator clicked a task card.
    callback kanban-task-selected(string);
    /// Step 6 (2026-05-20): operator clicked an action button in the
    /// detail pane.
    callback kanban-task-move(string, string);
    callback kanban-task-promote(string);
    callback kanban-task-comment(string, string);
    callback kanban-task-assign(string, string);
    callback kanban-task-finish(string);

    // True when the currently-picked provider needs an API key. Mirrors
    // the require_provider_key() logic in `providers/mod.rs`: claude_cli
    // uses OAuth, local_qwen is local, everything else is REST + bearer.
    out property <bool> provider-needs-key:
        root.provider-choice != "claude_cli"
            && root.provider-choice != "local_qwen"
            && root.provider-choice != "local_ouro";

    // Skip the keys step entirely when no secrets are needed — saves the
    // operator an empty screen when they've picked claude_cli + CLI-only.
    out property <bool> need-keys-step:
        root.provider-needs-key || root.enable-telegram;

    // ── Three-stripe layout (Pick #28 12/10 polish) ──────────────────
    // Top: persistent ProgressIndicator (brand bar + step counter + progress fill).
    // Middle: per-screen content area inside a Card surface so every screen
    //   looks coherent. Content scrolls if it overflows.
    // Bottom: thin FooterBar with the operator-readable status string
    //   (hardware summary on welcome, daemon version elsewhere).
    VerticalLayout {
        if root.show-progress: ProgressIndicator {
            current-step: root.current-step;
            total-steps: root.total-steps;
            step-label: root.step-label;
        }

    VerticalBox {
        padding: Theme.space-screen;
        spacing: Theme.space-loose;

        // ── Mode selection ─────────────────────────────────────────────
        // Operator's first decision — GUI flow or CLI flow. Two big
        // SVG-glyph cards side by side. GUI marked "recommended" for
        // noobs; CLI surface available without leaving the keyboard.
        //
        // Reviewer-3 P2 (2026-05-20): keyboard-first navigation. The
        // FocusScope catches G/C/Enter so pro operators never touch
        // the mouse. Microcopy below the cards exposes the shortcuts.
        if root.step == WizardStep.mode-selection: FocusScope {
            key-pressed(e) => {
                if (root.mode-choice-busy) { return accept; }
                if (e.text == "g" || e.text == "G") {
                    root.mode-gui-chosen = true;
                    root.mode-cli-chosen = false;
                    return accept;
                }
                if (e.text == "c" || e.text == "C") {
                    root.mode-cli-chosen = true;
                    root.mode-gui-chosen = false;
                    return accept;
                }
                if (e.text == "\n") {
                    if (root.mode-cli-chosen) {
                        root.mode-choice-busy = true;
                        root.cli-mode-chosen();
                    } else if (root.mode-gui-chosen) {
                        root.mode-choice-busy = true;
                        root.gui-mode-chosen();
                    }
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
            spacing: Theme.space-screen;
            alignment: center;
            VerticalLayout {
                spacing: Theme.space-tight;
                Text {
                    text: "NEOTH";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-h1 * 1.6;
                    font-weight: Theme.weight-ultralight;
                    letter-spacing: Theme.letter-spacing-hero;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Choose how you want to set up.";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-body;
                    font-weight: Theme.weight-light;
                    letter-spacing: Theme.letter-spacing-tight;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: Theme.space-loose;
                alignment: center;
                gui-mode-card := ModeCard {
                    title: "Graphical setup";
                    subtitle: "Click through eight short screens. Recommended if you're new.";
                    recommended: true;
                    selected: root.mode-gui-chosen;
                    enabled: !root.mode-choice-busy;
                    glyph: @image-url("assets/glyph_gui.svg");
                    clicked => {
                        if (!root.mode-choice-busy) {
                            root.mode-gui-chosen = true;
                            root.mode-cli-chosen = false;
                        }
                    }
                }
                cli-mode-card := ModeCard {
                    title: "Command-line setup";
                    subtitle: "Drop to a terminal. Runs `neoth init --cli`. Claude CLI session management is handled automatically; on Linux/macOS tmux is used when available.";
                    recommended: false;
                    selected: root.mode-cli-chosen;
                    enabled: !root.mode-choice-busy;
                    glyph: @image-url("assets/glyph_cli.svg");
                    clicked => {
                        if (!root.mode-choice-busy) {
                            root.mode-cli-chosen = true;
                            root.mode-gui-chosen = false;
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                NeothButton {
                    label: "Continue →";
                    enabled: (root.mode-gui-chosen || root.mode-cli-chosen) && !root.mode-choice-busy;
                    clicked => {
                        root.mode-choice-busy = true;
                        if (root.mode-cli-chosen) {
                            root.cli-mode-chosen();
                        } else {
                            root.gui-mode-chosen();
                        }
                    }
                }
            }

            // Reviewer-3 P2 keyboard-shortcut microcopy (2026-05-20)
            Text {
                text: "Shortcuts: G — graphical · C — command-line · Enter — continue";
                font-family: Theme.font-display;
                font-size: Theme.font-size-caption;
                color: Theme.text-dim;
                horizontal-alignment: center;
            }
            }
        }

        // ── Welcome ────────────────────────────────────────────────────
        if root.step == WizardStep.welcome: SovereignFade { VerticalBox {
            spacing: Theme.space-loose;
            // Hero block — NEOTH logo at full hero scale, tagline below.
            // Only screen where the logo runs at hero size; every other
            // screen uses the small brand bar in the ProgressIndicator.
            VerticalLayout {
                spacing: Theme.space-tight;
                Text {
                    text: "NEOTH";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-h1 * 1.6;
                    font-weight: Theme.weight-ultralight;
                    letter-spacing: Theme.letter-spacing-hero;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Your buddy. Your life.";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-body;
                    font-weight: Theme.weight-light;
                    letter-spacing: Theme.letter-spacing-extra-wide;
                    color: Theme.accent-green;
                    horizontal-alignment: center;
                }
                Text {
                    text: "First-launch setup — eight steps, about three minutes.";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-body;
                    font-weight: Theme.weight-regular;
                    letter-spacing: Theme.letter-spacing-body;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            // Hardware probe card — Noble-Curve 16px radius, monospace
            // body so detected hardware lines up visually.
            Card {
                preferred-height: 180px;
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Detected hardware";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    Text {
                        text: root.hardware-summary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
            // QM-9 Phase 3 — usage rollup tile. Mirrors the hardware
            // card layout so the visual rhythm carries from
            // "what hardware do you have" → "what did you spend".
            // Populated by the probe_usage_via_subprocess worker
            // thread on window-create + every USAGE_REFRESH_INTERVAL.
            Card {
                preferred-height: 100px;
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Last 24h usage";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    Text {
                        text: root.usage-summary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
            // GOLD-WIRE-10b — live token-budget meter tile. Mirrors the
            // usage tile; shows the daemon's running token totals as they
            // are persisted to ~/.neoth/meter.json.
            Card {
                preferred-height: 100px;
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Live token budget";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    Text {
                        text: root.budget-summary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
            // GOLD-ADAPT-OH-01 — migration-first onboarding, GUI mirror
            // of the CLI step-0 branch. Shown only when `neoth-migrate
            // detect` found complete prior-AI homes; informational —
            // the import itself runs in a terminal (consent-gated CLI).
            if root.migrate-summary != "": Card {
                min-height: 110px;
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Prior AI detected — migration available";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    Text {
                        text: root.migrate-summary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Terminal: neoth-migrate detect --output manifest.yaml → review → neoth-migrate dry-run --manifest manifest.yaml → neoth-migrate apply --manifest manifest.yaml --confirm";
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
            // QM-8 Phase 2 + 2.5 — saved preset bundle tile.
            // Operator-visible list of named preset bundles + the
            // active one. The Apply button shells `neothd preset
            // apply <active>` so operators flip the active bundle
            // into freedom.yaml in one click.
            Card {
                min-height: 130px;
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Saved presets";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    // SPEC-05 — click-to-activate selector. Each row activates
                    // that preset (sets the active marker); "Apply active" then
                    // merges the active one into freedom.yaml.
                    if root.preset-list.length == 0: Text {
                        text: root.preset-summary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    for p in root.preset-list: ta := TouchArea {
                        height: 22px;
                        clicked => { root.preset-activate-clicked(p.name); }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: p.active ? "●" : "○";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: p.active ? Theme.accent-green : Theme.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: p.name;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: ta.has-hover ? Theme.accent-teal : Theme.text-primary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        NeothButton {
                            label: "Apply active";
                            primary: false;
                            clicked => { root.preset-apply-clicked(); }
                        }
                    }
                }
            }
            // SPEC-05 step5c — behavioural-profile selector: how NEOTH talks to
            // you (casual / formal / deep-dive / tutor / opsec). Click to apply.
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "RESPONSE STYLE";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    if root.profile-preset-list.length == 0: Text {
                        text: "(start the daemon to choose a response style)";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    for p in root.profile-preset-list: ta2 := TouchArea {
                        height: 38px;
                        clicked => { root.profile-preset-apply-clicked(p.name); }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: p.active ? "●" : "○";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: p.active ? Theme.accent-green : Theme.text-muted;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: p.name + (p.recommended ? "  (recommended)" : "");
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-caption;
                                    color: ta2.has-hover ? Theme.accent-teal : Theme.text-primary;
                                }
                                Text {
                                    text: p.description;
                                    font-family: Theme.font-display;
                                    font-size: Theme.font-size-caption;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
            // G-11 fix: every wizard step from License onward has a
            // Back-button; Welcome was the only exception. Operator
            // who landed here from Mode Selection had no way back.
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Mode";
                    primary: false;
                    clicked => { root.step = WizardStep.mode-selection; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.license; }
                }
            }
        } }  // close Welcome VerticalBox + SovereignFade

        // ── License ────────────────────────────────────────────────────
        // G-2 fix: real plain-language summary instead of a single
        // throw-away sentence + dead air. Three bullets cover the
        // MIT/Apache-2.0 promise, the no-warranty disclaimer, and the
        // operator's freedom to use/modify/share. "View licenses →"
        // opens both canonical licence texts in the repository.
        if root.step == WizardStep.license: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "License";
                subtitle: "NEOTH is yours to use, modify, and share — under the MIT or Apache 2.0 license, your choice. Tick the box below to confirm you understand the basics.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;

                    Text {
                        text: "✓  Free to use — commercial or personal, no fee, no telemetry.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "✓  Free to modify — fork it, patch it, build on it. Keep the copyright notice.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "✓  Free to share — redistribute under the same license.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "⚠  No warranty — NEOTH is provided as-is. You run it at your own risk.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: Theme.space-base;
                        alignment: start;
                        NeothButton {
                            label: "View licenses →";
                            primary: false;
                            clicked => { root.open-license-url(); }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-subtle;
                    }

                    CheckBox {
                        text: "I have read the points above and accept the licence terms.";
                        checked <=> root.license-accepted;
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.welcome; }
                }
                NeothButton {
                    label: "Continue →";
                    enabled: root.license-accepted;
                    clicked => { root.step = WizardStep.identity; }
                }
            }
        }

        // ── Identity ───────────────────────────────────────────────────
        if root.step == WizardStep.identity: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Identity";
                subtitle: "Pick a short handle NEOTH uses to address you. Lowercase letters, digits, and dashes only — three to thirty-two characters. This name shows up in chat logs and on archived sessions.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Operator id";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    // G-1 fix: placeholder must look obviously instructional
                    // so a noob does not mistake it for a pre-filled value.
                    // "your-handle" reads as a hint; a real name reads as data.
                    // G-15 + Reviewer-3 P1-B (2026-05-20): Enter advances
                    // only on valid identity. Edited callback round-trips
                    // to Rust for regex validation (Slint has no regex).
                    LineEdit {
                        placeholder-text: "your-handle";
                        text <=> root.operator-id;
                        edited(t) => { root.operator-id-edited(t); }
                        accepted(t) => {
                            if (root.operator-id-valid) { root.step = WizardStep.project-context; }
                        }
                    }
                    if !root.operator-id-valid && root.operator-id == "": Text {
                        text: "Required — pick a short name like 'sam' or 'jamie'.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.accent-pink;
                    }
                    if !root.operator-id-valid && root.operator-id != "": Text {
                        text: "Use 3 to 32 characters: lowercase a-z, digits, dashes.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.accent-pink;
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.license; }
                }
                NeothButton {
                    label: "Continue →";
                    enabled: root.operator-id-valid;
                    clicked => { root.step = WizardStep.preset-picker; }
                }
            }
        }

        // ── Preset Picker (ZF-05) ───────────────────────────────────────
        // Operator chooses a built-in preset (express path → Done) or
        // "custom" (walks every detail screen). Non-custom preset writes
        // wizard-preset-choice and jumps straight to done; custom sets
        // wizard-preset-choice = "custom" and continues to project-context.
        if root.step == WizardStep.preset-picker: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Choose a preset";
                subtitle: "Built-in presets apply your autonomy, provider, and channel settings in one click — fine-tune everything later in Settings. Choose Custom to walk each screen now.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;

                    // ── full-auto ─────────────────────────────────────
                    TouchArea {
                        height: 60px;
                        clicked => {
                            root.wizard-preset-choice = "full-auto";
                            root.step = WizardStep.done;
                        }
                        Rectangle {
                            background: root.wizard-preset-choice == "full-auto" ? Theme.green-tint : transparent;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: Theme.space-base;
                                spacing: Theme.space-base;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "full-auto";
                                        font-family: Theme.font-display;
                                        font-size: Theme.font-size-body;
                                        font-weight: Theme.weight-medium;
                                        color: Theme.accent-green;
                                    }
                                    Text {
                                        text: "Full autonomous — acts on its own, asks rarely. For solo power-users.";
                                        font-family: Theme.font-display;
                                        font-size: Theme.font-size-caption;
                                        color: Theme.text-muted;
                                    }
                                }
                            }
                        }
                    }

                    // ── balanced ──────────────────────────────────────
                    TouchArea {
                        height: 60px;
                        clicked => {
                            root.wizard-preset-choice = "balanced";
                            root.step = WizardStep.done;
                        }
                        Rectangle {
                            background: root.wizard-preset-choice == "balanced" ? Theme.green-tint : transparent;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: Theme.space-base;
                                spacing: Theme.space-base;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "balanced";
                                        font-family: Theme.font-display;
                                        font-size: Theme.font-size-body;
                                        font-weight: Theme.weight-medium;
                                        color: Theme.accent-green;
                                    }
                                    Text {
                                        text: "Balanced — confirms before writes outside ~/.neoth. Default for most.";
                                        font-family: Theme.font-display;
                                        font-size: Theme.font-size-caption;
                                        color: Theme.text-muted;
                                    }
                                }
                            }
                        }
                    }

                    // ── essentials ────────────────────────────────────
                    TouchArea {
                        height: 60px;
                        clicked => {
                            root.wizard-preset-choice = "essentials";
                            root.step = WizardStep.done;
                        }
                        Rectangle {
                            background: root.wizard-preset-choice == "essentials" ? Theme.green-tint : transparent;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: Theme.space-base;
                                spacing: Theme.space-base;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "essentials";
                                        font-family: Theme.font-display;
                                        font-size: Theme.font-size-body;
                                        font-weight: Theme.weight-medium;
                                        color: Theme.accent-green;
                                    }
                                    Text {
                                        text: "Essentials — minimal feature set, no cloud channels, local-first.";
                                        font-family: Theme.font-display;
                                        font-size: Theme.font-size-caption;
                                        color: Theme.text-muted;
                                    }
                                }
                            }
                        }
                    }

                    // ── local-sovereign ───────────────────────────────
                    TouchArea {
                        height: 60px;
                        clicked => {
                            root.wizard-preset-choice = "local-sovereign";
                            root.step = WizardStep.done;
                        }
                        Rectangle {
                            background: root.wizard-preset-choice == "local-sovereign" ? Theme.green-tint : transparent;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: Theme.space-base;
                                spacing: Theme.space-base;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "local-sovereign";
                                        font-family: Theme.font-display;
                                        font-size: Theme.font-size-body;
                                        font-weight: Theme.weight-medium;
                                        color: Theme.accent-green;
                                    }
                                    Text {
                                        text: "Local-sovereign — air-gapped, Ollama-only, no outbound traffic.";
                                        font-family: Theme.font-display;
                                        font-size: Theme.font-size-caption;
                                        color: Theme.text-muted;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // ── custom ────────────────────────────────────────
                    TouchArea {
                        height: 60px;
                        clicked => {
                            root.wizard-preset-choice = "custom";
                            root.step = WizardStep.project-context;
                        }
                        Rectangle {
                            background: root.wizard-preset-choice == "custom" ? Theme.green-tint : transparent;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding: Theme.space-base;
                                spacing: Theme.space-base;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "custom";
                                        font-family: Theme.font-display;
                                        font-size: Theme.font-size-body;
                                        font-weight: Theme.weight-medium;
                                        color: Theme.text-primary;
                                    }
                                    Text {
                                        text: "Walk every setup screen and pick each option yourself.";
                                        font-family: Theme.font-display;
                                        font-size: Theme.font-size-caption;
                                        color: Theme.text-muted;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.identity; }
                }
            }
        }

        // ── Project context (GOLD-ADAPT-AOS-03) ────────────────────────
        // Three optional questions (agent-os plan-product): what you're
        // building, the domain, the stack. Skippable — NEOTH works fine
        // without; answers seed the sidebar card + future repo-context.
        if root.step == WizardStep.project-context: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Project context";
                subtitle: "Optional — three quick questions so NEOTH knows what world you work in. Skip freely; you can set this later in Settings.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    NeothLineEdit {
                        text <=> root.project-building;
                        placeholder-text: "What are you building? — e.g. \"a self-hosted AI companion\"";
                    }
                    NeothLineEdit {
                        text <=> root.project-domain;
                        placeholder-text: "Domain — e.g. \"security research\", \"e-commerce\", \"music\"";
                    }
                    NeothLineEdit {
                        text <=> root.project-stack;
                        placeholder-text: "Stack — e.g. \"Rust + Slint\", \"TypeScript/React\", \"none\"";
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.preset-picker; }
                }
                HorizontalLayout {
                    spacing: Theme.space-base;
                    NeothButton {
                        label: "Skip";
                        primary: false;
                        clicked => { root.step = WizardStep.provider; }
                    }
                    NeothButton {
                        label: "Continue →";
                        clicked => {
                            root.project-context-set(root.project-building, root.project-domain, root.project-stack);
                            root.step = WizardStep.provider;
                        }
                    }
                }
            }
        }

        // ── Provider ───────────────────────────────────────────────────
        if root.step == WizardStep.provider: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Provider";
                subtitle: "Which LLM runs NEOTH's chat. Local Qwen runs offline on your hardware (~3 GB cached). Cloud providers need a key on the next-but-one screen.";
            }
            // List MUST stay in sync with `cli::init::ProviderKind` so a
            // GUI-written `freedom.yaml` always loads cleanly in the
            // daemon. `anthropic_api` was removed because the daemon
            // enum has no matching variant — operators who want
            // Anthropic-direct use `claude_cli` (OAuth) or
            // `openai_compat` against the Anthropic-compatible endpoint.
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Backend";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    // G-3 fix: NeothComboBox replaces std-widgets'
                    // light-mode ComboBox. Maps current-index back to
                    // the bare provider token expected by freedom.yaml.
                    NeothComboBox {
                        model: [
                            "claude_cli",
                            "openai_api",
                            "openai_compat",
                            "gemini_api",
                            "local_qwen",
                            "local_ouro",
                            "hermes",
                            "openclaw",
                        ];
                        current-index: 0;
                        selected(i) => {
                            if (i == 0) { root.provider-choice = "claude_cli"; }
                            if (i == 1) { root.provider-choice = "openai_api"; }
                            if (i == 2) { root.provider-choice = "openai_compat"; }
                            if (i == 3) { root.provider-choice = "gemini_api"; }
                            if (i == 4) { root.provider-choice = "local_qwen"; }
                            if (i == 5) { root.provider-choice = "local_ouro"; }
                            if (i == 6) { root.provider-choice = "hermes"; }
                            if (i == 7) { root.provider-choice = "openclaw"; }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.project-context; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.autonomy; }
                }
            }
        }

        // ── Autonomy ───────────────────────────────────────────────────
        // G-7 fix: replace the lonely "Picked: X" Card with an inline
        // explanatory block. G-20 fix: subtitle uses plain language
        // instead of dev jargon.
        if root.step == WizardStep.autonomy: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Autonomy";
                subtitle: "Choose how independently NEOTH acts. 'Strict' asks before every change. 'Full' trusts your policy file and never interrupts. You can change this any time from Settings → Privacy.";
            }
            // G-3 fix: NeothComboBox replaces std-widgets ComboBox.
            // The verbose labels carry a one-line description so the
            // operator picks with context. selected() maps back to the
            // bare token freedom.yaml::autonomy expects.
            // GR-12 H-2 fix: bind current-index to autonomy-choice so
            // wizard re-entry (M-1 reload from existing freedom.yaml)
            // shows the correct level visually. Pre-fix the ComboBox
            // displayed index=1 ("standard") regardless of the actual
            // stored autonomy, while the YAML write path stayed correct
            // — display lied to the operator about the active level.
            NeothComboBox {
                model: [
                    "strict — confirm every write, no shell exec",
                    "standard — writes inside ~/.neoth allowed, every exec confirms",
                    "elevated — writes anywhere, exec inside ~/.neoth allowed",
                    "full — trust policy.yaml; nothing prompts",
                    "custom — defer to per-action rules in policy.yaml",
                ];
                current-index:
                    root.autonomy-choice == "strict"   ? 0 :
                    root.autonomy-choice == "standard" ? 1 :
                    root.autonomy-choice == "elevated" ? 2 :
                    root.autonomy-choice == "full"     ? 3 :
                    root.autonomy-choice == "custom"   ? 4 :
                    1;
                selected(i) => {
                    if (i == 0) { root.autonomy-choice = "strict"; }
                    if (i == 1) { root.autonomy-choice = "standard"; }
                    if (i == 2) { root.autonomy-choice = "elevated"; }
                    if (i == 3) { root.autonomy-choice = "full"; }
                    if (i == 4) { root.autonomy-choice = "custom"; }
                }
            }
            // Inline summary — no more empty Card. Reads as a single
            // narrative line ("Picked X — Y") rather than a chrome box.
            HorizontalLayout {
                spacing: Theme.space-tight;
                alignment: start;
                Text {
                    text: "Picked:";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-caption;
                    font-weight: Theme.weight-medium;
                    letter-spacing: Theme.letter-spacing-tight;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }
                Text {
                    text: root.autonomy-choice;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-size-body;
                    color: Theme.accent-green;
                    vertical-alignment: center;
                }
                Text {
                    text:
                        root.autonomy-choice == "strict"   ? " — every write asks first; shell commands always confirm." :
                        root.autonomy-choice == "standard" ? " — writes to ~/.neoth allowed; every shell command asks." :
                        root.autonomy-choice == "elevated" ? " — writes anywhere; shell inside ~/.neoth allowed." :
                        root.autonomy-choice == "full"     ? " — trusts your policy.yaml completely; never interrupts." :
                                                              " — defers to per-action rules in policy.yaml.";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-caption;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.provider; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.channels; }
                }
            }
        }

        // ── Channels ───────────────────────────────────────────────────
        // G-4 fix: surface every channel in the shipping matrix, group
        // by status, and replace developer jargon ("adapter scaffold")
        // with operator-friendly status notes ("Operational — v0.3+",
        // "Coming next", "Research phase"). Only Telegram is tickable
        // in the wizard for v0.1 — the others land via Settings →
        // Channels once their credential flow is complete. The
        // disabled rows still show so the operator understands the
        // full roadmap.
        if root.step == WizardStep.channels: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Channels";
                subtitle: "Where NEOTH listens and replies. CLI is always on. Tick Telegram now to set it up immediately — the rest you can connect any time from Settings → Channels.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;

                    // ── Always on ────────────────────────────────────
                    Text {
                        text: "ALWAYS ON";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-bold;
                        letter-spacing: Theme.letter-spacing-wide;
                        color: Theme.text-dim;
                    }
                    CheckBox {
                        text: "CLI — neoth chat / neoth serve REPL";
                        checked: true;
                        enabled: false;
                    }

                    // ── Ready to enable now ──────────────────────────
                    Text {
                        text: "READY NOW";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-bold;
                        letter-spacing: Theme.letter-spacing-wide;
                        color: Theme.accent-green;
                    }
                    CheckBox {
                        text: "Telegram bot — long-poll, no public HTTPS needed";
                        checked <=> root.enable-telegram;
                    }

                    // Reviewer-3 P1-B disclosure (2026-05-20): the 8
                    // disabled rows below DEFAULT hidden so DAUs see
                    // a 2-row screen instead of "list of grey graves".
                    // Pro operators click once to expand the roadmap.
                    NeothButton {
                        label: root.show-future-channels
                            ? "Hide future channels ▴"
                            : "Show future channels ▾";
                        primary: false;
                        clicked => {
                            root.show-future-channels = !root.show-future-channels;
                        }
                    }

                    if root.show-future-channels: VerticalLayout {
                        spacing: Theme.space-base;

                        // ── Set up later from Settings ───────────────
                        Text {
                            text: "SET UP FROM SETTINGS → CHANNELS";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.text-dim;
                        }
                        CheckBox {
                            text: "WhatsApp — Meta Business Cloud webhook (needs public HTTPS)";
                            checked: false;
                            enabled: false;
                        }
                        CheckBox {
                            text: "Slack — Socket Mode WebSocket (no public HTTPS needed)";
                            checked: false;
                            enabled: false;
                        }
                        CheckBox {
                            text: "Discord — Gateway WebSocket (direct messages today, guilds soon)";
                            checked: false;
                            enabled: false;
                        }
                        // ── On the roadmap ──────────────────────────
                        Text {
                            text: "ON THE ROADMAP";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.text-dim;
                        }
                        CheckBox {
                            text: "Signal — needs Signal Desktop running on this machine";
                            checked: false;
                            enabled: false;
                        }
                        CheckBox {
                            text: "Matrix — bring your own homeserver + access token";
                            checked: false;
                            enabled: false;
                        }
                        CheckBox {
                            text: "LINE — LINE Messaging API (bot account required)";
                            checked: false;
                            enabled: false;
                        }
                        CheckBox {
                            text: "iMessage — macOS only, Apple automation restrictions apply";
                            checked: false;
                            enabled: false;
                        }
                    }
                }
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    Text {
                        text: "OMI CONVERSATIONS & MEDIA (OPTIONAL)";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-bold;
                        color: Theme.accent-green;
                    }
                    Text {
                        text: "Import OMI conversations or accept authenticated local live media. Every data type and downstream effect is separately opt-in.";
                        color: Theme.text-muted;
                        font-size: Theme.font-size-caption;
                        wrap: word-wrap;
                    }
                    NeothCheckBox { text: "Enable OMI"; checked <=> root.wz-omi-enabled; }
                    if root.wz-omi-enabled: VerticalBox {
                        spacing: Theme.space-base;
                        NeothComboBox {
                            model: ["developer_api", "native_ingest", "both", "legacy_memories"];
                            current-index: root.wz-omi-mode == "native_ingest" ? 1
                                : root.wz-omi-mode == "both" ? 2
                                : root.wz-omi-mode == "legacy_memories" ? 3 : 0;
                            selected(i) => {
                                root.wz-omi-mode = i == 1 ? "native_ingest"
                                    : i == 2 ? "both"
                                    : i == 3 ? "legacy_memories" : "developer_api";
                            }
                        }
                        if root.wz-omi-mode == "both": Text {
                            text: "Both imports OMI conversations and exports completed native transcripts to the configured Developer API endpoint.";
                            color: Theme.accent-amber;
                            font-size: Theme.font-size-caption;
                            wrap: word-wrap;
                        }
                        NeothLineEdit { placeholder-text: "OMI endpoint"; text <=> root.wz-omi-endpoint; }
                        NeothLineEdit { placeholder-text: "Native listener (127.0.0.1:8003)"; text <=> root.wz-omi-listen-addr; }
                        NeothLineEdit { placeholder-text: "Retention days"; text <=> root.wz-omi-retention-days; }
                        if root.wz-omi-mode == "developer_api" || root.wz-omi-mode == "both": NeothLineEdit {
                            placeholder-text: "omi_dev_* Developer API key";
                            password: true;
                            text <=> root.wz-omi-developer-key;
                        }
                        if root.wz-omi-mode == "native_ingest" || root.wz-omi-mode == "both": NeothLineEdit {
                            placeholder-text: "Native bearer token (minimum 32 bytes)";
                            password: true;
                            text <=> root.wz-omi-native-token;
                        }
                        NeothCheckBox { text: "Retain raw transcripts locally"; checked <=> root.wz-omi-retain-transcripts; }
                        NeothCheckBox { text: "Accept/process audio"; checked <=> root.wz-omi-audio-enabled; }
                        NeothCheckBox { text: "Accept/process images"; checked <=> root.wz-omi-image-enabled; }
                        NeothCheckBox { text: "Accept/process video"; checked <=> root.wz-omi-video-enabled; }
                        NeothCheckBox { text: "Allow public Developer API reads + both-mode transcript exports (HTTPS only)"; checked <=> root.wz-omi-allow-cloud-api; }
                        NeothCheckBox { text: "Create bounded summaries"; checked <=> root.wz-omi-summary-enabled; }
                        NeothCheckBox { text: "Allow cloud model for summaries"; checked <=> root.wz-omi-allow-cloud-summary; }
                        NeothCheckBox { text: "Create local tasks from action items"; checked <=> root.wz-omi-create-actions; }
                        NeothCheckBox { text: "Seed corroborated ground truth"; checked <=> root.wz-omi-seed-groundtruth; }
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.autonomy; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.cluster; }
                }
            }
        }

        // ── Cluster (Q4 ratification: default ON + opt-out checkbox) ────
        // SPEC: cluster_auto_discovery_2026-05-22.md
        if root.step == WizardStep.cluster: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Network buddy discovery";
                subtitle: "Optional: let your NEOTH devices find each other on the same network and pair as a team.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    Text {
                        text: "NEOTH can automatically find your other devices on this network and connect them into one team — shared memory, shared chat, shared task board. It uses a lightweight mDNS broadcast (same technology as Airplay and Chromecast) to announce itself every 60 seconds. On a home or office LAN this is safe; on a shared or public network it reveals your instance label and public key to other devices on the subnet. If you only ever run one NEOTH instance, turn this off — you can re-enable it later with `neoth cluster enable`.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    CheckBox {
                        text: "Disable buddy discovery on this device";
                        checked <=> root.cluster-discovery-disabled;
                    }
                    Text {
                        text: "Recommended: leave unchecked if you run NEOTH on more than one device.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.channels; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => {
                        // Skip the keys screen when nothing needs a
                        // secret — operator goes straight to HMAC setup.
                        if (root.need-keys-step) {
                            root.step = WizardStep.keys;
                        } else {
                            root.step = WizardStep.hmac-setup;
                        }
                    }
                }
            }
        }

        // ── Keys ───────────────────────────────────────────────────────
        if root.step == WizardStep.keys: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "API keys & tokens";
                subtitle: "Stored in ~/.neoth/credentials.yaml at mode 0600. Leave blank to skip — add later via `neoth init --force`.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    if root.provider-needs-key: VerticalLayout {
                        spacing: Theme.space-tight;
                        Text {
                            text: "Provider key — " + root.provider-choice;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        LineEdit {
                            placeholder-text: "sk-... / API key";
                            input-type: password;
                            text <=> root.provider-key;
                        }
                    }
                    if root.enable-telegram: VerticalLayout {
                        spacing: Theme.space-tight;
                        Text {
                            text: "Telegram bot token — from @BotFather";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        LineEdit {
                            placeholder-text: "123456789:ABC-…";
                            input-type: password;
                            text <=> root.telegram-token;
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.cluster; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.hmac-setup; }
                }
            }
        }

        // ── HMAC / Outbound Webhook (ZF-05) ────────────────────────────
        if root.step == WizardStep.hmac-setup: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Outbound webhook signing";
                subtitle: "Optional. NEOTH can sign outbound webhook payloads with an HMAC-SHA256 secret so your endpoint can verify they came from your instance. Leave blank to skip — configure any time in Settings → Security.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    CheckBox {
                        text: "Enable outbound webhook signing";
                        checked <=> root.wz-hmac-enabled;
                    }
                    if root.wz-hmac-enabled: VerticalLayout {
                        spacing: Theme.space-tight;
                        Text {
                            text: "Webhook endpoint URL";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        LineEdit {
                            placeholder-text: "https://example.com/neoth-hook";
                            text <=> root.wz-hmac-webhook-url;
                        }
                        Text {
                            text: "Shared HMAC secret";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        LineEdit {
                            placeholder-text: "secret string — keep this safe";
                            input-type: password;
                            text <=> root.wz-hmac-webhook-secret;
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => {
                        if (root.need-keys-step) {
                            root.step = WizardStep.keys;
                        } else {
                            root.step = WizardStep.cluster;
                        }
                    }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.obsidian-setup; }
                }
            }
        }

        // ── Obsidian Vault (ZF-05) ─────────────────────────────────────
        if root.step == WizardStep.obsidian-setup: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Obsidian vault";
                subtitle: "Optional. Point NEOTH at an Obsidian vault folder so it can index your notes and write session summaries there. Skip freely — wire it up later in Settings → Integrations → Obsidian.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        LineEdit {
                            placeholder-text: "/home/you/Obsidian/MyVault";
                            text <=> root.wz-obsidian-vault;
                            horizontal-stretch: 1;
                        }
                        NeothButton {
                            label: "Browse…";
                            primary: false;
                            clicked => { root.wz-obsidian-browse-clicked(); }
                        }
                    }
                    if root.wz-obsidian-vault != "": VerticalLayout {
                        spacing: Theme.space-tight;
                        Text {
                            text: "Session subfolder inside vault";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        LineEdit {
                            placeholder-text: "NEOTH-sessions";
                            text <=> root.wz-obsidian-subdir;
                        }
                        CheckBox {
                            text: "Enable vault reader (lets NEOTH search your notes)";
                            checked <=> root.wz-obsidian-reader;
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.hmac-setup; }
                }
                HorizontalLayout {
                    spacing: Theme.space-base;
                    NeothButton {
                        label: "Skip";
                        primary: false;
                        clicked => { root.step = WizardStep.n8n-setup; }
                    }
                    NeothButton {
                        label: "Continue →";
                        clicked => { root.step = WizardStep.n8n-setup; }
                    }
                }
            }
        }

        // ── n8n (ZF-05) ────────────────────────────────────────────────
        if root.step == WizardStep.n8n-setup: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "n8n automation";
                subtitle: "Optional. Connect NEOTH to a local n8n instance so it can trigger and receive workflows. Leave disabled to skip — enable any time in Settings → Integrations → n8n.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    CheckBox {
                        text: "Enable n8n integration";
                        checked <=> root.wz-n8n-enabled;
                    }
                    if root.wz-n8n-enabled: VerticalLayout {
                        spacing: Theme.space-tight;
                        Text {
                            text: "n8n API port (default 9744)";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        LineEdit {
                            placeholder-text: "9744";
                            text <=> root.wz-n8n-port;
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.obsidian-setup; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.keet-tip; }
                }
            }
        }

        // ── Private mesh info (legacy step id: keet-tip) ───────────────
        if root.step == WizardStep.keet-tip: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "NEOTH private mesh";
                subtitle: "Optional node-to-node coordination over NEOTH's own peeroxide/Hyperswarm protocol. This is not a Keet room or Keet-compatible chat channel.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    Text {
                        text: "Inspect and enable the mesh after setup.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        font-weight: Theme.weight-medium;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "After the wizard, run:\n\n  neoth cluster status\n\nThe private mesh uses NEOTH's own authenticated wire protocol. Keet exposes no supported public room/message API, so NEOTH does not request a Keet seed or claim Keet interoperability.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "No external Keet or Pear installation is required.";
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.accent-green;
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.n8n-setup; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.wasm-setup; }
                }
            }
        }

        // ── WASM Plugin Host (ZF-05) ───────────────────────────────────
        if root.step == WizardStep.wasm-setup: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "WASM plugin host";
                subtitle: "Optional. Enable the built-in WASM runtime so you can load compiled plugin modules (.wasm files) that extend NEOTH with custom tools and skills. Disable if you never plan to install plugins — saves a few MB of memory.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    CheckBox {
                        text: "Enable WASM plugin host";
                        checked <=> root.wz-wasm-enabled;
                    }
                    Text {
                        text: "Plugins are loaded from ~/.neoth/plugins/ by default. You can install plugins later with `neoth plugin install <path>` or from Settings → Plugins.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.keet-tip; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.done; }
                }
            }
        }

        // ── Done ───────────────────────────────────────────────────────
        if root.step == WizardStep.done: SovereignFade { VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Ready to go";
                subtitle: "Review your configuration. Finish writes ~/.neoth/freedom.yaml and (when set) ~/.neoth/credentials.yaml at mode 0600.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "Operator";
                            width: 100px;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.operator-id;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "Provider";
                            width: 100px;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.provider-choice;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "Autonomy";
                            width: 100px;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.autonomy-choice;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "Channels";
                            width: 100px;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "cli" + (root.enable-telegram ? ", telegram" : "");
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "License";
                            width: 100px;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.license-accepted ? "accepted" : "NOT accepted";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: root.license-accepted ? Theme.text-primary : Theme.accent-pink;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "OMI";
                            width: 100px;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            color: Theme.accent-green;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.wz-omi-enabled ? root.wz-omi-mode + " · opt-in" : "disabled";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if root.status-line != "": Text {
                text: root.status-line;
                font-family: Theme.font-display;
                font-size: Theme.font-size-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            // ZF-05: express-path post-setup tips — shows when a built-in
            // preset was chosen so the operator knows what was skipped and
            // how to configure those areas later.
            if root.wz-is-express: Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    Text {
                        text: "Express preset applied — skipped areas";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-bold;
                        letter-spacing: Theme.letter-spacing-wide;
                        color: Theme.accent-green;
                    }
                    Text {
                        text: "These features were skipped. Configure them later in Settings:";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: "· Outbound webhook signing  →  Settings → Security";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "· Obsidian vault reader     →  Settings → Integrations → Obsidian";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "· n8n automation            →  Settings → Integrations → n8n";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "· NEOTH private mesh        →  run `neoth cluster status` in a terminal";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "· WASM plugins              →  Settings → Plugins";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-primary;
                    }
                }
            }
            // G-19 fix: three-button row clipped on narrow windows.
            // Primary actions (Back / Finish) stay in the bottom row;
            // re-entry shortcut "Open Settings →" gets its own line
            // above so its label cannot collide with Finish.
            HorizontalLayout {
                alignment: center;
                NeothButton {
                    label: "Open Settings →";
                    primary: false;
                    clicked => { root.step = WizardStep.settings; }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => {
                        // ZF-05: express path goes back to preset-picker;
                        // custom path goes back to wasm-setup (last parity screen).
                        if (root.wz-is-express) {
                            root.step = WizardStep.preset-picker;
                        } else if (root.need-keys-step) {
                            root.step = WizardStep.wasm-setup;
                        } else {
                            root.step = WizardStep.wasm-setup;
                        }
                    }
                }
                NeothButton {
                    label: "Finish";
                    enabled: root.license-accepted;
                    clicked => {
                        root.finish-clicked();
                        // Pick #33 — after writing freedom.yaml the
                        // operator lands in the Chat surface (primary
                        // daily view). Settings is one tap away via
                        // the ⚙ icon in the chat sidebar.
                        root.step = WizardStep.chat;
                    }
                }
            }
        } }  // close Done VerticalLayout + SovereignFade

        // ── Settings (Pick #32) ───────────────────────────────────────
        // ══ APP SHELL — persistent sidebar + topbar + content + status ══
        // The design-system desktop layout. Shown for the main experience
        // (chat + settings-family + the net-new mockup tabs); the wizard steps
        // above keep their own full-screen flow for first-run.
        if (root.step == WizardStep.chat || root.step == WizardStep.settings): HorizontalLayout {
            if !Theme.sidebar-collapsed: Sidebar {
                active-tab: root.nav-active;
                complexity: root.nav-complexity;
                show-loops: root.show-loops;
                channels-count: root.chat-channels.length;
                operator-name: root.operator-id != "" ? root.operator-id : "operator";
                project-domain: root.project-domain;
                nav(t) => {
                    root.nav-active = t;
                    root.step = (t == "chat") ? WizardStep.chat : WizardStep.settings;
                }
                set-complexity(l) => { root.nav-complexity = l; }
                toggle-theme => { root.theme-toggle-clicked(); }
            }
            VerticalLayout {
                if !Theme.header-hidden: TopBar {
                    kicker: "NEOTH · SOVEREIGN";
                    title: root.shell-title;
                    // Wave-2: activity toggle button in the TopBar right slot.
                    // Badge dot shows when rows contain active entries and panel is closed.
                    Rectangle {
                        width: 36px; height: 36px;
                        border-radius: Theme.radius-sm;
                        background: act-ta.has-hover ? Theme.surface-2
                            : (root.activity-open ? Theme.accent-tint : transparent);
                        border-width: root.activity-open ? 1px : 0px;
                        border-color: Theme.border-accent;
                        animate background { duration: Theme.duration-fast; easing: ease-out; }
                        Text {
                            text: "◫";
                            color: root.activity-open ? Theme.accent : Theme.text-secondary;
                            font-size: 16px; font-family: Theme.font-mono;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        // badge dot — visible when there are active rows while closed
                        if !root.activity-open && root.activity-rows.length > 0: Rectangle {
                            x: parent.width - 9px; y: 3px;
                            width: 7px; height: 7px; border-radius: 3.5px;
                            background: Theme.accent;
                        }
                        act-ta := TouchArea { clicked => { root.activity-toggle(); } }
                    }
                    // Companion overlay — minimize to floating orb companion.
                    // "⊟" glyph reads as "collapse/minimize" without being a system chrome icon.
                    Rectangle {
                        width: 36px; height: 36px;
                        border-radius: Theme.radius-sm;
                        background: min-ta.has-hover ? Theme.surface-2 : transparent;
                        animate background { duration: Theme.duration-micro; easing: ease-out; }
                        Text {
                            text: "⊟";
                            color: Theme.text-dim;
                            font-size: 16px; font-family: Theme.font-mono;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        min-ta := TouchArea { clicked => { root.minimize-to-companion(); } }
                    }
                }

                // `if` (not `visible:`) so a hidden SettingsView is removed from
                // the layout tree entirely — a `visible:false` element still
                // reserves its stretch space and would squash the active tab.
                if (root.nav-active != "chat"
                        && root.nav-active != "overview"
                        && root.nav-active != "agents" && root.nav-active != "automation"
                        && root.nav-active != "resources" && root.nav-active != "doctor"
                        && root.nav-active != "loops"
                        && root.nav-active != "n8n" && root.nav-active != "babel"
                        && root.nav-active != "calendar" && root.nav-active != "evolve"
                        && root.nav-active != "selfdev"
                        && root.nav-active != "obsidian" && root.nav-active != "dreaming"
                        && root.nav-active != "wiki" && root.nav-active != "buddyconfig"
                        && root.nav-active != "companion" && root.nav-active != "mesh"): SettingsView {
                    active: root.nav-active == "memory" ? SettingsTab.memory
                        : root.nav-active == "hemispheres" ? SettingsTab.hemispheres
                        : root.nav-active == "channels" ? SettingsTab.channels
                        : root.nav-active == "coding" ? SettingsTab.code-sessions
                        : root.nav-active == "privacy" ? SettingsTab.privacy
                        : root.nav-active == "plugins" ? SettingsTab.plugins
                        : root.nav-active == "cluster" ? SettingsTab.cluster
                        : SettingsTab.config;
                    autonomy-current: root.autonomy-choice;
            provider-current: root.provider-choice;
            provider-current-index: root.provider-choice-index;
            // GU-03 panel-visibility flows MainWindow → SettingsView.
            show-hemispheres: root.settings-show-hemispheres;
            show-channels: root.settings-show-channels;
            show-skills: root.settings-show-skills;
            show-plugins: root.settings-show-plugins;
            show-memory: root.settings-show-memory;
            show-cluster: root.settings-show-cluster;
            show-code-sessions: root.settings-show-code-sessions;
            kanban-backlog: root.kanban-backlog;
            kanban-todo: root.kanban-todo;
            kanban-in-progress: root.kanban-in-progress;
            kanban-review: root.kanban-review;
            kanban-done: root.kanban-done;
            kanban-feed: root.kanban-feed;
            kanban-session-summary: root.kanban-session-summary;
            cerebellum-bound: root.cerebellum-bound;
            safety-rails: root.safety-rails;
            rails-engaged-count: root.rails-engaged-count;
            rails-total: root.rails-total;
            trust-autonomy-level: root.trust-autonomy-level;
            trust-autonomy-behavior: root.trust-autonomy-behavior;
            trust-privacy: root.trust-privacy;
            trust-recovery: root.trust-recovery;
            trust-ledger: root.trust-ledger;
            omi-enabled <=> root.omi-enabled;
            omi-mode <=> root.omi-mode;
            omi-endpoint <=> root.omi-endpoint;
            omi-listen-addr <=> root.omi-listen-addr;
            omi-retention-days <=> root.omi-retention-days;
            omi-retain-transcripts <=> root.omi-retain-transcripts;
            omi-audio-enabled <=> root.omi-audio-enabled;
            omi-image-enabled <=> root.omi-image-enabled;
            omi-video-enabled <=> root.omi-video-enabled;
            omi-allow-cloud-api <=> root.omi-allow-cloud-api;
            omi-allow-cloud-summary <=> root.omi-allow-cloud-summary;
            omi-create-actions <=> root.omi-create-actions;
            omi-seed-groundtruth <=> root.omi-seed-groundtruth;
            omi-summary-enabled <=> root.omi-summary-enabled;
            omi-developer-key-draft <=> root.omi-developer-key-draft;
            omi-native-token-draft <=> root.omi-native-token-draft;
            omi-developer-key-present: root.omi-developer-key-present;
            omi-native-token-present: root.omi-native-token-present;
            omi-config-valid: root.omi-config-valid;
            omi-config-error: root.omi-config-error;
            omi-runtime-state: root.omi-runtime-state;
            omi-runtime-detail: root.omi-runtime-detail;
            omi-pending-audits: root.omi-pending-audits;
            omi-review-note <=> root.omi-review-note;
            omi-conversation-id <=> root.omi-conversation-id;
            omi-refresh-clicked => { root.omi-refresh(); }
            omi-probe-clicked => { root.omi-probe(); }
            omi-save-clicked(enabled, mode, endpoint, listen, retention, transcripts, audio, images, video, cloudapi, cloudsummary, actions, groundtruth, summary, developerkey, nativetoken) => {
                root.omi-save(enabled, mode, endpoint, listen, retention, transcripts, audio, images, video, cloudapi, cloudsummary, actions, groundtruth, summary, developerkey, nativetoken);
            }
            omi-resume-clicked(note) => { root.omi-resume(note); }
            omi-retention-clicked => { root.omi-retention(); }
            omi-purge-clicked(id) => { root.omi-purge(id); }
            omi-reimport-clicked(id) => { root.omi-reimport(id); }
            hw-cpu: root.hw-cpu;
            hw-memory: root.hw-memory;
            hw-accelerator: root.hw-accelerator;
            hw-vram: root.hw-vram;
            hw-vram-fraction: root.hw-vram-fraction;
            hw-disk: root.hw-disk;
            hw-models: root.hw-models;
            hw-load-readout: root.hw-load-readout;
            cluster-peers: root.cluster-peers;
            council-cap: root.council-cap;
            council-daily-usd: root.council-daily-usd;
            council-depth-warning: root.council-depth-warning;
            council-last-debate: root.council-last-debate;
            hemisphere-bindings: root.hemisphere-bindings;
            hemispheres-mode: root.hemispheres-mode;
            hemisphere-model-ids: root.hemisphere-model-ids;
            provider-ids: root.provider-ids;
            skills: root.skills;
            skills-filter <=> root.skills-filter;
            skills-total: root.skills-total;
            skills-filter-edited(t) => { root.skills-filter-edited(t); }
            spec-create-clicked(t, g, a) => { root.spec-create(t, g, a); }
            preset-list: root.preset-list;
            preset-summary: root.preset-summary;
            preset-activate-clicked(name) => { root.preset-activate-clicked(name); }
            preset-apply-clicked => { root.preset-apply-clicked(); }
            preset-apply-named-clicked(name) => { root.preset-apply-named-clicked(name); }
            preset-delete-clicked(name) => { root.preset-delete-clicked(name); }
            preset-consent-confirmed => { root.preset-consent-confirmed(); }
            preset-consent-cancelled => { root.preset-consent-cancelled(); }
            consent-preset-name <=> root.consent-preset-name;
            consent-warn-text <=> root.consent-warn-text;
            consent-needs-fullauto <=> root.consent-needs-fullauto;
            consent-fields-count <=> root.consent-fields-count;
            consent-visible <=> root.consent-visible;
            skills-always-embed-route: root.skills-always-embed-route;
            skills-always-embed-route-changed(v) => { root.skills-always-embed-route-set(v); }
            skill-toggle-clicked(id, en) => { root.skill-toggle(id, en); }
            skill-install-clicked => { root.skill-install(); }
            skill-uninstall-clicked(id) => { root.skill-uninstall(id); }
            skill-create-clicked(id, desc, kw, prompt) => { root.skill-create(id, desc, kw, prompt); }
            plugin-toggle-clicked(id, en) => { root.plugin-toggle(id, en); }
            plugin-install-clicked => { root.plugin-install(); }
            plugin-remove-clicked(id) => { root.plugin-remove(id); }
            // DES-12 — detail pane two-way binding + callbacks.
            plugin-detail-id <=> root.plugin-detail-id;
            plugin-detail-title: root.plugin-detail-title;
            plugin-detail-events: root.plugin-detail-events;
            plugin-detail-clicked(id) => { root.plugin-detail-clicked(id); }
            plugin-detail-close => { root.plugin-detail-close(); }
            autonomy-set-clicked(level) => { root.autonomy-set(level); }
            channels: root.channels;
            channel-types: root.channel-types;
            channel-status-error: root.channel-status-error;
            channel-add-success-seq: root.channel-add-success-seq;
            channel-activity: root.channel-activity;
            plugins: root.plugins;
            memory-blocks: root.memory-blocks;
            memory-total: root.memory-total;
            wizard-rerun-clicked => {
                root.settings-wizard-rerun-clicked();
            }
            open-cli-clicked => {
                root.settings-open-cli-clicked();
            }
            open-chat-clicked => {
                root.step = WizardStep.chat;
            }
            hemisphere-set-clicked(role, provider, model) => {
                root.hemisphere-set(role, provider, model);
            }
            hemisphere-provider-picked(provider) => {
                root.hemisphere-provider-picked(provider);
            }
            reload-config-clicked => {
                root.settings-reload-clicked();
            }
            kanban-refresh-clicked => {
                root.kanban-refresh-clicked();
            }
            channels-refresh-clicked => {
                root.channels-refresh-clicked();
            }
            channel-test-clicked(name) => { root.channel-test(name); }
            channel-remove-clicked(name) => { root.channel-remove(name); }
            channel-add-clicked(ctype, f1, f2, f3, f4, f5, f6, flag) => {
                root.channel-add(ctype, f1, f2, f3, f4, f5, f6, flag);
            }
            memory-forget-preview-clicked(t) => { root.memory-forget-preview(t); }
