// NEOTH GUI wizard — R-1 Phase 3.
//
// Multi-screen wizard. Each step writes into a single shared `WizardState`
// that `main.rs` reads at the end to render `freedom.yaml` + the
// secrets-split `credentials.yaml`. CLI parity: the screens mirror
// `neothd init` step order so an operator who has done the CLI flow
// recognises the layout.
//
// Phase 3 adds three steps between provider + done:
//   - autonomy: 5-level radio (strict / standard / elevated / full / custom)
//   - channels: which channels NEOTH should listen on
//   - keys:     provider API key + per-channel tokens. Skipped entirely
//               when the chosen provider needs none AND no channels are
//               enabled (e.g. claude_cli + CLI-only mode).
//
// Secrets are kept in their own structs and serialised to
// `~/.neoth/credentials.yaml` rather than `freedom.yaml`, matching the
// Codex audit split that landed earlier in this session.

import { Button, CheckBox, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NeothButton, Card, ScreenHeader, ProgressIndicator, FooterBar, ModeCard, NeothComboBox, NeothCheckBox, SovereignFade, NeothLineEdit, EntranceFade, SideIn, ToastData, ToastStack } from "components.slint";
import { SettingsView, SettingsTab, KanbanTaskRow, KanbanFeedRow, KanbanCommentRow, SafeRailRow, TrustRow, ClusterPeerRow, HemisphereRow, SkillRow, PluginRow, PluginEventRow, MemoryRow, ChannelRow, ChannelActivityRow, PresetRow, ProfilePresetRow } from "settings.slint";
import { ChatView, ChatMessage, SessionRow, LinkChip, ConsentGrant } from "chat.slint";
import { BuddyDock } from "buddy.slint";
import { Sidebar, TopBar, StatusFooter } from "app_shell.slint";
import { MiniOverlay } from "overlay.slint";
export { MiniOverlay }
import { ResourcesView, DoctorView, ProbeView } from "tabs.slint";
import { CronView, CronJobRow } from "cron.slint";
import { OverviewView, HemiCard, CalEvent, ConsentEntry } from "overview.slint";
import { LoopPanel, LoopRoundRow, LoopRunRow } from "loop.slint";
// Design Wave 4a — new real-data panels.
import { N8nView, N8nWorkflow } from "n8n.slint";
import { BabelView, BabelGranRow, BabelWindowRow } from "babel.slint";
import { CalendarView, CalEventRow } from "calendar.slint";
import { SelfImproveView, SiProposalRow, SiLogRow } from "selfimprove.slint";
import { SelfReprogramView, SelfReprogProposalRow } from "selfreprog.slint";
export { SelfReprogProposalRow }
import { ActivitySidecar, ActivityRow } from "activity.slint";
// Wave 4b — six new panels
import { ObsidianView } from "obsidian.slint";
import { DreamingView, DreamDayRow, DreamEntryRow } from "dreaming.slint";
import { WikiView, WikiRow } from "wiki.slint";
import { BuddyConfigView, SelfActSkill } from "buddyconfig.slint";
import { CompanionView } from "companion.slint";
import { MeshView, MeshPeerRow, MeshForeignRow } from "mesh.slint";
export { SettingsTab, ChatMessage, KanbanTaskRow, KanbanFeedRow, KanbanCommentRow }
export { Theme }

// SPEC-05 PresetRow/ProfilePresetRow now live in settings.slint (AOS-02
// surfaces presets in the Config tab too) — re-exported for Rust.
export { PresetRow, ProfilePresetRow }
// Wave-1 toast system — ToastData exported so Rust can push toasts.
export { ToastData }
// Wave-2 activity sidecar — ActivityRow exported so Rust can push rows.
export { ActivityRow }
// Wave-3 overview dashboard — structs Rust constructs in refresh_overview().
export { HemiCard, CalEvent, ConsentEntry }
// Wave 4b — six new panel structs.
export { DreamDayRow, DreamEntryRow }
export { WikiRow }
export { SelfActSkill }
export { MeshPeerRow, MeshForeignRow }
// DES-12 — plugin WAL-feed detail pane event row.
export { PluginEventRow }
// DES-10 — channel activity feed row (traffic metadata, no message bodies).
export { ChannelActivityRow }
// GAP-01 Cron panel — CronJobRow exported so Rust can push rows.
export { CronJobRow }
// Chat-surface consent strip.
export { ConsentGrant }

export enum WizardStep {
    /// Very first screen the operator sees — pick between the GUI
    /// onboarding flow (this binary keeps running) or the CLI wizard
    /// (operator drops to a terminal). Sets the tone before the
    /// commitment screens kick in. Pick #29 (12/10 polish).
    mode-selection,
    welcome,
    license,
    identity,
    /// ZF-05 — preset picker inserted after Identity. A non-custom preset
    /// triggers express mode: straight to done, skipping detail screens.
    preset-picker,
    /// GOLD-ADAPT-AOS-03 — optional project-context capture (agent-os
    /// plan-product): what you're building / domain / stack. Skippable;
    /// feeds the sidebar operator card + ~/.neoth/.project-context.
    project-context,
    provider,
    autonomy,
    channels,
    /// SPEC `cluster_auto_discovery` Q4 ratification: Design B —
    /// default ON + explanatory step + opt-out checkbox. Inserted
    /// between Channels and Keys.
    cluster,
    keys,
    /// ZF-05 parity — HMAC / outbound-webhook signing key.
    hmac-setup,
    /// ZF-05 parity — Obsidian vault path + reader toggle.
    obsidian-setup,
    /// ZF-05 parity — n8n API enable + port.
    n8n-setup,
    /// Legacy enum name retained for checkpoint compatibility. The screen now
    /// describes NEOTH's private mesh and explicitly disclaims Keet interop.
    keet-tip,
    /// ZF-05 parity — WASM plugin host enable/disable.
    wasm-setup,
    done,
    /// Post-onboarding settings surface — Pick #32. Renders the
    /// `SettingsView` tab layout. Operators reach this screen by
    /// (a) clicking the ⚙ icon in the Chat sidebar, or (b)
    /// clicking through Finish on a fresh install (auto-jumps to
    /// chat after wizard, but Settings is one tap away).
    settings,
    /// Chat surface — Pick #33. Primary post-onboarding view. The
    /// operator lands here after Finish + the daemon's PROVIDER_*
    /// + CHANNEL_* WAL frames stream into the scrollback.
    chat,
}

export component MainWindow inherits Window {
    // G-26 fix: window title reflects the active screen instead of
    // staying "NEOTH — Setup" forever. Settings + Chat are
    // post-onboarding surfaces, the title should follow.
    title:
        root.step == WizardStep.chat     ? "NEOTH — Chat" :
        root.step == WizardStep.settings ? "NEOTH — Settings" :
                                            "NEOTH — Setup";
    // GUI-overhaul: open at a comfortably large default (was 1100×720, which
    // felt cramped — Alex wants to scale up, e.g. tall chat windows). Freely
    // resizable up from min-*; no max so portrait sizes like 1080×1920 work.
    preferred-width: 1280px;
    preferred-height: 880px;
    min-width: 820px;
    min-height: 600px;

    // Style spec compliance (Session 15 Pick #11+#28): Window background
    // sourced from Theme tokens. The radial-gradient hero look from
    // the brand SVG ships as a Rectangle layer inside the welcome
    // screen — Slint windows take a flat background, the gradient
    // belongs to the screen-content layer.
    background: Theme.bg-base;

    in-out property <WizardStep> step: WizardStep.mode-selection;
    /// `true` once operator picked the GUI mode. Used by main.rs to
    /// know whether to skip the mode-selection on next launch (after
    /// freedom.yaml exists) — the GUI is now the operator's chosen
    /// surface.
    in-out property <bool> mode-gui-chosen: false;
    /// Operator picked CLI on the mode screen. main.rs persists the choice,
    /// opens a real platform terminal running `neoth init --cli`, waits for
    /// its private readiness handshake, then closes the first-run GUI.
    in-out property <bool> mode-cli-chosen: false;
    /// Prevent duplicate launcher processes while the canonical preference
    /// write / platform terminal spawn is in flight.
    in-out property <bool> mode-choice-busy: false;
    in-out property <bool> license-accepted: false;
    in-out property <string> operator-id: "";
    in-out property <string> provider-choice: "claude_cli";
    /// GUI-improve — index of provider-choice within provider-ids; Rust sets it
    /// in apply_provider_ids so the Config combo shows the right selected row.
    in-out property <int> provider-choice-index: 0;
    in-out property <string> autonomy-choice: "standard";

    // GU-03 — persona-adaptive settings-panel visibility. Rust sets these on
    // startup from `panel_logic::panels_for(read_complexity_level())`; they
    // flow into the SettingsView instance below. chat/privacy/config never gated.
    in property <bool> settings-show-hemispheres: true;
    in property <bool> settings-show-channels: true;
    in property <bool> settings-show-skills: true;
    in property <bool> settings-show-plugins: true;
    in property <bool> settings-show-memory: true;
    in property <bool> settings-show-cluster: true;
    in property <bool> settings-show-code-sessions: true;
    in-out property <bool> enable-telegram: false;
    /// SPEC `cluster_auto_discovery` Q4: operator's choice on the
    /// cluster step. True = disable mDNS announce on this device.
    /// Default false (announce enabled per Design B + the noob-
    /// wizard hard rule "default ON in shipped release").
    in-out property <bool> cluster-discovery-disabled: false;
    in-out property <string> provider-key: "";
    in-out property <string> telegram-token: "";
    /// Reviewer-3 P1-B (2026-05-20): channel-screen disclosure toggle.
    /// Disabled-channel sections ("SET UP LATER", "ON THE ROADMAP")
    /// stay hidden behind this until the operator expands — DAUs
    /// finish channels in 5 seconds, pros click once to see the road-
    /// map.
    in-out property <bool> show-future-channels: false;
    /// Reviewer-3 P1-B (2026-05-20): identity-format guard. Rust
    /// computes `^[a-z0-9-]{3,32}$` against `operator-id` and pushes
    /// the verdict back here. Continue gate consults this instead of
    /// the naive `!= ""` check so the copy + the gate finally agree.
    in property <bool> operator-id-valid: false;
    in-out property <string> status-line: "";
    // Wave-1 toast system. Rust pushes via push_toast(); expires via prune_toast().
    // The ToastStack overlay renders this model in the shell area (top-right, z=70).
    in-out property <[ToastData]> toasts: [];
    in property <string> hardware-summary: "";
    /// GOLD-ADAPT-OH-01 — prior-AI migration card body (welcome step).
    /// Empty = no supported assistant homes detected → card hidden.
    in property <string> migrate-summary: "";
    // GOLD-ADAPT-GUI-04 — daemon live-state for the footer Led:
    // "live" | "connecting" | "error" (derived from probe outcomes).
    in property <string> daemon-state: "connecting";
    // GOLD-ADAPT-GUI-05 — TypedStatus footer ticker (Rust types it in).
    in property <string> status-message: "";
    // QM-9 Phase 2: last 24h usage rollup rendered for the dashboard.
    // Format: "<calls> calls (ok=<x>, err=<y>), <cost> (<pct>% of cap)"
    // — populated by a subprocess probe to `neoth usage --format json`.
    in property <string> usage-summary: "Loading usage…";
    // GOLD-WIRE-10b: live token-budget meter rendered for the dashboard.
    // Populated by a subprocess probe to `neoth meter --json`.
    in property <string> budget-summary: "Loading budget…";
    // QM-8 Phase 2: saved preset list + active marker.
    // Populated by a subprocess probe to `neoth preset list`.
    in property <string> preset-summary: "Loading presets…";
    // SPEC-05: structured preset list for the click-to-activate selector,
    // from `neoth preset list --json`.
    in property <[PresetRow]> preset-list: [];
    // SPEC-05 step5c: behavioural-profile presets (LOWKEY/Formal/…) from
    // `neoth profile preset list --json` — the operator's interaction register.
    in property <[ProfilePresetRow]> profile-preset-list: [];
    // GOLD-ADAPT-AOS-01 — skills-index search state + true install count.
    in-out property <string> skills-filter: "";
    in property <int> skills-total: 0;
    callback skills-filter-edited(string);
    // GOLD-ADAPT-AOS-06 — New-Spec pane fired (title, goal, acceptance).
    // Rust shells `neothd kanban add` + refreshes the board.
    callback spec-create(string, string, string);
    // GOLD-ADAPT-AOS-03 — project-context step drafts + persist callback.
    // Rust writes ~/.neoth/.project-context + feeds the sidebar card.
    in-out property <string> project-building: "";
    in-out property <string> project-domain: "";
    in-out property <string> project-stack: "";
    callback project-context-set(string, string, string);
    // ── ZF-05 wizard parity properties ───────────────────────────────
    // wizard-preset-choice: "" = not reached; "custom" = custom path;
    // "full-auto"/"balanced"/"essentials"/"local-sovereign" = express.
    in-out property <string> wizard-preset-choice: "";
    // HMAC / outbound-webhook screen
    in-out property <bool> wz-hmac-enabled: false;
    in-out property <string> wz-hmac-webhook-url: "";
    in-out property <string> wz-hmac-webhook-secret: "";
    // Obsidian vault screen
    in-out property <string> wz-obsidian-vault: "";
    in-out property <string> wz-obsidian-subdir: "NEOTH-sessions";
    in-out property <bool> wz-obsidian-reader: false;
    // n8n screen
    in-out property <bool> wz-n8n-enabled: false;
    in-out property <string> wz-n8n-port: "9744";
    // WASM screen
    in-out property <bool> wz-wasm-enabled: false;
    // OMI onboarding card (custom wizard path, Channels step).
    in-out property <bool> wz-omi-enabled: false;
    in-out property <string> wz-omi-mode: "developer_api";
    in-out property <string> wz-omi-endpoint: "http://127.0.0.1:8002";
    in-out property <string> wz-omi-listen-addr: "127.0.0.1:8003";
    in-out property <string> wz-omi-retention-days: "30";
    in-out property <string> wz-omi-developer-key: "";
    in-out property <string> wz-omi-native-token: "";
    in-out property <bool> wz-omi-retain-transcripts: false;
    in-out property <bool> wz-omi-audio-enabled: false;
    in-out property <bool> wz-omi-image-enabled: false;
    in-out property <bool> wz-omi-video-enabled: false;
    in-out property <bool> wz-omi-allow-cloud-api: false;
    in-out property <bool> wz-omi-allow-cloud-summary: false;
    in-out property <bool> wz-omi-create-actions: true;
    in-out property <bool> wz-omi-seed-groundtruth: true;
    in-out property <bool> wz-omi-summary-enabled: true;
    // Folder-picker for the wizard Obsidian vault field (rfd dialog in Rust).
    callback wz-obsidian-browse-clicked();
    // GOLD-ADAPT-OH-12 — first-run tour overlay (chat surface only).
    // Rust arms it when ~/.neoth/.gui-tour-done is absent; dismiss/finish
    // writes the marker.
    in-out property <bool> tour-active: false;
    in-out property <int> tour-step: 0;
    callback tour-dismissed();

    // Pick #28 (12/10 polish): derive the step counter + label from
    // the active `WizardStep` so the top ProgressIndicator always
    // matches the rendered screen. Keys-step is conditional — when
    // `need-keys-step` is false the operator skips from channels
    // straight to done, so we collapse the displayed count to 7.
    /// G-13 fix: total-steps is constant 9 (welcome..summary).
    /// Cluster step inserted at slot 7 per Q4 ratification.
    /// Previously 8 — bumped after the cluster step landed.
    /// the keys screen is shown. Previously the denominator would
    /// flip from "Step 6 of 8" to "Step 7 of 7" mid-flow when the
    /// operator picked claude_cli + no channels — visibly confusing.
    /// When keys is skipped, current-step jumps from 6 (Channels) to
    /// 8 (Summary), which the bar fills smoothly.
    // ZF-05: express path = 5 steps (Welcome/License/Identity/Preset/Done);
    // custom path = 16 steps (adds ProjectContext..WasmSetup).
    // wizard-preset-choice is empty until preset-picker is reached, so the
    // denominator starts at 16 (custom) and flips to 5 on express choice.
    out property <bool> wz-is-express:
        root.wizard-preset-choice != "" && root.wizard-preset-choice != "custom";
    out property <int> total-steps: root.wz-is-express ? 5 : 16;
    out property <int> current-step:
        root.step == WizardStep.welcome         ? 1 :
        root.step == WizardStep.license         ? 2 :
        root.step == WizardStep.identity        ? 3 :
        root.step == WizardStep.preset-picker   ? 4 :
        // Express terminates here
        (root.wz-is-express && root.step == WizardStep.done) ? 5 :
        // Custom path continues from slot 5
        root.step == WizardStep.project-context ? 5 :
        root.step == WizardStep.provider        ? 6 :
        root.step == WizardStep.autonomy        ? 7 :
        root.step == WizardStep.channels        ? 8 :
        root.step == WizardStep.cluster         ? 9 :
        root.step == WizardStep.keys            ? 10 :
        root.step == WizardStep.hmac-setup      ? 11 :
        root.step == WizardStep.obsidian-setup  ? 12 :
        root.step == WizardStep.n8n-setup       ? 13 :
        root.step == WizardStep.keet-tip        ? 14 :
        root.step == WizardStep.wasm-setup      ? 15 :
        root.step == WizardStep.done            ? 16 :
        0;
    // G-23 fix: removed dead `mode-selection` branch — the progress
    // indicator is hidden on that screen so the label is never read.
    out property <string> step-label:
        root.step == WizardStep.welcome         ? "Welcome" :
        root.step == WizardStep.license         ? "License" :
        root.step == WizardStep.identity        ? "Identity" :
        root.step == WizardStep.preset-picker   ? "Preset" :
        root.step == WizardStep.project-context ? "Project" :
        root.step == WizardStep.provider        ? "Provider" :
        root.step == WizardStep.autonomy        ? "Autonomy" :
        root.step == WizardStep.channels        ? "Channels" :
        root.step == WizardStep.cluster         ? "Cluster" :
        root.step == WizardStep.keys            ? "API Keys" :
        root.step == WizardStep.hmac-setup      ? "Webhook" :
        root.step == WizardStep.obsidian-setup  ? "Obsidian" :
        root.step == WizardStep.n8n-setup       ? "n8n" :
        root.step == WizardStep.keet-tip        ? "Private mesh" :
        root.step == WizardStep.wasm-setup      ? "Plugins" :
                                                  "Summary";
    /// `true` only when the persistent ProgressIndicator should
    /// render the step counter + bar. Mode-selection + Settings are
    /// stand-alone screens — operator isn't in the numbered flow,
    /// so showing "Step 0 of 8" reads broken.
    out property <bool> show-progress:
        root.step != WizardStep.mode-selection
        && root.step != WizardStep.settings
        && root.step != WizardStep.chat;

    callback finish-clicked;
    callback cancel-clicked;
    /// Operator confirmed the graphical surface. Rust persists the canonical
    /// instance preference before advancing the wizard.
    callback gui-mode-chosen;
    /// Operator picked CLI on the mode screen. Rust persists the preference,
    /// opens a real terminal running `neoth init --cli`, then exits this first-
    /// run window only after the terminal launch succeeds.
    callback cli-mode-chosen;
    /// Reviewer-3 P1-B (2026-05-20): operator typed in the Identity
    /// LineEdit. Rust validates against `^[a-z0-9-]{3,32}$` and
    /// pushes the verdict back via `operator-id-valid`. Slint has no
    /// regex; the round-trip is the simplest accurate path.
    callback operator-id-edited(string);
    /// G-2 fix — operator clicked "View full text →" on the License
    /// screen. Rust side opens the project licence URL in the system
    /// default browser via `start` (Windows) / `open` (macOS) /
    /// `xdg-open` (Linux).
    callback open-license-url;
    /// Settings panel triggered the hot-reload sentinel write
    /// (`/reload` mirror). Rust drops the file under ~/.neoth/.
    callback settings-reload-clicked;
    /// Settings panel triggered "Re-run wizard". Rust resets the
    /// state back to `mode-selection` so the operator walks the
    /// flow fresh.
    callback settings-wizard-rerun-clicked;
    /// Settings offers a reversible GUI -> CLI switch at any time.
    callback settings-open-cli-clicked;
    // SPEC-06 — forwarded from the Hemispheres rebind control; Rust shells
    // `neoth hemispheres set --role <r> --provider <p>` + refreshes the panel.
    callback hemisphere-set(string, string, string);
    callback hemisphere-provider-picked(string);
    // PF-01-GUI — forwarded from the Skills auto-route toggle; Rust writes
    // `skills.always_embed_route` into freedom.yaml + drops the reload sentinel.
    callback skills-always-embed-route-set(bool);
    /// G-12 fix — operator picked a different provider in Settings
    /// → Config. Rust persists the change.
    callback provider-changed(string);

    /// Bite #5 — cluster auto-discovery state surfaced in
    /// Settings → Cluster. Rust populates these on window
    /// startup from freedom.yaml; toggle fires the callback
    /// which mutates freedom.yaml + drops the reload sentinel.
    in-out property <bool> cluster-mdns-enabled: true;
    in-out property <int> cluster-listen-port: 49737;
    in-out property <string> cluster-trusted-ssids-summary: "";
    callback cluster-mdns-enabled-changed(bool);
    // GOLD-FEAT-01c — full-auto (sudomode) toggle, forwarded to SettingsView.
    in-out property <bool> full-auto-active: false;
    callback full-auto-confirmed();
    callback full-auto-gated();
    // GOLD-PROG-08 — live token budget, forwarded to SettingsView.
    in property <bool> usage-available: false;
    in property <string> usage-responses: "";
    in property <string> usage-tokens: "";
    in property <string> usage-note: "";

    // ── Reactive Buddy companion (NEOTH Design System) ────────────────
    // The living neural-core orb, docked bottom-right, that reflects what
    // NEOTH is doing right now. Rust drives `buddy-mood` from daemon activity
    // (idle / thinking / working / memory / audit / alert / success …) and
    // `buddy-caption` is the short status word under the orb. Defaults keep
    // the orb gently breathing ("idle") until the daemon reports a state.
    in property <string> buddy-mood: "idle";
    in property <string> buddy-caption: "ready";
    in property <bool> buddy-visible: true;
    callback buddy-clicked();

    // ── App-shell navigation (design-system desktop layout) ───────────
    // The persistent sidebar's active tab. "chat" shows the ChatView; the
    // settings-family tabs (memory/hemispheres/channels/coding/privacy/
    // plugins/cluster/config) drive SettingsView's subtab; agents/automation/
    // resources/doctor are the net-new mockup tabs.
    in-out property <string> nav-active: "chat";
    in-out property <int> nav-complexity: 2;     // 0 minimal · 1 standard · 2 full
    // Doctor tab — Rust runs `neoth doctor` + streams the result here.
    in property <string> doctor-output: "";
    in property <bool> doctor-running: false;
    callback doctor-run-clicked();
    // GAP-05 — Status probe (`neoth status`).
    in property <string> doctor-status-output: "";
    in property <bool> doctor-status-running: false;
    callback doctor-status-run-clicked();
    // GAP-13 — Security audit probe (`neoth security audit`).
    in property <string> doctor-security-output: "";
    in property <bool> doctor-security-running: false;
    callback doctor-security-run-clicked();
    // Agents tab — `neoth cluster status` (the agent/worker topology).
    in property <string> agents-output: "";
    in property <bool> agents-running: false;
    callback agents-refresh-clicked();
    // Automation tab — CRUD cron panel (GAP-01).
    in property <[CronJobRow]> cron-jobs: [];
    in property <bool>         cron-running: false;
    in property <string>       cron-refreshed-at: "";
    callback cron-refresh-clicked();
    callback cron-add-clicked(string, string, string, string, string, string, string, string);
    //                        id      name    cron    prompt  tz      channel recipient timeout
    callback cron-run-clicked(string);          // id
    callback cron-toggle-clicked(string, bool); // id, new_enabled
    callback cron-remove-clicked(string);       // id
    // GOLD-LOOP-03 — Loop panel (display-gated: Rust sets show-loops from
    // the `gui-loop` cargo feature; the wiring drives a `neothd loop run`
    // subprocess + the `~/.neoth/loops/` history).
    in property <bool> show-loops: false;
    in-out property <string> loop-prompt-draft: "";
    in property <bool> loop-running: false;
    in property <[LoopRoundRow]> loop-rounds: [];
    in property <[LoopRunRow]> loop-history: [];
    in property <string> loop-selected-id: "";
    in property <string> loop-stop-reason: "";
    in property <string> loop-final-text: "";
    in property <int> loop-tool-calls: 0;
    in property <int> loop-tool-call-budget: 0;
    in property <float> loop-convergence: 0.0;
    in property <string> loop-status-note: "";
    callback loop-run-clicked(string);
    callback loop-kill-clicked();
    callback loop-refresh-clicked();
    callback loop-run-selected(string);
    // ── Overview / Mission Control ─────────────────────────────────────────────
    // Design Wave 3 — all set by refresh_overview() via invoke_from_event_loop.
    in property <string> ov-operating-mode: "";
    in property <string> ov-autonomy: "";
    in property <string> ov-daemon-state: "connecting";
    in property <string> ov-channel-health: "";
    in property <string> ov-wal-bytes: "";
    in property <string> ov-tier-counts: "";
    in property <string> ov-tokens-in: "";
    in property <string> ov-tokens-out: "";
    in property <string> ov-responses: "";
    in property <string> ov-cost: "";
    in property <float>  ov-token-fraction: 0.0;
    in property <[HemiCard]> ov-hemispheres: [];
    in property <string> ov-agents-count: "";
    in property <[string]> ov-agent-names: [];
    in property <string> ov-skills-active: "";
    in property <string> ov-plugins-active: "";
    in property <[string]> ov-skill-names: [];
    in property <[string]> ov-plugin-names: [];
    in property <[CalEvent]> ov-calendar-events: [];
    in property <bool>   ov-calendar-configured: true;
