// NEOTH GUI wizard — R-1 Phase 3.
//
// Multi-screen wizard. Each step writes into a single shared `WizardState`
// that `main.rs` reads at the end to render `freedom.yaml` + the
// secrets-split `credentials.yaml`. CLI parity: the screens mirror
// `neothd init` step order so an operator who has done the CLI flow
// recognises the layout.
//
// Phase 3 adds three steps between provider + done:
//   - autonomy: 5-level radio (strict / standard / elevated / full / custom)
//   - channels: which channels NEOTH should listen on (Telegram today;
//                Slack / Keet / Discord land when their adapters ship)
//   - keys:     provider API key + per-channel tokens. Skipped entirely
//               when the chosen provider needs none AND no channels are
//               enabled (e.g. claude_cli + CLI-only mode).
//
// Secrets are kept in their own structs and serialised to
// `~/.neoth/credentials.yaml` rather than `freedom.yaml`, matching the
// Codex audit split that landed earlier in this session.

import { Button, CheckBox, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NeothButton, Card, ScreenHeader, ProgressIndicator, FooterBar, ModeCard, NeothComboBox, SovereignFade } from "components.slint";
import { SettingsView, SettingsTab, KanbanTaskRow, KanbanFeedRow, KanbanCommentRow, SafeRailRow, TrustRow, ClusterPeerRow, HemisphereRow, SkillRow, PluginRow, MemoryRow, ChannelRow } from "settings.slint";
import { ChatView, ChatMessage } from "chat.slint";
import { BuddyDock } from "buddy.slint";
import { Sidebar, TopBar, StatusFooter } from "app_shell.slint";
import { ResourcesView, DoctorView } from "tabs.slint";
export { SettingsTab, ChatMessage, KanbanTaskRow, KanbanFeedRow, KanbanCommentRow }
export { Theme }

// SPEC-05 — one saved preset for the selector tile.
export struct PresetRow {
    name: string,
    active: bool,
}

// SPEC-05 step5c — one behavioural profile preset (LOWKEY/Formal/Deepdive/…)
// for the interaction-register selector.
export struct ProfilePresetRow {
    name: string,
    description: string,
    recommended: bool,
    active: bool,
}

export enum WizardStep {
    /// Very first screen the operator sees — pick between the GUI
    /// onboarding flow (this binary keeps running) or the CLI wizard
    /// (operator drops to a terminal). Sets the tone before the
    /// commitment screens kick in. Pick #29 (12/10 polish).
    mode-selection,
    welcome,
    license,
    identity,
    provider,
    autonomy,
    channels,
    /// SPEC `cluster_auto_discovery` Q4 ratification: Design B —
    /// default ON + explanatory step + opt-out checkbox. Inserted
    /// between Channels and Keys.
    cluster,
    keys,
    done,
    /// Post-onboarding settings surface — Pick #32. Renders the
    /// `SettingsView` tab layout. Operators reach this screen by
    /// (a) clicking the ⚙ icon in the Chat sidebar, or (b)
    /// clicking through Finish on a fresh install (auto-jumps to
    /// chat after wizard, but Settings is one tap away).
    settings,
    /// Chat surface — Pick #33. Primary post-onboarding view. The
    /// operator lands here after Finish + the daemon's PROVIDER_*
    /// + CHANNEL_* WAL frames stream into the scrollback.
    chat,
}

export component MainWindow inherits Window {
    // G-26 fix: window title reflects the active screen instead of
    // staying "NEOTH — Setup" forever. Settings + Chat are
    // post-onboarding surfaces, the title should follow.
    title:
        root.step == WizardStep.chat     ? "NEOTH — Chat" :
        root.step == WizardStep.settings ? "NEOTH — Settings" :
                                            "NEOTH — Setup";
    // GUI-overhaul: open at a comfortably large default (was 1100×720, which
    // felt cramped — Alex wants to scale up, e.g. tall chat windows). Freely
    // resizable up from min-*; no max so portrait sizes like 1080×1920 work.
    preferred-width: 1280px;
    preferred-height: 880px;
    min-width: 820px;
    min-height: 600px;

    // Style spec compliance (Session 15 Pick #11+#28): Window background
    // sourced from Theme tokens. The radial-gradient hero look from
    // the brand SVG ships as a Rectangle layer inside the welcome
    // screen — Slint windows take a flat background, the gradient
    // belongs to the screen-content layer.
    background: Theme.bg-base;

    in-out property <WizardStep> step: WizardStep.mode-selection;
    /// `true` once operator picked the GUI mode. Used by main.rs to
    /// know whether to skip the mode-selection on next launch (after
    /// freedom.yaml exists) — the GUI is now the operator's chosen
    /// surface.
    in-out property <bool> mode-gui-chosen: false;
    /// Operator picked CLI on the mode screen. main.rs handles this
    /// via the `cli-mode-chosen` callback — typically: print the
    /// `neoth init` command to stdout + exit so the operator runs
    /// the CLI wizard manually. Pick #29 contract.
    in-out property <bool> mode-cli-chosen: false;
    in-out property <bool> license-accepted: false;
    in-out property <string> operator-id: "";
    in-out property <string> provider-choice: "claude_cli";
    /// GUI-improve — index of provider-choice within provider-ids; Rust sets it
    /// in apply_provider_ids so the Config combo shows the right selected row.
    in-out property <int> provider-choice-index: 0;
    in-out property <string> autonomy-choice: "standard";

    // GU-03 — persona-adaptive settings-panel visibility. Rust sets these on
    // startup from `panel_logic::panels_for(read_complexity_level())`; they
    // flow into the SettingsView instance below. chat/privacy/config never gated.
    in property <bool> settings-show-hemispheres: true;
    in property <bool> settings-show-channels: true;
    in property <bool> settings-show-skills: true;
    in property <bool> settings-show-plugins: true;
    in property <bool> settings-show-memory: true;
    in property <bool> settings-show-cluster: true;
    in property <bool> settings-show-code-sessions: true;
    in-out property <bool> enable-telegram: false;
    /// SPEC `cluster_auto_discovery` Q4: operator's choice on the
    /// cluster step. True = disable mDNS announce on this device.
    /// Default false (announce enabled per Design B + the noob-
    /// wizard hard rule "default ON in shipped release").
    in-out property <bool> cluster-discovery-disabled: false;
    in-out property <string> provider-key: "";
    in-out property <string> telegram-token: "";
    /// Reviewer-3 P1-B (2026-05-20): channel-screen disclosure toggle.
    /// Disabled-channel sections ("SET UP LATER", "ON THE ROADMAP")
    /// stay hidden behind this until the operator expands — DAUs
    /// finish channels in 5 seconds, pros click once to see the road-
    /// map.
    in-out property <bool> show-future-channels: false;
    /// Reviewer-3 P1-B (2026-05-20): identity-format guard. Rust
    /// computes `^[a-z0-9-]{3,32}$` against `operator-id` and pushes
    /// the verdict back here. Continue gate consults this instead of
    /// the naive `!= ""` check so the copy + the gate finally agree.
    in property <bool> operator-id-valid: false;
    in-out property <string> status-line: "";
    in property <string> hardware-summary: "";
    // QM-9 Phase 2: last 24h usage rollup rendered for the dashboard.
    // Format: "<calls> calls (ok=<x>, err=<y>), <cost> (<pct>% of cap)"
    // — populated by a subprocess probe to `neoth usage --format json`.
    in property <string> usage-summary: "Loading usage…";
    // QM-8 Phase 2: saved preset list + active marker.
    // Populated by a subprocess probe to `neoth preset list`.
    in property <string> preset-summary: "Loading presets…";
    // SPEC-05: structured preset list for the click-to-activate selector,
    // from `neoth preset list --json`.
    in property <[PresetRow]> preset-list: [];
    // SPEC-05 step5c: behavioural-profile presets (LOWKEY/Formal/…) from
    // `neoth profile preset list --json` — the operator's interaction register.
    in property <[ProfilePresetRow]> profile-preset-list: [];

    // Pick #28 (12/10 polish): derive the step counter + label from
    // the active `WizardStep` so the top ProgressIndicator always
    // matches the rendered screen. Keys-step is conditional — when
    // `need-keys-step` is false the operator skips from channels
    // straight to done, so we collapse the displayed count to 7.
    /// G-13 fix: total-steps is constant 9 (welcome..summary).
    /// Cluster step inserted at slot 7 per Q4 ratification.
    /// Previously 8 — bumped after the cluster step landed.
    /// the keys screen is shown. Previously the denominator would
    /// flip from "Step 6 of 8" to "Step 7 of 7" mid-flow when the
    /// operator picked claude_cli + no channels — visibly confusing.
    /// When keys is skipped, current-step jumps from 6 (Channels) to
    /// 8 (Summary), which the bar fills smoothly.
    out property <int> total-steps: 9;
    out property <int> current-step:
        root.step == WizardStep.welcome  ? 1 :
        root.step == WizardStep.license  ? 2 :
        root.step == WizardStep.identity ? 3 :
        root.step == WizardStep.provider ? 4 :
        root.step == WizardStep.autonomy ? 5 :
        root.step == WizardStep.channels ? 6 :
        root.step == WizardStep.cluster  ? 7 :
        root.step == WizardStep.keys     ? 8 :
        root.step == WizardStep.done     ? 9 :
        0;
    // G-23 fix: removed dead `mode-selection` branch — the progress
    // indicator is hidden on that screen so the label is never read.
    out property <string> step-label:
        root.step == WizardStep.welcome  ? "Welcome" :
        root.step == WizardStep.license  ? "License" :
        root.step == WizardStep.identity ? "Identity" :
        root.step == WizardStep.provider ? "Provider" :
        root.step == WizardStep.autonomy ? "Autonomy" :
        root.step == WizardStep.channels ? "Channels" :
        root.step == WizardStep.cluster  ? "Cluster" :
        root.step == WizardStep.keys     ? "API Keys" :
                                            "Summary";
    /// `true` only when the persistent ProgressIndicator should
    /// render the step counter + bar. Mode-selection + Settings are
    /// stand-alone screens — operator isn't in the numbered flow,
    /// so showing "Step 0 of 8" reads broken.
    out property <bool> show-progress:
        root.step != WizardStep.mode-selection
        && root.step != WizardStep.settings
        && root.step != WizardStep.chat;

    callback finish-clicked;
    callback cancel-clicked;
    /// Operator picked CLI on the mode screen. Rust side prints
    /// `neoth init` instructions + exits the GUI.
    callback cli-mode-chosen;
    /// Reviewer-3 P1-B (2026-05-20): operator typed in the Identity
    /// LineEdit. Rust validates against `^[a-z0-9-]{3,32}$` and
    /// pushes the verdict back via `operator-id-valid`. Slint has no
    /// regex; the round-trip is the simplest accurate path.
    callback operator-id-edited(string);
    /// G-2 fix — operator clicked "View full text →" on the License
    /// screen. Rust side opens the project licence URL in the system
    /// default browser via `start` (Windows) / `open` (macOS) /
    /// `xdg-open` (Linux).
    callback open-license-url;
    /// Settings panel triggered the hot-reload sentinel write
    /// (`/reload` mirror). Rust drops the file under ~/.neoth/.
    callback settings-reload-clicked;
    /// Settings panel triggered "Re-run wizard". Rust resets the
    /// state back to `mode-selection` so the operator walks the
    /// flow fresh.
    callback settings-wizard-rerun-clicked;
    // SPEC-06 — forwarded from the Hemispheres rebind control; Rust shells
    // `neoth hemispheres set --role <r> --provider <p>` + refreshes the panel.
    callback hemisphere-set(string, string, string);
    callback hemisphere-provider-picked(string);
    // PF-01-GUI — forwarded from the Skills auto-route toggle; Rust writes
    // `skills.always_embed_route` into freedom.yaml + drops the reload sentinel.
    callback skills-always-embed-route-set(bool);
    /// G-12 fix — operator picked a different provider in Settings
    /// → Config. Rust persists the change.
    callback provider-changed(string);

    /// Bite #5 — cluster auto-discovery state surfaced in
    /// Settings → Cluster. Rust populates these on window
    /// startup from freedom.yaml; toggle fires the callback
    /// which mutates freedom.yaml + drops the reload sentinel.
    in-out property <bool> cluster-mdns-enabled: true;
    in-out property <int> cluster-listen-port: 49737;
    in-out property <string> cluster-trusted-ssids-summary: "";
    callback cluster-mdns-enabled-changed(bool);
    // GOLD-FEAT-01c — full-auto (sudomode) toggle, forwarded to SettingsView.
    in-out property <bool> full-auto-active: false;
    callback full-auto-confirmed();
    callback full-auto-gated();
    // GOLD-PROG-08 — live token budget, forwarded to SettingsView.
    in property <bool> usage-available: false;
    in property <string> usage-responses: "";
    in property <string> usage-tokens: "";
    in property <string> usage-note: "";

    // ── Reactive Buddy companion (NEOTH Design System) ────────────────
    // The living neural-core orb, docked bottom-right, that reflects what
    // NEOTH is doing right now. Rust drives `buddy-mood` from daemon activity
    // (idle / thinking / working / memory / audit / alert / success …) and
    // `buddy-caption` is the short status word under the orb. Defaults keep
    // the orb gently breathing ("idle") until the daemon reports a state.
    in property <string> buddy-mood: "idle";
    in property <string> buddy-caption: "ready";
    in property <bool> buddy-visible: true;
    callback buddy-clicked();

    // ── App-shell navigation (design-system desktop layout) ───────────
    // The persistent sidebar's active tab. "chat" shows the ChatView; the
    // settings-family tabs (memory/hemispheres/channels/coding/privacy/
    // plugins/cluster/config) drive SettingsView's subtab; agents/automation/
    // resources/doctor are the net-new mockup tabs.
    in-out property <string> nav-active: "chat";
    in-out property <int> nav-complexity: 2;     // 0 minimal · 1 standard · 2 full
    // Doctor tab — Rust runs `neoth doctor` + streams the result here.
    in property <string> doctor-output: "";
    in property <bool> doctor-running: false;
    callback doctor-run-clicked();
    // Theme toggle — the sidebar flips Theme.dark live; Rust persists the choice.
    callback theme-toggle-clicked();
    property <string> shell-title:
        root.nav-active == "chat"        ? "Chat"
        : root.nav-active == "memory"      ? "Memory"
        : root.nav-active == "hemispheres" ? "Hemispheres"
        : root.nav-active == "channels"    ? "Channels"
        : root.nav-active == "coding"      ? "Coding"
        : root.nav-active == "agents"      ? "Agents"
        : root.nav-active == "automation"  ? "Automation"
        : root.nav-active == "privacy"     ? "Privacy"
        : root.nav-active == "plugins"     ? "Plugins"
        : root.nav-active == "cluster"     ? "Private Mesh"
        : root.nav-active == "resources"   ? "Resources"
        : root.nav-active == "doctor"      ? "Doctor"
        : "Config";

    /// QM-8 Phase 2.5 — operator clicked "Apply Active" on the
    /// preset tile. Rust shells `neothd preset apply <active>`
    /// + refreshes the summary. The string carries the operator
    /// hint string for logging — the active preset is resolved
    /// Rust-side from a fresh `neoth preset list` probe.
    callback preset-apply-clicked();
    /// SPEC-05 — operator clicked a preset row in the selector. Rust shells
    /// `neoth preset activate <name>` (sets the active marker) + refreshes the
    /// list. `apply-active` then merges the active preset into freedom.yaml.
    callback preset-activate-clicked(string);
    // SPEC-05 step5c: operator picked a behavioural profile — Rust runs
    // `neoth profile preset apply <name>` + refreshes the list.
    callback profile-preset-apply-clicked(string);

    // ── Chat surface state (Pick #33) ─────────────────────────────────
    /// Scrollback feed. Rust pushes ChatMessage rows as the daemon
    /// emits PROVIDER_RESPONSE / CHANNEL_INGRESS frames. The
    /// streaming-bubble pattern flips `streaming: true` on the
    /// last entry while chunks arrive, then `false` when the
    /// completion settles.
    in property <[ChatMessage]> chat-messages: [];
    in-out property <string> chat-composer-draft: "";
    in property <bool> chat-send-enabled: true;
    /// Channel labels for the chat sidebar. CLI is always first
    /// + always available; the rest reflect the operator's
    /// configured channels from freedom.yaml.
    in property <[string]> chat-channels: ["CLI", "Telegram", "WhatsApp"];
    in-out property <int> chat-active-channel: 0;
    in property <[int]> chat-unread-counts: [0, 0, 0];
    /// Rust sets this from the composer-draft via a text-edited
    /// callback (Slint can't run `starts-with` in expressions). When
    /// `true` the chat view renders the slash-discovery hint.
    in property <bool> chat-slash-active: false;

    /// Operator typed + sent a message. Rust dispatches through
    /// `cli::chat::run_chat_with`.
    callback chat-send-clicked(string);
    /// Operator switched channels in the sidebar.
    callback chat-channel-switched(int);

    // ── Code Sessions tab state (Pick #8 step 2) ────────────────────
    // Rust populates these from `neothd kanban list/show --output json`
    // subprocess calls. The five status buckets cover the board's
    // five columns; the feed array drives the right-rail activity log.
    in property <[KanbanTaskRow]> kanban-backlog: [];
    in property <[KanbanTaskRow]> kanban-todo: [];
    in property <[KanbanTaskRow]> kanban-in-progress: [];
    in property <[KanbanTaskRow]> kanban-review: [];
    in property <[KanbanTaskRow]> kanban-done: [];
    in property <[KanbanFeedRow]> kanban-feed: [];
    in property <string> kanban-session-summary: "";
    // GR-10 — Safety Rails (Privacy tab), forwarded to SettingsView. Rust sets
    // these on startup from `neoth security safe-mode --json`.
    in property <[SafeRailRow]> safety-rails: [];
    in property <int> rails-engaged-count: 0;
    in property <int> rails-total: 0;
    // GR-03 — Trust panel (Privacy tab), forwarded to SettingsView. Rust sets
    // these on startup from `neoth trust --output json`.
    in property <string> trust-autonomy-level: "";
    in property <string> trust-autonomy-behavior: "";
    in property <[TrustRow]> trust-privacy: [];
    in property <[TrustRow]> trust-recovery: [];
    in property <[TrustRow]> trust-ledger: [];
    // SL-03 — Local resources (Cluster tab), forwarded to SettingsView. Rust
    // sets these on startup from `neoth hardware --output json`.
    in property <string> hw-cpu: "";
    in property <string> hw-memory: "";
    in property <string> hw-accelerator: "";
    in property <string> hw-vram: "";
    // GOLD-PROG-07 — VRAM used/total fraction for the live meter, forwarded to SettingsView.
    in property <float> hw-vram-fraction: 0.0;
    in property <string> hw-disk: "";
    in property <[TrustRow]> hw-models: [];
    // GOLD-PROG-05 — cluster peer topology, forwarded to SettingsView.
    in property <[ClusterPeerRow]> cluster-peers: [];
    // KF-08 — Council budget meter (Config tab), forwarded to SettingsView.
    in property <string> council-cap: "";
    in property <string> council-daily-usd: "";
    in property <string> council-depth-warning: "";
    in property <[TrustRow]> council-last-debate: [];
    // GU-01 — Hemispheres + Skills panels, forwarded to SettingsView.
    in property <[HemisphereRow]> hemisphere-bindings: [];
    in property <string> hemispheres-mode: "";
    /// GOLD-GUI-OVERHAUL — model-picker options for the rebind row, refreshed by
    /// Rust when the operator picks a provider (local GGUF refs / cloud catalog).
    in property <[string]> hemisphere-model-ids: ["(provider default)"];
    in property <[string]> provider-ids: [];
    in property <[SkillRow]> skills: [];
    in-out property <bool> skills-always-embed-route: true;
    in property <[ChannelRow]> channels: [];
    in property <[PluginRow]> plugins: [];
    in property <[MemoryRow]> memory-blocks: [];
    in property <string> memory-total: "";
    /// HO-02: Cerebellum-bound flag, forwarded to the SettingsWindow
    /// Code Sessions tab. Default true so a probe failure doesn't
    /// false-alarm with the "no Cerebellum bound" banner.
    in property <bool> cerebellum-bound: true;
    /// Step 5 (2026-05-20): selected task + detail-pane bindings.
    in-out property <string> kanban-selected-task-id: "";
    in property <string> kanban-selected-title: "";
    in property <string> kanban-selected-status: "";
    in property <string> kanban-selected-hemisphere: "";
    in property <string> kanban-selected-description: "";
    in property <[KanbanCommentRow]> kanban-selected-comments: [];
    /// Operator clicked Refresh on the Code Sessions tab. Rust
    /// re-fetches via subprocess + updates the seven properties above.
    callback kanban-refresh-clicked;
    callback channels-refresh-clicked;
    callback channel-test(string);
    callback channel-remove(string);
    callback memory-forget-preview(string);
    callback memory-forget-confirm(string);
    callback skill-toggle(string, bool);
    callback plugin-toggle(string, bool);
    callback autonomy-set(string);
    /// Step 5 (2026-05-20): operator clicked a task card.
    callback kanban-task-selected(string);
    /// Step 6 (2026-05-20): operator clicked an action button in the
    /// detail pane.
    callback kanban-task-move(string, string);
    callback kanban-task-promote(string);
    callback kanban-task-comment(string, string);
    callback kanban-task-assign(string, string);

    // True when the currently-picked provider needs an API key. Mirrors
    // the require_provider_key() logic in `providers/mod.rs`: claude_cli
    // uses OAuth, local_qwen is local, everything else is REST + bearer.
    out property <bool> provider-needs-key:
        root.provider-choice != "claude_cli"
            && root.provider-choice != "local_qwen"
            && root.provider-choice != "local_ouro";

    // Skip the keys step entirely when no secrets are needed — saves the
    // operator an empty screen when they've picked claude_cli + CLI-only.
    out property <bool> need-keys-step:
        root.provider-needs-key || root.enable-telegram;

    // ── Three-stripe layout (Pick #28 12/10 polish) ──────────────────
    // Top: persistent ProgressIndicator (brand bar + step counter + progress fill).
    // Middle: per-screen content area inside a Card surface so every screen
    //   looks coherent. Content scrolls if it overflows.
    // Bottom: thin FooterBar with the operator-readable status string
    //   (hardware summary on welcome, daemon version elsewhere).
    VerticalLayout {
        if root.show-progress: ProgressIndicator {
            current-step: root.current-step;
            total-steps: root.total-steps;
            step-label: root.step-label;
        }

    VerticalBox {
        padding: Theme.space-screen;
        spacing: Theme.space-loose;

        // ── Mode selection ─────────────────────────────────────────────
        // Operator's first decision — GUI flow or CLI flow. Two big
        // SVG-glyph cards side by side. GUI marked "recommended" for
        // noobs; CLI surface available without leaving the keyboard.
        //
        // Reviewer-3 P2 (2026-05-20): keyboard-first navigation. The
        // FocusScope catches G/C/Enter so pro operators never touch
        // the mouse. Microcopy below the cards exposes the shortcuts.
        if root.step == WizardStep.mode-selection: FocusScope {
            key-pressed(e) => {
                if (e.text == "g" || e.text == "G") {
                    root.mode-gui-chosen = true;
                    root.mode-cli-chosen = false;
                    return accept;
                }
                if (e.text == "c" || e.text == "C") {
                    root.mode-cli-chosen = true;
                    root.mode-gui-chosen = false;
                    return accept;
                }
                if (e.text == "\n") {
                    if (root.mode-cli-chosen) {
                        root.cli-mode-chosen();
                    } else if (root.mode-gui-chosen) {
                        root.step = WizardStep.welcome;
                    }
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
            spacing: Theme.space-screen;
            alignment: center;
            VerticalLayout {
                spacing: Theme.space-tight;
                Text {
                    text: "NEOTH";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-h1 * 1.6;
                    font-weight: Theme.weight-ultralight;
                    letter-spacing: Theme.letter-spacing-hero;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Choose how you want to set up.";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-body;
                    font-weight: Theme.weight-light;
                    letter-spacing: Theme.letter-spacing-tight;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: Theme.space-loose;
                alignment: center;
                ModeCard {
                    title: "Graphical setup";
                    subtitle: "Click through eight short screens. Recommended if you're new.";
                    recommended: true;
                    selected: root.mode-gui-chosen;
                    glyph: @image-url("assets/glyph_gui.svg");
                    clicked => {
                        root.mode-gui-chosen = true;
                        root.mode-cli-chosen = false;
                    }
                }
                ModeCard {
                    title: "Command-line setup";
                    subtitle: "Drop to a terminal. Runs `neoth init`. Fast if you live in tmux.";
                    recommended: false;
                    selected: root.mode-cli-chosen;
                    glyph: @image-url("assets/glyph_cli.svg");
                    clicked => {
                        root.mode-cli-chosen = true;
                        root.mode-gui-chosen = false;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                NeothButton {
                    label: "Continue →";
                    enabled: root.mode-gui-chosen || root.mode-cli-chosen;
                    clicked => {
                        if (root.mode-cli-chosen) {
                            root.cli-mode-chosen();
                        } else {
                            root.step = WizardStep.welcome;
                        }
                    }
                }
            }

            // Reviewer-3 P2 keyboard-shortcut microcopy (2026-05-20)
            Text {
                text: "Shortcuts: G — graphical · C — command-line · Enter — continue";
                font-family: Theme.font-display;
                font-size: Theme.font-size-caption;
                color: Theme.text-dim;
                horizontal-alignment: center;
            }
            }
        }

        // ── Welcome ────────────────────────────────────────────────────
        if root.step == WizardStep.welcome: SovereignFade { VerticalBox {
            spacing: Theme.space-loose;
            // Hero block — NEOTH logo at full hero scale, tagline below.
            // Only screen where the logo runs at hero size; every other
            // screen uses the small brand bar in the ProgressIndicator.
            VerticalLayout {
                spacing: Theme.space-tight;
                Text {
                    text: "NEOTH";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-h1 * 1.6;
                    font-weight: Theme.weight-ultralight;
                    letter-spacing: Theme.letter-spacing-hero;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Your buddy. Your life.";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-body;
                    font-weight: Theme.weight-light;
                    letter-spacing: Theme.letter-spacing-extra-wide;
                    color: Theme.accent-green;
                    horizontal-alignment: center;
                }
                Text {
                    text: "First-launch setup — eight steps, about three minutes.";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-body;
                    font-weight: Theme.weight-regular;
                    letter-spacing: Theme.letter-spacing-body;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            // Hardware probe card — Noble-Curve 16px radius, monospace
            // body so detected hardware lines up visually.
            Card {
                preferred-height: 180px;
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Detected hardware";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    Text {
                        text: root.hardware-summary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
            // QM-9 Phase 3 — usage rollup tile. Mirrors the hardware
            // card layout so the visual rhythm carries from
            // "what hardware do you have" → "what did you spend".
            // Populated by the probe_usage_via_subprocess worker
            // thread on window-create + every USAGE_REFRESH_INTERVAL.
            Card {
                preferred-height: 100px;
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Last 24h usage";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    Text {
                        text: root.usage-summary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
            // QM-8 Phase 2 + 2.5 — saved preset bundle tile.
            // Operator-visible list of named preset bundles + the
            // active one. The Apply button shells `neothd preset
            // apply <active>` so operators flip the active bundle
            // into freedom.yaml in one click.
            Card {
                min-height: 130px;
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Saved presets";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    // SPEC-05 — click-to-activate selector. Each row activates
                    // that preset (sets the active marker); "Apply active" then
                    // merges the active one into freedom.yaml.
                    if root.preset-list.length == 0: Text {
                        text: root.preset-summary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    for p in root.preset-list: ta := TouchArea {
                        height: 22px;
                        clicked => { root.preset-activate-clicked(p.name); }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: p.active ? "●" : "○";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: p.active ? Theme.accent-green : Theme.text-muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: p.name;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: ta.has-hover ? Theme.accent-teal : Theme.text-primary;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        NeothButton {
                            label: "Apply active";
                            primary: false;
                            clicked => { root.preset-apply-clicked(); }
                        }
                    }
                }
            }
            // SPEC-05 step5c — behavioural-profile selector: how NEOTH talks to
            // you (casual / formal / deep-dive / tutor / opsec). Click to apply.
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "RESPONSE STYLE";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    if root.profile-preset-list.length == 0: Text {
                        text: "(start the daemon to choose a response style)";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    for p in root.profile-preset-list: ta2 := TouchArea {
                        height: 38px;
                        clicked => { root.profile-preset-apply-clicked(p.name); }
                        HorizontalLayout {
                            spacing: Theme.space-base;
                            Text {
                                text: p.active ? "●" : "○";
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-caption;
                                color: p.active ? Theme.accent-green : Theme.text-muted;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: p.name + (p.recommended ? "  (recommended)" : "");
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-caption;
                                    color: ta2.has-hover ? Theme.accent-teal : Theme.text-primary;
                                }
                                Text {
                                    text: p.description;
                                    font-family: Theme.font-display;
                                    font-size: Theme.font-size-caption;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
            // G-11 fix: every wizard step from License onward has a
            // Back-button; Welcome was the only exception. Operator
            // who landed here from Mode Selection had no way back.
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Mode";
                    primary: false;
                    clicked => { root.step = WizardStep.mode-selection; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.license; }
                }
            }
        } }  // close Welcome VerticalBox + SovereignFade

        // ── License ────────────────────────────────────────────────────
        // G-2 fix: real plain-language summary instead of a single
        // throw-away sentence + dead air. Three bullets cover the
        // MIT/Apache-2.0 promise, the no-warranty disclaimer, and the
        // operator's freedom to use/modify/share. "View full text →"
        // opens the canonical licence text in the system browser.
        if root.step == WizardStep.license: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "License";
                subtitle: "NEOTH is yours to use, modify, and share — under the MIT or Apache 2.0 license, your choice. Tick the box below to confirm you understand the basics.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;

                    Text {
                        text: "✓  Free to use — commercial or personal, no fee, no telemetry.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "✓  Free to modify — fork it, patch it, build on it. Keep the copyright notice.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "✓  Free to share — redistribute under the same license.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "⚠  No warranty — NEOTH is provided as-is. You run it at your own risk.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: Theme.space-base;
                        alignment: start;
                        NeothButton {
                            label: "View full text →";
                            primary: false;
                            clicked => { root.open-license-url(); }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-subtle;
                    }

                    CheckBox {
                        text: "I have read the points above and accept the licence terms.";
                        checked <=> root.license-accepted;
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.welcome; }
                }
                NeothButton {
                    label: "Continue →";
                    enabled: root.license-accepted;
                    clicked => { root.step = WizardStep.identity; }
                }
            }
        }

        // ── Identity ───────────────────────────────────────────────────
        if root.step == WizardStep.identity: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Identity";
                subtitle: "Pick a short handle NEOTH uses to address you. Lowercase letters, digits, and dashes only — three to thirty-two characters. This name shows up in chat logs and on archived sessions.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Operator id";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    // G-1 fix: placeholder must look obviously instructional
                    // so a noob does not mistake it for a pre-filled value.
                    // "your-handle" reads as a hint; a real name reads as data.
                    // G-15 + Reviewer-3 P1-B (2026-05-20): Enter advances
                    // only on valid identity. Edited callback round-trips
                    // to Rust for regex validation (Slint has no regex).
                    LineEdit {
                        placeholder-text: "your-handle";
                        text <=> root.operator-id;
                        edited(t) => { root.operator-id-edited(t); }
                        accepted(t) => {
                            if (root.operator-id-valid) { root.step = WizardStep.provider; }
                        }
                    }
                    if !root.operator-id-valid && root.operator-id == "": Text {
                        text: "Required — pick a short name like 'sam' or 'jamie'.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.accent-pink;
                    }
                    if !root.operator-id-valid && root.operator-id != "": Text {
                        text: "Use 3 to 32 characters: lowercase a-z, digits, dashes.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.accent-pink;
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.license; }
                }
                NeothButton {
                    label: "Continue →";
                    enabled: root.operator-id-valid;
                    clicked => { root.step = WizardStep.provider; }
                }
            }
        }

        // ── Provider ───────────────────────────────────────────────────
        if root.step == WizardStep.provider: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Provider";
                subtitle: "Which LLM runs NEOTH's chat. Local Qwen runs offline on your hardware (~3 GB cached). Cloud providers need a key on the next-but-one screen.";
            }
            // List MUST stay in sync with `cli::init::ProviderKind` so a
            // GUI-written `freedom.yaml` always loads cleanly in the
            // daemon. `anthropic_api` was removed because the daemon
            // enum has no matching variant — operators who want
            // Anthropic-direct use `claude_cli` (OAuth) or
            // `openai_compat` against the Anthropic-compatible endpoint.
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-tight;
                    Text {
                        text: "Backend";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-medium;
                        letter-spacing: Theme.letter-spacing-tight;
                        color: Theme.accent-green;
                    }
                    // G-3 fix: NeothComboBox replaces std-widgets'
                    // light-mode ComboBox. Maps current-index back to
                    // the bare provider token expected by freedom.yaml.
                    NeothComboBox {
                        model: [
                            "claude_cli",
                            "openai_api",
                            "openai_compat",
                            "gemini_api",
                            "local_qwen",
                            "local_ouro",
                            "hermes",
                            "openclaw",
                        ];
                        current-index: 0;
                        selected(i) => {
                            if (i == 0) { root.provider-choice = "claude_cli"; }
                            if (i == 1) { root.provider-choice = "openai_api"; }
                            if (i == 2) { root.provider-choice = "openai_compat"; }
                            if (i == 3) { root.provider-choice = "gemini_api"; }
                            if (i == 4) { root.provider-choice = "local_qwen"; }
                            if (i == 5) { root.provider-choice = "local_ouro"; }
                            if (i == 6) { root.provider-choice = "hermes"; }
                            if (i == 7) { root.provider-choice = "openclaw"; }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.identity; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.autonomy; }
                }
            }
        }

        // ── Autonomy ───────────────────────────────────────────────────
        // G-7 fix: replace the lonely "Picked: X" Card with an inline
        // explanatory block. G-20 fix: subtitle uses plain language
        // instead of dev jargon.
        if root.step == WizardStep.autonomy: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Autonomy";
                subtitle: "Choose how independently NEOTH acts. 'Strict' asks before every change. 'Full' trusts your policy file and never interrupts. You can change this any time from Settings → Privacy.";
            }
            // G-3 fix: NeothComboBox replaces std-widgets ComboBox.
            // The verbose labels carry a one-line description so the
            // operator picks with context. selected() maps back to the
            // bare token freedom.yaml::autonomy expects.
            // GR-12 H-2 fix: bind current-index to autonomy-choice so
            // wizard re-entry (M-1 reload from existing freedom.yaml)
            // shows the correct level visually. Pre-fix the ComboBox
            // displayed index=1 ("standard") regardless of the actual
            // stored autonomy, while the YAML write path stayed correct
            // — display lied to the operator about the active level.
            NeothComboBox {
                model: [
                    "strict — confirm every write, no shell exec",
                    "standard — writes inside ~/.neoth allowed, every exec confirms",
                    "elevated — writes anywhere, exec inside ~/.neoth allowed",
                    "full — trust policy.yaml; nothing prompts",
                    "custom — defer to per-action rules in policy.yaml",
                ];
                current-index:
                    root.autonomy-choice == "strict"   ? 0 :
                    root.autonomy-choice == "standard" ? 1 :
                    root.autonomy-choice == "elevated" ? 2 :
                    root.autonomy-choice == "full"     ? 3 :
                    root.autonomy-choice == "custom"   ? 4 :
                    1;
                selected(i) => {
                    if (i == 0) { root.autonomy-choice = "strict"; }
                    if (i == 1) { root.autonomy-choice = "standard"; }
                    if (i == 2) { root.autonomy-choice = "elevated"; }
                    if (i == 3) { root.autonomy-choice = "full"; }
                    if (i == 4) { root.autonomy-choice = "custom"; }
                }
            }
            // Inline summary — no more empty Card. Reads as a single
            // narrative line ("Picked X — Y") rather than a chrome box.
            HorizontalLayout {
                spacing: Theme.space-tight;
                alignment: start;
                Text {
                    text: "Picked:";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-caption;
                    font-weight: Theme.weight-medium;
                    letter-spacing: Theme.letter-spacing-tight;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }
                Text {
                    text: root.autonomy-choice;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-size-body;
                    color: Theme.accent-green;
                    vertical-alignment: center;
                }
                Text {
                    text:
                        root.autonomy-choice == "strict"   ? " — every write asks first; shell commands always confirm." :
                        root.autonomy-choice == "standard" ? " — writes to ~/.neoth allowed; every shell command asks." :
                        root.autonomy-choice == "elevated" ? " — writes anywhere; shell inside ~/.neoth allowed." :
                        root.autonomy-choice == "full"     ? " — trusts your policy.yaml completely; never interrupts." :
                                                              " — defers to per-action rules in policy.yaml.";
                    font-family: Theme.font-display;
                    font-size: Theme.font-size-caption;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.provider; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.channels; }
                }
            }
        }

        // ── Channels ───────────────────────────────────────────────────
        // G-4 fix: surface every channel in the shipping matrix, group
        // by status, and replace developer jargon ("adapter scaffold")
        // with operator-friendly status notes ("Operational — v0.3+",
        // "Coming next", "Research phase"). Only Telegram is tickable
        // in the wizard for v0.1 — the others land via Settings →
        // Channels once their credential flow is complete. The
        // disabled rows still show so the operator understands the
        // full roadmap.
        if root.step == WizardStep.channels: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Channels";
                subtitle: "Where NEOTH listens and replies. CLI is always on. Tick Telegram now to set it up immediately — the rest you can connect any time from Settings → Channels.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;

                    // ── Always on ────────────────────────────────────
                    Text {
                        text: "ALWAYS ON";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-bold;
                        letter-spacing: Theme.letter-spacing-wide;
                        color: Theme.text-dim;
                    }
                    CheckBox {
                        text: "CLI — neoth chat / neoth serve REPL";
                        checked: true;
                        enabled: false;
                    }

                    // ── Ready to enable now ──────────────────────────
                    Text {
                        text: "READY NOW";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        font-weight: Theme.weight-bold;
                        letter-spacing: Theme.letter-spacing-wide;
                        color: Theme.accent-green;
                    }
                    CheckBox {
                        text: "Telegram bot — long-poll, no public HTTPS needed";
                        checked <=> root.enable-telegram;
                    }

                    // Reviewer-3 P1-B disclosure (2026-05-20): the 8
                    // disabled rows below DEFAULT hidden so DAUs see
                    // a 2-row screen instead of "list of grey graves".
                    // Pro operators click once to expand the roadmap.
                    NeothButton {
                        label: root.show-future-channels
                            ? "Hide future channels ▴"
                            : "Show future channels ▾";
                        primary: false;
                        clicked => {
                            root.show-future-channels = !root.show-future-channels;
                        }
                    }

                    if root.show-future-channels: VerticalLayout {
                        spacing: Theme.space-base;

                        // ── Set up later from Settings ───────────────
                        Text {
                            text: "SET UP FROM SETTINGS → CHANNELS";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.text-dim;
                        }
                        CheckBox {
                            text: "WhatsApp — Meta Business Cloud webhook (needs public HTTPS)";
                            checked: false;
                            enabled: false;
                        }
                        CheckBox {
                            text: "Slack — Socket Mode WebSocket (no public HTTPS needed)";
                            checked: false;
                            enabled: false;
                        }
                        CheckBox {
                            text: "Discord — Gateway WebSocket (direct messages today, guilds soon)";
                            checked: false;
                            enabled: false;
                        }
                        CheckBox {
                            text: "Keet — Hyperswarm / Pears mesh (preview)";
                            checked: false;
                            enabled: false;
                        }

                        // ── On the roadmap ──────────────────────────
                        Text {
                            text: "ON THE ROADMAP";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-bold;
                            letter-spacing: Theme.letter-spacing-wide;
                            color: Theme.text-dim;
                        }
                        CheckBox {
                            text: "Signal — needs Signal Desktop running on this machine";
                            checked: false;
                            enabled: false;
                        }
                        CheckBox {
                            text: "Matrix — bring your own homeserver + access token";
                            checked: false;
                            enabled: false;
                        }
                        CheckBox {
                            text: "LINE — LINE Messaging API (bot account required)";
                            checked: false;
                            enabled: false;
                        }
                        CheckBox {
                            text: "iMessage — macOS only, Apple automation restrictions apply";
                            checked: false;
                            enabled: false;
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.autonomy; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.cluster; }
                }
            }
        }

        // ── Cluster (Q4 ratification: default ON + opt-out checkbox) ────
        // SPEC: cluster_auto_discovery_2026-05-22.md
        if root.step == WizardStep.cluster: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Network buddy discovery";
                subtitle: "Optional: let your NEOTH devices find each other on the same network and pair as a team.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    Text {
                        text: "NEOTH can automatically find your other devices on this network and connect them into one team — shared memory, shared chat, shared task board. It uses a lightweight mDNS broadcast (same technology as Airplay and Chromecast) to announce itself every 60 seconds. On a home or office LAN this is safe; on a shared or public network it reveals your instance label and public key to other devices on the subnet. If you only ever run one NEOTH instance, turn this off — you can re-enable it later with `neoth cluster enable`.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-body;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    CheckBox {
                        text: "Disable buddy discovery on this device";
                        checked <=> root.cluster-discovery-disabled;
                    }
                    Text {
                        text: "Recommended: leave unchecked if you run NEOTH on more than one device.";
                        font-family: Theme.font-display;
                        font-size: Theme.font-size-caption;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.channels; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => {
                        // Skip the keys screen when nothing needs a
                        // secret — operator goes straight to Summary.
                        if (root.need-keys-step) {
                            root.step = WizardStep.keys;
                        } else {
                            root.step = WizardStep.done;
                        }
                    }
                }
            }
        }

        // ── Keys ───────────────────────────────────────────────────────
        if root.step == WizardStep.keys: VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "API keys & tokens";
                subtitle: "Stored in ~/.neoth/credentials.yaml at mode 0600. Leave blank to skip — add later via `neoth init --force`.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    if root.provider-needs-key: VerticalLayout {
                        spacing: Theme.space-tight;
                        Text {
                            text: "Provider key — " + root.provider-choice;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        LineEdit {
                            placeholder-text: "sk-... / API key";
                            input-type: password;
                            text <=> root.provider-key;
                        }
                    }
                    if root.enable-telegram: VerticalLayout {
                        spacing: Theme.space-tight;
                        Text {
                            text: "Telegram bot token — from @BotFather";
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                        }
                        LineEdit {
                            placeholder-text: "123456789:ABC-…";
                            input-type: password;
                            text <=> root.telegram-token;
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => { root.step = WizardStep.cluster; }
                }
                NeothButton {
                    label: "Continue →";
                    clicked => { root.step = WizardStep.done; }
                }
            }
        }

        // ── Done ───────────────────────────────────────────────────────
        if root.step == WizardStep.done: SovereignFade { VerticalLayout {
            spacing: Theme.space-loose;
            ScreenHeader {
                title: "Ready to go";
                subtitle: "Review your configuration. Finish writes ~/.neoth/freedom.yaml and (when set) ~/.neoth/credentials.yaml at mode 0600.";
            }
            Card {
                VerticalBox {
                    padding: Theme.space-base;
                    spacing: Theme.space-base;
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "Operator";
                            width: 100px;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.operator-id;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "Provider";
                            width: 100px;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.provider-choice;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "Autonomy";
                            width: 100px;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.autonomy-choice;
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "Channels";
                            width: 100px;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "cli" + (root.enable-telegram ? ", telegram" : "");
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-base;
                        Text {
                            text: "License";
                            width: 100px;
                            font-family: Theme.font-display;
                            font-size: Theme.font-size-caption;
                            font-weight: Theme.weight-medium;
                            letter-spacing: Theme.letter-spacing-tight;
                            color: Theme.accent-green;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.license-accepted ? "accepted" : "NOT accepted";
                            font-family: Theme.font-mono;
                            font-size: Theme.font-size-body;
                            color: root.license-accepted ? Theme.text-primary : Theme.accent-pink;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if root.status-line != "": Text {
                text: root.status-line;
                font-family: Theme.font-display;
                font-size: Theme.font-size-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            // G-19 fix: three-button row clipped on narrow windows.
            // Primary actions (Back / Finish) stay in the bottom row;
            // re-entry shortcut "Open Settings →" gets its own line
            // above so its label cannot collide with Finish.
            HorizontalLayout {
                alignment: center;
                NeothButton {
                    label: "Open Settings →";
                    primary: false;
                    clicked => { root.step = WizardStep.settings; }
                }
            }
            HorizontalLayout {
                alignment: space-between;
                NeothButton {
                    label: "← Back";
                    primary: false;
                    clicked => {
                        if (root.need-keys-step) {
                            root.step = WizardStep.keys;
                        } else {
                            root.step = WizardStep.channels;
                        }
                    }
                }
                NeothButton {
                    label: "Finish";
                    enabled: root.license-accepted;
                    clicked => {
                        root.finish-clicked();
                        // Pick #33 — after writing freedom.yaml the
                        // operator lands in the Chat surface (primary
                        // daily view). Settings is one tap away via
                        // the ⚙ icon in the chat sidebar.
                        root.step = WizardStep.chat;
                    }
                }
            }
        } }  // close Done VerticalLayout + SovereignFade

        // ── Settings (Pick #32) ───────────────────────────────────────
        // ══ APP SHELL — persistent sidebar + topbar + content + status ══
        // The design-system desktop layout. Shown for the main experience
        // (chat + settings-family + the net-new mockup tabs); the wizard steps
        // above keep their own full-screen flow for first-run.
        if (root.step == WizardStep.chat || root.step == WizardStep.settings): HorizontalLayout {
            Sidebar {
                active-tab: root.nav-active;
                complexity: root.nav-complexity;
                channels-count: root.chat-channels.length;
                operator-name: root.operator-id != "" ? root.operator-id : "operator";
                nav(t) => {
                    root.nav-active = t;
                    root.step = (t == "chat") ? WizardStep.chat : WizardStep.settings;
                }
                set-complexity(l) => { root.nav-complexity = l; }
                toggle-theme => { root.theme-toggle-clicked(); }
            }
            VerticalLayout {
                TopBar { kicker: "NEOTH · SOVEREIGN"; title: root.shell-title; }

                SettingsView {
                    visible: root.nav-active != "chat"
                        && root.nav-active != "agents" && root.nav-active != "automation"
                        && root.nav-active != "resources" && root.nav-active != "doctor";
                    active: root.nav-active == "memory" ? SettingsTab.memory
                        : root.nav-active == "hemispheres" ? SettingsTab.hemispheres
                        : root.nav-active == "channels" ? SettingsTab.channels
                        : root.nav-active == "coding" ? SettingsTab.code-sessions
                        : root.nav-active == "privacy" ? SettingsTab.privacy
                        : root.nav-active == "plugins" ? SettingsTab.plugins
                        : root.nav-active == "cluster" ? SettingsTab.cluster
                        : SettingsTab.config;
                    autonomy-current: root.autonomy-choice;
            provider-current: root.provider-choice;
            provider-current-index: root.provider-choice-index;
            // GU-03 panel-visibility flows MainWindow → SettingsView.
            show-hemispheres: root.settings-show-hemispheres;
            show-channels: root.settings-show-channels;
            show-skills: root.settings-show-skills;
            show-plugins: root.settings-show-plugins;
            show-memory: root.settings-show-memory;
            show-cluster: root.settings-show-cluster;
            show-code-sessions: root.settings-show-code-sessions;
            kanban-backlog: root.kanban-backlog;
            kanban-todo: root.kanban-todo;
            kanban-in-progress: root.kanban-in-progress;
            kanban-review: root.kanban-review;
            kanban-done: root.kanban-done;
            kanban-feed: root.kanban-feed;
            kanban-session-summary: root.kanban-session-summary;
            cerebellum-bound: root.cerebellum-bound;
            safety-rails: root.safety-rails;
            rails-engaged-count: root.rails-engaged-count;
            rails-total: root.rails-total;
            trust-autonomy-level: root.trust-autonomy-level;
            trust-autonomy-behavior: root.trust-autonomy-behavior;
            trust-privacy: root.trust-privacy;
            trust-recovery: root.trust-recovery;
            trust-ledger: root.trust-ledger;
            hw-cpu: root.hw-cpu;
            hw-memory: root.hw-memory;
            hw-accelerator: root.hw-accelerator;
            hw-vram: root.hw-vram;
            hw-vram-fraction: root.hw-vram-fraction;
            hw-disk: root.hw-disk;
            hw-models: root.hw-models;
            cluster-peers: root.cluster-peers;
            council-cap: root.council-cap;
            council-daily-usd: root.council-daily-usd;
            council-depth-warning: root.council-depth-warning;
            council-last-debate: root.council-last-debate;
            hemisphere-bindings: root.hemisphere-bindings;
            hemispheres-mode: root.hemispheres-mode;
            hemisphere-model-ids: root.hemisphere-model-ids;
            provider-ids: root.provider-ids;
            skills: root.skills;
            skills-always-embed-route: root.skills-always-embed-route;
            skills-always-embed-route-changed(v) => { root.skills-always-embed-route-set(v); }
            skill-toggle-clicked(id, en) => { root.skill-toggle(id, en); }
            plugin-toggle-clicked(id, en) => { root.plugin-toggle(id, en); }
            autonomy-set-clicked(level) => { root.autonomy-set(level); }
            channels: root.channels;
            plugins: root.plugins;
            memory-blocks: root.memory-blocks;
            memory-total: root.memory-total;
            wizard-rerun-clicked => {
                root.settings-wizard-rerun-clicked();
            }
            open-chat-clicked => {
                root.step = WizardStep.chat;
            }
            hemisphere-set-clicked(role, provider, model) => {
                root.hemisphere-set(role, provider, model);
            }
            hemisphere-provider-picked(provider) => {
                root.hemisphere-provider-picked(provider);
            }
            reload-config-clicked => {
                root.settings-reload-clicked();
            }
            kanban-refresh-clicked => {
                root.kanban-refresh-clicked();
            }
            channels-refresh-clicked => {
                root.channels-refresh-clicked();
            }
            channel-test-clicked(name) => { root.channel-test(name); }
            channel-remove-clicked(name) => { root.channel-remove(name); }
            memory-forget-preview-clicked(t) => { root.memory-forget-preview(t); }
            memory-forget-confirm-clicked(t) => { root.memory-forget-confirm(t); }
            // Step 5 (2026-05-20): selected-task + detail-pane wiring.
            kanban-selected-task-id <=> root.kanban-selected-task-id;
            kanban-selected-title: root.kanban-selected-title;
            kanban-selected-status: root.kanban-selected-status;
            kanban-selected-hemisphere: root.kanban-selected-hemisphere;
            kanban-selected-description: root.kanban-selected-description;
            kanban-selected-comments: root.kanban-selected-comments;
            kanban-task-selected(id) => { root.kanban-task-selected(id); }
            kanban-task-move(id, status) => { root.kanban-task-move(id, status); }
            kanban-task-promote(id) => { root.kanban-task-promote(id); }
            kanban-task-comment(id, body) => { root.kanban-task-comment(id, body); }
            kanban-task-assign(id, hemi) => { root.kanban-task-assign(id, hemi); }
            // G-12 fix: provider change in Settings → Config flows
            // up to MainWindow where Rust persists it.
            provider-changed(name) => {
                root.provider-choice = name;
                root.provider-changed(name);
            }
            // Bite #5: cluster auto-discovery state. Read flows
            // root → SettingsView via two-way bind (`<=>` lets the
            // checkbox toggle propagate back into root so callbacks
            // see the latest value); the changed-callback bubbles
            // up to MainWindow where Rust mutates freedom.yaml.
            cluster-mdns-enabled <=> root.cluster-mdns-enabled;
            cluster-listen-port: root.cluster-listen-port;
            cluster-trusted-ssids-summary: root.cluster-trusted-ssids-summary;
            cluster-mdns-enabled-changed(enabled) => {
                root.cluster-mdns-enabled-changed(enabled);
            }
            full-auto-active <=> root.full-auto-active;
            full-auto-confirmed => {
                root.full-auto-confirmed();
            }
            full-auto-gated => {
                root.full-auto-gated();
            }
            usage-available: root.usage-available;
            usage-responses: root.usage-responses;
            usage-tokens: root.usage-tokens;
            usage-note: root.usage-note;
            // G-5 fix: route "← Chat" back to the Chat surface so the
            // operator can leave Settings without hunting for an exit.
                    back-clicked => { root.nav-active = "chat"; root.step = WizardStep.chat; }
                }

                // Chat — primary surface, inside the shell content. Sovereign-
                // curve fade on remount (Slint `if`-remount → opacity 0→1).
                if root.nav-active == "chat": SovereignFade { ChatView {
                    messages: root.chat-messages;
                    composer-draft <=> root.chat-composer-draft;
                    send-enabled: root.chat-send-enabled;
                    slash-active: root.chat-slash-active;
                    channels: root.chat-channels;
                    active-channel-index <=> root.chat-active-channel;
                    unread-counts: root.chat-unread-counts;
                    send-clicked(text) => { root.chat-send-clicked(text); }
                    channel-switched(idx) => { root.chat-channel-switched(idx); }
                    open-settings => { root.nav-active = "config"; }
                } }  // close ChatView + SovereignFade

                // Net-new mockup tab — Resources (live hardware probe, wired).
                if root.nav-active == "resources": ResourcesView {
                    cpu: root.hw-cpu;
                    memory: root.hw-memory;
                    accelerator: root.hw-accelerator;
                    vram: root.hw-vram;
                    vram-fraction: root.hw-vram-fraction;
                    disk: root.hw-disk;
                    models-count: root.hw-models.length;
                }
                // Net-new mockup tab — Doctor (`neoth doctor`, wired).
                if root.nav-active == "doctor": DoctorView {
                    output: root.doctor-output;
                    running: root.doctor-running;
                    run-clicked => { root.doctor-run-clicked(); }
                }
                // Agents / Automation — scaffolded; data wiring lands next.
                if (root.nav-active == "agents" || root.nav-active == "automation"): Rectangle {
                    background: Theme.bg-base;
                    VerticalLayout {
                        alignment: center; spacing: 10px;
                        Text {
                            text: root.shell-title;
                            color: Theme.text-primary; font-family: Theme.font-display;
                            font-size: Theme.font-size-display-sm; horizontal-alignment: center;
                        }
                        Text {
                            text: "This surface is being wired up.";
                            color: Theme.text-tertiary; font-family: Theme.font-mono;
                            font-size: Theme.font-size-sm; horizontal-alignment: center;
                        }
                    }
                }

                StatusFooter {
                    hardware: root.hardware-summary;
                    cluster-id: root.cluster-mdns-enabled ? "nh-mesh" : "";
                    peers: root.cluster-peers.length;
                    wal-ok: true;
                    local: true;
                }
            }  // close shell content VerticalLayout
        }  // close shell HorizontalLayout
    }

        // Wizard footer — the app-shell uses its own StatusFooter, so this only
        // shows for the first-run wizard steps (avoids a double footer).
        if (root.step != WizardStep.chat && root.step != WizardStep.settings): FooterBar {
            // GUI-overhaul: the footer is the single status surface for EVERY
            // screen. status-line (set by Settings actions — skill/plugin/autonomy
            // toggles, channel tests, hemisphere rebinds, memory ops) takes
            // priority so the operator gets visible confirmation there too — it
            // was previously only rendered on the wizard's Done step, so Settings
            // actions silently gave no feedback. Falls back to the hardware probe.
            status: root.status-line != ""
                ? root.status-line
                : (root.hardware-summary != ""
                    ? root.hardware-summary
                    : "NEOTH — Your buddy. Your life.");
        }
    }

    // ── Docked Buddy overlay — floats bottom-right above all screens ───
    // Declared last so it sits on top; positioned with explicit x/y.
    if root.buddy-visible: BuddyDock {
        mood: root.buddy-mood;
        caption: root.buddy-caption;
        orb-size: 88px;
        x: root.width - self.width - 24px;
        y: root.height - self.height - 24px;
        clicked => { root.buddy-clicked(); }
    }
}
