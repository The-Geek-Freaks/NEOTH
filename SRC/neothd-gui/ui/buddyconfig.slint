// NEOTH — Buddy Configuration panel (Design Wave 5).
//
// Brain-level settings for the sovereign buddy: sovereign mode, self-activation
// skill allowlist, smart-approve, autonomy level, proactive messaging.
//
// Hard constraints observed:
//   - @children must NOT sit inside an `if` block.
//   - `visible: false` still reserves layout space — `if` used throughout.
//   - No inline hex — Theme tokens only.
//   - ScrollView needs an explicit inner height when inside a stretched layout.
//   - Structs exported here must also be re-exported from main.slint by the integrator.
//   - Led state values: "live" | "connecting" | "error" | "off" (NOT "active"/"idle").
//   - NeothButton prop is `label:`, NOT `text:`.

import { Theme } from "theme.slint";
import { Card, Led, EntranceFade, NeothButton, NeothComboBox, Kicker, InfoRow, RefreshFooter } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// ── Wire structs ──────────────────────────────────────────────────────────────

/// One skill chip in the self-activation allowlist.
export struct SelfActSkill {
    name: string,
}

/// Read-only W142 quality projection supplied by `buddy status`.
export struct BuddySelfImproveProposal {
    id: string,
    skill: string,
    summary: string,
    status: string,
    quality-state: string,
    quality-reason: string,
    quality-metric: string,
    score-delta: string,
    evaluator-source-short-id: string,
    corpus-manifest-short-sha256: string,
    regression-summary: string,
    evidence-sha256: string,
    review-ready: bool,
}

/// Selected-embedding status as observed through the Buddy command surface.
/// This remains separate from the Ollama model inventory.
export struct BuddyEmbeddingModel {
    model: string,
    artifact-state: string,
    readiness: string,
    detail: string,
    can-probe: bool,
    can-pull: bool,
    can-repair: bool,
    can-prune: bool,
}

// ── Internal micro-components ─────────────────────────────────────────────────

// Explanation text — small, muted, left-aligned.
component Note inherits Text {
    in property <string> body;
    text: root.body;
    color: Theme.text-tertiary;
    font-family: Theme.font-sans;
    font-size: Theme.font-size-xs;
    wrap: word-wrap;
}

// Horizontal card-header row: kicker + LED on right.
// The header is a plain HorizontalLayout rather than a component so that
// the outer VerticalLayout drives the height.
// --- used inline at each card site ---

// Thin divider line inside cards.
component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border-subtle;
}

// Toggle row: label left, LED + Enable/Disable buttons right.
component ToggleRow inherits Rectangle {
    in property <string>  label;
    in property <string>  led-state: "off";   // "live" | "off"
    in property <bool>    enabled-state: false;
    in property <bool>    controls-enabled: true;
    callback enable-clicked();
    callback disable-clicked();

    height: 40px;
    background: transparent;

    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        Text {
            text: root.label;
            overflow: elide;
            color: Theme.text-secondary;
            font-family: Theme.font-sans;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Led {
            state: root.led-state;
            dot-size: 7px;
        }
        NeothButton {
            label: "Enable";
            size: "sm";
            primary: !root.enabled-state;
            enabled: root.controls-enabled && !root.enabled-state;
            clicked => { root.enable-clicked(); }
        }
        NeothButton {
            label: "Disable";
            size: "sm";
            danger: root.enabled-state;
            enabled: root.controls-enabled && root.enabled-state;
            clicked => { root.disable-clicked(); }
        }
    }
}

// Skill chip pill — mono text on audit-tint background.
component SkillChip inherits Rectangle {
    in property <string> name;

    height: 24px;
    border-radius: Theme.radius-pill;
    background: Theme.audit-tint;
    border-width: 1px;
    border-color: Theme.audit;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.name;
            overflow: elide;
            color: Theme.audit;
            font-family: Theme.font-mono;
            font-size: Theme.font-size-2xs;
            vertical-alignment: center;
        }
    }
}

// ── BuddyConfigView ───────────────────────────────────────────────────────────

export component BuddyConfigView inherits Rectangle {

    // ── Data properties (set by Rust) ─────────────────────────────────────────

    /// Sovereign buddy: acts without being asked AND sends unsolicited messages.
    in property <bool>   bc-sovereign-buddy: false;

    /// Self-activation: buddy may autonomously invoke skills from the allowlist.
    in property <bool>   bc-self-activation-enabled: false;

    /// Allowlist of skill names that can be self-activated.
    in property <[SelfActSkill]> bc-self-activation-skills: [];

    /// Smart-approve: auto-approves read-only tool calls without prompting.
    in property <bool>   bc-smart-approve: false;

    /// Current autonomy level label (e.g. "standard", "elevated", "full").
    in property <string> bc-autonomy: "";

    /// Proactive messaging: buddy sends scheduled / context-triggered messages.
    in property <bool>   bc-proactive-enabled: false;

    /// Passive Buddy snapshot of the canonical self-improve quality readback.
    /// `unavailable` is explicit and never rendered as an empty success list.
    in property <string> bc-self-improve-quality-state: "";
    in property <string> bc-self-improve-quality-reason: "";
    in property <[BuddySelfImproveProposal]> bc-self-improve-proposals: [];
    in property <string> bc-self-improve-selected-id: "";

    /// Refresh timestamp — shown in footer of each card.
    in property <string> bc-refreshed-at: "";

    /// True only after the most recent CLI status probe parsed completely.
    in property <bool>   bc-status-valid: false;

    /// Explicit probe/parse error. Existing values remain the last known-good
    /// snapshot while this is non-empty; mutation controls stay disabled.
    in property <string> bc-status-error: "";

    /// Versioned membership snapshot rendered from `buddy cluster status`.
    in property <string> bc-cluster-summary: "";
    in property <string> bc-cluster-pending-id: "";
    in property <string> bc-cluster-revocable-id: "";
    in property <string> bc-cluster-revocable-state: "";
    in property <int> bc-cluster-snapshot-version: 0;
    in property <string> bc-cluster-snapshot-digest: "";
    in property <bool> bc-cluster-status-valid: false;
    in property <string> bc-cluster-status-error: "";
    in property <string> bc-cluster-revocation-request-id: "";
    in property <string> bc-cluster-revocation-state: "checking";
    in property <string> bc-cluster-revocation-detail: "Checking the authoritative durable revocation state.";
    in property <bool> bc-cluster-revocation-unresolved: true;

    /// W184 vault-mirror projection. Remote identity and raw Git diagnostics
    /// intentionally never enter the GUI model.
    in property <string> bc-vault-mirror-config: "disabled";
    in property <string> bc-vault-mirror-phase: "not_started";
    in property <string> bc-vault-mirror-repair-state: "no_action";
    in property <string> bc-vault-mirror-archive-prefix: "";
    in property <string> bc-vault-mirror-verified-at: "";
    in property <bool> bc-vault-mirror-repair-available: false;
    in property <bool> bc-vault-mirror-in-flight: false;

    /// W218 Buddy-scoped selected embedding lifecycle projection. A status
    /// sample is cache-only until an explicit Verify returns fresh readiness.
    in property <[BuddyEmbeddingModel]> bc-embedding-models: [];
    in property <bool> bc-embedding-status-valid: false;
    in property <string> bc-embedding-status-error: "";
    in property <bool> bc-embedding-in-flight: false;
    in property <string> bc-embedding-refreshed: "";
    in-out property <string> bc-embedding-current: "qwen3_q8";
    in-out property <int> bc-embedding-current-index: 0;

    // ── Callbacks (fired by UI, mapped to daemon commands by integrator) ──────

    /// Open the real TTY-only Sovereign activation ceremony.
    callback bc-sovereign-enable-cli();

    /// Disable Sovereign mode through the audited policy path.
    callback bc-sovereign-disable();

    /// Self-activation toggled.
    callback bc-selfact-toggle(bool);

    /// Smart-approve toggled.
    callback bc-smart-approve-toggle(bool);

    /// Proactive messaging toggled.
    callback bc-proactive-toggle(bool);

    /// Read-only handoff. The integrator changes only Self-improve navigation.
    callback bc-self-improve-review(string);

    /// Refresh requested.
    callback bc-refresh-clicked();
    callback bc-cluster-continue-pairing();
    callback bc-cluster-revoke(string);
    callback bc-vault-mirror-repair();
    callback bc-embedding-model-changed(string);
    callback bc-embedding-probe(string);
    callback bc-embedding-pull(string);
    callback bc-embedding-repair(string);
    callback bc-embedding-prune(string);

    // ── Layout ────────────────────────────────────────────────────────────────
    background: Theme.bg-base;

    EntranceFade {
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;

            // ── View header ──────────────────────────────────────────────────
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                height: 44px;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Buddy Configuration";
                        color: Theme.text-primary;
                        font-family: Theme.font-sans;
                        font-size: Theme.font-size-md;
                        font-weight: Theme.weight-bold;
                        letter-spacing: Theme.letter-spacing-tight;
                    }
                    Text {
                        text: "brain-level settings — distinct from the orb animation";
                        color: Theme.text-tertiary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-2xs;
                        letter-spacing: Theme.letter-spacing-wide;
                    }
                }

                // spacer
                Rectangle { horizontal-stretch: 1; }

                // Refresh button — styled inline, same pattern as overview.slint.
                NeothButton {
                    label: "Refresh";
                    size: "sm";
                    primary: false;
                    clicked => { root.bc-refresh-clicked(); }
                }
            }

            // Hairline separator
            Rectangle {
                height: 1px;
                background: Theme.border-subtle;
            }

            if root.bc-status-error != "": Card {
                shimmer: false;
                border-color: Theme.accent-pink;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    Text {
                        text: "Buddy status unavailable";
                        color: Theme.accent-pink;
                        font-family: Theme.font-sans;
                        font-size: Theme.font-size-sm;
                        font-weight: Theme.weight-bold;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                    Text {
                        text: root.bc-status-error + " Last known values are retained; changes are disabled until Refresh succeeds.";
                        color: Theme.text-secondary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-size-xs;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                }
            }

            // ── Scrollable card stack ────────────────────────────────────────
            ScrollView {

                VerticalLayout {
                    spacing: 14px;
                    alignment: start;
                    // ScrollView needs a concrete inner height; cards self-size
                    // so we give the inner layout a generous min-height.
                    min-height: 1500px;

                    // ────────────────────────────────────────────────────
                    // LOCAL EMBEDDING MODEL — Buddy command surface only
                    // ────────────────────────────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: Theme.space-4;
                            spacing: Theme.space-3;
                            alignment: start;

                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: start;
                                Kicker { label: "LOCAL EMBEDDING MODEL"; }
                                Rectangle { horizontal-stretch: 1; }
                                Led {
                                    state: root.bc-embedding-status-error != "" ? "error"
                                        : !root.bc-embedding-status-valid ? "connecting"
                                        : root.bc-embedding-in-flight ? "connecting" : "live";
                                    dot-size: 7px;
                                }
                            }

                            Note {
                                body: "Buddy uses the selected local embedding model. Qwen is selectable but has no local lifecycle controls. Verify is the only action that proves fresh adapter readiness.";
                            }

                            HorizontalLayout {
                                spacing: Theme.space-3;
                                Text {
                                    text: "Selected model";
                                    color: Theme.text-secondary;
                                    font-family: Theme.font-sans;
                                    font-size: Theme.font-size-sm;
                                    vertical-alignment: center;
                                }
                                NeothComboBox {
                                    model: ["Qwen3 Q8", "BGE-M3"];
                                    current-index <=> root.bc-embedding-current-index;
                                    enabled: root.bc-embedding-status-valid && !root.bc-embedding-in-flight;
                                    selected(index) => {
                                        root.bc-embedding-model-changed(index == 0 ? "qwen3_q8" : "bge_m3");
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: root.bc-embedding-in-flight ? "Updating…" : root.bc-embedding-refreshed;
                                    color: Theme.text-tertiary;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.font-size-2xs;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }

                            if root.bc-embedding-status-error != "": Text {
                                text: root.bc-embedding-status-error;
                                color: Theme.warning;
                                font-family: Theme.font-sans;
                                font-size: Theme.font-size-xs;
                                wrap: word-wrap;
                            }

                            if root.bc-embedding-models.length == 0: Text {
                                text: root.bc-embedding-status-valid ? "No embedding model status returned." : "Embedding-model status has not been verified.";
                                color: Theme.text-tertiary;
                                font-family: Theme.font-sans;
                                font-size: Theme.font-size-sm;
                            }

                            for row in root.bc-embedding-models: Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                VerticalLayout {
                                    padding: Theme.space-3;
                                    spacing: Theme.space-2;
                                    HorizontalLayout {
                                        spacing: Theme.space-2;
                                        Text {
                                            text: row.model == "bge_m3" ? "BGE-M3" : "Qwen3 Q8";
                                            color: Theme.text-primary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-xs;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: row.readiness;
                                            color: row.readiness == "Ready (fresh load verified)" ? Theme.accent : Theme.warning;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                        }
                                    }
                                    Text {
                                        text: row.artifact-state + (row.detail != "" ? " · " + row.detail : "");
                                        color: Theme.text-tertiary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-2;
                                        NeothButton { label: "Verify"; size: "sm"; enabled: row.can-probe && !root.bc-embedding-in-flight; clicked => { root.bc-embedding-probe(row.model); } }
                                        NeothButton { label: "Pull"; size: "sm"; enabled: row.can-pull && !root.bc-embedding-in-flight; clicked => { root.bc-embedding-pull(row.model); } }
                                        NeothButton { label: "Repair"; size: "sm"; enabled: row.can-repair && !root.bc-embedding-in-flight; clicked => { root.bc-embedding-repair(row.model); } }
                                        NeothButton { label: "Prune"; size: "sm"; danger: true; enabled: row.can-prune && !root.bc-embedding-in-flight; clicked => { root.bc-embedding-prune(row.model); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }
                    }

                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "VAULT MIRROR"; }
                                Rectangle { horizontal-stretch: 1; }
                                Led {
                                    state: root.bc-vault-mirror-in-flight ? "connecting"
                                        : root.bc-vault-mirror-phase == "verified" ? "live"
                                        : root.bc-vault-mirror-config == "disabled" ? "off"
                                        : root.bc-vault-mirror-repair-available ? "error" : "connecting";
                                    dot-size: 7px;
                                }
                            }

                            Note {
                                body: "Nightly archive mirroring is configured in automation settings. This panel shows the latest durable receipt and can only reconcile an indeterminate push; it cannot start a mirror push.";
                            }

                            Divider {}

                            InfoRow { label: "CONFIG"; value: root.bc-vault-mirror-config; value-color: root.bc-vault-mirror-config == "ready" ? Theme.accent : Theme.text-tertiary; }
                            InfoRow { label: "PHASE"; value: root.bc-vault-mirror-phase; value-color: root.bc-vault-mirror-phase == "verified" ? Theme.memory : root.bc-vault-mirror-repair-available ? Theme.consent : Theme.warning; }
                            InfoRow { label: "REPAIR"; value: root.bc-vault-mirror-repair-state; value-color: root.bc-vault-mirror-repair-available ? Theme.warning : Theme.text-tertiary; }
                            if root.bc-vault-mirror-verified-at != "": InfoRow { label: "LAST VERIFIED"; value: root.bc-vault-mirror-verified-at; value-color: Theme.audit; }
                            if root.bc-vault-mirror-archive-prefix != "": InfoRow { label: "ARCHIVE SHA-256"; value: root.bc-vault-mirror-archive-prefix; value-color: Theme.audit; }

                            HorizontalLayout {
                                Rectangle { horizontal-stretch: 1; }
                                NeothButton {
                                    label: root.bc-vault-mirror-in-flight ? "Repairing…" : "Repair";
                                    size: "sm";
                                    primary: root.bc-vault-mirror-repair-available;
                                    loading: root.bc-vault-mirror-in-flight;
                                    enabled: root.bc-status-valid && root.bc-vault-mirror-repair-available && !root.bc-vault-mirror-in-flight;
                                    clicked => { root.bc-vault-mirror-repair(); }
                                }
                            }

                            RefreshFooter { ts: root.bc-refreshed-at; }
                        }
                    }

                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "CLUSTER MEMBERSHIP"; }
                                Rectangle { horizontal-stretch: 1; }
                                Led {
                                    state: root.bc-cluster-status-error != "" ? "error"
                                        : !root.bc-cluster-status-valid ? "connecting"
                                        : "live";
                                    dot-size: 7px;
                                }
                            }

                            Text {
                                text: root.bc-cluster-summary == ""
                                    ? "No membership snapshot loaded."
                                    : root.bc-cluster-summary;
                                color: Theme.text-secondary;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-xs;
                                wrap: word-wrap;
                            }

                            if root.bc-cluster-status-error != "": Text {
                                text: root.bc-cluster-status-error + " Last known membership state is retained.";
                                color: Theme.accent-pink;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-xs;
                                wrap: word-wrap;
                            }

                            Note {
                                body: "Discovery shows authenticated candidates only. Activation requires a signed, carrier-bound, one-time authority invite and exact EndpointAttestation confirmation; no direct-add shortcut exists.";
                            }

                            if root.bc-cluster-revocable-id != "": Text {
                                text: "Selected " + root.bc-cluster-revocable-state + " node: "
                                    + root.bc-cluster-revocable-id;
                                color: Theme.text-tertiary;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-2xs;
                                overflow: elide;
                            }

                            if root.bc-cluster-snapshot-digest != "": Text {
                                text: "Snapshot v\{root.bc-cluster-snapshot-version} · "
                                    + root.bc-cluster-snapshot-digest;
                                color: Theme.text-disabled;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-2xs;
                                overflow: elide;
                            }

                            Text {
                                text: "Revocation is permanent for the current authorization incarnation, closes live carrier sessions, and advances the membership fence.";
                                color: Theme.consent;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-xs;
                                wrap: word-wrap;
                            }

                            if root.bc-cluster-revocation-state != "": Rectangle {
                                min-height: 76px;
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: root.bc-cluster-revocation-unresolved
                                    ? Theme.accent-pink : Theme.border-subtle;
                                background: root.bc-cluster-revocation-unresolved
                                    ? Theme.consent-tint : Theme.surface-2;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    Text {
                                        text: "REVOCATION · " + root.bc-cluster-revocation-state;
                                        color: root.bc-cluster-revocation-unresolved
                                            ? Theme.accent-pink : Theme.text-secondary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        font-weight: Theme.weight-bold;
                                    }
                                    Text {
                                        text: root.bc-cluster-revocation-request-id;
                                        color: Theme.text-tertiary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-2xs;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.bc-cluster-revocation-detail;
                                        color: Theme.text-secondary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                NeothButton {
                                    label: "Continue pairing";
                                    size: "sm";
                                    enabled: root.bc-cluster-status-valid
                                        && !root.bc-cluster-revocation-unresolved
                                        && root.bc-cluster-pending-id != "";
                                    clicked => { root.bc-cluster-continue-pairing(); }
                                }
                                NeothButton {
                                    label: "Revoke membership";
                                    size: "sm";
                                    danger: true;
                                    enabled: root.bc-cluster-status-valid
                                        && !root.bc-cluster-revocation-unresolved
                                        && root.bc-cluster-revocable-id != ""
                                        && root.bc-cluster-snapshot-version > 0
                                        && root.bc-cluster-snapshot-digest != "";
                                    clicked => {
                                        root.bc-cluster-revoke(root.bc-cluster-revocable-id);
                                    }
                                }
                            }
                        }
                    }

                    // ────────────────────────────────────────────────────────
                    // SELF-IMPROVE QUALITY — passive readback, no lifecycle control
                    // ────────────────────────────────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: Theme.space-4;
                            spacing: Theme.space-3;
                            alignment: start;

                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "SELF-IMPROVE QUALITY"; }
                                Rectangle { horizontal-stretch: 1; }
                                Led {
                                    state: root.bc-self-improve-quality-state == "available" ? "live"
                                        : root.bc-self-improve-quality-state == "unavailable" ? "error"
                                        : "connecting";
                                    dot-size: 7px;
                                }
                            }

                            Text {
                                text: "Passive quality evidence readback. Review opens Self-improve; it does not evaluate, execute, or accept a proposal.";
                                color: Theme.text-tertiary;
                                font-family: Theme.font-sans;
                                font-size: Theme.font-size-xs;
                                wrap: word-wrap;
                            }

                            if root.bc-self-improve-quality-state == "unavailable": Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.consent-tint;
                                border-width: 1px;
                                border-color: Theme.consent;
                                VerticalLayout {
                                    padding: Theme.space-3;
                                    spacing: Theme.space-1;
                                    Text {
                                        text: "Self-improve quality is unavailable";
                                        color: Theme.consent;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-xs;
                                    }
                                    Text {
                                        text: root.bc-self-improve-quality-reason;
                                        color: Theme.text-secondary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.bc-self-improve-quality-state == "": Text {
                                text: "Quality snapshot has not been refreshed.";
                                color: Theme.text-tertiary;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-xs;
                            }

                            if root.bc-self-improve-quality-state != ""
                                && root.bc-self-improve-quality-state != "available"
                                && root.bc-self-improve-quality-state != "unavailable": Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.warning-tint;
                                border-width: 1px;
                                border-color: Theme.warning;
                                VerticalLayout {
                                    padding: Theme.space-3;
                                    spacing: Theme.space-1;
                                    Text {
                                        text: "Self-improve quality is not current";
                                        color: Theme.warning;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-xs;
                                    }
                                    Text {
                                        text: root.bc-self-improve-quality-reason != ""
                                            ? root.bc-self-improve-quality-reason
                                            : "Refresh Buddy status for a complete quality snapshot.";
                                        color: Theme.text-secondary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-xs;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if root.bc-self-improve-quality-state == "available"
                                && root.bc-self-improve-proposals.length == 0: Text {
                                text: "No self-improve proposals are currently staged.";
                                color: Theme.text-disabled;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-xs;
                            }

                            if root.bc-self-improve-quality-state == "available": VerticalLayout {
                                spacing: Theme.space-2;
                                alignment: start;
                                for proposal in root.bc-self-improve-proposals: Rectangle {
                                    min-height: 98px;
                                    border-radius: Theme.radius-md;
                                    background: proposal.id == root.bc-self-improve-selected-id
                                        ? Theme.audit-tint : Theme.surface-1;
                                    border-width: 1px;
                                    border-color: proposal.id == root.bc-self-improve-selected-id
                                        ? Theme.audit : Theme.border-subtle;
                                    VerticalLayout {
                                        padding: Theme.space-3;
                                        spacing: Theme.space-1;
                                        HorizontalLayout {
                                            spacing: Theme.space-2;
                                            Text {
                                                text: proposal.id + " · " + proposal.status;
                                                color: proposal.review-ready ? Theme.accent : Theme.warning;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.font-size-2xs;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: proposal.quality-state;
                                                color: proposal.quality-state == "current" ? Theme.accent
                                                    : proposal.quality-state == "failed" ? Theme.consent
                                                    : Theme.warning;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.font-size-2xs;
                                            }
                                        }
                                        Text {
                                            text: proposal.summary;
                                            color: Theme.text-secondary;
                                            font-family: Theme.font-sans;
                                            font-size: Theme.font-size-xs;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: proposal.quality-reason != "" ? proposal.quality-reason
                                                : proposal.quality-metric + " " + proposal.score-delta
                                                    + " · " + proposal.regression-summary;
                                            color: Theme.text-tertiary;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            overflow: elide;
                                        }
                                        if proposal.evaluator-source-short-id != "": Text {
                                            text: "Verifier " + proposal.evaluator-source-short-id
                                                + " · corpus " + proposal.corpus-manifest-short-sha256;
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            overflow: elide;
                                        }
                                        if proposal.evidence-sha256 != "": Text {
                                            text: "Evidence " + proposal.evidence-sha256;
                                            color: Theme.text-disabled;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.font-size-2xs;
                                            overflow: elide;
                                        }
                                        HorizontalLayout {
                                            Rectangle { horizontal-stretch: 1; }
                                            NeothButton {
                                                label: "Review in Self-improve";
                                                size: "sm";
                                                enabled: true;
                                                clicked => { root.bc-self-improve-review(proposal.id); }
                                            }
                                        }
                                    }
                                }
                            }

                            RefreshFooter { ts: root.bc-refreshed-at; }
                        }
                    }

                    // ────────────────────────────────────────────────────────
                    // SOVEREIGN card — pink-consent accent (highest-trust mode)
                    // ────────────────────────────────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            // Card header: kicker + consent LED
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "SOVEREIGN"; }
                                Rectangle { horizontal-stretch: 1; }
                                Led {
                                    state: root.bc-status-error != "" ? "error"
                                        : !root.bc-status-valid ? "connecting"
                                        : root.bc-sovereign-buddy ? "live" : "off";
                                    dot-size: 7px;
                                }
                            }

                            // Pink-tinted banner — only when sovereign is active,
                            // signals to the operator this is the highest-trust mode.
                            if root.bc-sovereign-buddy: Rectangle {
                                height: 34px;
                                border-radius: Theme.radius-md;
                                background: Theme.consent-tint;
                                border-width: 1px;
                                border-color: Theme.consent;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: start;
                                    spacing: 8px;
                                    Text {
                                        text: "⚠";
                                        color: Theme.consent;
                                        font-size: Theme.font-size-sm;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Sovereign mode is active — buddy may act without asking.";
                                        color: Theme.consent;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-xs;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            Note {
                                body: "Sovereign mode: buddy acts without asking AND sends unsolicited messages. Enable opens a secure terminal and still requires the exact phrase `sovereign`; Disable applies immediately through the audited policy path.";
                            }

                            Divider {}

                            // Enable / Disable buttons
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                NeothButton {
                                    label: "Enable in CLI";
                                    size: "sm";
                                    primary: !root.bc-sovereign-buddy;
                                    enabled: root.bc-status-valid && !root.bc-sovereign-buddy;
                                    clicked => { root.bc-sovereign-enable-cli(); }
                                }
                                NeothButton {
                                    label: "Disable";
                                    size: "sm";
                                    danger: root.bc-sovereign-buddy;
                                    enabled: root.bc-status-valid && root.bc-sovereign-buddy;
                                    clicked => { root.bc-sovereign-disable(); }
                                }
                            }

                            RefreshFooter { ts: root.bc-refreshed-at; }
                        }
                    }

                    // ────────────────────────────────────────────────────────
                    // SELF-ACTIVATION card
                    // ────────────────────────────────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            // Header
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "SELF-ACTIVATION"; }
                                Rectangle { horizontal-stretch: 1; }
                                Led {
                                    state: root.bc-status-error != "" ? "error"
                                        : !root.bc-status-valid ? "connecting"
                                        : root.bc-self-activation-enabled ? "live" : "off";
                                    dot-size: 7px;
                                }
                            }

                            Note {
                                body: "When enabled, the buddy may autonomously invoke any skill on the allowlist below without an explicit operator command.";
                            }

                            Divider {}

                            // Toggle controls
                            ToggleRow {
                                label: "Self-activation";
                                led-state: root.bc-status-error != "" ? "error"
                                    : !root.bc-status-valid ? "connecting"
                                    : root.bc-self-activation-enabled ? "live" : "off";
                                enabled-state: root.bc-self-activation-enabled;
                                controls-enabled: root.bc-status-valid;
                                enable-clicked => { root.bc-selfact-toggle(true); }
                                disable-clicked => { root.bc-selfact-toggle(false); }
                            }

                            // Skill allowlist chips — shown even when disabled so
                            // operator can review the list without toggling.
                            if root.bc-self-activation-skills.length > 0: VerticalLayout {
                                spacing: 6px;
                                alignment: start;

                                Kicker { label: "ALLOWED SKILLS"; }

                                // Wrap chips horizontally — Slint has no flex-wrap,
                                // so we render each chip as a full-width pill row.
                                // (A true multi-row chip grid requires width math from
                                //  Rust; for now one chip per row is the safe idiom.)
                                for skill in root.bc-self-activation-skills: SkillChip {
                                    name: skill.name;
                                }
                            }

                            if root.bc-self-activation-skills.length == 0: Text {
                                text: "No skills in allowlist — add via neoth self-activate add <skill>.";
                                color: Theme.text-disabled;
                                font-family: Theme.font-mono;
                                font-size: Theme.font-size-xs;
                            }

                            RefreshFooter { ts: root.bc-refreshed-at; }
                        }
                    }

                    // ────────────────────────────────────────────────────────
                    // SMART-APPROVE card
                    // ────────────────────────────────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "SMART-APPROVE"; }
                                Rectangle { horizontal-stretch: 1; }
                                Led {
                                    state: root.bc-status-error != "" ? "error"
                                        : !root.bc-status-valid ? "connecting"
                                        : root.bc-smart-approve ? "live" : "off";
                                    dot-size: 7px;
                                }
                            }

                            Note {
                                body: "Auto-approves read-only tool calls (file reads, searches, status queries) without prompting. Write and destructive operations are never auto-approved.";
                            }

                            Divider {}

                            ToggleRow {
                                label: "Smart-approve";
                                led-state: root.bc-status-error != "" ? "error"
                                    : !root.bc-status-valid ? "connecting"
                                    : root.bc-smart-approve ? "live" : "off";
                                enabled-state: root.bc-smart-approve;
                                controls-enabled: root.bc-status-valid;
                                enable-clicked => { root.bc-smart-approve-toggle(true); }
                                disable-clicked => { root.bc-smart-approve-toggle(false); }
                            }

                            RefreshFooter { ts: root.bc-refreshed-at; }
                        }
                    }

                    // ────────────────────────────────────────────────────────
                    // AUTONOMY card — read-only display; change in Privacy tab
                    // ────────────────────────────────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "AUTONOMY"; }
                            }

                            InfoRow {
                                label: "LEVEL";
                                value: root.bc-autonomy;
                                value-color: root.bc-autonomy == "full" ? Theme.consent
                                           : root.bc-autonomy == "elevated" ? Theme.warning
                                           : Theme.accent;
                            }

                            // Static note — no toggle here.
                            Rectangle {
                                height: 32px;
                                border-radius: Theme.radius-md;
                                background: Theme.surface-1;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: start;
                                    spacing: 6px;
                                    Text {
                                        text: "ℹ";
                                        color: Theme.audit;
                                        font-size: Theme.font-size-xs;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Change autonomy level in Privacy tab → Autonomy.";
                                        color: Theme.text-tertiary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.font-size-xs;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            RefreshFooter { ts: root.bc-refreshed-at; }
                        }
                    }

                    // ────────────────────────────────────────────────────────
                    // PROACTIVE card
                    // ────────────────────────────────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 18px;
                                Kicker { label: "PROACTIVE MESSAGING"; }
                                Rectangle { horizontal-stretch: 1; }
                                Led {
                                    state: root.bc-status-error != "" ? "error"
                                        : !root.bc-status-valid ? "connecting"
                                        : root.bc-proactive-enabled ? "live" : "off";
                                    dot-size: 7px;
                                }
                            }

                            Note {
                                body: "When enabled, the buddy sends scheduled check-ins and context-triggered messages even when not directly addressed. Requires at least Standard autonomy.";
                            }

                            Divider {}

                            ToggleRow {
                                label: "Proactive messaging";
                                led-state: root.bc-status-error != "" ? "error"
                                    : !root.bc-status-valid ? "connecting"
                                    : root.bc-proactive-enabled ? "live" : "off";
                                enabled-state: root.bc-proactive-enabled;
                                controls-enabled: root.bc-status-valid;
                                enable-clicked => { root.bc-proactive-toggle(true); }
                                disable-clicked => { root.bc-proactive-toggle(false); }
                            }

                            RefreshFooter { ts: root.bc-refreshed-at; }
                        }
                    }

                }
            }
        }
    }
}
