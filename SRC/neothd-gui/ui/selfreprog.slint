// NEOTH — Self-Dev Proposal Review panel (FEAT-05).
//
// Displays proposals from `neoth self-dev review --output json` with per-row
// Accept / Decline buttons.  Accept marks the proposal for human review — no
// source files are modified.
//
// RED-LINE copy contract (mandatory, never change):
//   "Accepting a proposal marks it for human review.
//    No source files are modified — self-editing is not enabled."
//
// Layout: EntranceFade > ScrollView > VerticalLayout{min-height} (no binding-loop).
// Follows the babel.slint / selfimprove.slint wave-4a pattern exactly.

import { Theme } from "theme.slint";
import { Card, EntranceFade, NeothButton, Kicker, RefreshFooter } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// ── Wire struct ───────────────────────────────────────────────────────────────

/// One row from `neoth self-dev review --output json`.
/// confidence is pre-formatted ("0.83").  status-badge is display-only.
/// patch-path, diff-sha256, is-source-edit — GUI-DES-SELFDEV-APPLY-01:
/// only populated for kind == "source_edit" proposals.
export struct SelfReprogProposalRow {
    id: string,
    kind: string,
    confidence: string,
    target: string,
    reason: string,
    status-badge: string,
    // SourceEdit-specific (empty for all other kinds):
    patch-path: string,
    diff-sha256: string,
    is-source-edit: bool,
}

// ── Per-row component ─────────────────────────────────────────────────────────

// One proposal row: id chip · kind chip · confidence · target · reason (wrapped)
// · Accept (consent) · Decline (ghost) · Apply to Source (SourceEdit only).
// target and reason are DISPLAY-ONLY — never forwarded to shell args.
component SelfReprogRow inherits Rectangle {
    in property <string> row-id;
    in property <string> row-kind;
    in property <string> row-confidence;
    in property <string> row-target;
    in property <string> row-reason;
    in property <string> row-status-badge;
    // GUI-DES-SELFDEV-APPLY-01 — SourceEdit fields:
    in property <bool>   row-is-source-edit: false;
    in property <string> row-patch-path: "";
    in property <string> row-diff-sha256: "";
    callback accept-clicked();
    callback decline-clicked();
    /// Fired when operator confirms "Apply to Source" for a SourceEdit proposal.
    /// args: (id, patch_path, diff_sha256) — validated + escaped in Rust before
    /// being forwarded to `run_neothd_probe(["self-edit", "--diff", ..., "--expect-hash", ...])`.
    callback apply-source-clicked(string, string, string);

    border-radius: Theme.radius-md;
    background: Theme.surface-1;
    border-width: 1px;
    border-color: Theme.border-subtle;

    // ── Confirm-apply popup ───────────────────────────────────────────────────
    // Shown when the operator clicks "Apply to Source".  Requires a second
    // explicit confirmation click before the gate subprocess fires.
    apply-confirm := PopupWindow {
        x: 0px; y: 0px;
        width: root.width;
        height: 152px;

        Rectangle {
            background: Theme.surface-1;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.accent;
            width: root.width;
            height: 152px;

            VerticalLayout {
                padding: 14px; spacing: 10px;

                Text {
                    text: "Apply diff to live source tree?";
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    font-weight: Theme.weight-semibold;
                }
                Text {
                    text: root.row-target;
                    color: Theme.text-secondary;
                    font-size: 10px;
                    overflow: elide;
                }

                HorizontalLayout {
                    alignment: end; spacing: 8px;

                    NeothButton {
                        label: "Cancel"; size: "sm"; primary: false;
                        clicked => { apply-confirm.close(); }
                    }

                    Rectangle {
                        width: 100px; height: 26px;
                        border-radius: Theme.radius-md;
                        background: Theme.consent;
                        TouchArea {
                            clicked => {
                                apply-confirm.close();
                                root.apply-source-clicked(
                                    root.row-id,
                                    root.row-patch-path,
                                    root.row-diff-sha256,
                                );
                            }
                        }
                        Text {
                            text: "Confirm Apply";
                            color: Theme.text-primary;
                            font-size: Theme.font-size-sm;
                            font-weight: Theme.weight-semibold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    VerticalLayout {
        padding: 12px; spacing: 6px;

        // ── top meta row: id · kind chip · confidence · status ───────────────
        HorizontalLayout {
            spacing: 8px;

            // id (mono)
            Text {
                text: root.row-id;
                color: Theme.text-disabled;
                font-family: Theme.font-mono;
                font-size: 9px;
                vertical-alignment: center;
                width: 120px;
                overflow: elide;
            }

            // kind chip
            Rectangle {
                width: 72px; height: 20px;
                border-radius: 4px;
                background: Theme.surface-2;
                border-width: 1px;
                border-color: Theme.border-subtle;
                Text {
                    text: root.row-kind;
                    overflow: elide;
                    color: Theme.accent;
                    font-family: Theme.font-mono;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // confidence
            Text {
                text: root.row-confidence;
                overflow: elide;
                color: Theme.text-secondary;
                font-family: Theme.font-mono;
                font-size: 10px;
                vertical-alignment: center;
                width: 36px;
            }

            // status badge
            Text {
                text: root.row-status-badge;
                color: Theme.text-secondary;
                font-family: Theme.font-mono;
                font-size: 9px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        // ── target + reason ───────────────────────────────────────────────────
        if root.row-target != "": Text {
            text: "target: " + root.row-target;
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            overflow: elide;
        }

        if root.row-reason != "": Text {
            text: root.row-reason;
            color: Theme.text-primary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }

        // ── action buttons ────────────────────────────────────────────────────
        HorizontalLayout {
            alignment: end; spacing: 8px;

            // Accept — consent-pink (operator authorization action)
            Rectangle {
                width: 72px; height: 26px;
                border-radius: Theme.radius-md;
                background: Theme.consent;
                TouchArea {
                    clicked => { root.accept-clicked(); }
                }
                Text {
                    text: "Accept";
                    color: Theme.text-primary;
                    font-size: Theme.font-size-sm;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Decline — ghost (secondary action)
            NeothButton {
                label: "Decline";
                size: "sm";
                primary: false;
                width: 72px; height: 26px;
                clicked => { root.decline-clicked(); }
            }

            // Apply to Source — only for accepted SourceEdit proposals.
            // Disabled (greyed) when status != "accepted".
            if root.row-is-source-edit: Rectangle {
                width: 100px; height: 26px;
                border-radius: Theme.radius-md;
                background: root.row-status-badge == "accepted" ? Theme.consent : Theme.surface-2;
                opacity: root.row-status-badge == "accepted" ? 1.0 : 0.38;
                border-width: 1px;
                border-color: root.row-status-badge == "accepted" ? Theme.accent : Theme.border-subtle;
                TouchArea {
                    enabled: root.row-status-badge == "accepted";
                    clicked => { apply-confirm.show(); }
                }
                Text {
                    text: "Apply to Source";
                    color: root.row-status-badge == "accepted" ? Theme.text-primary : Theme.text-disabled;
                    font-size: 9px;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// ── Public component ──────────────────────────────────────────────────────────

export component SelfReprogramView inherits Rectangle {
    // Proposals list
    in property <[SelfReprogProposalRow]> sd-proposals: [];
    in property <string>  sd-refreshed-at: "";
    in property <bool>    sd-scan-running: false;

    // Callbacks
    callback accept-clicked(string);   // proposal id — validated in Rust before any shell
    callback decline-clicked(string);  // proposal id — reason is hard-coded "declined" in Rust
    callback scan-clicked();
    callback refresh-clicked();
    /// GUI-DES-SELFDEV-APPLY-01 — fires after operator confirms the apply dialog.
    /// args: (id, patch_path, diff_sha256) forwarded to the Rust handler which
    /// invokes run_neothd_probe(["self-edit", "--diff", patch_path, "--yes",
    ///   "--expect-hash", diff_sha256]).
    callback sd-apply-source-clicked(string, string, string);

    background: transparent;

    EntranceFade {
        ScrollView {
            VerticalLayout {
                padding: 16px; spacing: 12px;
                min-height: 1000px;

                // ── HEADER ────────────────────────────────────────────────────
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 2px;
                        Text {
                            text: "⟁  Proposal Review";
                            color: Theme.text-primary;
                            font-size: Theme.font-size-lg;
                            font-weight: Theme.weight-bold;
                        }
                        Text {
                            text: "Self-development proposals pending review.";
                            color: Theme.text-secondary;
                            font-size: Theme.font-size-sm;
                        }
                    }
                    // Scan button
                    NeothButton {
                        label: root.sd-scan-running ? "Scanning…" : "Scan";
                        size: "sm";
                        primary: false;
                        clicked => { root.scan-clicked(); }
                    }
                    // Refresh button
                    NeothButton {
                        label: "Refresh";
                        size: "sm";
                        primary: false;
                        clicked => { root.refresh-clicked(); }
                    }
                }

                // ── MANDATORY RED-LINE INFO CARD ──────────────────────────────
                // Copy must never say "Applied" or "Self-Reprogramming applied".
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.surface-1;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        alignment: center;
                        Text {
                            text: "Accepting a proposal marks it for human review. No source files are modified — self-editing is not enabled.";
                            color: Theme.text-secondary;
                            font-size: 10px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }

                // ── PROPOSALS CARD ────────────────────────────────────────────
                Card {
                    VerticalLayout {
                        padding: 16px; spacing: 8px;

                        Kicker { label: "PROPOSAL REVIEW"; }

                        // Empty state
                        if root.sd-proposals.length == 0: Rectangle {
                            height: 48px;
                            Text {
                                text: "No pending proposals.";
                                color: Theme.text-disabled;
                                font-size: Theme.font-size-sm;
                                font-family: Theme.font-mono;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Proposal rows
                        for p in root.sd-proposals: SelfReprogRow {
                            row-id: p.id;
                            row-kind: p.kind;
                            row-confidence: p.confidence;
                            row-target: p.target;
                            row-reason: p.reason;
                            row-status-badge: p.status-badge;
                            // GUI-DES-SELFDEV-APPLY-01 — SourceEdit fields:
                            row-is-source-edit: p.is-source-edit;
                            row-patch-path: p.patch-path;
                            row-diff-sha256: p.diff-sha256;
                            accept-clicked       => { root.accept-clicked(p.id); }
                            decline-clicked      => { root.decline-clicked(p.id); }
                            apply-source-clicked => { root.sd-apply-source-clicked(p.id, p.patch-path, p.diff-sha256); }
                        }
                    }
                }

                RefreshFooter { ts: root.sd-refreshed-at; }
            }
        }
    }
}
