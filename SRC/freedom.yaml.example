# ─────────────────────────────────────────────────────────────────────────────
# freedom.yaml — NEOTH operator configuration
# ─────────────────────────────────────────────────────────────────────────────
# This is an annotated example. Copy it to `~/.neoth/freedom.yaml`, edit the
# fields you care about, and `neoth init --force` to apply (or run
# `neoth init` for the interactive wizard which writes this file for you).
#
# Secrets (API keys, bot tokens) live in `~/.neoth/credentials.yaml` —
# NEVER paste them into this file. Both files round-trip through serde
# automatically.
#
# OS keychain (optional, default: file): set secrets_backend below to
# `keychain` to store secrets in the Windows Credential Manager / macOS
# Keychain / Linux Secret Service instead of credentials.yaml.
# Run `neoth credential migrate --to keychain` first to populate the store.
# Revert with `neoth credential migrate --to file`.
# secrets_backend: keychain   # default: file
#
# File permissions: 0600 on unix, ACL-restricted to the current user on
# Windows. `neoth init` sets these correctly; if you create the file by
# hand on unix run `chmod 600 ~/.neoth/freedom.yaml`.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. Operator identity ─────────────────────────────────────────────────────

# Stable short identifier — 2-32 chars, [a-zA-Z0-9_-]. Used as the
# author tag on every WAL event the daemon emits. Pick something
# meaningful; you cannot easily change this without retagging history.
operator_id: demo-user

# BCP-47 primary language. Drives default replies + onboarding text.
language_primary: de

# BCP-47 code-context language. Defaults to language_primary.
# Useful when you talk to NEOTH in German but want commit messages
# in English: set language_primary=de and language_code=en.
language_code: en

# One of: developer, security-researcher, founder, data-scientist,
# writer, none. Picks the system-prompt persona + default skill set.
role: developer

# Free-form override when the `role` enum is too narrow. [a-z0-9_-]{1,32}.
# Validated against the regex at load time.
# role_custom: red-team


# ── 2. Provider (LLM backend) ────────────────────────────────────────────────

# One of: claude_cli, openai_api, gemini_api, openai_compat, local_qwen,
# hermes, openclaw, skip. `skip` means "configure later via the wizard".
provider_kind: claude_cli

# Path to the provider binary (for `claude_cli`). Auto-detected via $PATH
# when the wizard runs; override here for non-standard installs.
# provider_binary: /home/user/.npm-global/bin/claude

# API endpoint (for `openai_compat` only — e.g. LM Studio, vLLM, Ollama).
# provider_endpoint: http://127.0.0.1:1234/v1

# Model override. Defaults are sensible per provider:
#   claude_cli   → claude-opus-4-7
#   openai_api   → gpt-5
#   gemini_api   → gemini-2.5-pro
#   openai_compat → operator-supplied
#   local_qwen   → Qwen/Qwen2.5-3B-Instruct
# provider_model: claude-opus-4-7


# ── 3. Telegram channel (optional) ───────────────────────────────────────────

# Bot token lives in credentials.yaml, NEVER here. The numeric user id below
# restricts who can talk to the bot — without it, anyone who finds the bot
# username can issue commands.
# telegram_user_id: 123456789
# Other messaging sender policies live beside their channel credentials in
# credentials.yaml (or are written through `neoth channel add` / the GUI):
# `discord_allowed_user_id`, `slack_allowed_user_id`,
# `whatsapp_allowed_sender`, `signal_allowed_sender`, and
# `line_allowed_sender`. They are mandatory for inbound startup; a valid bot
# token or webhook signature never opens the adapter by itself.


# ── 4. Autonomy level ────────────────────────────────────────────────────────

# One of:
#   strict   — every shell exec + every channel send confirms. Maximum
#              brakes; expect a confirmation per action.
#   standard — confirms shell execs + cross-channel sends, allows writes
#              inside ~/.neoth/. Default + recommended for most operators.
#   elevated — allows shell execs without confirm; still confirms channel
#              sends + destructive ops (rm -rf, force-push).
#   full     — broad autonomy; irreducible dangerous/self-modifying actions
#              still confirm. Use only on isolated VMs.
#   custom   — Standard baseline plus the per-action table below. Missing
#              entries inherit Standard exactly; Full confirm/deny decisions
#              cannot be weakened. Cron and auto-update remain fail-closed.
autonomy: standard

# Used only when `autonomy: custom`. Stable action names are listed by
# `neoth permissions show`; edit atomically with:
#   neoth permissions set external_http_request confirm
#   neoth permissions clear external_http_request
custom_autonomy:
  overrides: {}
# Example:
#   overrides:
#     exec_arbitrary: deny
#     external_http_request: confirm
#     channel_send: allow


# ── 4a. Proactive delivery ──────────────────────────────────────────────────

# Default OFF: NEOTH never posts unsolicited messages until you explicitly
# enable this switch. Channel routing and each underlying channel's own sender,
# account and permission checks still apply.
proactive:
  enabled: false
  # Optional UTC quiet-hours window [start_hour, end_hour]. Delivery is silent
  # from start through the hour before end; [22, 7] means 22:00–06:59 UTC.
  # quiet_hours_utc: [22, 7]
  # When true, only deliver after this many seconds without an operator turn.
  idle_only: false
  idle_only_window_secs: 300
  # Absolute time budget for ONE delivery attempt. Default 60; valid range
  # is 1..300 seconds. Timeout cancels the attempt rather than allowing a
  # stalled channel operation to run without a bound.
  delivery_attempt_timeout_secs: 60


# ── 5. Cluster transport + LAN privacy ──────────────────────────────────────

# The cluster master switch is OFF by default. A public `name`, a shared
# `cluster_passphrase` in credentials.yaml, and `enabled: true` are all required
# before the daemon joins a transport. Prefer the GUI Cluster panel or
# `neoth cluster configure` over independent YAML edits: it writes the complete
# snapshot (plus an optional stdin-only passphrase) atomically. A changed
# snapshot reports `restart_required: true`; restart the supervised daemon to
# activate transport/mDNS lifecycle changes. Gossip privacy/replay values are
# read live by every carrier after a successful reload. mDNS discovery defaults on, but the
# privacy policy below announces only on explicitly trusted SSIDs; an empty
# list therefore stays silent. `listen_port` is shared by mDNS and Tailscale.
cluster:
  # name: home-lab
  enabled: false
  transport: peeroxide       # peeroxide | iroh (native desktop includes both;
                             # source builds need cluster-iroh for iroh)
  peers: []                  # iroh Node IDs for first outbound contact
  mdns:
    enabled: true
  policy:
    announce_on_untrusted_wifi: false
    trusted_ssids: []        # e.g. [home-wifi, home-wifi-5g]
  gossip:
    replicate_raw_ingress: false  # privacy-first; semantic events only
    replay_budget_days: 30         # valid range: 1..90 days
  listen_port: 49737


# ── 6. Inference topology ────────────────────────────────────────────────────

# Per-hemisphere provider selection (R-22 Council). Three modes:
#   single  — one provider for all roles. Default. Mirrors the legacy
#             provider_kind path; existing configs work unchanged.
#   triplet — same provider on all three slots, configured per-slot
#             (e.g. one Claude account per hemisphere for rate-limit
#             isolation).
#   custom  — independent provider per role.
#
# Per-slot fields (left/right/cerebellum/default_slot):
#   provider — claude_cli | anthropic_api | openai_api | openai_compat
#              | gemini_api | local_qwen | hermes | openclaw
#   model    — provider-native model id (e.g. claude-opus-4-7, gpt-4o)
#   key      — API key (omit for claude_cli / local_qwen; keep secrets
#              in `~/.neoth/credentials.yaml` instead of inlining here)
#   endpoint — base URL for openai_compat (LM Studio, vLLM, Ollama,
#              OpenRouter, Together, Groq, Fireworks, …)
#   openai_compat_profile — optional exact wire contract:
#              generic | openrouter | deepseek | moonshot_kimi | qwen_chat
#              Named profiles require a reviewed matching official endpoint;
#              arbitrary/local endpoints stay generic.
inference:
  mode: single
  # Legacy top-level openai_compat binding only. Slot fields below take
  # precedence for custom/fallback role routing.
  # openai_compat_profile: generic
  # accelerator: cuda      # cuda | metal | openvino | cpu. Auto-detected.
  # embedding_provider: local_qwen
  # left:
  #   provider: claude_cli
  #   model: claude-opus-4-7
  # right:
  #   provider: gemini_api
  #   model: gemini-2.5-pro
  # cerebellum:
  #   provider: local_qwen
  #   model: Qwen/Qwen2.5-3B-Instruct

# ── Dreaming pipeline (R-02 Phase 4c) ───────────────────────────────────────
#
# On-demand pass (`neoth dream now`) plus an optional calendar cron that groups
# recent episodes from `idx_episode` into themed "dreams". Cron is OFF by
# default — no unattended work occurs unless `cron_enabled: true`. Strict and
# Custom autonomy fail closed. When `inference.embedding_provider` is also set,
# clustering is embedding-based (cosine over the local Qwen embeddings,
# per ADR-004); otherwise it falls back to a deterministic compose. The daily
# boundary is claimed durably before effects, is never replayed after restart,
# and an already-passed boundary is not caught up on daemon boot.
# dream:
#   cron_enabled: false     # master cron switch; `dream now` remains available
#   cron_at: "03:00"        # zero-padded local HH:MM
#   timezone: Europe/Berlin # optional IANA zone; falls back to user_tz, then UTC
#   window_secs: 86400      # episode lookback window per pass (default 24h)
#   max_events: 500         # cap on events processed per pass (default 500)
#   summarize_themes: false # LLM-label each cluster via the chat provider
#                           #   (SPEC-12 Phase 4b). OFF by default: it adds
#                           #   one LLM call per cluster — on a metered cloud
#                           #   provider an opted-in nightly run would bill.
#                           #   false/no-provider/error → deterministic label.
#   merge_cross_themes: false # SPEC-12 cross-theme merge: collapse clusters
#                           #   whose centroid embeddings are co-located
#                           #   (cosine >= 0.75) into one meta-theme. OFF by
#                           #   default. PURE centroid math — no LLM, no cost.

# ── 5a. Recipe: cloud-Qwen via OpenRouter (no local GPU needed) ──────────────
#
# Operators without GPU for local Qwen3 inference can route any
# hemisphere to a hosted Qwen / DeepSeek / Llama / etc via OpenRouter.
# OpenRouter exposes an OpenAI-compatible endpoint. NEOTH keeps the explicit
# OpenRouter profile so router guardrails and observed upstream provider/model
# evidence are not flattened into a generic-compatible result.
#
# Get an API key at https://openrouter.ai/keys, then paste it into
# `~/.neoth/credentials.yaml` (NOT this file) or set the slot's `key:`
# field below for a single-machine setup.
#
# Example: Right hemisphere on OpenRouter-hosted Qwen3-72B-Instruct.
# inference:
#   mode: custom
#   right:
#     provider: openai_compat
#     openai_compat_profile: openrouter
#     endpoint: https://openrouter.ai/api/v1
#     model: qwen/qwen3-72b-instruct
#     # key: sk-or-v1-...  # prefer ~/.neoth/credentials.yaml
#
# Other OpenAI-compatible hosts that work identically:
#   - Together AI  https://api.together.xyz/v1
#   - Groq         https://api.groq.com/openai/v1
#   - Fireworks    https://api.fireworks.ai/inference/v1
#   - DeepInfra    https://api.deepinfra.com/v1/openai
#   - LM Studio    http://127.0.0.1:1234/v1   (local, no key)
#   - Ollama       http://127.0.0.1:11434/v1  (local, no key)
#
# CLI shortcut (after `neoth init` has run once):
#   neoth hemispheres set --role right \
#     --provider openai_compat \
#     --endpoint https://openrouter.ai/api/v1 \
#     --model qwen/qwen3-72b-instruct \
#     --key sk-or-v1-...


# ── 7. Babel-Index observer (local by default) ───────────────────────────────

# The observer and K_d_v0 histogram are enabled by default. Optional memory /
# skill posture signals are content-free and off by default. Selecting a K_d
# embedding model requires a configured local EmbedProvider; failures degrade
# explicitly to K=0 and never fall back under a false algorithm label.
# Incognito provider calls never enter either K_d feed.
# babel:
#   enabled: true
#   tick_interval_secs: 60
#   threshold: 0.8
#   v_max_default: 150.0
#   memory_signals: false
#   skill_signals: false
#   k_d_embedding_model: null  # e.g. a locally configured embedding checkpoint
#   export_format: jsonl
#   federate: false            # separate explicit egress opt-in; fail-closed

# ── 8. Observability listener (optional) ─────────────────────────────────────

# When set, `neoth serve` exposes /healthz + /metrics on this address.
# Bind to 127.0.0.1 unless you have a real reason — these endpoints
# expose runtime state.
# observability_listen: 127.0.0.1:43117


# ── 9. Two-stage sub-agent review (off by default) ───────────────────────────

# obra/superpowers port #2. When true, every `/agent <name> ...` call
# chains two extra provider passes (spec compliance + code quality)
# and emits 0x84 SUBAGENT_REVIEW_STAGE WAL frames per stage. Costs
# ~3× the spend of an un-reviewed call.
review_gate_enabled: false


# ── 10. Obsidian vault sync (optional) ───────────────────────────────────────

# When set, the daemon mirrors `~/.neoth/archive/sessions/<day>/<file>.md`
# into the operator's Obsidian vault on a schedule.
# obsidian_vault: /home/user/vaults/main
# obsidian_subdir: NEOTH       # default: "NEOTH"
# obsidian_auto_sync_secs: 3600 # default: 1 hour
# obsidian_preload_template_dir: /home/user/agenter/L6_Vault_Template  # auto-runs once at serve startup when set
# obsidian_preload_subdir: NEOTH-Preload
# knowledge_preload_dirs:   # each entry auto-runs once at serve startup; skipped if preload_manifest.yaml is absent
#   - /home/user/agenter/L6_Vault_Template


# ── 11. Hysteria transport (optional, R-3) ───────────────────────────────────

# Encrypted egress for provider HTTP traffic. When configured, `neoth serve`
# spawns the Hysteria subprocess at startup + routes provider HTTP via the
# resulting SOCKS5 proxy. Operator supplies server + auth; binary is
# auto-found in $PATH or ~/.neoth/bin/hysteria.
# hysteria:
#   server: example.com:443
#   auth: shared-secret
#   socks_port: 1080


# ── 12. Cloud archive mirror (optional, R-8) ─────────────────────────────────

# Local folder that the operator's cloud client (Dropbox, GDrive, OneDrive,
# iCloud, SMB mount, …) ALREADY syncs upstream. Daemon mirrors
# `~/.neoth/archive/sessions/` into this folder on a schedule. Cloud
# auth + transport are owned by the cloud vendor's desktop client —
# NEOTH stays out of it.
# cloud_archive_dest: /home/user/Dropbox/NEOTH-archive
# cloud_archive_subdir: NEOTH
# cloud_archive_auto_sync_secs: 3600


# ── 13. B-Rollback snapshot policy (CDX-02) ──────────────────────────────────

# Which effect-adapter mutations should NEOTH snapshot before they
# happen? Snapshots live in `~/.neoth/wal/*-snapshot-*.wal` and the
# operator restores them via `neoth rollback apply --to <offset>`.
#
# Supported `capture_kinds` (snake_case):
#   config_write    — freedom.yaml / credentials.yaml rewrites
#   channel_send    — outbound text via send_text_with_snapshot()
#   sql_mutation    — writes to ~/.neoth/views.db (opt-in, payload-heavy)
#   mcp_tool_invoke — MCP tool calls (opt-in, see CDX-03)
#   file_write      — generic file writes (opt-in)
#   other           — operator-tagged manual snapshots
#
# Empty list = rollback fully off.
# Per-frame ceiling: `before_state` over `max_snapshot_bytes` skips the
# snapshot (WARN logged). Default 64 KiB.
rollback:
  capture_kinds:
    - config_write
    - channel_send
  max_snapshot_bytes: 65536


# ── 14. Claude CLI provider tuning (B-6) ─────────────────────────────────────

# Only consumed when `provider_kind: claude_cli`. Switches the adapter
# between the cold-start `claude --print` subprocess path and the warm
# tmux-backed interactive session.
#
# Backend modes:
#   auto       — probe tmux availability at startup; tmux wins when
#                present, subprocess otherwise. Default + recommended.
#   tmux       — force the warm session. Errors at startup if tmux is
#                missing. Recommended for tmux-based setups — subprocess
#                mode is documented broken there.
#   subprocess — force `claude --print`. Use only on Windows-without-WSL
#                where tmux is not an option.
#
# Tmux sub-block (ignored when backend == subprocess):
#   session_scope            — singleton (one warm session per adapter,
#                              v0.1) or per_conversation (Agent-4 pool,
#                              v0.2+; falls back to singleton today).
#   compaction_rotate_after  — rotate to a fresh session after N
#                              "Memory was condensed" responses.
#                              Bridge.py default 10.
#   idle_ttl_secs            — sweeper kills warm sessions idle longer
#                              than this. Bridge.py default 1800 (30 min).
#   idle_timeout_secs        — per-request idle-window cap (no pane
#                              change = response done). Bridge.py 120.
#                              Declared today; honored end-to-end when
#                              B-6 Item 3 (retry classifier) lands.
#   hard_timeout_secs        — per-request absolute cap before
#                              claude_tmux gives up. Bridge.py 300.
#                              Same wiring status as idle_timeout_secs.
claude_cli:
  backend: auto
  tmux:
    session_scope: singleton
    compaction_rotate_after: 10
    idle_ttl_secs: 1800
    idle_timeout_secs: 120
    hard_timeout_secs: 300


# ── 15. Communication adaptation + fact learning ─────────────────────────────

# The communication engine is ON by default. It is deterministic and local:
# no extra model call, no raw-message persistence, and no medical diagnosis.
# It learns typed presentation preferences only after repeated authenticated
# evidence across sessions. Explicit settings always win. Incognito performs
# zero profile reads and writes. Full/Sovereign may make a stable low-risk
# accommodation durable until the operator resets it; privacy and subject
# isolation remain mandatory.
#
# `prompt_export: accommodations_only` sends providers only concrete style
# instructions. It never sends autism/ADHD/neurodivergence labels. Label export
# requires both an explicit operator declaration and the explicit
# `label_and_accommodations` setting.

# When `learn_enabled: true`, NEOTH runs the 6-stage profile pipeline
# after every `neoth chat` reply. The pipeline reads the conversation
# window, asks the LLM to extract operator-facts ("the operator lives
# in Berlin", "prefers Rust over Go"), runs them through the H1/H2/H5
# claim guards, and writes accepted claims into `~/.neoth/views.db ::
# idx_profile`. Those claims are then injected into Corpus Callosum
# synthesis on Council Split verdicts (CH-11), giving the council
# real operator context to weight competing hemisphere outputs.
#
# OFF by default because the Stage-3 extract is a full LLM call —
# operators on paid clouds (OpenAI / Anthropic / OpenRouter) would
# see a 2× token bill per chat without opt-in. Operators on local
# Qwen or prepaid plans flip `learn_enabled: true` and pay zero
# incremental cost.
#
# `timeout_secs` caps how long the post-reply pipeline can block the
# shell prompt. A hung extract call is abandoned past this budget
# (logged at warn) so the operator's CLI always returns.
#
# Env overrides:
#   NEOTH_PROFILE_LEARN_DISABLE=1 — per-call brake (skip even when on)
#   NEOTH_PROFILE_LEARN_FORCE=1   — per-call lift  (run even when off)
profile:
  communication:
    enabled: true
    auto_apply_low_risk: true
    min_observations: 5
    min_distinct_sessions: 3
    min_confidence: 0.75
    passive_half_life_days: 30
    feedback_half_life_days: 90
    correction_half_life_days: 180
    full_auto_min_observations: 10
    full_auto_min_distinct_sessions: 5
    full_auto_min_confidence: 0.85
    max_evidence_per_dimension: 32
    prompt_export: accommodations_only
    cluster_sync: false

  # Separate opt-in LLM fact extraction. This can cost provider tokens;
  # communication adaptation above cannot.
  learn_enabled: false
  timeout_secs: 15

# ── 16. Council local-first weighting (COUNCIL-WEIGHTING-01) ────────────────
#
# Prevents cloud models from winning a council debate purely by TIER_TABLE
# score when actual response quality is equivalent to a local provider.
#
# locality_tie_break (default: true) — when the highest-scoring cloud
#   candidate is within `locality_tie_epsilon` of a local candidate, the
#   local provider wins.  Set `false` to fall back to raw score ordering.
#
# locality_tie_epsilon (default: 0.05) — tie window on the [0,1] composite
#   scale.  Raise to widen the promotion window; lower to tighten it.
#
# local_score_bonus (default: 0.0) — explicit additive prior for local
#   providers, applied before the tie-break.  Default 0.0 = no extra boost.
#   Set e.g. 0.2 to give local providers a 20-point head-start.
#
# "Local" providers: local_qwen, local_ouro, local_ollama, recursive_mas.
# cloud_cli is NOT local (inference runs on Anthropic's servers).
#
# Applied by the live CLI and channel council winner-selection paths.
#
#council:
#  locality_tie_break: true
#  locality_tie_epsilon: 0.05
#  local_score_bonus: 0.0

# ── 17. OMI conversation + native media ingest (off by default) ─────────────
#
# Modes:
#   developer_api  — official OMI list/detail import. Public HTTPS requires
#                    allow_cloud_api=true + omi_developer_api_key (`omi_dev_*`).
#   native_ingest  — authenticated private listener for PCM/captions/frames.
#   both           — both surfaces; native completions export to official OMI.
#   legacy_memories — old local/private GET /v1/memories compatibility feed.
#
# Put the relevant secrets in ~/.neoth/credentials.yaml or the keychain:
#   omi_developer_api_key: omi_dev_...
#   omi_ingest_token: <at least 32 random bytes>
#
# Audio, images, video-call frames, verbatim transcript retention, derived
# summaries, tasks, ground-truth, cloud API use, and cloud summaries are
# independent opt-ins. Raw media bytes are never persisted. SC-18 quarantine
# halts every downstream effect until `neoth omi resume --review-note ...`.
#
# omi:
#   enabled: false
#   mode: developer_api
#   endpoint: http://127.0.0.1:8002
#   allow_cloud_api: false
#   poll_interval_secs: 30
#   confidence_threshold: 0.75
#   listen_addr: 127.0.0.1:8003
#   initial_lookback_secs: 86400
#   max_conversations_per_poll: 100
#   retain_transcripts: false
#   audio_enabled: false
#   visual_enabled: false
#   video_enabled: false
#   create_actions: true
#   seed_groundtruth: true
#   summary_enabled: true
#   allow_cloud_summary: false
#   retention_days: 30
#   max_audio_bytes_per_stream: 67108864
#   max_image_bytes: 16777216
#   max_connections: 4
#   max_active_calls: 4
#   idle_timeout_secs: 120
#   allowed_uids: []

# ── 18. WASM plugin approvals (managed by the CLI) ──────────────────────────
#
# Newly discovered plugins stay Pending until `neoth plugin enable <id>`.
# Enable/re-enable writes an approval-bound record containing the exact
# requested permission plus canonical plugin.toml and plugin.wasm SHA-256
# digests. Do not manufacture these values by hand: any permission, semantic
# manifest, or WASM change is refused on the next load and appears as
# `reconsent_required` in `neoth plugin list`; review it and run the enable
# command again. A running daemon uses only its immutable validated snapshot.
#
# Historical scalar entries such as `example: active` remain parseable, but
# deliberately do not run until explicitly re-enabled.
#
# plugins:
#   wasm:
#     enabled: true
#     activations:
#       example:
#         state: active
#         approval:
#           approved_permission: read_only
#           manifest_sha256: <written-by-neoth-plugin-enable>
#           wasm_sha256: <written-by-neoth-plugin-enable>
#     pinned_hashes:
#       example: <trusted-plugin-wasm-sha256>
#     require_all_pinned: false
#     require_signature: false
#     revoked_ids: []

# ── 19. Signed release-bundle self-update (off by default) ──────────────────
#
# `enabled` arms the daemon's recurring self-update intent. Until the
# request-bound transport/effect authority and WAL contract lands, production
# recurring passes terminate as `SkippedByGate` before GitHub, process,
# download, install, or staging work. `auto_apply: true` records the operator's
# future verified-stage intent; it does not bypass that deny gate. Manual
# `neoth update --self` and explicit `neoth update --self --apply` remain the
# active paths, and replacement always requires the latter command.
#
# Channels are strict release rings:
#   stable  — final SemVer releases only
#   rc      — final + rc-tagged SemVer releases
#   nightly — final + rc + nightly-tagged SemVer releases
# Alpha/beta tags are rejected by every ring. `check_interval_secs: 0`
# disables background checks/staging while preserving manual update commands.
# `repo` must be a GitHub owner/repo slug. `target_triple` is normally omitted
# for host detection; an override must exist in the release build matrix.
#
# auto_update:
#   enabled: false
#   auto_apply: false
#   channel: stable
#   check_interval_secs: 86400
#   repo: The-Geek-Freaks/NEOTH
#   # target_triple: x86_64-unknown-linux-musl

# ── 20. Cluster resource snapshots + swarm dashboard ────────────────────────
#
# With the cluster feature compiled in, the daemon records local CPU/RAM/VRAM
# snapshots at this cadence. `neoth cluster swarm` reads local and replicated
# peer snapshots from the WAL and drops rows older than `stale_after_secs`.
# Both time values must be greater than zero; invalid config fails startup.
# Set `enabled: false` to stop the sampling task. An explicit dashboard
# `--stale-secs` overrides only the display threshold for that invocation.
#
# swarm:
#   enabled: true
#   interval_secs: 30
#   stale_after_secs: 300
